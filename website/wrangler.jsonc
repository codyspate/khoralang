{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "khora-docs",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "khoralang.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
