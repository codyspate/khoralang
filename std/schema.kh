module std::schema;

import std::core::{Dict, Eq, List, Map, Option, Ord, Ordering, Pair, Redacted, Result, Show, Validated, Vector};
import std::decimal::{Decimal};
import std::json::{Field, Json, member, object};
import std::time::{Date, DateTime, Time};

//! One description of a value's shape, used to decode untrusted input.
//!
//! **A schema describes a value. It does not know where the bytes came from.**
//! That separation is the whole of the library. A `Schema<A>` describes an
//! `A`; a [`Raw`] is whatever a source produced -- a JSON document, the
//! environment, a query string, a database row; and `decode` is one function
//! over the pair. The same `Schema<Settings>` reads a request body, a test
//! fixture and the deployment's variables, and does not know which.
//!
//! # Both halves, in one record
//!
//! A schema carries a `read` closure *and* a [`Shape`] beside it, and both are
//! load-bearing. The closure is what makes `schema.decode(value)` an ordinary
//! call and what lets schemas be combined. The shape is untyped -- no type
//! parameter -- which is what lets a record's fields sit in a `List` and be
//! walked, so a deployment can ask which keys a configuration needs without
//! starting the program, and a document can be rendered from the same value
//! that checks the input.
//!
//! # Every problem, not the first
//!
//! Decoding answers a `Validated`, so a record with three bad fields reports
//! three. A person fixing a deployment wants the list, not one line of it at
//! a time. `Validated::to_result` is one call for a caller who wants to stop.
//!
//! # Strict where the source could say, lenient where it could not
//!
//! `int()` reads a `Raw::Number`, and refuses a `Raw::Text` holding `"8080"`:
//! a JSON body that sends a number as a string is wrong, and serde and
//! `encoding/json` refuse it too. The environment cannot label anything, so
//! it hands over [`Raw::Untyped`], which every primitive reads. Leniency is a
//! fact about the source, recorded by the source, and no primitive has to
//! guess.

// ---------------------------------------------------------------------------
// What arrived
// ---------------------------------------------------------------------------

/// A value as a source handed it over, before anything has been asked of it.
///
/// A record's fields are [`Pair`]s from `std::core` rather than a type of this
/// module's own, so anything that already walks a `Pair` walks these.
///
/// **A number is its text, and that is not an oversight.** A `Float` holds
/// about fifteen significant digits, so `9007199254740993` comes back one
/// short of itself and `10.10` is never exactly recoverable -- and a schema
/// that decoded a `Decimal` through one would rebuild, inside the library
/// meant to prevent that class of thing, the exact bug it exists to prevent.
/// Keeping the token lets [`int`] and [`decimal`] parse it exactly.
///
/// **`Null` is not `Absent`.** A key that was not there and a key that was
/// there holding nothing are different facts to a client: [`optional`] treats
/// both as nothing, and a required field given `null` says so rather than
/// saying it was not set, which is the difference between a client bug and a
/// deployment bug.
///
/// **`Untyped` is text the source could not label.** An environment variable,
/// a command-line argument, a query parameter and a header are all text, and
/// none of them knows whether `8080` was meant as a number. Every primitive
/// reads an `Untyped`, and none reads a `Text` as anything but text, which is
/// how one `Schema<Int>` refuses `"port": "8080"` in a JSON body and accepts
/// `PORT=8080` from the environment.
///
/// **`Denied` is a value the source was not allowed to look at.** The
/// environment puts it where a variable the manifest does not grant would
/// go, and it decodes as [`Problem::Denied`] rather than as missing, because
/// the fix is a line in `khora.toml` and not in the deployment.
derive(Show)
pub type Raw =
  | Absent
  | Null
  | Text(text: String)
  | Untyped(text: String)
  | Number(text: String)
  | Bool(value: Bool)
  | Sequence(items: List<Raw>)
  | Record(fields: List<Pair<String, Raw>>)
  | Denied;

impl Raw {
  /// One entry of a record: what a generated encoder writes a field as.
  pub fn entry(key: String, value: Raw) -> Pair<String, Raw> { { key: key, value: value } }

  /// The field of a record, or [`Raw::Absent`].
  ///
  /// Absent rather than an `Option`, so that a missing field and a field
  /// holding nothing are the same thing to everything downstream and only
  /// [`optional`] has to know the difference.
  pub fn field(self, name: String) -> Raw {
    match self {
      Raw::Record(fields) =>
        match List::find(fields, fn entry => entry.key == name) {
          Option::Some(entry) => entry.value,
          Option::None => Raw::Absent,
        },
      _ => Raw::Absent,
    }
  }

  /// What to call this in a message: `text`, `a number`, and so on.
  pub fn describe(self) -> String {
    match self {
      Raw::Absent => "nothing",
      Raw::Null => "null",
      Raw::Text(_t) => "text",
      Raw::Untyped(_t) => "text",
      Raw::Number(_t) => "a number",
      Raw::Bool(_b) => "true or false",
      Raw::Sequence(_i) => "a list",
      Raw::Record(_f) => "a record",
      Raw::Denied => "something that was not granted",
    }
  }

  /// A JSON document as a source produced it.
  ///
  /// Total: `null` stays `Null`, a number keeps its literal, and an object
  /// becomes a record in the order `Json::entries` gives.
  pub fn of_json(document: Json) -> Raw {
    match document {
      Json::Null => Raw::Null,
      Json::Bool(value) => Raw::Bool(value),
      Json::Number(literal) => Raw::Number(literal),
      Json::Text(value) => Raw::Text(value),
      Json::Array(items) => {
        // A fold and a reverse rather than `List::map`, which recurses once
        // per element; a document is allowed to be long.
        let converted = List::fold(items, List::Nil, fn (acc, item) => List::Cons(Raw::of_json(item), acc));
        Raw::Sequence(List::reverse(converted))
      },
      Json::Object(_fields) => {
        let converted = List::fold(Json::entries(document), List::Nil, fn (acc, field) =>
          List::Cons(Raw::entry(field.name, Raw::of_json(field.value)), acc));
        Raw::Record(List::reverse(converted))
      },
    }
  }

  /// The JSON a value renders to; the one bridge out.
  ///
  /// An `Absent` entry is left out of an object and written as `null` inside
  /// an array, because an element cannot be omitted. `Untyped` is text, which
  /// is all a source that could not label it ever knew.
  pub fn to_json(self) -> Json {
    match self {
      Raw::Absent => Json::Null,
      Raw::Null => Json::Null,
      Raw::Text(text) => Json::Text(text),
      Raw::Untyped(text) => Json::Text(text),
      Raw::Number(text) => Json::Number(text),
      Raw::Bool(value) => Json::Bool(value),
      Raw::Sequence(items) => {
        let converted = List::fold(items, List::Nil, fn (acc, item) => List::Cons(Raw::to_json(item), acc));
        Json::Array(List::reverse(converted))
      },
      Raw::Record(fields) => {
        let converted = List::fold(fields, List::Nil, fn (acc, field) =>
          match field.value {
            Raw::Absent => acc,
            present => List::Cons(member(field.key, Raw::to_json(present)), acc),
          });
        object(List::reverse(converted))
      },
      Raw::Denied => Json::Null,
    }
  }

  /// A record of text nobody labelled: a query string, the path parameters,
  /// the headers.
  pub fn of_map(text: Map<String, String>) -> Raw {
    let converted = List::fold(Map::entries(text), List::Nil, fn (acc, field) =>
      List::Cons(Raw::entry(field.key, Raw::Untyped(field.value)), acc));
    Raw::Record(List::reverse(converted))
  }

  /// Command-line arguments as a record.
  ///
  /// `--host x` and `--host=x` are a field named `host`; a bare `--verbose`
  /// is `true`; `-` in a flag is `_` in its name, so `--log-level` reaches a
  /// field called `log_level`; and anything that is not a flag is collected,
  /// in order, under `arguments`.
  pub fn of_arguments(arguments: List<String>) -> Raw {
    let mut fields = List::Nil;
    let mut positional = List::Nil;
    let mut rest = arguments;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) => {
          if String::starts_with(head, "--") {
            let flag = String::slice(head, 2, String::byte_length(head));
            match String::index_of(flag, "=") {
              Option::Some(at) => {
                let name = flag_name(String::slice(flag, 0, at));
                let value = String::slice(flag, at + 1, String::byte_length(flag));
                fields = List::Cons(Raw::entry(name, Raw::Untyped(value)), fields);
                rest = tail;
              },
              Option::None => {
                let name = flag_name(flag);
                match tail {
                  List::Cons(next, after) => {
                    if String::starts_with(next, "--") {
                      fields = List::Cons(Raw::entry(name, Raw::Bool(true)), fields);
                      rest = tail;
                    } else {
                      fields = List::Cons(Raw::entry(name, Raw::Untyped(next)), fields);
                      rest = after;
                    }
                  },
                  List::Nil => {
                    fields = List::Cons(Raw::entry(name, Raw::Bool(true)), fields);
                    rest = tail;
                  },
                }
              },
            }
          } else {
            positional = List::Cons(Raw::Untyped(head), positional);
            rest = tail;
          }
        },
      }
    };
    let with_positional = match positional {
      List::Nil => fields,
      some => List::Cons(Raw::entry("arguments", Raw::Sequence(List::reverse(some))), fields),
    };
    Raw::Record(List::reverse(with_positional))
  }
}

/// `log-level` is the flag; `log_level` is the field.
fn flag_name(flag: String) -> String { String::replace(flag, "-", "_") }

// ---------------------------------------------------------------------------
// Where it went wrong
// ---------------------------------------------------------------------------

/// One step into a value, so an error can say `listen.port` or `items[3].id`.
derive(Show, Eq)
pub type Segment = | Field(name: String) | Index(at: Int);

/// What a refinement asked of a value, kept as structure rather than as a
/// sentence.
///
/// A sentence is what a person reads and a keyword is what a JSON Schema
/// carries, and only structure can become both. [`refine`] takes a sentence
/// and keeps it as `Custom`; the named rules -- [`between`], [`min_length`]
/// and their neighbours -- carry their bounds.
derive(Show, Eq)
pub type Rule =
  | Custom(must: String)
  | Between(low: String, high: String)
  | AtLeast(bound: String)
  | AtMost(bound: String)
  | MinLength(n: Int)
  | MaxLength(n: Int)
  | MinItems(n: Int)
  | MaxItems(n: Int)
  | OneOf(allowed: List<String>);

/// `1 character`, `3 characters`.
fn count(n: Int, noun: String) -> String {
  if n == 1 { "1 " + noun } else { Int::to_string(n) + " " + noun + "s" }
}

impl Rule {
  /// The rule as the rest of a sentence beginning `must`: `be between 1 and
  /// 65535`, `have at least 1 item`.
  pub fn describe(self) -> String {
    match self {
      Rule::Custom(must) => "be " + must,
      Rule::Between(low, high) => "be between " + low + " and " + high,
      Rule::AtLeast(bound) => "be at least " + bound,
      Rule::AtMost(bound) => "be at most " + bound,
      Rule::MinLength(n) => "be at least " + count(n, "character"),
      Rule::MaxLength(n) => "be at most " + count(n, "character"),
      Rule::MinItems(n) => "have at least " + count(n, "item"),
      Rule::MaxItems(n) => "have at most " + count(n, "item"),
      Rule::OneOf(allowed) =>
        "be one of " + String::join(List::map(allowed, fn a => "`" + a + "`"), ", "),
    }
  }
}

/// What was wrong at one place.
///
/// **`found` is a `Redacted<String>`**, always, rather than only inside a
/// secret. A decode error quotes what it saw, which is most of its value, and
/// that is the easiest imaginable way to put a password in a log. Making the
/// wrapper unconditional means [`Rejection::describe`] decides once whether
/// to expose it and no future variant can forget.
///
/// `Unexpected` is a key a closed record did not declare, and only
/// [`Schema::closed`] produces it: unknown keys are ignored by default, as
/// every library this audience has used ignores them. `Denied` is a value the
/// source was not allowed to read, kept apart from `Missing` because the fix
/// is in `khora.toml` and not in the deployment.
derive(Show)
pub type Problem =
  | Missing
  | Wrong(wanted: String, found: Redacted<String>)
  | Refused(rule: Rule)
  | Unexpected
  | Denied;

/// A problem, and where it was.
derive(Show)
pub type Rejection = { path: List<Segment>, secret: Bool, problem: Problem };

impl Segment {
  /// The step as it appears in a path: `.name` or `[3]`.
  pub fn write(self) -> String {
    match self {
      Segment::Field(name) => "." + name,
      Segment::Index(at) => "[" + Int::to_string(at) + "]",
    }
  }
}

impl Rejection {
  /// Where this was, as a reader would write it: `listen.port`.
  ///
  /// The leading dot is dropped, so a top-level field reads `port` rather than
  /// `.port`, and a failure at the root reads `the value` rather than nothing.
  ///
  /// **The path is held innermost-first and turned round here.** Appending to
  /// the end of a `List` walks it, and a path is extended once per field at
  /// every depth; pushing is one cell and this runs only when something has
  /// gone wrong.
  pub fn at(self) -> String {
    let outward = List::reverse(self.path);
    let written = List::fold(outward, "", fn (acc, step) => acc + Segment::write(step));
    if written == "" {
      "the value"
    } else if String::starts_with(written, ".") {
      // Only a *dot*, and only the leading one. Dropping the first byte
      // whatever it was ate the bracket off `[1]`, which a test caught and a
      // reader would have read as a typo.
      String::slice(written, 1, String::byte_length(written))
    } else {
      written
    }
  }

  /// One line a person can act on.
  ///
  /// **What was found is quoted, unless this is inside a secret.** A message
  /// naming the bad value is what makes a decode error worth reading, and a
  /// message naming a password is a leak. The flag is set by [`secret`] and
  /// nothing else looks at it.
  ///
  /// Text is written in double quotes and a number bare, so `port should be
  /// a whole number, and is "8080"` says what was wrong with it: `8080` is a
  /// whole number, and the problem was that it arrived as text.
  pub fn describe(self) -> String {
    let at = Rejection::at(self);
    match self.problem {
      Problem::Missing => at + " is not set",
      Problem::Refused(rule) => at + " must " + Rule::describe(rule),
      Problem::Unexpected => at + " is not expected",
      Problem::Denied => at + " is not granted",
      Problem::Wrong(wanted, found) =>
        if self.secret {
          at + " should be " + wanted
        } else {
          at + " should be " + wanted + ", and is " + Redacted::expose(found)
        },
    }
  }

  /// Every problem, one per line, in the order they were found.
  pub fn report(problems: List<Rejection>) -> String {
    String::join(List::map(problems, fn problem => Rejection::describe(problem)), "\n")
  }
}

// ---------------------------------------------------------------------------
// What a schema looks like
// ---------------------------------------------------------------------------

/// The untyped half of a schema: what it describes, without saying as what.
///
/// No type parameter, which is the point. A record's fields have different
/// types and this is what lets them sit in one `List` and be walked -- to list
/// the keys a configuration needs, to print a request body in generated
/// documentation, to render a JSON Schema. A closure answers none of those.
///
/// **Every arm is named after the constructor that builds it**, one for one:
/// [`string`] builds `String`, [`list`] builds `List`, [`Schema::cases`]
/// builds `Cases`, [`Schema::lazy`] builds `Lazy`. `Struct` is what
/// [`Schema::record`] builds, and is named for the literal that will build it.
///
/// `Lazy` holds a thunk rather than a shape, so that a type which mentions
/// itself has a shape at all; a walker forces it, and a walker that can meet
/// the same name twice keeps a visited set. It is also why `Show` is written
/// by hand below: nothing can be derived over a closure.
pub type Shape =
  | Any
  | String
  | Int
  | Float
  | Decimal
  | Bool
  | List(of: Shape)
  | Dict(of: Shape)
  | Struct(fields: List<Named>)
  | Cases(cases: List<Alternative>)
  | Optional(inner: Shape)
  | Nullable(inner: Shape)
  | Default(inner: Shape)
  | Keyed(wire: String, inner: Shape)
  | Refined(inner: Shape, rule: Rule)
  | Secret(inner: Shape)
  | Closed(inner: Shape)
  | Described(inner: Shape, text: String)
  | Lazy(name: String, inner: () -> Shape);

/// One named field of a [`Shape::Struct`].
///
/// `name` is the field's name in the type. The key it is read under on the
/// wire is the same unless the shape inside is [`Shape::Keyed`], which
/// [`Shape::keys`] looks through.
derive(Show)
pub type Named = { name: String, shape: Shape };

/// One case of a [`Shape::Cases`]: its tag, and the fields of its payload.
derive(Show)
pub type Alternative = { name: String, fields: List<Named> };

impl Show for Shape {
  fn show(self) -> String {
    match self {
      Shape::Any => "Any",
      Shape::String => "String",
      Shape::Int => "Int",
      Shape::Float => "Float",
      Shape::Decimal => "Decimal",
      Shape::Bool => "Bool",
      Shape::List(of) => "List(" + Show::show(of) + ")",
      Shape::Dict(of) => "Dict(" + Show::show(of) + ")",
      Shape::Struct(fields) =>
        "Struct(" + String::join(List::map(fields, fn named => named.name + ": " + Show::show(named.shape)), ", ") + ")",
      Shape::Cases(cases) =>
        "Cases(" + String::join(List::map(cases, fn case => case.name), ", ") + ")",
      Shape::Optional(inner) => "Optional(" + Show::show(inner) + ")",
      Shape::Nullable(inner) => "Nullable(" + Show::show(inner) + ")",
      Shape::Default(inner) => "Default(" + Show::show(inner) + ")",
      Shape::Keyed(wire, inner) => "Keyed(" + wire + ", " + Show::show(inner) + ")",
      Shape::Refined(inner, rule) => "Refined(" + Show::show(inner) + ", " + Show::show(rule) + ")",
      Shape::Secret(inner) => "Secret(" + Show::show(inner) + ")",
      Shape::Closed(inner) => "Closed(" + Show::show(inner) + ")",
      Shape::Described(inner, text) => "Described(" + Show::show(inner) + ", " + text + ")",
      Shape::Lazy(name, _inner) => "Lazy(" + name + ")",
    }
  }
}

impl Shape {
  /// The keys a record shape needs, in the order they were declared, as they
  /// are spelled on the wire.
  ///
  /// **The question a deployment asks and a program should not have to be
  /// started to answer.** Empty for anything that is not a record.
  pub fn keys(self) -> List<String> {
    match self {
      Shape::Struct(fields) =>
        List::map(fields, fn named => Option::unwrap_or(Shape::wire_key(named.shape), named.name)),
      Shape::Optional(inner) => Shape::keys(inner),
      Shape::Nullable(inner) => Shape::keys(inner),
      Shape::Default(inner) => Shape::keys(inner),
      Shape::Keyed(_wire, inner) => Shape::keys(inner),
      Shape::Refined(inner, _rule) => Shape::keys(inner),
      Shape::Secret(inner) => Shape::keys(inner),
      Shape::Closed(inner) => Shape::keys(inner),
      Shape::Described(inner, _text) => Shape::keys(inner),
      Shape::Lazy(_name, inner) => Shape::keys(inner()),
      _ => List::Nil,
    }
  }

  /// The wire key a field shape was given by [`key`], looking through the
  /// wrappers that may sit outside it.
  pub fn wire_key(self) -> Option<String> {
    match self {
      Shape::Keyed(wire, _inner) => Option::Some(wire),
      Shape::Optional(inner) => Shape::wire_key(inner),
      Shape::Nullable(inner) => Shape::wire_key(inner),
      Shape::Default(inner) => Shape::wire_key(inner),
      Shape::Refined(inner, _rule) => Shape::wire_key(inner),
      Shape::Secret(inner) => Shape::wire_key(inner),
      Shape::Closed(inner) => Shape::wire_key(inner),
      Shape::Described(inner, _text) => Shape::wire_key(inner),
      _ => Option::None,
    }
  }
}

/// A description of an `A`, and how to read one.
///
/// Built with the constructors below rather than by hand: the record is public
/// so that a package may add a primitive of its own, and everything `std`
/// offers goes through [`string`], [`int`] and their neighbours.
pub type Schema<A> = {
  shape: Shape,
  read: (List<Segment>, Raw) -> Validated<A, Rejection>,
};

/// The fields of a record, decoding to an `A`.
///
/// What [`Schema::record`] turns into a schema. Two fields are joined with
/// [`Fields::zip`], which nests a tuple, and [`Fields::map`] turns the tuple
/// into the record; there is no arity anywhere in it. Public because a
/// package may want to build a record schema from something that is not
/// source -- a database catalog, say.
pub type Fields<A> = {
  fields: List<Named>,
  read: (List<Segment>, Raw) -> Validated<A, Rejection>,
};

/// One case of a variant: its tag on the wire, the fields of its payload, and
/// how the payload becomes the value. Built by [`Schema::case`].
pub type Case<A> = {
  name: String,
  fields: List<Named>,
  read: (List<Segment>, Raw) -> Validated<A, Rejection>,
};

impl<A> Schema<A> {
  /// Reads a value, reporting every problem rather than the first.
  ///
  /// The method a caller wants: `Settings::schema().decode(input)`.
  pub fn decode(self, from: Raw) -> Validated<A, Rejection> {
    (self.read)(List::Nil, from)
  }

  /// The same, stopping at the first problem.
  ///
  /// For one field, or for a caller with nothing to do with a list.
  pub fn decode_or_stop(self, from: Raw) -> Result<A, List<Rejection>> {
    Validated::to_result(Schema::decode(self, from))
  }

  /// The same shape, decoding to something made from the value.
  ///
  /// How a newtype reads: `int().map(fn n => UserId(n))`.
  pub fn map<B>(self, f: (A) -> B) -> Schema<B> {
    {
      shape: self.shape,
      read: fn (path, value) => Validated::map((self.read)(path, value), f),
    }
  }

  /// The same shape, decoding to something the value may fail to become.
  ///
  /// Parse, don't validate: `string().try_map("an ISO 8601 date",
  /// Date::of_string)` is a `Schema<Date>`, and a value that is not one reads
  /// `when should be an ISO 8601 date, and is "yesterday"`.
  pub fn try_map<B>(self, wanted: String, f: (A) -> Option<B>) -> Schema<B> {
    {
      shape: self.shape,
      read: fn (path, value) =>
      Validated::and_then((self.read)(path, value), fn a =>
        match f(a) {
          Option::Some(b) => Validated::of(b),
          Option::None => wrong(path, wanted, value),
        }),
    }
  }

  /// A record, from its fields.
  ///
  /// The value has to be a record: a field that is not there is reported by
  /// the field, and something that is not a record at all is reported once.
  pub fn record(fields: Fields<A>) -> Schema<A> {
    {
      shape: Shape::Struct(fields.fields),
      read: fn (path, value) =>
      match value {
        Raw::Record(_entries) => (fields.read)(path, value),
        other => wrong(path, "a record", other),
      },
    }
  }

  /// One case of a variant, for [`Schema::cases`].
  ///
  /// `make` turns the decoded payload into the value; a case with no payload
  /// takes [`Fields::none`] and ignores its argument.
  pub fn case<F>(name: String, fields: Fields<F>, make: (F) -> A) -> Case<A> {
    {
      name: name,
      fields: fields.fields,
      read: fn (path, value) => Validated::map((fields.read)(path, value), make),
    }
  }

  /// A variant, tagged with `type`.
  ///
  /// **A payload-free case is a bare string on the wire and a payload case is
  /// an object whose first key is `type`.** `"Local"` and `{ "type":
  /// "Remote", "url": ".." }` are the two forms, decided by the case and not
  /// by its siblings, so adding a payload case to a shipped enum does not
  /// change how the existing cases are written. That is what a TypeScript
  /// union of a literal and a tagged object encodes, and what JSON Schema's
  /// `oneOf` expresses directly.
  ///
  /// The tag key is `type` because `type` is a keyword, and a record field
  /// cannot be named by it, so no payload can ever collide with its own tag.
  pub fn cases(cases: List<Case<A>>) -> Schema<A> {
    Schema::cases_tagged("type", cases)
  }

  /// A variant tagged with a key of a foreign API's choosing: `kind`,
  /// `_tag`.
  pub fn cases_tagged(tag: String, cases: List<Case<A>>) -> Schema<A> {
    let wanted =
      "one of " + String::join(List::map(cases, fn case => "`" + case.name + "`"), ", ");
    {
      shape: Shape::Cases(List::map(cases, fn case => {
            let alternative: Alternative = { name: case.name, fields: case.fields };
            alternative
          })),
      read: fn (path, value) =>
      match value {
        Raw::Text(name) => bare_case(cases, wanted, name, path, value),
        Raw::Untyped(name) => bare_case(cases, wanted, name, path, value),
        Raw::Record(_entries) => {
          let at = List::push(path, Segment::Field(tag));
          match Raw::field(value, tag) {
            Raw::Absent =>
              Validated::error({ path: at, secret: false, problem: Problem::Missing }),
            Raw::Text(name) =>
              match List::find(cases, fn case => case.name == name) {
                Option::Some(chosen) => (chosen.read)(path, value),
                Option::None => wrong(at, wanted, Raw::Text(name)),
              },
            other => wrong(at, "text", other),
          }
        },
        other => wrong(path, wanted, other),
      },
    }
  }

  /// A schema built when it is first read, so a type may mention itself.
  ///
  /// `name` is what the shape carries, and what a rendered document uses to
  /// refer to the type a second time. Construction never recurses, because
  /// nothing inside is built until a value arrives; the cost is that the
  /// inner schema is rebuilt once per value decoded.
  pub fn lazy(name: String, build: () -> Schema<A>) -> Schema<A> {
    {
      shape: Shape::Lazy(name, fn () => build().shape),
      read: fn (path, value) => (build().read)(path, value),
    }
  }

  /// The same record, refusing a key it did not declare.
  ///
  /// Unknown keys are ignored by default, which is what every library this
  /// audience has used does; a boundary that wants to reject a misspelled
  /// setting rather than ignore it asks for it here, and gets `verbose is not
  /// expected` for each one.
  pub fn closed(self) -> Schema<A> {
    let known = Shape::keys(self.shape);
    {
      shape: Shape::Closed(self.shape),
      read: fn (path, value) => {
        let inner = (self.read)(path, value);
        match value {
          Raw::Record(entries) => {
            let start: Validated<(), Rejection> = Validated::of(());
            let extras = List::fold(entries, start, fn (acc, field) =>
              if List::contains(known, field.key) {
                acc
              } else {
                let unexpected: Validated<(), Rejection> = Validated::error({
                    path: List::push(path, Segment::Field(field.key)),
                    secret: false,
                    problem: Problem::Unexpected,
                  });
                Validated::map2(acc, unexpected, fn (u, _v) => u)
              });
            Validated::map2(inner, extras, fn (a, _u) => a)
          },
          _ => inner,
        }
      },
    }
  }

  /// The same schema, with a sentence for a document to carry.
  pub fn described(self, text: String) -> Schema<A> {
    { shape: Shape::Described(self.shape, text), read: self.read }
  }
}

/// A bare string where a variant was expected: the payload-free case of that
/// name, or a complaint.
fn bare_case<A>(
  cases: List<Case<A>>,
  wanted: String,
  name: String,
  path: List<Segment>,
  value: Raw,
) -> Validated<A, Rejection> {
  match List::find(cases, fn case => case.name == name) {
    Option::Some(chosen) =>
      match chosen.fields {
        List::Nil => (chosen.read)(path, Raw::Record(List::Nil)),
        _ => wrong(path, "a record", value),
      },
    Option::None => wrong(path, wanted, value),
  }
}

impl<A> Fields<A> {
  /// One field, read under its own name -- or under the wire key its schema
  /// was given by [`key`].
  pub fn of(name: String, inner: Schema<A>) -> Fields<A> {
    let wire = Option::unwrap_or(Shape::wire_key(inner.shape), name);
    let named: Named = { name: name, shape: inner.shape };
    {
      fields: List::Cons(named, List::Nil),
      read: fn (path, value) =>
      (inner.read)(List::push(path, Segment::Field(wire)), Raw::field(value, wire)),
    }
  }

  /// No fields at all: the payload of a case that has none.
  pub fn none() -> Fields<()> {
    { fields: List::Nil, read: fn (_path, _value) => Validated::of(()) }
  }

  /// Both sets of fields, decoding to the pair, keeping both sides' failures.
  pub fn zip<B>(self, other: Fields<B>) -> Fields<(A, B)> {
    {
      fields: List::concat(self.fields, other.fields),
      read: fn (path, value) => Validated::zip((self.read)(path, value), (other.read)(path, value)),
    }
  }

  /// The same fields, assembled into something else -- the record, usually.
  pub fn map<B>(self, f: (A) -> B) -> Fields<B> {
    {
      fields: self.fields,
      read: fn (path, value) => Validated::map((self.read)(path, value), f),
    }
  }
}

// ---------------------------------------------------------------------------
// The primitives
// ---------------------------------------------------------------------------

/// The one place a `Wrong` is built, so the redaction cannot be forgotten.
///
/// Text is quoted and a number is bare, so that `and is "8080"` says the
/// value arrived as text and `and is 8080` says it did not.
fn wrong<A>(path: List<Segment>, wanted: String, saw: Raw) -> Validated<A, Rejection> {
  match saw {
    Raw::Absent =>
      Validated::error({ path: path, secret: false, problem: Problem::Missing }),
    Raw::Denied =>
      Validated::error({ path: path, secret: false, problem: Problem::Denied }),
    _ => {
      let found = match saw {
        Raw::Text(text) => "\"" + text + "\"",
        Raw::Untyped(text) => "\"" + text + "\"",
        Raw::Number(text) => text,
        Raw::Bool(value) => Bool::to_string(value),
        other => Raw::describe(other),
      };
      Validated::error({
          path: path,
          secret: false,
          problem: Problem::Wrong(wanted, Redacted::of(found)),
        })
    },
  }
}

/// Text, as it arrived.
///
/// A number is not text: `{ "name": 42 }` is refused, as serde refuses it.
/// A source that could not tell hands over [`Raw::Untyped`], which is read.
pub fn string() -> Schema<String> {
  {
    shape: Shape::String,
    read: fn (path, value) =>
    match value {
      Raw::Text(text) => Validated::of(text),
      Raw::Untyped(text) => Validated::of(text),
      other => wrong(path, "text", other),
    },
  }
}

/// An `Int`, parsed from the token rather than through a float.
///
/// A rejection reads `port should be a whole number, and is "eighty"`.
pub fn int() -> Schema<Int> {
  {
    shape: Shape::Int,
    read: fn (path, value) =>
    match value {
      Raw::Number(text) =>
        match Int::of_string(text) {
          Option::Some(n) => Validated::of(n),
          Option::None => wrong(path, "a whole number", value),
        },
      Raw::Untyped(text) =>
        match Int::of_string(text) {
          Option::Some(n) => Validated::of(n),
          Option::None => wrong(path, "a whole number", value),
        },
      other => wrong(path, "a whole number", other),
    },
  }
}

/// A `Float`, parsed from the token.
///
/// The fifteen significant digits a `Float` carries are the caller's choice
/// here, and are not made anywhere else in this module.
pub fn float() -> Schema<Float> {
  {
    shape: Shape::Float,
    read: fn (path, value) =>
    match value {
      Raw::Number(text) =>
        match Float::of_string(text) {
          Option::Some(f) => Validated::of(f),
          Option::None => wrong(path, "a number", value),
        },
      Raw::Untyped(text) =>
        match Float::of_string(text) {
          Option::Some(f) => Validated::of(f),
          Option::None => wrong(path, "a number", value),
        },
      other => wrong(path, "a number", other),
    },
  }
}

/// An exact decimal, parsed from the token.
///
/// The reason [`Raw::Number`] keeps its text: this is the one a price goes
/// through, and a `Float` on the way would make it the wrong price.
///
/// **Read from text as well as from a number.** Money travels as a string on
/// most wires, for the sake of JavaScript clients whose only number is a
/// double, and every decimal library this audience has used writes it so.
pub fn decimal() -> Schema<Decimal> {
  {
    shape: Shape::Decimal,
    read: fn (path, value) =>
    match value {
      Raw::Number(text) => parse_decimal(path, text, value),
      Raw::Text(text) => parse_decimal(path, text, value),
      Raw::Untyped(text) => parse_decimal(path, text, value),
      other => wrong(path, "an exact decimal", other),
    },
  }
}

fn parse_decimal(path: List<Segment>, text: String, value: Raw) -> Validated<Decimal, Rejection> {
  match Decimal::of_string(text) {
    Option::Some(d) => Validated::of(d),
    Option::None => wrong(path, "an exact decimal", value),
  }
}

/// True or false.
///
/// From a source that could not label it, `true`, `false`, `1` and `0` --
/// and not `yes`, because a reader that accepts every spelling accepts a
/// typo as `false`.
pub fn bool() -> Schema<Bool> {
  {
    shape: Shape::Bool,
    read: fn (path, value) =>
    match value {
      Raw::Bool(b) => Validated::of(b),
      Raw::Untyped(text) =>
        if text == "true" || text == "1" {
          Validated::of(true)
        } else if text == "false" || text == "0" {
          Validated::of(false)
        } else {
          wrong(path, "true or false", value)
        },
      other => wrong(path, "true or false", other),
    },
  }
}

/// Whatever arrived, as it arrived.
///
/// For a field whose shape is somebody else's business; the only thing it
/// refuses is a value that is not there.
pub fn any() -> Schema<Raw> {
  {
    shape: Shape::Any,
    read: fn (path, value) =>
    match value {
      Raw::Absent => wrong(path, "a value", value),
      Raw::Denied => wrong(path, "a value", value),
      present => Validated::of(present),
    },
  }
}

// ---------------------------------------------------------------------------
// The combinators
// ---------------------------------------------------------------------------

/// A value that may not be there.
///
/// Absent or null is `None`; present and the wrong shape is still an error,
/// which is the distinction that matters: a misspelled setting should not
/// read as one nobody set. A denied value is not `None` either, because a
/// denied optional is still a line missing from `khora.toml`.
pub fn optional<A>(inner: Schema<A>) -> Schema<Option<A>> {
  {
    shape: Shape::Optional(inner.shape),
    read: fn (path, value) =>
    match value {
      Raw::Absent => Validated::of(Option::None),
      Raw::Null => Validated::of(Option::None),
      present => Validated::map((inner.read)(path, present), fn a => Option::Some(a)),
    },
  }
}

/// A value that must be there and may be null.
///
/// The field a JSON API sends as `"ended": null` to mean "not yet", where
/// leaving it out would be a different mistake.
pub fn nullable<A>(inner: Schema<A>) -> Schema<Option<A>> {
  {
    shape: Shape::Nullable(inner.shape),
    read: fn (path, value) =>
    match value {
      Raw::Null => Validated::of(Option::None),
      present => Validated::map((inner.read)(path, present), fn a => Option::Some(a)),
    },
  }
}

/// A value, or `fallback` when it is not there.
///
/// **Absent only.** A value that is present and wrong is never quietly
/// replaced, and neither is `null`: a client that sent `"port": null` said
/// something, and the answer is a rejection rather than 8080.
pub fn default<A>(inner: Schema<A>, fallback: A) -> Schema<A> {
  {
    shape: Shape::Default(inner.shape),
    read: fn (path, value) =>
    match value {
      Raw::Absent => Validated::of(fallback),
      present => (inner.read)(path, present),
    },
  }
}

/// A list of them, with each element's index in its own path.
pub fn list<A>(inner: Schema<A>) -> Schema<List<A>> {
  {
    shape: Shape::List(inner.shape),
    read: fn (path, value) =>
    match value {
      Raw::Sequence(items) => {
        let mut out = Validated::of(List::Nil);
        let mut at = 0;
        let mut rest = items;
        let mut walking = true;
        while walking {
          match rest {
            List::Nil => { walking = false; },
            List::Cons(head, tail) => {
              let here = List::push(path, Segment::Index(at));
              let one = (inner.read)(here, head);
              out = Validated::map2(out, one, fn (so_far, next) => List::Cons(next, so_far));
              at = at + 1;
              rest = tail;
            },
          }
        };
        // Built back to front, for the reason `List::map` is: an accumulator
        // and a reverse rather than a frame per element.
        Validated::map(out, fn built => List::reverse(built))
      },
      other => wrong(path, "a list", other),
    },
  }
}

/// A record whose keys are data: `{ "en": "Hello", "fr": "Bonjour" }`.
///
/// Every value is read with `inner`, under its key, so a bad one reads
/// `greetings.fr should be text, and is 7`.
pub fn dict<A>(inner: Schema<A>) -> Schema<Dict<String, A>> {
  {
    shape: Shape::Dict(inner.shape),
    read: fn (path, value) =>
    match value {
      Raw::Record(entries) => {
        let start: Validated<List<Pair<String, A>>, Rejection> = Validated::of(List::Nil);
        let gathered = List::fold(entries, start, fn (acc, field) => {
            let one = (inner.read)(List::push(path, Segment::Field(field.key)), field.value);
            Validated::map2(acc, one, fn (so_far, decoded) => {
                let pair: Pair<String, A> = { key: field.key, value: decoded };
                List::Cons(pair, so_far)
              })
          });
        Validated::map(gathered, fn built => Dict::from_list(List::reverse(built)))
      },
      other => wrong(path, "a record", other),
    },
  }
}

/// A condition on a value that is otherwise the right shape.
///
/// `must` is the rest of the sentence after `must be`, so write it as one:
/// `"between 1 and 65535"` reads as *port must be between 1 and 65535*. The
/// named rules below carry their bounds as structure instead, which is what a
/// rendered document needs; this is for the rule the vocabulary lacks.
pub fn refine<A>(inner: Schema<A>, must: String, holds: (A) -> Bool) -> Schema<A> {
  checked(inner, Rule::Custom(must), holds)
}

/// The refinement every named rule is built on.
fn checked<A>(inner: Schema<A>, rule: Rule, holds: (A) -> Bool) -> Schema<A> {
  {
    shape: Shape::Refined(inner.shape, rule),
    read: fn (path, value) =>
    Validated::and_then((inner.read)(path, value), fn a =>
      if holds(a) {
        Validated::of(a)
      } else {
        Validated::error({ path: path, secret: false, problem: Problem::Refused(rule) })
      }),
  }
}

/// Whether `low <= a <= high`.
fn within<A: Ord>(a: A, low: A, high: A) -> Bool {
  match a.cmp(low) {
    Ordering::Less => false,
    _ => match a.cmp(high) {
      Ordering::Greater => false,
      _ => true,
    },
  }
}

/// A value between two bounds, inclusive: `between(int(), 1, 65535)`.
pub fn between<A: Ord + Show>(inner: Schema<A>, low: A, high: A) -> Schema<A> {
  checked(inner, Rule::Between(Show::show(low), Show::show(high)), fn a => within(a, low, high))
}

/// A value no smaller than `bound`.
pub fn at_least<A: Ord + Show>(inner: Schema<A>, bound: A) -> Schema<A> {
  checked(inner, Rule::AtLeast(Show::show(bound)), fn a =>
    match a.cmp(bound) { Ordering::Less => false, _ => true })
}

/// A value no larger than `bound`.
pub fn at_most<A: Ord + Show>(inner: Schema<A>, bound: A) -> Schema<A> {
  checked(inner, Rule::AtMost(Show::show(bound)), fn a =>
    match a.cmp(bound) { Ordering::Greater => false, _ => true })
}

/// Text of at least `n` characters.
pub fn min_length(inner: Schema<String>, n: Int) -> Schema<String> {
  checked(inner, Rule::MinLength(n), fn text => List::length(String::chars(text)) >= n)
}

/// Text of at most `n` characters.
pub fn max_length(inner: Schema<String>, n: Int) -> Schema<String> {
  checked(inner, Rule::MaxLength(n), fn text => List::length(String::chars(text)) <= n)
}

/// A list of at least `n` items.
pub fn min_items<A>(inner: Schema<List<A>>, n: Int) -> Schema<List<A>> {
  checked(inner, Rule::MinItems(n), fn items => List::length(items) >= n)
}

/// A list of at most `n` items.
pub fn max_items<A>(inner: Schema<List<A>>, n: Int) -> Schema<List<A>> {
  checked(inner, Rule::MaxItems(n), fn items => List::length(items) <= n)
}

/// A list with something in it.
pub fn non_empty<A>(inner: Schema<List<A>>) -> Schema<List<A>> {
  min_items(inner, 1)
}

/// A value from a closed set: `one_of(string(), ["gzip", "br"])`.
pub fn one_of<A: Eq + Show>(inner: Schema<A>, allowed: List<A>) -> Schema<A> {
  checked(inner, Rule::OneOf(List::map(allowed, fn a => Show::show(a))), fn a =>
    List::contains(allowed, a))
}

/// A value nothing may print.
///
/// **A combinator over any inner schema, not a leaf.** `secret(int())` and
/// `secret(string())` both work, and redaction composes with everything else
/// instead of sitting beside it. No bound on `A`: a `Schema<A>` is a value, and
/// holding one already is the evidence that an `A` can be decoded.
///
/// A failure inside one is marked, and [`Rejection::describe`] then says what
/// was wanted without quoting what it saw.
pub fn secret<A>(inner: Schema<A>) -> Schema<Redacted<A>> {
  {
    shape: Shape::Secret(inner.shape),
    read: fn (path, value) =>
    match Validated::map((inner.read)(path, value), fn a => Redacted::of(a)) {
      Validated::Valid(wrapped) => Validated::Valid(wrapped),
      Validated::Invalid(errors) =>
        Validated::Invalid(List::map(errors, fn e => { ..e, secret: true })),
    },
  }
}

/// A field read under a key that is not its name: `key("userId", int())`.
///
/// For the wire whose spelling the type cannot use. The rejection names the
/// wire key, because that is the one the client sent.
pub fn key<A>(wire: String, inner: Schema<A>) -> Schema<A> {
  { shape: Shape::Keyed(wire, inner.shape), read: inner.read }
}

/// A record schema with one of its keys spelled differently on the wire:
/// `renamed(Settings::schema(), "userId", "user_id")` reads `userId` into the
/// field `user_id`.
///
/// For the one odd key in a record that is otherwise fine as declared. The
/// rejection names the wire key.
pub fn renamed<A>(inner: Schema<A>, wire: String, field: String) -> Schema<A> {
  {
    shape: rename_shape(inner.shape, wire, field),
    read: fn (path, value) => {
      let read = match value {
        Raw::Record(entries) => {
          let moved = List::map(entries, fn e =>
            if e.key == wire { Raw::entry(field, e.value) } else { e });
          (inner.read)(path, Raw::Record(moved))
        },
        other => (inner.read)(path, other),
      };
      match read {
        Validated::Valid(a) => Validated::Valid(a),
        Validated::Invalid(errors) => {
          // The record's own field segment sits just before the prefix this
          // read was given, however deep the problem under it was.
          let prefix = List::length(path);
          Validated::Invalid(List::map(errors, fn e =>
              { ..e, path: rename_segment(e.path, List::length(e.path) - prefix - 1, wire, field) }))
        },
      }
    },
  }
}

/// The shape of a record with one field's key renamed.
fn rename_shape(shape: Shape, wire: String, field: String) -> Shape {
  match shape {
    Shape::Struct(fields) =>
      Shape::Struct(List::map(fields, fn named =>
          if named.name == field {
            let keyed: Named = { name: named.name, shape: Shape::Keyed(wire, named.shape) };
            keyed
          } else {
            named
          })),
    Shape::Lazy(name, inner) => Shape::Lazy(name, fn () => rename_shape(inner(), wire, field)),
    Shape::Closed(inner) => Shape::Closed(rename_shape(inner, wire, field)),
    Shape::Described(inner, text) => Shape::Described(rename_shape(inner, wire, field), text),
    Shape::Refined(inner, rule) => Shape::Refined(rename_shape(inner, wire, field), rule),
    other => other,
  }
}

/// The path with the segment at `index` renamed from `field` to `wire`, if
/// that is what it is.
fn rename_segment(path: List<Segment>, index: Int, wire: String, field: String) -> List<Segment> {
  let mut out = List::Nil;
  let mut at = 0;
  let mut rest = path;
  let mut walking = true;
  while walking {
    match rest {
      List::Nil => { walking = false; },
      List::Cons(head, tail) => {
        let step = if at == index {
          match head {
            Segment::Field(name) => if name == field { Segment::Field(wire) } else { head },
            other => other,
          }
        } else {
          head
        };
        out = List::Cons(step, out);
        at = at + 1;
        rest = tail;
      },
    }
  };
  List::reverse(out)
}

// ---------------------------------------------------------------------------
// The record literal
// ---------------------------------------------------------------------------

/// A record schema, from a record literal of schemas.
///
/// `struct({ host: string(), port: between(int(), 1, 65535) })` is a
/// `Schema<Listen>` when `Listen` is the record with those fields. Which
/// record it is comes from the type the expression is asked for -- an
/// annotation, a parameter, the declared return type -- or from the labels
/// alone when only one record has them, the way it does for any record
/// literal. A field whose schema decodes the wrong type is reported at that
/// schema; a field the record does not have, or one it has and the literal
/// does not, is reported at the call.
///
/// **Not a function that runs.** Its argument is a record of *schemas* and
/// its result a schema of the record they decode, and there is no type-level
/// map from one to the other. A call to it is rewritten before it is typed,
/// into [`Schema::record`] over [`Fields`] -- which is what a hand-written
/// record schema is, and what a derived one is too. The declaration is here
/// so the name can be imported and read about; a call with anything but a
/// record literal, or a use of the name as a value, is refused.
///
/// Most records need no literal at all: `derive(Decode)` writes the same
/// thing from the declaration. The literal is for the record that needs
/// something the declaration cannot say -- a refined port, a renamed key, a
/// default -- and every schema that contains the record picks it up through
/// the trait.
pub fn struct<A>(fields: Fields<A>) -> Schema<A>;

// ---------------------------------------------------------------------------
// The traits
// ---------------------------------------------------------------------------

/// A type that can be read from untrusted input.
///
/// The schema for a type is a property of the type, so it is reached through
/// the type: `Settings::schema()` for one that implements this, and
/// `Decode::schema()` where the expected type says which. `std` implements it
/// for its own types; a program's record or variant implements it with the
/// constructors above.
pub trait Decode {
  /// The schema for `Self`, chosen by the type the call is asked for.
  fn schema() -> Schema<Self>;
}

/// A type with one representation on the wire.
///
/// Kept apart from [`Decode`] rather than folded into the schema, because a
/// secret has no representation on the wire: `Redacted` implements `Decode`,
/// through [`secret`], and not this, so a record holding one reads and does
/// not write, and the build says so rather than a round trip somewhere far
/// away.
pub trait Encode {
  /// The value as a source would have produced it; [`Raw::to_json`] is the
  /// bridge out.
  fn encode(self) -> Raw;
}

/// Reads a value of the type the surrounding expression asks for.
///
/// `let settings: Validated<Settings, Rejection> = decode(raw);` chooses the
/// schema from the annotation; `Settings::schema().decode(raw)` is the same
/// call with the type named.
pub fn decode<A: Decode>(from: Raw) -> Validated<A, Rejection> {
  let schema: Schema<A> = Decode::schema();
  Schema::decode(schema, from)
}

impl Decode for String {
  fn schema() -> Schema<String> { string() }
}

impl Decode for Int {
  fn schema() -> Schema<Int> { int() }
}

impl Decode for Float {
  fn schema() -> Schema<Float> { float() }
}

impl Decode for Bool {
  fn schema() -> Schema<Bool> { bool() }
}

impl Decode for Decimal {
  fn schema() -> Schema<Decimal> { decimal() }
}

impl Decode for Raw {
  fn schema() -> Schema<Raw> { any() }
}

impl Decode for Json {
  fn schema() -> Schema<Json> { Schema::map(any(), fn raw => Raw::to_json(raw)) }
}

impl Decode for Date {
  fn schema() -> Schema<Date> {
    Schema::try_map(string(), "an ISO 8601 date", fn text => Date::of_string(text))
  }
}

impl Decode for Time {
  fn schema() -> Schema<Time> {
    Schema::try_map(string(), "a time of day, as ISO 8601 writes it", fn text => Time::of_string(text))
  }
}

impl Decode for DateTime {
  fn schema() -> Schema<DateTime> {
    Schema::try_map(string(), "an ISO 8601 date and time", fn text => DateTime::of_string(text))
  }
}

impl<A: Decode> Decode for Option<A> {
  fn schema() -> Schema<Option<A>> {
    let inner: Schema<A> = Decode::schema();
    optional(inner)
  }
}

impl<A: Decode> Decode for List<A> {
  fn schema() -> Schema<List<A>> {
    let inner: Schema<A> = Decode::schema();
    list(inner)
  }
}

impl<A: Decode> Decode for Vector<A> {
  fn schema() -> Schema<Vector<A>> {
    let inner: Schema<A> = Decode::schema();
    Schema::map(list(inner), fn items => Vector::from_list(items))
  }
}

impl<A: Decode> Decode for Redacted<A> {
  fn schema() -> Schema<Redacted<A>> {
    let inner: Schema<A> = Decode::schema();
    secret(inner)
  }
}

impl<V: Decode> Decode for Dict<String, V> {
  fn schema() -> Schema<Dict<String, V>> {
    let inner: Schema<V> = Decode::schema();
    dict(inner)
  }
}

impl<V: Decode> Decode for Map<String, V> {
  fn schema() -> Schema<Map<String, V>> {
    let inner: Schema<V> = Decode::schema();
    Schema::map(dict(inner), fn entries => {
        let out: Map<String, V> = Map::new();
        List::fold(Dict::entries(entries), (), fn (_u, pair) => Map::insert(out, pair.key, pair.value));
        out
      })
  }
}

impl Encode for String {
  fn encode(self) -> Raw { Raw::Text(self) }
}

impl Encode for Int {
  fn encode(self) -> Raw { Raw::Number(Int::to_string(self)) }
}

impl Encode for Float {
  fn encode(self) -> Raw { Raw::Number(Float::to_string(self)) }
}

impl Encode for Bool {
  fn encode(self) -> Raw { Raw::Bool(self) }
}

/// Written as text, because that is how money travels on most wires: every
/// decimal library this audience has used writes it so, for the sake of
/// JavaScript clients whose only number is a double, and [`decimal`] reads
/// it back.
impl Encode for Decimal {
  fn encode(self) -> Raw { Raw::Text(Show::show(self)) }
}

impl Encode for Raw {
  fn encode(self) -> Raw { self }
}

impl Encode for Json {
  fn encode(self) -> Raw { Raw::of_json(self) }
}

impl Encode for Date {
  fn encode(self) -> Raw { Raw::Text(Show::show(self)) }
}

impl Encode for Time {
  fn encode(self) -> Raw { Raw::Text(Show::show(self)) }
}

impl Encode for DateTime {
  fn encode(self) -> Raw { Raw::Text(Show::show(self)) }
}

/// `None` is an absent key, and both an absent key and `null` read back as
/// `None`.
impl<A: Encode> Encode for Option<A> {
  fn encode(self) -> Raw {
    match self {
      Option::Some(value) => value.encode(),
      Option::None => Raw::Absent,
    }
  }
}

impl<A: Encode> Encode for List<A> {
  fn encode(self) -> Raw {
    let items = List::fold(self, List::Nil, fn (acc, item) => List::Cons(item.encode(), acc));
    Raw::Sequence(List::reverse(items))
  }
}

impl<A: Encode> Encode for Vector<A> {
  fn encode(self) -> Raw { Vector::to_list(self).encode() }
}

impl<V: Encode> Encode for Dict<String, V> {
  fn encode(self) -> Raw {
    let entries = List::fold(Dict::entries(self), List::Nil, fn (acc, pair) =>
      List::Cons(Raw::entry(pair.key, pair.value.encode()), acc));
    Raw::Record(List::reverse(entries))
  }
}

impl<V: Encode> Encode for Map<String, V> {
  fn encode(self) -> Raw {
    let entries = List::fold(Map::entries(self), List::Nil, fn (acc, pair) =>
      List::Cons(Raw::entry(pair.key, pair.value.encode()), acc));
    Raw::Record(List::reverse(entries))
  }
}

/// A problem as a client reads it: where, and what.
///
/// The one hand-written encoder over a type that holds a secret, and the
/// reason it is safe is the reason [`Rejection::describe`] exists: the
/// message never quotes a value that was under [`secret`], and nothing else
/// of the rejection is written.
impl Encode for Rejection {
  fn encode(self) -> Raw {
    Raw::Record(List::Cons(
        Raw::entry("path", Raw::Text(Rejection::at(self))),
        List::Cons(Raw::entry("message", Raw::Text(Rejection::describe(self))), List::Nil)))
  }
}
