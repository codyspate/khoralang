module std::config;

import std::core::{List, Option, Pair, Result, Validated, attempt};
import std::env::{Env, EnvError};
import std::schema::{Alternative, Named, Problem, Raw, Rejection, Schema, Segment, Shape};

//! Settings read out of the environment, through a schema, and reported all
//! at once.
//!
//! The environment is a source like any other: a JSON body, a query string
//! and a database row are all read by one `Schema<A>`, and so is this. What
//! this module adds is the walk -- which variables a shape needs, and what to
//! call them -- and the report, which spells a path the way a deployment
//! does.
//!
//! ```khora
//! derive(Show, Decode)
//! type Listen = { host: String, port: Int };
//!
//! derive(Show, Decode)
//! type Settings = { listen: Listen, password: Redacted<String>, debug: Option<Bool> };
//!
//! fn settings() -> Validated<Settings, Rejection> with { env: Env } {
//!   read(Settings::schema())
//! }
//! ```
//!
//! reads `LISTEN_HOST`, `LISTEN_PORT`, `PASSWORD` and `DEBUG`, and answers
//! every problem rather than the first: a person fixing a deployment wants
//! the list, not one line of it per restart.
//!
//! # How a shape becomes variable names
//!
//! A field is its name in upper case; a nested record's fields are joined
//! to it with `_`, so `listen.port` is `LISTEN_PORT`. A list is one variable
//! split on commas, `TAGS=a,b`. A variant is one variable holding the case,
//! `MODE=Remote`, and its payload fields beside it, `MODE_URL`. A key given
//! by `key("http_host", ..)` replaces the field's name in that scheme and
//! nothing else. An optional nested record is present when any of its
//! variables is.
//!
//! Every variable a shape needs is [`variables`], which is the question a
//! deployment asks and a program should not have to be started to answer.
//!
//! # Why every value arrives `Untyped`
//!
//! The environment cannot say whether `8080` was meant as a number, so it
//! does not: every value is `Raw::Untyped`, which every primitive reads.
//! Strictness is a fact about the source, and this source has none to offer.
//!
//! # Denied is not missing
//!
//! A variable the manifest does not grant is a different thing from one
//! nobody set, and the fix is a line in `khora.toml` rather than a line in a
//! deployment script. `Env::variable` raises for it; this catches the raise
//! into `Raw::Denied`, which decodes as `Problem::Denied`, and [`report`]
//! names the file.

/// Reads the settings a schema describes, every problem reported.
///
/// The schema's shape decides which variables are read and what they are
/// called; the schema's decoder decides what they mean. A record schema is
/// what this is for: a bare `int()` at the top level has no name to read.
///
/// ```khora
/// import std::config::{read, report};
/// import std::env::{Env};
/// import std::schema::{Decode};
///
/// derive(Decode)
/// pub type Settings = { listen_port: Int, database_url: String };
///
/// pub fn main() -> Int {
///   with { env: Env::real() } {
///     match read(Settings::schema()) {
///       Validated::Valid(settings) => start(settings),
///       Validated::Invalid(problems) => { print(report(problems)); 1 },
///     }
///   }
/// }
/// ```
///
/// The shape decides the variable names: `listen_port` is read from
/// `LISTEN_PORT`. A record written once with `derive(Decode)` reads from the
/// environment, a request body and a test fixture alike, which is what it
/// means for the schema to be a property of the type.
pub fn read<A>(schema: Schema<A>) -> Validated<A, Rejection> with { env: Env } {
  Schema::decode(schema, gather(schema.shape, List::Nil))
}

/// The variables a shape needs, in the order they would be read.
///
/// `[LISTEN_HOST, LISTEN_PORT, PASSWORD, DEBUG]` for the settings above.
pub fn variables(shape: Shape) -> List<String> {
  List::reverse(names(shape, List::Nil, List::Nil))
}

/// One line a person can act on, with the path spelled as the variable it
/// came from: `LISTEN_PORT should be a whole number, and is "eighty"`.
pub fn describe(problem: Rejection) -> String {
  let name = variable_of(problem.path);
  match problem.problem {
    Problem::Denied => name + " is not granted -- add it to `[permissions] env` in khora.toml",
    _ => Rejection::describe_as(problem, name),
  }
}

/// Every reason, one per line, in the order they were found.
///
/// What a service prints just before it stops, and the reason the whole
/// module answers `Validated`: this list is allowed to have more than one
/// thing in it.
pub fn report(problems: List<Rejection>) -> String {
  String::join(List::map(problems, fn problem => describe(problem)), "\n")
}

// ---------------------------------------------------------------------------
// The walk
// ---------------------------------------------------------------------------

/// The variable for a path, innermost segment first: `LISTEN_PORT`.
fn variable(prefix: List<String>) -> String {
  String::upper(String::join(List::reverse(prefix), "_"))
}

/// The variable a rejection's path names.
fn variable_of(path: List<Segment>) -> String {
  List::fold(List::reverse(path), "", fn (acc, step) =>
    match step {
      Segment::Field(field) =>
        if acc == "" { String::upper(field) } else { acc + "_" + String::upper(field) },
      Segment::Index(at) => acc + "[" + Int::to_string(at) + "]",
    })
}

/// One variable, as the source hands it over.
///
/// `attempt` rather than `catch`, because the denial has to survive as a
/// *different* answer from "not set", and a `catch` that produced an
/// `Option` would have thrown that away one line before the distinction is
/// used.
fn fetch(name: String) -> Raw with { env: Env } {
  let read: Result<Option<String>, EnvError> = attempt(fn () => env.variable(name)!);
  match read {
    Result::Err(EnvError::Denied(_denied)) => Raw::Denied,
    Result::Ok(Option::Some(text)) => Raw::Untyped(text),
    Result::Ok(Option::None) => Raw::Absent,
  }
}

/// The wire key a field is read under: what `key` gave it, or its name.
fn wire_of(field: Named) -> String {
  Option::unwrap_or(Shape::wire_key(field.shape), field.name)
}

/// What the environment holds for a shape, at a prefix.
fn gather(shape: Shape, prefix: List<String>) -> Raw with { env: Env } {
  match shape {
    Shape::Struct(fields) => {
      let entries = List::fold(fields, List::Nil, fn (acc, field) => {
          let wire = wire_of(field);
          List::Cons(Raw::entry(wire, gather(field.shape, List::Cons(wire, prefix))), acc)
        });
      Raw::Record(List::reverse(entries))
    },
    // The variable holds the case; a payload case's fields sit beside it.
    // A tag naming no case stays a bare value, so the rejection is about
    // the variable that holds it.
    Shape::Cases(cases) =>
      match fetch(variable(prefix)) {
        Raw::Untyped(tag) =>
          match List::find(cases, fn case => case.name == tag) {
            Option::Some(chosen) =>
              match chosen.fields {
                List::Nil => Raw::Untyped(tag),
                payload => {
                  let entries = List::fold(payload, List::Nil, fn (acc, field) => {
                      let wire = wire_of(field);
                      List::Cons(Raw::entry(wire, gather(field.shape, List::Cons(wire, prefix))), acc)
                    });
                  Raw::Record(List::Cons(Raw::entry("type", Raw::Untyped(tag)), List::reverse(entries)))
                },
              },
            Option::None => Raw::Untyped(tag),
          },
        other => other,
      },
    Shape::List(_of) =>
      match fetch(variable(prefix)) {
        Raw::Untyped(text) =>
          Raw::Sequence(List::map(String::split(text, ","), fn piece => Raw::Untyped(piece))),
        other => other,
      },
    Shape::Optional(inner) => without_empty(gather(inner, prefix)),
    Shape::Default(inner) => without_empty(gather(inner, prefix)),
    Shape::Nullable(inner) => gather(inner, prefix),
    Shape::Keyed(_wire, inner) => gather(inner, prefix),
    Shape::Refined(inner, _rule) => gather(inner, prefix),
    Shape::Via(inner, _becomes) => gather(inner, prefix),
    Shape::Secret(inner) => gather(inner, prefix),
    Shape::Closed(inner) => gather(inner, prefix),
    Shape::Described(inner, _text) => gather(inner, prefix),
    Shape::Lazy(_name, inner) => gather(inner(), prefix),
    _ => fetch(variable(prefix)),
  }
}

/// A record none of whose variables is set is not there, which is what lets
/// an optional nested record be optional.
fn without_empty(value: Raw) -> Raw {
  if is_unset(value) { Raw::Absent } else { value }
}

fn is_unset(value: Raw) -> Bool {
  match value {
    Raw::Absent => true,
    Raw::Record(entries) => List::all(entries, fn field => is_unset(field.value)),
    _ => false,
  }
}

/// The variables a shape reads, innermost-first onto `acc`.
fn names(shape: Shape, prefix: List<String>, acc: List<String>) -> List<String> {
  match shape {
    Shape::Struct(fields) =>
      List::fold(fields, acc, fn (so_far, field) => {
          let wire = wire_of(field);
          names(field.shape, List::Cons(wire, prefix), so_far)
        }),
    Shape::Cases(cases) =>
      List::fold(cases, List::Cons(variable(prefix), acc), fn (so_far, case) =>
        List::fold(case.fields, so_far, fn (inner, field) => {
            let wire = wire_of(field);
            names(field.shape, List::Cons(wire, prefix), inner)
          })),
    Shape::Optional(inner) => names(inner, prefix, acc),
    Shape::Nullable(inner) => names(inner, prefix, acc),
    Shape::Default(inner) => names(inner, prefix, acc),
    Shape::Keyed(_wire, inner) => names(inner, prefix, acc),
    Shape::Refined(inner, _rule) => names(inner, prefix, acc),
    Shape::Via(inner, _becomes) => names(inner, prefix, acc),
    Shape::Secret(inner) => names(inner, prefix, acc),
    Shape::Closed(inner) => names(inner, prefix, acc),
    Shape::Described(inner, _text) => names(inner, prefix, acc),
    Shape::Lazy(_name, inner) => names(inner(), prefix, acc),
    _ => List::Cons(variable(prefix), acc),
  }
}
