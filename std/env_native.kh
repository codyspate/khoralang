module std::env;

import std::core::{Array, Eq, List, Option, Ptr, Show};
import std::permissions::{granted_name};
import std::permissions::grants::{env as env_grants};

//! What a program was told: its arguments and its environment.
//!
//! The smallest thing that separates a program from a demo. Until this
//! existed, nothing a Khora program did could depend on anything outside its
//! own source — every path, every port, every setting was compiled in.
//!
//! **`Clock` used to live here and now does not.** The two were together
//! because both answer "what did the outside world hand this process", and
//! that grouping cost something: this file is native-only for `getenv` and
//! `argv`, so the clock was native-only too, for a reason that had nothing to
//! do with clocks. `std::clock` has it, and says why.
//!
//! The C side is almost all ISO C: `getenv`, `strlen`, `memcpy`. The one
//! exception is the argument vector, which no C function returns — it arrives
//! through `main` and is gone, so the generated `main` hands it to the runtime
//! and `khora_arg` gives it back.

extern fn getenv(name: Ptr) -> Ptr;
extern fn strlen(text: Ptr) -> Int;
extern fn memcpy(into: Ptr, from: Ptr, count: Int) -> Ptr;
extern fn khora_arg_count() -> Int;
extern fn khora_arg(index: Int) -> Ptr;

// ---------------------------------------------------------------------------
// The interface
// ---------------------------------------------------------------------------

/// Why reading the environment did not work.
///
/// One case, because there is one way for it to fail that is not "no such
/// variable": the manifest did not grant it. Not being set is `None`, which is
/// an answer rather than a failure.
derive(Show, Eq)
pub type EnvError = | Denied(name: String);

/// What the process was started with.
///
/// A capability rather than plain functions, for the reason every other one is:
/// a function that reads `DATABASE_URL` says so in its signature, and a test
/// can hand it something else. Reading the environment is exactly the kind of
/// hidden input that makes a program hard to test, and this is the seam.
pub effect Env {
  /// The value of a variable, or `None` when it is not set.
  ///
  /// **`raises` because a denial is not `None`.** A variable the manifest does
  /// not grant is a different thing from one nobody set, and the fix is a line
  /// in `khora.toml` rather than a line in a deployment script. Answering
  /// `None` for both would send a reader to look at their environment for a
  /// decision their own manifest made -- the same reasoning `IoError::Denied`
  /// records.
  variable: (String) -> Option<String> raises EnvError,
  /// Everything the process was invoked with, the program's own name first —
  /// the same convention C, Rust and Go all follow.
  arguments: () -> List<String>,
}

impl Env {
  /// The real environment.
  pub fn real() -> Env {
    handler for Env {
      variable: fn name =>
      if granted_name(env_grants(), name) {
        read_variable(name)
      } else {
        raise EnvError::Denied(name)
      },
      arguments: fn () => collect_arguments(khora_arg_count() - 1, List::Nil),
    }
  }
}

/// A variable, or a default when it is not set.
///
/// The shape almost every caller wants, written once here rather than as a
/// `match` at each of them.
///
/// **The fallback is for "not set", not for "not allowed".** A denial passes
/// through rather than quietly becoming the default: a program told it may not
/// read `DATABASE_URL` and silently given `localhost` is a program that starts
/// and does the wrong thing, which is worse than one that stops and says why.
///
/// ```khora
/// import std::env::{Env, variable_or};
///
/// fn port() -> Int with { env: Env } raises EnvError {
///   match Int::of_string(variable_or("PORT", "8080")!) {
///     Option::Some(n) => n,
///     Option::None => 8080,
///   }
/// }
/// ```
///
/// The `!` is there because a *denial* is a failure rather than a missing
/// value, which is the distinction the paragraph above is about.
pub fn variable_or(name: String, fallback: String) -> String
  with { env: Env }
  raises EnvError
{
  match env.variable(name)! {
    Option::None => fallback,
    Option::Some(found) => found,
  }
}

// ---------------------------------------------------------------------------
// Reading C strings
// ---------------------------------------------------------------------------

/// The bytes at `text`, up to its NUL, as a `String`.
///
/// The one operation this module needs that Khora has no other way to do:
/// `Ptr` is opaque by design, so reading through one is `memcpy` into an array
/// Khora owns. Private, and staying that way — a public "read whatever is at
/// this address" is not a thing a safe language should export.
fn text_at(pointer: Ptr) -> String {
  if Ptr::is_null(pointer) {
    ""
  } else {
    let length = strlen(pointer);
    let bytes: Array<U8> = Array::new(length, 0);
    Array::with_data(bytes, fn (into, n) => memcpy(into, pointer, n));
    String::from_bytes(bytes)
  }
}

fn read_variable(name: String) -> Option<String> {
  let found = String::with_c_string(name, fn asked => getenv(asked));
  if Ptr::is_null(found) { Option::None } else { Option::Some(text_at(found)) }
}

/// The arguments, gathered from the last back to the first.
///
/// Backwards because `List::Cons` puts a value at the front, so counting down
/// builds the list in the order it was given without reversing it afterwards.
fn collect_arguments(index: Int, gathered: List<String>) -> List<String> {
  if index < 0 {
    gathered
  } else {
    collect_arguments(index - 1, List::Cons(text_at(khora_arg(index)), gathered))
  }
}
