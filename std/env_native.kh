module std::env;

import std::core::{Array, List, Option, Ptr};

//! What a program was told, and what time it is.
//!
//! The smallest thing that separates a program from a demo: until this existed,
//! nothing a Khora program did could depend on anything outside its own source.
//! Every path, every port, every setting was compiled in.
//!
//! Two capabilities, and the split is the one `docs/design/permissions.md`
//! draws. `Env` is what the process was handed — its arguments and its
//! variables — and `Clock` is the time, which is a different kind of access and
//! a different thing to want to deny a dependency.
//!
//! The C side is almost all ISO C: `getenv`, `strlen`, `memcpy`. There are two
//! exceptions, and both are things C has no portable answer for. The argument
//! vector is not returned by any C function, because it arrives through `main`
//! and is gone — so the generated `main` hands it to the runtime, and
//! `khora_arg` gives it back. And the clock is milliseconds, which is
//! `GetSystemTimeAsFileTime` on Windows and `clock_gettime` on Unix; ISO C's
//! `time` is whole seconds and there is nothing finer that is spelled the same
//! everywhere. The runtime already knows which target it was built for.

extern fn getenv(name: Ptr) -> Ptr;
extern fn strlen(text: Ptr) -> Int;
extern fn memcpy(into: Ptr, from: Ptr, count: Int) -> Ptr;
extern fn khora_arg_count() -> Int;
extern fn khora_arg(index: Int) -> Ptr;
extern fn khora_unix_millis() -> Int;
extern fn khora_monotonic_millis() -> Int;

// ---------------------------------------------------------------------------
// The interface
// ---------------------------------------------------------------------------

/// What the process was started with.
///
/// A capability rather than plain functions, for the reason every other one is:
/// a function that reads `DATABASE_URL` says so in its signature, and a test
/// can hand it something else. Reading the environment is exactly the kind of
/// hidden input that makes a program hard to test, and this is the seam.
pub effect Env {
  /// The value of a variable, or `None` when it is not set.
  variable: (String) -> Option<String>,
  /// Everything the process was invoked with, the program's own name first —
  /// the same convention C, Rust and Go all follow.
  arguments: () -> List<String>,
}

/// What time it is.
///
/// Separate from `Env` because it is a different thing to deny: a library that
/// may read a configuration variable is not thereby a library that may know
/// how long something took, and a test that pins one usually wants to pin the
/// other differently.
///
/// **Two clocks, not one, and the split is not a detail.** A wall clock says
/// what time it is and can jump: NTP steps it, an administrator sets it, a
/// virtual machine resumes with a stale one — and it can jump *backwards*, so
/// subtracting two readings of it is not a duration, it is a guess. A monotonic
/// clock cannot go backwards and is what "how long did this take" actually
/// wants; its zero is arbitrary, so it can never be a timestamp.
///
/// One `millis` would therefore have been the wrong one about half the time,
/// and the half it was wrong for would be the half that only fails in
/// production, at 2am, when the clock is stepped an hour. Naming both makes the
/// caller say which they meant.
pub effect Clock {
  /// Seconds since 1970, on the wall clock.
  ///
  /// Kept, because it is what a caller who wants a date wants, and it is
  /// derived from the same source as `unix_millis` so the two can never
  /// disagree about what second it is.
  unix_seconds: () -> Int,
  /// Milliseconds since 1970, on the wall clock. A timestamp, not a duration.
  unix_millis: () -> Int,
  /// Milliseconds on a clock that only goes forwards, counted from the first
  /// time anything in the process asked.
  ///
  /// The one to subtract. Two readings are always ordered and their difference
  /// is always a real elapsed time — which is exactly what `unix_millis`
  /// cannot promise.
  monotonic_millis: () -> Int,
}

impl Env {
  /// The real environment.
  pub fn real() -> Env {
    handler for Env {
      variable: fn name => read_variable(name),
      arguments: fn () => collect_arguments(khora_arg_count() - 1, List::Nil),
    }
  }
}

impl Clock {
  /// The real clock.
  ///
  /// Seconds are milliseconds divided down rather than a second call to ISO C's
  /// `time`, so that a program reading both never sees them straddle a tick.
  pub fn real() -> Clock {
    handler for Clock {
      unix_seconds: fn () => khora_unix_millis() / 1000,
      unix_millis: fn () => khora_unix_millis(),
      monotonic_millis: fn () => khora_monotonic_millis(),
    }
  }
}

/// A variable, or a default when it is not set.
///
/// The shape almost every caller wants, written once here rather than as a
/// `match` at each of them.
pub fn variable_or(name: String, fallback: String) -> String
  with { env: Env }
{
  match env.variable(name) {
    Option::None => fallback,
    Option::Some(found) => found,
  }
}

// ---------------------------------------------------------------------------
// Reading C strings
// ---------------------------------------------------------------------------

/// The bytes at `text`, up to its NUL, as a `String`.
///
/// The one operation this module needs that Khora has no other way to do:
/// `Ptr` is opaque by design, so reading through one is `memcpy` into an array
/// Khora owns. Private, and staying that way — a public "read whatever is at
/// this address" is not a thing a safe language should export.
fn text_at(pointer: Ptr) -> String {
  if Ptr::is_null(pointer) {
    ""
  } else {
    let length = strlen(pointer);
    let bytes: Array<U8> = Array::new(length, 0);
    Array::with_data(bytes, fn (into, n) => memcpy(into, pointer, n));
    String::from_bytes(bytes)
  }
}

fn read_variable(name: String) -> Option<String> {
  let found = String::with_c_string(name, fn asked => getenv(asked));
  if Ptr::is_null(found) { Option::None } else { Option::Some(text_at(found)) }
}

/// The arguments, gathered from the last back to the first.
///
/// Backwards because `List::Cons` puts a value at the front, so counting down
/// builds the list in the order it was given without reversing it afterwards.
fn collect_arguments(index: Int, gathered: List<String>) -> List<String> {
  if index < 0 {
    gathered
  } else {
    collect_arguments(index - 1, List::Cons(text_at(khora_arg(index)), gathered))
  }
}
