module std::db;

//! Talking to a database, as a capability rather than a library.
//!
//! [The ecosystem design note](https://github.com/codyspate/khoralang/blob/main/docs/design/ecosystem.md) §"Applying the rule" settles what belongs here
//! and it is not an engine. SQLite has no middle layer at all — no framing, no
//! handshake, nothing that fails at a packet boundary — so putting it in `std`
//! would be the mistake `std::net::http` avoided, all top layer plus a quarter
//! of a million lines of C. It is a first-party package. Postgres is a package
//! for the ordinary reason: its wire protocol is versioned by somebody else.
//!
//! # What the middle layer actually is
//!
//! **What a transaction does when its fiber is cancelled.** That is the part
//! that fails in production and never in testing, the part every package would
//! answer differently, and the part that is Khora's to answer rather than an
//! engine's — because cancellation semantics belong to the language. A
//! transaction that returns without rolling back, holding a connection and its
//! locks, is the truncated-request-at-a-packet-boundary of this subject.
//!
//! So `std` owns three things: the `Db` capability's shape, the row and value
//! types two packages must agree on to exchange a result, and the contract
//! below. Everything that speaks a protocol is somebody else's.
//!
//! # The contract
//!
//! `transaction` commits when its body returns and rolls back when it does not
//! — including when the body raises, and including when the fiber running it is
//! cancelled. **A handler that cannot promise that is a broken handler**, and
//! the test beside this module is written against the promise rather than
//! against any engine.
//!
//! **A rollback that itself fails is two facts, and they go to two places.**
//! What the *caller* is told is `RolledBack` with the body's reason, because
//! the engine's complaint about a rollback is a worse thing to report than the
//! reason the rollback was needed. What the *handler* is told is `broken`,
//! because a connection whose `ROLLBACK` did not arrive may still be holding a
//! transaction open and is not one to lend out again.
//!
//! The second half is why `broken` is an operation rather than a return value:
//! on the cancellation path there is no caller left to return anything to, and
//! that is exactly the path where a connection goes back to a pool.
//!
//! Database authority is carried by the capability row all the way through.
//! Application code says `with { db: Db }`; `transaction` says the same thing.
//! The concrete handler belongs at a composition boundary, not as a `Db`
//! parameter threaded through domain functions.
//!
//! All three ways out are covered, and the third took two pieces rather than
//! one: the rollback is registered with a region before the body runs, and the
//! body carries a `raises` row so that a cancellation has a channel to reach
//! it on. `transaction`'s own comment has the argument. What the runtime owes
//! in return is that a finalizer running *because* of a cancellation is not
//! itself cancelled — `khora-rt`'s `cancel::Shielded`.

import std::core::{Eq, List, Option, Pair, Result, Scope, Show, acquire, scoped};
import std::decimal::{Decimal};
import std::schema::{Raw};

/// A value in a column, or bound to a parameter.
///
/// **`Decimal` is here and `Float` is not, for money.** A database `NUMERIC`
/// read through a float is a number that has already lost, and
/// [The numbers design note](https://github.com/codyspate/khoralang/blob/main/docs/design/numbers.md) is the long version. Floats can be added when
/// something that is genuinely a measurement needs one.
pub type Cell =
  | Null
  | Text(String)
  | Number(Int)
  | Money(Decimal)
  | Flag(Bool);

/// One row: the columns the query named, and a cell under each.
///
/// The names are what let a row be read through a schema -- `Entry::schema()`
/// reads `id`, `account`, `amount` and `memo` by name -- and a driver that
/// has them has no reason to drop them. A driver that genuinely does not
/// (a bare `SELECT` with no description) leaves them empty, and
/// [`Row::to_raw`] then hands over a sequence rather than a record.
pub type Row = {
  columns: List<String>,
  cells: List<Cell>,
};

/// What went wrong, as far as `std` is willing to say.
///
/// **Deliberately coarse**, on the same reasoning `std::fs` gives for not
/// knowing C's error numbers: a code that means "unique violation" is a
/// different integer in every engine, and a `std` that pretended otherwise
/// would be wrong for the second engine anybody wrote. A package that knows
/// its engine can offer a richer type; this is what everything can agree on.
derive(Eq)
pub type DbError =
  /// The statement was not accepted.
  | Rejected(String)
  /// The connection is gone.
  | Disconnected(String)
  /// The transaction was rolled back rather than committed.
  | RolledBack(String);

/// Somewhere to run statements.
///
/// A record of closures, so a Postgres package, a SQLite package, D1 behind a
/// Worker and an in-memory double are the same type to everything above.
pub effect Db {
  /// Runs a query and gives back every row.
  query: (String, List<Cell>) -> Result<List<Row>, DbError>,
  /// Runs a statement and gives back how many rows it changed.
  execute: (String, List<Cell>) -> Result<Int, DbError>,
  /// Begins a transaction. Handlers use this to implement `transaction`.
  begin: () -> Result<(), DbError>,
  /// Commits the transaction in progress.
  commit: () -> Result<(), DbError>,
  /// Rolls the transaction in progress back.
  rollback: () -> Result<(), DbError>,
  /// Says this connection's state is no longer known.
  ///
  /// **Called when a rollback fails**, and only then. A `ROLLBACK` that does
  /// not arrive leaves a connection that may still be holding a transaction
  /// open and rows locked, and there is no second thing to try: another
  /// rollback would fail the same way, and asking the server what state it is
  /// in needs a working connection to ask over.
  ///
  /// So the handler is told, because the handler *is* the connection and is
  /// the only thing that can act. A pool stops lending it out. A single
  /// connection may close it. A test counts it.
  ///
  /// **Answers nothing and cannot fail**, because it is called from a region
  /// finalizer on the way out — including on the way out of a cancellation,
  /// where there is no caller left to tell. A signal that could fail here
  /// would need a handler for its own failure, and that handler would be this
  /// one.
  broken: () -> (),
}

/// Runs `body` in a transaction, committing on success and rolling back
/// otherwise.
///
/// The database is a capability, not an ordinary argument. The caller must
/// have `db: Db` in its capability row; the same binding is used for begin,
/// the body, commit, and rollback.
///
/// **This is the function the whole module exists for.** A caller that wrote
/// begin, body and commit by hand has written the correct thing only for the
/// path where nothing goes wrong, and the paths where something does are the
/// ones that leave a connection holding locks until somebody restarts the
/// service.
///
/// **The body's failure is a `DbError`**, not a type variable. A body doing
/// database work produces one already, and a caller with an error of its own
/// renders it into `Rejected` before getting here — which keeps this function
/// concrete, and keeps the rendering where the type is still known rather than
/// behind a `Show` the transaction would have to carry.
///
/// # How the third way out is covered
///
/// A body can return, it can fail, and its fiber can be **cancelled** — and
/// the third one does not pass through any `match` written here. A
/// cancellation travels the same tagged return an error does, straight out of
/// this function, so a version that only inspected `body()`'s answer was
/// correct for two paths out of three. The one it missed is the one that
/// happens in production: a request times out, the nursery stops its children,
/// and a connection goes back to the pool inside an open transaction holding
/// its locks.
///
/// So the rollback is **registered before the body runs** rather than decided
/// after it, with `scoped` and `acquire`: a region's finalizers run on every
/// path out, because every path out already releases the binding holding the
/// region. Committing marks the transaction settled, and a settled transaction
/// has nothing left to undo — so the finalizer costs a boolean on the ordinary
/// path and is the whole contract on the extraordinary one.
///
/// The region is **this function's own**, for the reason `postgres::pool` gives
/// at greater length: a transaction that borrowed its caller's scope would end
/// when the caller did, which is not what a transaction is.
///
/// # Why the body carries a row it does not seem to need
///
/// `raises 'er` is the other half, and without it the paragraph above is
/// theatre. [The effect-runtime design note](https://github.com/codyspate/khoralang/blob/main/docs/design/effect-runtime.md) §6: **a cancellation point is a
/// `!` in a function that can raise**, and it travels out on the tagged return
/// an error uses. A body typed `() -> Result<A, DbError>` with no row has no
/// `!` anywhere inside it, so nothing in the transaction can observe a
/// cancellation, and the frames above have no channel to receive one on
/// either. The first version of this function was in that state: a region, a
/// finalizer, and no path that could ever reach it.
///
/// With the row, a body that does fallible work has cancellation points, and
/// one that fires unwinds through here — releasing the region, running the
/// rollback. A body that does no fallible work instantiates `'r` empty, needs
/// no `!` at the call, and has nothing to interrupt: §6's promise is that an
/// interruption is delayed to the next mark that can carry it, never lost, and
/// a transaction with no marks in it runs to its commit.
///
/// The row is the *caller's*, deliberately. A transaction over a body that can
/// fail its own way keeps that failure's type — folding it into `DbError`
/// would be the loss `Result<A, DbError>` already declines to take.
pub fn transaction<A, 'ef, 'er>(
  body: () -> Result<A, DbError> with 'ef raises 'er
) -> Result<A, DbError>
  with { 'ef | db: Db }
  raises 'er
{
  match db.begin() {
    Result::Err(problem) => Result::Err(problem),
    Result::Ok(_) => scoped(fn () => guarded(body))!,
  }
}

/// Whether the transaction has already been settled.
///
/// A record because the finalizer and the body have to agree about it after
/// both have been written, and a record field is the one thing two closures
/// can share and one can change.
type Settled = { mut done: Bool };

/// The body, with the rollback registered before it starts.
///
/// Separate from `transaction` for the reason `postgres::pool`'s `held` is
/// separate from `with_db`: `acquire` needs a `Scope`, and `transaction`'s
/// whole point is that its caller does not have to have one.
fn guarded<A, 'ef, 'er>(
  body: () -> Result<A, DbError> with 'ef raises 'er
) -> Result<A, DbError>
  with { 'ef | db: Db, scope: Scope }
  raises 'er
{
  let settled = { done: false };
  acquire(settled, fn state => undo(state));
  match body()! {
    Result::Err(problem) => {
      // The rollback's own failure is not allowed to hide the reason for it.
      // A caller who sees `RolledBack` knows the transaction did not commit,
      // which is the fact they have to act on; the engine's complaint about
      // the rollback is a second problem and a worse thing to report.
      settled.done = true;
      // The caller is told `RolledBack` either way -- the engine's complaint
      // about the rollback is a worse thing to report than the reason it was
      // needed -- but the *connection* is a separate question, and the handler
      // is told about it.
      match db.rollback() {
        Result::Ok(_) => (),
        Result::Err(_why) => db.broken(),
      };
      Result::Err(DbError::RolledBack(problem.show()))
    },
    // Settled *before* the commit is attempted, so a refused commit is
    // reported as itself rather than rolled back on the way out. An engine
    // that refuses a commit has already ended the transaction; sending a
    // rollback after it would ask about one that is no longer there.
    Result::Ok(answer) => {
      settled.done = true;
      match db.commit() {
        Result::Err(problem) => Result::Err(problem),
        Result::Ok(_) => Result::Ok(answer),
      }
    },
  }
}

/// Rolls back, unless the transaction has already ended.
///
/// Reached on the way out of the region, which is every way out — including
/// the cancellation that never touched a line of `guarded`.
fn undo(settled: Settled) -> () with { db: Db } {
  if settled.done {
    ()
  } else {
    match db.rollback() {
      Result::Ok(_) => (),
      // **The path with nobody to tell.** A cancelled fiber has no caller
      // waiting for an answer, so this is the only place the failure can go --
      // and going nowhere is what let a connection return to a pool having
      // neither committed nor, as far as anything knew, rolled back.
      Result::Err(_why) => db.broken(),
    }
  }
}

impl Cell {
  /// The text in this cell, or `None` if it holds something else.
  ///
  /// **No coercion.** A `Number` read as text is a schema misunderstanding,
  /// and a library that rendered it would hide the day somebody changed a
  /// column's type.
  pub fn text(self) -> Option<String> {
    match self { Cell::Text(value) => Option::Some(value), _ => Option::None }
  }

  /// The number in this cell, or `None`.
  pub fn number(self) -> Option<Int> {
    match self { Cell::Number(value) => Option::Some(value), _ => Option::None }
  }

  /// The decimal in this cell, or `None`.
  pub fn money(self) -> Option<Decimal> {
    match self { Cell::Money(value) => Option::Some(value), _ => Option::None }
  }

  /// The boolean in this cell, or `None`.
  pub fn flag(self) -> Option<Bool> {
    match self { Cell::Flag(value) => Option::Some(value), _ => Option::None }
  }

  /// Whether the cell is null, which is a question rather than a value.
  pub fn is_null(self) -> Bool {
    match self { Cell::Null => true, _ => false }
  }
}

impl Row {
  /// The cell at `index`, or `None` past the end.
  pub fn cell(self, index: Int) -> Option<Cell> {
    nth(self.cells, index)
  }

  /// The cell under `name`, or `None` when no column has it.
  pub fn named(self, name: String) -> Option<Cell> {
    let mut names = self.columns;
    let mut rest = self.cells;
    let mut found: Option<Cell> = Option::None;
    let mut walking = true;
    while walking {
      match names {
        List::Nil => { walking = false; },
        List::Cons(column, more_names) =>
          match rest {
            List::Nil => { walking = false; },
            List::Cons(cell, more_cells) => {
              if column == name {
                found = Option::Some(cell);
                walking = false;
              } else {
                names = more_names;
                rest = more_cells;
              }
            },
          },
      }
    };
    found
  }

  /// The row as a source hands it over, keyed by column, for a schema to
  /// read.
  ///
  /// A `Number` and a `Money` become the token their digits spell, which
  /// both round-trip exactly, so `Raw` keeps one numeric representation.
  /// `Text` is text the column said was text, and is not read as a number.
  pub fn to_raw(self) -> Raw {
    let values = List::fold(self.cells, List::Nil, fn (acc, cell) => List::Cons(Cell::to_raw(cell), acc));
    let values = List::reverse(values);
    match self.columns {
      List::Nil => Raw::Sequence(values),
      _ => Raw::Record(zip_columns(self.columns, values)),
    }
  }

  /// Every row, in order, for `list(Entry::schema())` to read at once: a
  /// problem in the third row is reported as `[2].amount`.
  pub fn sequence(rows: List<Row>) -> Raw {
    let raws = List::fold(rows, List::Nil, fn (acc, row) => List::Cons(Row::to_raw(row), acc));
    Raw::Sequence(List::reverse(raws))
  }
}

/// Columns and cells side by side, stopping at the shorter.
fn zip_columns(columns: List<String>, values: List<Raw>) -> List<Pair<String, Raw>> {
  let mut out = List::Nil;
  let mut names = columns;
  let mut rest = values;
  let mut walking = true;
  while walking {
    match names {
      List::Nil => { walking = false; },
      List::Cons(name, more_names) =>
        match rest {
          List::Nil => { walking = false; },
          List::Cons(value, more_values) => {
            out = List::Cons(Raw::entry(name, value), out);
            names = more_names;
            rest = more_values;
          },
        },
    }
  };
  List::reverse(out)
}

impl Cell {
  /// The cell as a source hands it over.
  pub fn to_raw(self) -> Raw {
    match self {
      Cell::Null => Raw::Null,
      Cell::Text(text) => Raw::Text(text),
      Cell::Number(n) => Raw::Number(Int::to_string(n)),
      Cell::Money(d) => Raw::Number(Show::show(d)),
      Cell::Flag(flag) => Raw::Bool(flag),
    }
  }
}

impl Eq for Cell {
  fn eq(self, other: Cell) -> Bool {
    match self {
      Cell::Null => match other { Cell::Null => true, _ => false },
      Cell::Text(mine) => match other { Cell::Text(theirs) => mine == theirs, _ => false },
      Cell::Number(mine) => match other { Cell::Number(theirs) => mine == theirs, _ => false },
      Cell::Money(mine) => match other { Cell::Money(theirs) => mine == theirs, _ => false },
      Cell::Flag(mine) => match other { Cell::Flag(theirs) => mine == theirs, _ => false },
    }
  }
}

impl Show for Cell {
  fn show(self) -> String {
    match self {
      Cell::Null => "null",
      Cell::Text(value) => value,
      Cell::Number(value) => Int::to_string(value),
      Cell::Money(value) => value.show(),
      Cell::Flag(value) => if value { "true" } else { "false" },
    }
  }
}

impl Show for DbError {
  /// Written out rather than derived, unlike the `Eq` above.
  ///
  /// A derived `Show` gives `DbError::Rejected(...)`, which is right for the
  /// error types whose cases a reader has to tell apart. This one goes into a
  /// log line a person reads, and "rejected: duplicate key" is the sentence
  /// they want rather than a constructor.
  fn show(self) -> String {
    match self {
      DbError::Rejected(why) => "rejected: " + why,
      DbError::Disconnected(why) => "disconnected: " + why,
      DbError::RolledBack(why) => "rolled back: " + why,
    }
  }
}

/// The element at `index`, counting from zero.
///
/// Here rather than in `core` because adding to `List` is a decision about
/// `List`, and this module only needs one column.
fn nth(items: List<Cell>, index: Int) -> Option<Cell> {
  match items {
    List::Nil => Option::None,
    List::Cons(head, tail) => if index <= 0 { Option::Some(head) } else { nth(tail, index - 1) },
  }
}
