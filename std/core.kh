module std::core;

// Khora tracks effects as rows on the signature rather than as a wrapper type,
// so there is no `Effect<A, R, E>` here. A computation's requirements live in
// its `with` clause and its failures in its `raises` clause; both are inferred
// on private functions and written out on exported ones.
//
// The module is `std::core` rather than `std::effect` for two reasons: there is
// no longer an `Effect` type to name it after, and `effect` is now a reserved
// word, so `std::effect` will not lex as a path.
//
// See docs/design/effects.md.

// ---------------------------------------------------------------------------
// Comparison and display
// ---------------------------------------------------------------------------

/// The result of comparing two values.
///
/// A three-way answer rather than two booleans: one comparison decides all six
/// operators, and a type cannot accidentally disagree with itself about `<` and
/// `>=`.
export type Ordering =
  | Less
  | Equal
  | Greater;

export trait Eq {
  fn eq(self, other: Self) -> Bool;
}

/// Ordering refines equality: anything orderable can be compared for equality,
/// so `Ord` requires `Eq` rather than repeating it.
export trait Ord: Eq {
  fn cmp(self, other: Self) -> Ordering;
}

/// A value that can be a key.
///
/// Requires `Eq` rather than repeating it, because the two have to agree: a
/// map finds a key by hashing it to a bucket and then comparing, so **equal
/// values must hash equal**. Unequal values may collide — that is what the
/// bucket's chain is for — but two values that `eq` says are the same and
/// `hash` sends to different buckets are an entry that can be inserted and
/// never found.
///
/// `Float` is deliberately not an instance, because it is not an instance of
/// `Eq`: `NaN == NaN` is false, and a key that is not equal to itself is a
/// lost entry in every language that allows one. `docs/design/numbers.md`.
export trait Hash: Eq {
  /// A number to bucket by. Any number: spreading it out is the map's job, not
  /// this one's, so an implementation only has to be *consistent*.
  fn hash(self) -> Int;
}

export trait Show {
  fn show(self) -> String;
}

/// Two fibers may hold this at once.
///
/// A marker: no methods, and implementing it asserts rather than provides.
/// Nothing has to write it for an ordinary type — a record, a variant, a tuple
/// is shareable exactly when everything inside it is, and the compiler can see
/// that. This is for the types it *cannot* see inside: one declared with no
/// body, whose behaviour lives in the runtime or across the C ABI.
///
/// Those default to unshareable, which is the only safe way round. `Array` can
/// be written through `Array::set` and `Ptr` points at memory this language
/// did not allocate; both look like empty structures and neither is safe for
/// two fibers to share. So the author says which is which, and the reader can
/// see where the assertion was made.
///
/// Fibers are operating-system threads today, so this is `Sync` rather than
/// `Send`: both fibers keep their reference, and neither hands it over.
///
/// `docs/design/sharing.md`.
export trait Share {}

impl Eq for Int {
  fn eq(self, other: Int) -> Bool { self == other }
}

impl Ord for Int {
  fn cmp(self, other: Int) -> Ordering {
    if self < other { Ordering::Less } else if self == other { Ordering::Equal }
    else { Ordering::Greater }
  }
}

/// An `Int` is its own hash. `Map::slot` does the mixing, so there is nothing
/// for this to add.
impl Hash for Int {
  fn hash(self) -> Int { self }
}

impl Eq for Bool {
  fn eq(self, other: Bool) -> Bool { self == other }
}

impl Eq for String {
  fn eq(self, other: String) -> Bool { self == other }
}

impl Hash for Bool {
  fn hash(self) -> Int { if self { 1 } else { 0 } }
}

/// FNV-1a over the bytes, which is one multiply and one xor each and is what a
/// string hash is supposed to look like. Wrapping on purpose: the overflow is
/// where the mixing comes from.
impl Hash for String {
  fn hash(self) -> Int {
    U32::to_int(String::fold(self, 0, U32::of(2166136261)))
  }
}

impl String {
  /// FNV-1a over the bytes from `from` on.
  fn fold(self, from: Int, seed: U32) -> U32 {
    let count = String::byte_length(self);
    let mut at = from;
    let mut hash = seed;
    while at < count {
      let mixed = U32::xor(hash, U32::of(U8::to_int(String::byte(self, at))));
      hash = U32::wrapping_mul(mixed, 16777619);
      at = at + 1;
    }
    hash
  }
}

/// Byte order, which is what `<` on a `String` means here.
///
/// Not a locale's order and not code-point order — the first needs a table
/// nobody has bound and the second differs from this one only above the basic
/// plane. What it *is* is stable, cheap, and the same on every machine, which
/// is what sorting for a program's own use wants. A human-facing sort wants a
/// collation library and should say so.
impl Ord for String {
  fn cmp(self, other: String) -> Ordering {
    String::compare_bytes(self, other, 0)
  }
}

impl String {
  fn compare_bytes(self, other: String, from: Int) -> Ordering {
    let mine = String::byte_length(self);
    let theirs = String::byte_length(other);
    let shorter = if mine < theirs { mine } else { theirs };
    let mut at = from;
    let mut answer = Ordering::Equal;
    while at < shorter && answer.is_equal() {
      let here = String::byte(self, at);
      let there = String::byte(other, at);
      if here < there { answer = Ordering::Less }
      else if here > there { answer = Ordering::Greater }
      else { at = at + 1 }
    }
    // Neither differed in the bytes they share, so the shorter one is first
    // and equal lengths mean equal text.
    if answer.is_equal() {
      if mine < theirs { Ordering::Less }
      else if mine > theirs { Ordering::Greater }
      else { Ordering::Equal }
    } else {
      answer
    }
  }
}

impl Eq for Ordering {
  fn eq(self, other: Ordering) -> Bool {
    match self {
      Ordering::Less => match other { Ordering::Less => true, Ordering::Equal => false, Ordering::Greater => false },
      Ordering::Equal => match other { Ordering::Less => false, Ordering::Equal => true, Ordering::Greater => false },
      Ordering::Greater => match other { Ordering::Less => false, Ordering::Equal => false, Ordering::Greater => true },
    }
  }
}

impl Ordering {
  fn is_less(self) -> Bool { self.eq(Ordering::Less) }
  fn is_equal(self) -> Bool { self.eq(Ordering::Equal) }
  fn is_greater(self) -> Bool { self.eq(Ordering::Greater) }
  /// `a.cmp(b).reverse()` sorts descending without a second comparison.
  fn reverse(self) -> Ordering {
    match self {
      Ordering::Less => Ordering::Greater,
      Ordering::Equal => Ordering::Equal,
      Ordering::Greater => Ordering::Less,
    }
  }
}

// ---------------------------------------------------------------------------
// Optional values and failures
// ---------------------------------------------------------------------------

export type Option<A> =
  | Some(value: A)
  | None;

export type Result<A, E> =
  | Ok(value: A)
  | Err(error: E);

impl<A> Option<A> {
  fn is_some(self) -> Bool { match self { Option::Some(v) => true, Option::None => false } }
  fn is_none(self) -> Bool { match self { Option::Some(v) => false, Option::None => true } }

  /// The value, or `fallback` if there is none.
  ///
  /// `fallback` is evaluated either way. `unwrap_or_else` takes a closure for
  /// when producing it is expensive.
  fn unwrap_or(self, fallback: A) -> A {
    match self { Option::Some(v) => v, Option::None => fallback }
  }

  fn unwrap_or_else(self, fallback: () -> A) -> A {
    match self { Option::Some(v) => v, Option::None => fallback() }
  }

  /// Turns absence into a failure, which is how an `Option` joins a `raises`
  /// chain.
  fn ok_or<E>(self, error: E) -> Result<A, E> {
    match self { Option::Some(v) => Result::Ok(v), Option::None => Result::Err(error) }
  }
}

impl<A, E> Result<A, E> {
  fn is_ok(self) -> Bool { match self { Result::Ok(v) => true, Result::Err(e) => false } }
  fn is_err(self) -> Bool { match self { Result::Ok(v) => false, Result::Err(e) => true } }

  fn unwrap_or(self, fallback: A) -> A {
    match self { Result::Ok(v) => v, Result::Err(e) => fallback }
  }

  /// Discards the error, which is the one direction that cannot fail.
  fn ok(self) -> Option<A> {
    match self { Result::Ok(v) => Option::Some(v), Result::Err(e) => Option::None }
  }

  fn map_err<F>(self, f: (E) -> F) -> Result<A, F> {
    match self { Result::Ok(v) => Result::Ok(v), Result::Err(e) => Result::Err(f(e)) }
  }
}

// ---------------------------------------------------------------------------
// Containers
// ---------------------------------------------------------------------------

export type List<A> =
  | Nil
  | Cons(head: A, tail: List<A>);

/// A list split down the middle, for `sort`.
export type Halves<A> = {
  left: List<A>,
  right: List<A>,
};

impl<A: Ord> List<A> {
  /// The same elements, in order.
  ///
  /// A merge sort, because a linked list is what it was invented for: it needs
  /// no indexing, no copying into an array and back, and it is stable — equal
  /// elements keep the order they were given, which is the property a caller
  /// notices the absence of when sorting by one field and expecting the
  /// previous sort to survive.
  ///
  /// `A: Ord` rather than a comparison function, so that `<` on the elements
  /// and `sort` on the list cannot disagree. Sorting by something else is
  /// `sort_by`, which does not exist yet and wants a closure.
  fn sort(self) -> List<A> {
    match self {
      List::Nil => List::Nil,
      List::Cons(only, rest) => match rest {
        // One element is sorted, and stopping here is what keeps the split
        // below from recursing forever on a list it cannot make smaller.
        List::Nil => List::Cons(only, List::Nil),
        List::Cons(second, more) => {
          let halves = List::split(List::Cons(only, List::Cons(second, more)));
          List::merge(halves.left.sort(), halves.right.sort())
        }
      },
    }
  }

  /// The first half and the second, each in the order it was given.
  ///
  /// **By counting to the middle, not by dealing alternately.** Dealing is one
  /// pass and needs no length, and it is what this did first — but it is not
  /// stable, and the test said so. Two equal elements at positions 1 and 2 land
  /// in *different* halves with the later one on the left, and a merge that
  /// breaks its tie towards the left then puts them back the wrong way round.
  ///
  /// The cost is a length and a reversal, both linear, against a sort that is
  /// already linearithmic.
  fn split(self) -> Halves<A> {
    List::take_first(self, self.length() / 2, List::Nil)
  }

  fn take_first(self, count: Int, taken: List<A>) -> Halves<A> {
    if count <= 0 {
      { left: taken.reverse(), right: self }
    } else {
      match self {
        List::Nil => { left: taken.reverse(), right: List::Nil },
        List::Cons(head, rest) => List::take_first(rest, count - 1, List::Cons(head, taken)),
      }
    }
  }

  /// Two sorted lists, as one.
  ///
  /// `<=` rather than `<` on the tie, which is exactly what makes the sort
  /// stable: an element from the left half goes first when they are equal, and
  /// the left half is the earlier one.
  fn merge(self, other: List<A>) -> List<A> {
    match self {
      List::Nil => other,
      List::Cons(mine, my_rest) => match other {
        List::Nil => List::Cons(mine, my_rest),
        List::Cons(theirs, their_rest) =>
        if mine <= theirs {
          List::Cons(mine, List::merge(my_rest, List::Cons(theirs, their_rest)))
        } else {
          List::Cons(theirs, List::merge(List::Cons(mine, my_rest), their_rest))
        },
      },
    }
  }
}

impl<A> List<A> {
  fn is_empty(self) -> Bool { match self { List::Nil => true, List::Cons(h, t) => false } }

  fn length(self) -> Int {
    match self { List::Nil => 0, List::Cons(h, t) => 1 + t.length() }
  }

  fn head(self) -> Option<A> {
    match self { List::Nil => Option::None, List::Cons(h, t) => Option::Some(h) }
  }

  /// Prepends, which is the cheap end. Appending walks the whole list, so it
  /// is spelled `concat` and its cost is visible at the call site.
  fn push(self, item: A) -> List<A> { List::Cons(item, self) }

  fn concat(self, other: List<A>) -> List<A> {
    match self {
      List::Nil => other,
      List::Cons(h, t) => List::Cons(h, t.concat(other)),
    }
  }

  fn reverse(self) -> List<A> { self.reverse_onto(List::Nil) }

  fn reverse_onto(self, acc: List<A>) -> List<A> {
    match self {
      List::Nil => acc,
      List::Cons(h, t) => t.reverse_onto(List::Cons(h, acc)),
    }
  }

  fn fold<B>(self, start: B, step: (B, A) -> B) -> B {
    match self {
      List::Nil => start,
      List::Cons(h, t) => t.fold(step(start, h), step),
    }
  }
}

// ---------------------------------------------------------------------------
// Iteration
// ---------------------------------------------------------------------------

/// One step of an iteration: the next item and the rest, or the end.
///
/// Khora has no mutable references and no mutable fields, so Rust's
/// `fn next(&mut self) -> Option<Item>` is not expressible. An iterator hands
/// back its successor instead. `for` desugars to this and reads the same.
export type Step<S, A> =
  | Yield(state: S, item: A)
  | Done;

export trait Iterator {
  type Item;
  fn next(self) -> Step<Self, Self::Item>;
}

/// `Range::Of(from, to)` yields `from` up to but not including `to`.
export type Range = | Of(from: Int, to: Int);

impl Iterator for Range {
  type Item = Int;
  fn next(self) -> Step<Range, Int> {
    match self {
      Range::Of(from, to) => if from >= to {
        Step::Done
      } else {
        Step::Yield(Range::Of(from + 1, to), from)
      },
    }
  }
}

impl<A> Iterator for List<A> {
  type Item = A;
  fn next(self) -> Step<List<A>, A> {
    match self {
      List::Nil => Step::Done,
      List::Cons(h, t) => Step::Yield(t, h),
    }
  }
}

// ---------------------------------------------------------------------------
// Abstracting over containers
// ---------------------------------------------------------------------------

export trait Functor {
  fn map<A, B>(self: Self<A>, f: (A) -> B) -> Self<B>;
}

/// `pure` lifts a value; `map2` combines two containers. `map2` rather than
/// `ap` because `ap` would need a container of *functions*, and reading a
/// signature is easier than reading `Self<(A) -> B>`.
export trait Applicative: Functor {
  fn pure<A>(value: A) -> Self<A>;
  fn map2<A, B, C>(self: Self<A>, other: Self<B>, f: (A, B) -> C) -> Self<C>;
}

/// Walks a structure left to right, collecting the effects of each step.
///
/// This is the abstraction Rust cannot express and the reason higher-kinded
/// types are a non-negotiable in `docs/vision.md`: one `traverse` per
/// container serves every `Applicative`.
export trait Traversable: Functor {
  fn traverse<A, B, F: Applicative>(self: Self<A>, f: (A) -> F<B>) -> F<Self<B>>;
}

impl Functor for Option {
  fn map<A, B>(self: Option<A>, f: (A) -> B) -> Option<B> {
    match self {
      Option::Some(v) => Option::Some(f(v)),
      Option::None => Option::None,
    }
  }
}

impl Applicative for Option {
  fn pure<A>(value: A) -> Option<A> { Option::Some(value) }
  fn map2<A, B, C>(self: Option<A>, other: Option<B>, f: (A, B) -> C) -> Option<C> {
    match self {
      Option::Some(a) => match other {
        Option::Some(b) => Option::Some(f(a, b)),
        Option::None => Option::None,
      },
      Option::None => Option::None,
    }
  }
}

impl Traversable for Option {
  fn traverse<A, B, F: Applicative>(self: Option<A>, f: (A) -> F<B>) -> F<Option<B>> {
    match self {
      Option::Some(v) => f(v).map(fn b => Option::Some(b)),
      Option::None => F::pure(Option::None),
    }
  }
}

impl Functor for List {
  fn map<A, B>(self: List<A>, f: (A) -> B) -> List<B> {
    match self {
      List::Nil => List::Nil,
      List::Cons(h, t) => List::Cons(f(h), t.map(f)),
    }
  }
}

impl Traversable for List {
  fn traverse<A, B, F: Applicative>(self: List<A>, f: (A) -> F<B>) -> F<List<B>> {
    match self {
      List::Nil => F::pure(List::Nil),
      List::Cons(h, t) => f(h).map2(t.traverse(f), fn (b, rest) => List::Cons(b, rest)),
    }
  }
}

// ---------------------------------------------------------------------------
// Effects — phase 4
// ---------------------------------------------------------------------------
//
// Everything below declares the shape of the effect system. None of it is
// implemented yet; the signatures are here so that the design is written down
// where it will live rather than only in a document.

/// Fails the test this is written in, if `condition` is false.
///
/// Only allowed inside a `test` block, and inside one it needs no `!`. Both
/// halves of that are deliberate: an assertion is the one place a reader of a
/// test already expects control to leave, it is written at every one of them,
/// and a test is not ordinary code. `docs/design/testing.md`.
export fn assert(condition: Bool);

/// Writes a line to standard output.
///
/// Declared without a body, so it is an extern: the backend dispatches it on
/// the argument's type, because there is no prelude yet to declare three
/// differently-typed printers. It is not an effect, which it eventually should
/// be — writing to a console is exactly the sort of thing a capability is for.
export fn print(value: String);

/// The empty type. A function whose return type is `Never` does not return
/// normally — it raises, diverges, or transfers control to a handler.
export type Never;

/// Resource lifetimes.
///
/// A finalizer registered with a scope runs when the enclosing region ends,
/// however it ends: falling off the end, an early `return`, or a raise passing
/// through.
///
/// The operation takes only a thunk. A handler's fields are ordinary closures
/// and a closure is monomorphic, so an operation cannot be generic — and it
/// need not be: `acquire` below is an ordinary generic function that closes
/// over the value and the release, which is where the polymorphism belongs.
export effect Scope {
  defer: (() -> ()) -> (),
}

/// A region, and the finalizers deferred to it.
///
/// The type is here rather than hidden because `scoped` is written in Khora
/// and has to name it. Reference counted like everything else — which is the
/// whole mechanism: releasing the last reference runs the finalizers, and the
/// paths that release a binding are already the paths a region has to end on.
export type Region;

/// A fiber that acquires something wants it released by the scope that outlives
/// it, so a `Scope` has to be able to cross — which means the region behind it
/// does. `khora_region_defer` takes a lock for exactly this.
impl Share for Region {}

impl Region {
  fn open() -> Region;
  fn defer(self, finalizer: () -> ()) -> ();
  /// The region that ends when the program does, released by the entry point
  /// after `main` returns — on the failing path as well as the ordinary one.
  fn root() -> Region;
}

impl Scope {
  /// The outermost scope: the one that ends when the program does.
  ///
  /// An entry point has to get a `Scope` from somewhere, and there is nothing
  /// above it to ask. Everything else should take one rather than reach for
  /// this — a library that roots its own scope has decided its caller's
  /// lifetimes for it.
  fn root() -> Scope {
    let region = Region::root();
    handler for Scope { defer: fn f => Region::defer(region, f) }
  }
}

/// A running fiber, and the only way to wait for one or stop it.
///
/// Releasing a handle *joins*, so a fiber cannot outlive the binding that
/// holds it — on every path out, including a raise passing through. Put one in
/// a region and the region waits; put it in a block and the block does. That
/// is where structured concurrency comes from, and it needed nothing of its
/// own. `docs/design/fibers.md`.
export type Fiber;

/// A handle to a running fiber, and every operation on one is a message to the
/// runtime rather than a write to shared memory. Joining twice is joining once,
/// from either side.
impl Share for Fiber {}

impl Fiber {
  /// Runs `body` on a fiber of its own.
  ///
  /// The thunk may fail, and a thunk that can is also one that can be
  /// *stopped*: a cancellation travels out on the same tagged return an error
  /// does, so a fiber with no error row has no channel to be interrupted on
  /// and runs to its end.
  fn spawn<'e>(body: () -> () raises 'e) -> Fiber;
  /// Waits for the fiber to finish. Joining twice is joining once.
  fn join(self) -> ();
  /// Asks the fiber to stop at its next cancellation point. Returns at once.
  fn cancel(self) -> ();
}

/// A fixed number of elements, side by side.
///
/// Fixed because growing is a *library* question and this is the primitive one
/// is built out of: `{ mut items: Array<A>, mut len: Int }` is a vector, and
/// it can be written in Khora now that a field can be written.
///
/// Reading an element is a bounds check and a load — no call — because the
/// layout is a contract with the code generator rather than something the
/// runtime hides. What the runtime does own is allocation and release, both of
/// which need the length at run time.
export type Array<A>;

impl<A> Array<A> {
  /// `length` elements, every one of them `fill`.
  fn new(length: Int, fill: A) -> Array<A>;
  fn length(self) -> Int;
  /// The element at `index`.
  ///
  /// An index outside the array stops the program and says which index and
  /// what length. Same reasoning as trapping on integer overflow: a program
  /// that runs off its own array is wrong, and reading whatever is next in
  /// memory is the least useful possible response.
  fn get(self, index: Int) -> A;
  fn set(self, index: Int, value: A) -> ();

  /// Whether these bytes are well-formed UTF-8, and so whether
  /// `String::from_bytes` will accept them. Only an `Array<U8>` has an answer.
  fn is_utf8(self) -> Bool;

  /// The first `count` elements, copied.
  ///
  /// What a caller does with a buffer it only partly filled: a socket read
  /// says how many bytes arrived, and the rest of the buffer is not part of
  /// the message.
  fn prefix(self, count: Int) -> Array<A> {
    let length = Array::length(self);
    // Nothing to copy and — the part that used to trap — nothing to seed the
    // new array with. `Array::new` needs a value of `A`, and the only one to
    // hand is `self`'s first element, which an empty array does not have.
    // Returning `self` is exact: it is already the empty array of the right
    // type.
    if length == 0 {
      self
    } else {
      let taken = if count < 0 { 0 } else if count > length { length } else { count };
      let out: Array<A> = Array::new(taken, Array::get(self, 0));
      let mut at = 0;
      while at < taken {
        Array::set(out, at, Array::get(self, at));
        at = at + 1;
      }
      out
    }
  }

  /// Lends the elements to `body` as a pointer and a count, for the duration
  /// of the call and no longer.
  ///
  /// This is how a buffer reaches a foreign function. The count is the number
  /// of *elements* — the same number `length` gives — so a body that wants
  /// bytes multiplies by the element's width itself.
  ///
  /// **The lifetime is the call, and that is the design rather than a
  /// limitation.** A plain `data(self) -> Ptr` would be a dangling pointer
  /// waiting to happen: the array is released at its last use, and that use
  /// would be the `data` call. No wider scope is right either — the innermost
  /// one is wrong for a pointer taken in one branch of an `if`, and the
  /// function's own is wrong for a loop, which would hold one buffer alive per
  /// iteration.
  ///
  /// Only an array of numbers can be lent. An `Array<A>` of Khora objects
  /// holds reference-counted pointers, and handing those across is the mistake
  /// the whole boundary exists to prevent. `docs/design/ffi.md`.
  fn with_data<B, 'c, 'e>(self, body: (Ptr, Int) -> B with 'c raises 'e) -> B
    with 'c
    raises 'e;
}

/// Arithmetic that does not trap, and the bits underneath it.
///
/// Ordinary `+`, `-` and `*` **stop the program** when they do not fit: a
/// program that passes its tests and then wraps in production is the failure
/// worth a branch to prevent. These are how you ask for the other behaviour in
/// the places that genuinely want it — a hash, a checksum, a pseudo-random
/// number — by name, so that the trap stays the default without being in the
/// way.
///
/// Methods rather than operators for now. `^`, `&`, `|`, `<<` and `>>` are five
/// new tokens and `>>` has to be told apart from the end of two nested type
/// arguments; none of that is hard and none of it is what a hash was waiting
/// for.
impl Int {
  fn wrapping_add(self, other: Int) -> Int;
  fn wrapping_sub(self, other: Int) -> Int;
  fn wrapping_mul(self, other: Int) -> Int;
  fn xor(self, other: Int) -> Int;
  fn and(self, other: Int) -> Int;
  fn or(self, other: Int) -> Int;
  fn shl(self, other: Int) -> Int;
  /// Arithmetic, so a negative number stays negative. A logical shift is what
  /// `Int` cannot express and what an unsigned fixed-width type will.
  fn shr(self, other: Int) -> Int;
}

// --- text ------------------------------------------------------------------
//
/// What `split_once` found: the text before the separator, and everything
/// after it.
export type Split = {
  head: String,
  rest: String,
};
//
// All of it written in Khora, over `String::byte`, `Array<U8>` and
// `String::from_bytes`. Nothing here is an intrinsic, which is the point: if
// slicing a string needed the compiler's help, so would everything above it.

impl String {
  /// The bytes from `from` up to but not including `to`.
  ///
  /// **Byte indices, and no rounding.** A range that splits a character gives
  /// back bytes that are not text, and `from_bytes` stops the program rather
  /// than pretend — which is the honest failure for a caller who sliced by
  /// eye. Indices outside the string are clamped, because "the rest of it" is
  /// what every caller of `slice(i, byte_length(s))` means.
  fn slice(self, from: Int, to: Int) -> String {
    let length = String::byte_length(self);
    let start = if from < 0 { 0 } else if from > length { length } else { from };
    let end = if to < start { start } else if to > length { length } else { to };
    let count = end - start;
    let out: Array<U8> = Array::new(count, 0);
    let mut at = 0;
    while at < count {
      Array::set(out, at, String::byte(self, start + at));
      at = at + 1;
    }
    String::from_bytes(out)
  }

  /// Where `needle` first appears, or `None`.
  fn index_of(self, needle: String) -> Option<Int> {
    let room = String::byte_length(self) - String::byte_length(needle);
    let mut at = 0;
    let mut found = 0 - 1;
    while at <= room && found < 0 {
      if String::matches_at(self, needle, at) { found = at; } else { at = at + 1; }
    }
    if found < 0 { Option::None } else { Option::Some(found) }
  }

  fn matches_at(self, needle: String, at: Int) -> Bool {
    let count = String::byte_length(needle);
    let mut done = 0;
    let mut same = true;
    while done < count && same {
      if String::byte(self, at + done) == String::byte(needle, done) {
        done = done + 1;
      } else {
        same = false;
      }
    }
    same
  }

  fn starts_with(self, prefix: String) -> Bool {
    if String::byte_length(prefix) > String::byte_length(self) {
      false
    } else {
      String::matches_at(self, prefix, 0)
    }
  }

  /// The text either side of the first `separator`, or `None` if it is absent.
  ///
  /// One split rather than a list of them, because a list wants an allocation
  /// per piece and every caller here wants the head and the rest. A record
  /// rather than a pair, because `.head` says which one it is and `.0` does
  /// not.
  fn split_once(self, separator: String) -> Option<Split> {
    match String::index_of(self, separator) {
      Option::None => Option::None,
      Option::Some(at) => Option::Some({
          head: String::slice(self, 0, at),
          rest: String::slice(self, at + String::byte_length(separator), String::byte_length(self)),
        }),
    }
  }
}

/// The shortest text that reads back as the same number.
///
/// Bound rather than written: shortest-round-trip formatting is Ryū or Grisu,
/// a table and a thousand lines, and `docs/design/ecosystem.md` names exactly
/// this kind of thing as something to bind rather than write twice.
extern fn khora_float_text(value: Float, into: Ptr, capacity: Int) -> Int;

impl Float {
  /// The number, written out — `1.5`, `0.1`, `inf`.
  ///
  /// The shortest form that reads back as the same number, which is what a
  /// reader means by "the number" and what `print` on a `Float` already gives.
  /// Thirty-two bytes is always enough for a double; the call says how many it
  /// needed, so a longer answer would be caught rather than truncated.
  fn to_string(self) -> String {
    let out: Array<U8> = Array::new(32, 0);
    let written = Array::with_data(out, fn (into, n) => khora_float_text(self, into, n));
    if written > 32 { "?" } else { String::from_bytes(Array::prefix(out, written)) }
  }

  /// The whole part, with nothing rounded.
  ///
  /// **Truncates toward zero** — `2.9` is `2` and `-2.9` is `-2` — which is
  /// what every machine's "convert to integer" does, and what C, Rust and Go
  /// all mean by it. Rounding is a different question with four defensible
  /// answers, so it gets a different function when somebody needs one.
  ///
  /// A number too large for an `Int` clamps to the nearest end, and a `NaN` is
  /// zero. Undefined behaviour is the alternative and is not one.
  fn to_int(self) -> Int;
}

impl Int {
  /// The same number as a `Float`.
  ///
  /// Exact up to 2^53 and rounded beyond it, which is IEEE's business rather
  /// than Khora's.
  fn to_float(self) -> Float;

  /// The number, written out.
  ///
  /// Needed by anything that puts a number in a message — a `Content-Length`,
  /// a status line, a log — and written here rather than in the runtime
  /// because it is four lines of Khora and a good test of whether they are
  /// pleasant to write.
  fn to_string(self) -> String {
    if self == 0 {
      "0"
    } else if self < 0 {
      "-" + Int::digits(0 - self, "")
    } else {
      Int::digits(self, "")
    }
  }

  /// `self`'s digits, most significant first, accumulated from the least.
  fn digits(self, tail: String) -> String {
    let here = Int::digit(self % 10);
    if self < 10 { here + tail } else { Int::digits(self / 10, here + tail) }
  }

  fn digit(self) -> String {
    let out: Array<U8> = Array::new(1, 0);
    // `0` is 48, and the digits are consecutive.
    Array::set(out, 0, U8::of(48 + self));
    String::from_bytes(out)
  }
}

/// An opaque machine address: a C `void *`.
///
/// **Not counted, not dereferenceable, and never a pointer into Khora's own
/// heap.** It exists so a foreign library can hand back a handle — a `FILE *`,
/// an `SSL_CTX *` — and be given it again later. Nothing in the language turns
/// a Khora value into one, which is what makes a dangling `Ptr` impossible:
/// every pointer that exists came from the other side, and its lifetime is
/// that side's business.
///
/// Lending a *buffer* across is the harder question and this type deliberately
/// does not answer it. `docs/design/ffi.md`.
export type Ptr;

impl Ptr {
  /// The null pointer, for the libraries that take one.
  fn null() -> Ptr;

  /// Whether this is null — which is how a great many C functions say they
  /// failed.
  fn is_null(self) -> Bool;
}

/// A string's bytes.
///
/// **Length and index are both in bytes**, and say so in their names. A
/// `String` is UTF-8, so a character is one to four of these, and a `length`
/// that quietly meant one of the two would be wrong for half its callers and
/// silent about which half. Anything that wants characters wants a decoder,
/// which is a library on top of this rather than a different meaning for the
/// same word.
impl String {
  /// How many bytes the string occupies. Not how many characters it has.
  fn byte_length(self) -> Int;

  /// The byte at `index`, counting from zero. Out of range stops the program,
  /// the same as an array.
  fn byte(self, index: Int) -> U8;

  /// The same bytes, as a `String`.
  ///
  /// **Stops the program if they are not UTF-8.** The same bargain `get` makes
  /// about an index: the check exists — `Array::is_utf8` — and calling this
  /// without it is the mistake. An `Option` was the alternative and would put
  /// the decision in the wrong place, because what to *do* about bytes that
  /// are not text depends entirely on where they came from.
  fn from_bytes(bytes: Array<U8>) -> String;

  /// A copy of the bytes.
  ///
  /// A copy rather than a view, because a string is immutable and an array is
  /// not — a view would let one be edited through the other.
  fn bytes(self) -> Array<U8>;

  /// Lends the bytes to `body` as a pointer and a length, for the duration of
  /// the call and no longer.
  ///
  /// Lends the bytes to `body` as a `const char *`: the same bytes with a
  /// zero after them, which is how every function in the C library finds the
  /// end of a string.
  ///
  /// A copy, necessarily — a Khora string knows its length instead of carrying
  /// a terminator, and there is nowhere to append one to a borrowed view. The
  /// copy lives exactly as long as the call.
  ///
  /// A string with a zero inside it is not refused: C will see a shorter
  /// string than Khora has, which is what C strings are.
  fn with_c_string<B, 'c, 'e>(self, body: (Ptr) -> B with 'c raises 'e) -> B
    with 'c
    raises 'e;

  /// See `Array::with_data`, which is the same thing and carries the argument
  /// for why the lifetime is a call rather than anything wider.
  fn with_data<B, 'c, 'e>(self, body: (Ptr, Int) -> B with 'c raises 'e) -> B
    with 'c
    raises 'e;
}

// --- The fixed-width integers ----------------------------------------------
//
// A table, and it reads like one. Seven types, each with the same ten
// operations, because `Int` alone cannot describe a byte and a byte is what
// every file, socket and string is made of. `docs/design/numbers.md`.
//
// `I64` is not here: it is a second spelling of `Int`, so `impl Int` above is
// its impl too. Two different 64-bit signed integers would mean a conversion
// between them that can never fail and never does anything.
//
// Every conversion goes through `Int` — `U8::of` and `U8::to_int` rather than
// a method for each of the forty-two ordered pairs. `U8` to `U32` is two
// steps, which is more to type and never wrong.

/// An unsigned byte: 0 to 255.
///
/// The one every other type here is in service of — a wire format, a file and
/// a string are all made of these.
impl U8 {
  /// The same number as a `U8`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  fn of(value: Int) -> U8;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  fn wrapping(value: Int) -> U8;

  /// Every `U8` is an `Int`, so this cannot fail and costs one
  /// instruction.
  fn to_int(self) -> Int;

  fn wrapping_add(self, other: U8) -> U8;
  fn wrapping_sub(self, other: U8) -> U8;
  fn wrapping_mul(self, other: U8) -> U8;
  fn xor(self, other: U8) -> U8;
  fn and(self, other: U8) -> U8;
  fn or(self, other: U8) -> U8;
  fn shl(self, other: U8) -> U8;
  /// Logical, because the type is unsigned: the vacated bits are zeros
  /// and a large value stays large.
  fn shr(self, other: U8) -> U8;
}

/// An unsigned 16-bit integer: 0 to 65,535.
impl U16 {
  /// The same number as a `U16`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  fn of(value: Int) -> U16;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  fn wrapping(value: Int) -> U16;

  /// Every `U16` is an `Int`, so this cannot fail and costs one
  /// instruction.
  fn to_int(self) -> Int;

  fn wrapping_add(self, other: U16) -> U16;
  fn wrapping_sub(self, other: U16) -> U16;
  fn wrapping_mul(self, other: U16) -> U16;
  fn xor(self, other: U16) -> U16;
  fn and(self, other: U16) -> U16;
  fn or(self, other: U16) -> U16;
  fn shl(self, other: U16) -> U16;
  /// Logical, because the type is unsigned: the vacated bits are zeros
  /// and a large value stays large.
  fn shr(self, other: U16) -> U16;
}

/// An unsigned 32-bit integer: 0 to 4,294,967,295.
impl U32 {
  /// The same number as a `U32`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  fn of(value: Int) -> U32;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  fn wrapping(value: Int) -> U32;

  /// Every `U32` is an `Int`, so this cannot fail and costs one
  /// instruction.
  fn to_int(self) -> Int;

  fn wrapping_add(self, other: U32) -> U32;
  fn wrapping_sub(self, other: U32) -> U32;
  fn wrapping_mul(self, other: U32) -> U32;
  fn xor(self, other: U32) -> U32;
  fn and(self, other: U32) -> U32;
  fn or(self, other: U32) -> U32;
  fn shl(self, other: U32) -> U32;
  /// Logical, because the type is unsigned: the vacated bits are zeros
  /// and a large value stays large.
  fn shr(self, other: U32) -> U32;
}

/// An unsigned 64-bit integer: 0 to 18,446,744,073,709,551,615.
///
/// The only type here that holds numbers `Int` cannot, which is why it is the
/// only one whose `to_int` can stop the program.
impl U64 {
  /// The same number as a `U64`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  fn of(value: Int) -> U64;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  fn wrapping(value: Int) -> U64;

  /// `Int` cannot hold every `U64`, so this stops the program above
  /// `Int`'s maximum. `U64::wrapping_to_int` is how to reinterpret the bits
  /// instead.
  fn to_int(self) -> Int;

  /// The same bits read as a signed `Int`, so a `U64` above `Int`'s maximum
  /// comes back negative rather than stopping.
  fn wrapping_to_int(self) -> Int;

  fn wrapping_add(self, other: U64) -> U64;
  fn wrapping_sub(self, other: U64) -> U64;
  fn wrapping_mul(self, other: U64) -> U64;
  fn xor(self, other: U64) -> U64;
  fn and(self, other: U64) -> U64;
  fn or(self, other: U64) -> U64;
  fn shl(self, other: U64) -> U64;
  /// Logical, because the type is unsigned: the vacated bits are zeros
  /// and a large value stays large.
  fn shr(self, other: U64) -> U64;
}

/// A signed 8-bit integer: -128 to 127.
impl I8 {
  /// The same number as a `I8`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  fn of(value: Int) -> I8;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  fn wrapping(value: Int) -> I8;

  /// Every `I8` is an `Int`, so this cannot fail and costs one
  /// instruction.
  fn to_int(self) -> Int;

  fn wrapping_add(self, other: I8) -> I8;
  fn wrapping_sub(self, other: I8) -> I8;
  fn wrapping_mul(self, other: I8) -> I8;
  fn xor(self, other: I8) -> I8;
  fn and(self, other: I8) -> I8;
  fn or(self, other: I8) -> I8;
  fn shl(self, other: I8) -> I8;
  /// Arithmetic, because the type is signed: a negative number stays
  /// negative.
  fn shr(self, other: I8) -> I8;
}

/// A signed 16-bit integer: -32,768 to 32,767.
impl I16 {
  /// The same number as a `I16`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  fn of(value: Int) -> I16;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  fn wrapping(value: Int) -> I16;

  /// Every `I16` is an `Int`, so this cannot fail and costs one
  /// instruction.
  fn to_int(self) -> Int;

  fn wrapping_add(self, other: I16) -> I16;
  fn wrapping_sub(self, other: I16) -> I16;
  fn wrapping_mul(self, other: I16) -> I16;
  fn xor(self, other: I16) -> I16;
  fn and(self, other: I16) -> I16;
  fn or(self, other: I16) -> I16;
  fn shl(self, other: I16) -> I16;
  /// Arithmetic, because the type is signed: a negative number stays
  /// negative.
  fn shr(self, other: I16) -> I16;
}

/// A signed 32-bit integer: -2,147,483,648 to 2,147,483,647.
///
/// A C `int`, which is why it is the one a foreign function usually wants.
impl I32 {
  /// The same number as a `I32`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  fn of(value: Int) -> I32;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  fn wrapping(value: Int) -> I32;

  /// Every `I32` is an `Int`, so this cannot fail and costs one
  /// instruction.
  fn to_int(self) -> Int;

  fn wrapping_add(self, other: I32) -> I32;
  fn wrapping_sub(self, other: I32) -> I32;
  fn wrapping_mul(self, other: I32) -> I32;
  fn xor(self, other: I32) -> I32;
  fn and(self, other: I32) -> I32;
  fn or(self, other: I32) -> I32;
  fn shl(self, other: I32) -> I32;
  /// Arithmetic, because the type is signed: a negative number stays
  /// negative.
  fn shr(self, other: I32) -> I32;
}

/// One bucket's worth of entries: the keys that hashed to the same slot.
///
/// Separate chaining rather than open addressing, because a chain is an
/// ordinary recursive ADT and needs no tombstones, no sentinel value and no
/// second array saying which slots are live. It allocates per entry, which is
/// the price, and it is the shape the language is actually good at.
export type Chain<K, V> =
  | Empty
  | Node(key: K, value: V, rest: Chain<K, V>);

impl<K: Hash, V> Chain<K, V> {
  fn find(self, key: K) -> Option<V> {
    match self {
      Chain::Empty => Option::None,
      Chain::Node(k, v, rest) =>
      if k.eq(key) { Option::Some(v) } else { Chain::find(rest, key) },
    }
  }

  /// The chain with `key` removed, or the same chain if it was not there.
  fn without(self, key: K) -> Chain<K, V> {
    match self {
      Chain::Empty => Chain::Empty,
      Chain::Node(k, v, rest) =>
      if k.eq(key) { rest } else { Chain::Node(k, v, Chain::without(rest, key)) },
    }
  }

  fn holds(self, key: K) -> Bool {
    match Chain::find(self, key) {
      Option::Some(v) => true,
      Option::None => false,
    }
  }
}

/// A hash map from `Int` keys.
///
/// Written in Khora, out of an array for the buckets and a `mut` field for the
/// count — which is what phase 6 was for. Nothing below this is a compiler
/// feature.
///
/// Keys are `Int` because hashing a string means walking its bytes, and there
/// are no bytes yet — that arrives with fixed-width integers, and is the first
/// thing to revisit here.
///
/// The bucket count is always a power of two, which is what lets `slot` mask
/// instead of dividing. `new` starts at eight and `grow` doubles, so nothing
/// else has to maintain it.
export type Map<K, V> = {
  mut buckets: Array<Chain<K, V>>,
  mut count: Int,
};

impl<K: Hash, V> Map<K, V> {
  fn new() -> Map<K, V> { { buckets: Array::new(8, Chain::Empty), count: 0 } }

  fn len(self) -> Int { self.count }

  fn get(self, key: K) -> Option<V> {
    Chain::find(Array::get(self.buckets, Map::slot(self, key)), key)
  }

  fn holds(self, key: K) -> Bool {
    Chain::holds(Array::get(self.buckets, Map::slot(self, key)), key)
  }

  /// Adds `key`, replacing whatever was there. The count only moves when the
  /// key is new, which is what makes it the number of entries rather than the
  /// number of insertions.
  fn insert(self, key: K, value: V) -> () {
    if self.count * 4 >= Array::length(self.buckets) * 3 { Map::grow(self); }
    let at = Map::slot(self, key);
    let bucket = Array::get(self.buckets, at);
    if Chain::holds(bucket, key) {
      Array::set(self.buckets, at, Chain::Node(key, value, Chain::without(bucket, key)));
    } else {
      Array::set(self.buckets, at, Chain::Node(key, value, bucket));
      self.count = self.count + 1;
    }
  }

  fn remove(self, key: K) -> () {
    let at = Map::slot(self, key);
    let bucket = Array::get(self.buckets, at);
    if Chain::holds(bucket, key) {
      Array::set(self.buckets, at, Chain::without(bucket, key));
      self.count = self.count - 1;
    }
  }

  /// Which bucket a key belongs in.
  ///
  /// Knuth's multiplicative constant, then a shift-xor so that the high bits —
  /// where multiplication puts the information — reach the low ones the mask
  /// keeps. Wrapping on purpose: overflow is where the mixing comes from.
  fn slot(self, key: K) -> Int {
    let mixed = Int::wrapping_mul(key.hash(), 2654435761);
    let spread = Int::xor(mixed, Int::shr(mixed, 16));
    Int::and(spread, Array::length(self.buckets) - 1)
  }

  /// Twice the buckets, and every entry moved into the new ones.
  fn grow(self) -> () {
    let old = self.buckets;
    self.buckets = Array::new(Array::length(old) * 2, Chain::Empty);
    let mut i = 0;
    while i < Array::length(old) {
      Map::rehash(self, Array::get(old, i));
      i = i + 1;
    }
  }

  fn rehash(self, chain: Chain<K, V>) -> () {
    match chain {
      Chain::Empty => (),
      Chain::Node(k, v, rest) => {
        let at = Map::slot(self, k);
        Array::set(self.buckets, at, Chain::Node(k, v, Array::get(self.buckets, at)));
        Map::rehash(self, rest);
      },
    };
  }
}

/// The fibers a block is responsible for.
///
/// Releasing one *cancels its children and waits*, which is the answer for a
/// block that did not finish — a raise, or a cancellation, passing through. On
/// the ordinary path `nursery` has already waited, so the release finds
/// nothing to stop. That is how one value means both "wait for the children"
/// and "the answers are no longer wanted" without ever being told which
/// happened.
/// A function two fibers may hold.
///
/// A closure is never shareable on its own: what it captured is not in its
/// type, so no amount of looking at `(Request) -> Response` says whether the
/// thing behind it can be written. That is fine until a container of closures
/// has to cross — a router holding its handlers, a table of callbacks — at
/// which point the whole container is stuck on this side.
///
/// This is the proof, reified. `SharedFn::of` accepts only a closure written at
/// the call, where the captures are on the screen and can be checked; what it
/// returns has forgotten how it was made, and is shareable because the check
/// already happened. A `Route` holding one is shareable in the ordinary
/// structural way, with nothing special said about routers.
///
/// The cost is the wrapper at the mount site, and that is the honest price: the
/// alternative is a bit in every function type, which colours every container
/// of a function all the way up. `docs/design/sharing.md`.
export type SharedFn<A, B, 'e>;

impl<A, B, 'e> Share for SharedFn<A, B, 'e> {}

impl<A, B, 'e> SharedFn<A, B, 'e> {
  /// Certifies a closure written here.
  ///
  /// The argument has to be a closure literal or a named function — anything
  /// else was written elsewhere and took its captures with it, which is the
  /// one thing this cannot check and so the one thing it refuses.
  fn of(f: (A) -> B raises 'e) -> SharedFn<A, B, 'e>;
  /// Calls it. A plain closure call; the wrapper costs nothing at runtime.
  fn call(self, argument: A) -> B raises 'e;
}

export type Fibers;

/// Adopting from more than one fiber at once is what a nursery is for, and the
/// runtime takes a lock to do it. `khora-rt`.
impl Share for Fibers {}

impl Fibers {
  fn open() -> Fibers;
  fn adopt(self, fiber: Fiber) -> ();
  /// Waits for every child, oldest first, and empties the nursery.
  fn wait(self) -> ();
}

/// Where a spawned fiber goes.
///
/// The operation takes a fiber rather than a thunk for two reasons. A handler's
/// fields are closures and a closure cannot be generic, so an operation could
/// not be generic in what the thunk raises. And a thunk cannot be *forwarded*
/// to `Fiber::spawn` at all: a fiber's body has to be written where it starts,
/// so that what it closes over can be checked against the rule that a mutable
/// value may not cross. `docs/design/memory.md` §5a.
///
/// So the idiom is one call inside another, and the body is on the screen:
///
/// ```
/// nursery.adopt(Fiber::spawn(fn () => analyze(id)!));
/// ```
export effect Nursery {
  adopt: (Fiber) -> (),
}

/// Runs `body` with a nursery, and does not return until its children are done.
///
/// Structured concurrency, and the structure is the region's: a fiber cannot
/// outlive this block, because leaving it — at the end, on a `return`, or with
/// a raise passing through — releases the nursery, and releasing a nursery
/// stops what is still running.
///
/// **Pass a named function, not a lambda.** A named function receives what its
/// `with` clause names as evidence parameters, so it can be handed here and
/// called with the nursery this function installs:
///
/// ```khora
/// fn serve<'e>() -> () with { 'e | nursery: Nursery } { .. }
/// nursery(serve)!
/// ```
///
/// A lambda cannot, and `nursery(fn () => serve()!)` is refused: a lambda's
/// requirement row is always empty, because it *captures* the capabilities it
/// uses rather than receiving them — and this thunk was written before the
/// binding existed, so there is nothing to capture.
///
/// Which makes eta-expansion change meaning, and it should not.
/// `docs/design/capability-passing.md` decides what to do about that.
export fn nursery<A, 'e, 'r>(body: () -> A with { 'e | nursery: Nursery } raises 'r) -> A
  with 'e
  raises 'r
{
  let crew = Fibers::open();
  let value = with { nursery: handler for Nursery { adopt: fn f => Fibers::adopt(crew, f) } } {
    body()!
  };
  // Only reached when `body` finished: waiting for children that are still
  // wanted. The other way out releases `crew`, which cancels them first.
  Fibers::wait(crew);
  value
}

/// Runs `body` in a fresh region, discharging its `scope` requirement.
///
/// Row subtraction made concrete: `scope` is present in the body's requirement
/// row and absent from the result's. The region is an ordinary binding of this
/// function, so it ends when this function does — including when `body` raises
/// and the error passes straight through.
///
/// **Pass a named function, not a lambda**, for the reason on `nursery`.
export fn scoped<A, 'e, 'r>(body: () -> A with { 'e | scope: Scope } raises 'r) -> A
  with 'e
  raises 'r
{
  let region = Region::open();
  with { scope: handler for Scope { defer: fn f => Region::defer(region, f) } } {
    body()!
  }
}

/// Acquires a value and registers its release in one step.
///
/// The generic half of `Scope`, kept out of the effect so the operation can
/// stay a plain closure. `release` is called with `value` when the region ends.
export fn acquire<A, 'e>(value: A, release: (A) -> ()) -> A
  with { 'e | scope: Scope }
{
  scope.defer(fn () => release(value));
  value
}

/// Runs `body` and makes its failure a value.
///
/// The error channel and `Result` are the same thing said two ways — a tagged
/// return already *is* "an error or a value" — and this is where a caller
/// chooses which way to read it. The row of `body` is discharged, so what
/// comes back cannot fail again.
///
/// This is also what makes retrying possible: a policy that runs a computation
/// a second time has to be able to see that the first time did not work,
/// without knowing what it was doing.
export fn attempt<A, E, 'e>(body: () -> A with 'e raises E) -> Result<A, E>
  with 'e;

// --- schedules -------------------------------------------------------------

/// How many times to run something, and when to stop.
///
/// Deliberately a plain description rather than a stream of instants: a
/// schedule with no clock in it can be read, compared and tested, and the
/// clock arrives later without changing what a policy *means*.
export type Schedule = {
  /// Attempts in total, including the first. `1` is "do not retry".
  attempts: Int,
};

impl Schedule {
  /// Run once. The identity, and the one you get by not asking.
  fn once() -> Schedule { { attempts: 1 } }
  /// Run up to `n` times, stopping at the first success.
  fn times(n: Int) -> Schedule { { attempts: if n < 1 { 1 } else { n } } }
}

/// Runs `body` until it succeeds or the schedule runs out.
///
/// The last failure is the one that comes back, because it is the one that
/// stopped the retrying — an earlier error is a thing that was already
/// recovered from, and reporting it would say the wrong thing about what
/// happened.
export fn retry<A, E, 'e>(schedule: Schedule, body: () -> A with 'e raises E) -> A
  with 'e
  raises E
{
  // The first attempt happens outside the loop, so there is always an outcome
  // to report and no fourth case to invent a value for.
  let mut left = schedule.attempts - 1;
  let mut outcome = attempt(body);
  while left > 0 {
    match outcome {
      Result::Ok(value) => left = 0,
      Result::Err(error) => {
        outcome = attempt(body);
        left = left - 1;
      }
    };
  }
  match outcome {
    Result::Ok(value) => value,
    Result::Err(error) => raise error,
  }
}

/// Runs `body` until it fails, or the schedule runs out. The count of runs
/// that succeeded comes back.
export fn repeat<A, E, 'e>(schedule: Schedule, body: () -> A with 'e raises E) -> Int
  with 'e
{
  let mut left = schedule.attempts;
  let mut done = 0;
  while left > 0 {
    match attempt(body) {
      Result::Ok(value) => {
        done = done + 1;
        left = left - 1;
      }
      Result::Err(error) => left = 0,
    };
  }
  done
}
