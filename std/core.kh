module std::core;

//! The vocabulary every Khora program starts with.
//!
//! `Option` and `Result`, the comparison and display traits, lists, arrays,
//! strings, vectors, maps and dictionaries, and the pieces structured
//! concurrency is built out of -- regions, fibers, nurseries and `Shared`.
//! Nothing here is optional in the way the rest of `std` is: two libraries
//! that disagree about what an `Option` is cannot exchange one.
//!
//! # Where the effects went
//!
//! Khora tracks effects as rows on the signature rather than as a wrapper
//! type, so there is no `Effect<A, R, E>` here. A computation's requirements
//! live in its `with` clause and its failures in its `raises` clause; both are
//! inferred on private functions and written out on exported ones.
//!
//! The module is `std::core` rather than `std::effect` for two reasons: there
//! is no longer an `Effect` type to name it after, and `effect` is now a
//! reserved word, so `std::effect` will not lex as a path.
//!
//! See docs/design/effects.md.

// ---------------------------------------------------------------------------
// Comparison and display
// ---------------------------------------------------------------------------

/// The result of comparing two values.
///
/// A three-way answer rather than two booleans: one comparison decides all six
/// operators, and a type cannot accidentally disagree with itself about `<` and
/// `>=`.
pub type Ordering =
  | Less
  | Equal
  | Greater;

/// Whether two values of a type are the same value.
///
/// Structural, and written rather than derived for a type whose identity is
/// not its contents. Nothing here defines `!=`: one operator is one thing to
/// get right, and the negation is the negation.
///
/// **`Float` is not an instance**, because `NaN == NaN` is false and a type
/// whose values are not equal to themselves breaks every container built on
/// this one. `docs/design/numbers.md` has the argument.
pub trait Eq {
  /// Whether these are the same value.
  fn eq(self, other: Self) -> Bool;
}

/// Ordering refines equality: anything orderable can be compared for equality,
/// so `Ord` requires `Eq` rather than repeating it.
pub trait Ord: Eq {
  /// Where `self` falls relative to `other`.
  ///
  /// Must agree with `eq`: `cmp` answering `Equal` and `eq` answering false is
  /// a sort that loses elements and a search that cannot find them.
  fn cmp(self, other: Self) -> Ordering;
}

/// A value that can be a key.
///
/// Requires `Eq` rather than repeating it, because the two have to agree: a
/// map finds a key by hashing it to a bucket and then comparing, so **equal
/// values must hash equal**. Unequal values may collide — that is what the
/// bucket's chain is for — but two values that `eq` says are the same and
/// `hash` sends to different buckets are an entry that can be inserted and
/// never found.
///
/// `Float` is deliberately not an instance, because it is not an instance of
/// `Eq`: `NaN == NaN` is false, and a key that is not equal to itself is a
/// lost entry in every language that allows one. `docs/design/numbers.md`.
pub trait Hash: Eq {
  /// A number to bucket by. Any number: spreading it out is the map's job, not
  /// this one's, so an implementation only has to be *consistent*.
  fn hash(self) -> Int;
}

/// A value rendered for a person to read.
///
/// **Not a serialization format.** `show` is for a log line, an error message
/// and a test's failure output; `std::json` is for something that has to be
/// read back. Nothing promises that `show` round-trips, and `Float` is the one
/// place it happens to — see `docs/design/compatibility.md`, which makes that
/// a promise about `Float` rather than about `Show`.
pub trait Show {
  /// This value, as text.
  fn show(self) -> String;
}

/// The scalars, so that `derive(Show)` on a record of them has something to
/// call.
///
/// One line each, and each deferring to a `to_string` that already existed.
/// The two have to agree — `Show` is what a *generic* function asks for and
/// `to_string` is what a caller reaches for directly — and they agree here by
/// one being written in terms of the other rather than by anyone remembering.
///
/// A `String` shows as itself, unquoted. A derived `Show` is for reading, not
/// for parsing back: `User { name: alice }` is what a person wants in a log
/// line, and a caller who needs the quotes is writing a serializer, which is
/// `std::json`'s job and not this trait's.
impl Show for Int {
  fn show(self) -> String { Int::to_string(self) }
}

impl Show for Float {
  fn show(self) -> String { Float::to_string(self) }
}

impl Show for Bool {
  fn show(self) -> String { if self { "true" } else { "false" } }
}

impl Show for String {
  fn show(self) -> String { self }
}

/// Two fibers may hold this at once.
///
/// A marker: no methods, and implementing it asserts rather than provides.
/// Nothing has to write it for an ordinary type — a record, a variant, a tuple
/// is shareable exactly when everything inside it is, and the compiler can see
/// that. This is for the types it *cannot* see inside: one declared with no
/// body, whose behaviour lives in the runtime or across the C ABI.
///
/// Those default to unshareable, which is the only safe way round. `Array` can
/// be written through `Array::set` and `Ptr` points at memory this language
/// did not allocate; both look like empty structures and neither is safe for
/// two fibers to share. So the author says which is which, and the reader can
/// see where the assertion was made.
///
/// Fibers are operating-system threads today, so this is `Sync` rather than
/// `Send`: both fibers keep their reference, and neither hands it over.
///
/// `docs/design/sharing.md`.
pub trait Share {}

impl Eq for Int {
  fn eq(self, other: Int) -> Bool { self == other }
}

impl Ord for Int {
  fn cmp(self, other: Int) -> Ordering {
    if self < other { Ordering::Less } else if self == other { Ordering::Equal }
    else { Ordering::Greater }
  }
}

/// An `Int` is its own hash. `Map::slot` does the mixing, so there is nothing
/// for this to add.
impl Hash for Int {
  fn hash(self) -> Int { self }
}

impl Eq for Bool {
  fn eq(self, other: Bool) -> Bool { self == other }
}

impl Eq for String {
  fn eq(self, other: String) -> Bool { self == other }
}

impl Hash for Bool {
  fn hash(self) -> Int { if self { 1 } else { 0 } }
}

/// FNV-1a over the bytes, which is one multiply and one xor each and is what a
/// string hash is supposed to look like. Wrapping on purpose: the overflow is
/// where the mixing comes from.
impl Hash for String {
  fn hash(self) -> Int {
    U32::to_int(String::fold(self, 0, U32::of(2166136261)))
  }
}

impl String {
  /// FNV-1a over the bytes from `from` on.
  fn fold(self, from: Int, seed: U32) -> U32 {
    let count = String::byte_length(self);
    let mut at = from;
    let mut hash = seed;
    while at < count {
      let mixed = U32::xor(hash, U32::of(U8::to_int(String::byte(self, at))));
      hash = U32::wrapping_mul(mixed, 16777619);
      at = at + 1;
    }
    hash
  }
}

/// Byte order, which is what `<` on a `String` means here.
///
/// Not a locale's order and not code-point order — the first needs a table
/// nobody has bound and the second differs from this one only above the basic
/// plane. What it *is* is stable, cheap, and the same on every machine, which
/// is what sorting for a program's own use wants. A human-facing sort wants a
/// collation library and should say so.
impl Ord for String {
  fn cmp(self, other: String) -> Ordering {
    String::compare_bytes(self, other, 0)
  }
}

impl String {
  fn compare_bytes(self, other: String, from: Int) -> Ordering {
    let mine = String::byte_length(self);
    let theirs = String::byte_length(other);
    let shorter = if mine < theirs { mine } else { theirs };
    let mut at = from;
    let mut answer = Ordering::Equal;
    while at < shorter && answer.is_equal() {
      let here = String::byte(self, at);
      let there = String::byte(other, at);
      if here < there { answer = Ordering::Less }
      else if here > there { answer = Ordering::Greater }
      else { at = at + 1 }
    }
    // Neither differed in the bytes they share, so the shorter one is first
    // and equal lengths mean equal text.
    if answer.is_equal() {
      if mine < theirs { Ordering::Less }
      else if mine > theirs { Ordering::Greater }
      else { Ordering::Equal }
    } else {
      answer
    }
  }
}

impl Eq for Ordering {
  fn eq(self, other: Ordering) -> Bool {
    match self {
      Ordering::Less => match other { Ordering::Less => true, Ordering::Equal => false, Ordering::Greater => false },
      Ordering::Equal => match other { Ordering::Less => false, Ordering::Equal => true, Ordering::Greater => false },
      Ordering::Greater => match other { Ordering::Less => false, Ordering::Equal => false, Ordering::Greater => true },
    }
  }
}

impl Ordering {
  /// Whether the comparison came out `Less`.
  pub fn is_less(self) -> Bool { self.eq(Ordering::Less) }
  /// Whether it came out `Equal`.
  pub fn is_equal(self) -> Bool { self.eq(Ordering::Equal) }
  /// Whether it came out `Greater`.
  pub fn is_greater(self) -> Bool { self.eq(Ordering::Greater) }
  /// `a.cmp(b).reverse()` sorts descending without a second comparison.
  pub fn reverse(self) -> Ordering {
    match self {
      Ordering::Less => Ordering::Greater,
      Ordering::Equal => Ordering::Equal,
      Ordering::Greater => Ordering::Less,
    }
  }
}

// ---------------------------------------------------------------------------
// Optional values and failures
// ---------------------------------------------------------------------------

/// A value, or nothing.
///
/// For absence that is ordinary and expected: a key that is not in a map, the
/// head of an empty list. When the absence is a *failure* — something went
/// wrong and the caller should know what — the type is `Result`, and
/// `ok_or` below is the bridge between them.
pub type Option<A> =
  | Some(value: A)
  | None;

/// A value, or the reason there is not one.
///
/// **The same thing a `raises` row says, said as a value.** A tagged return
/// already *is* "an error or a value"; which of the two readings a function
/// offers is a choice about its caller, and `attempt` is where one becomes the
/// other. `docs/design/effect-runtime.md` §8.
pub type Result<A, E> =
  | Ok(value: A)
  | Err(error: E);

impl<A> Option<A> {
  /// Whether there is a value.
  ///
  /// For a condition. Reaching for the value afterwards means matching twice;
  /// `match` once instead.
  pub fn is_some(self) -> Bool { match self { Option::Some(_v) => true, Option::None => false } }

  /// Whether there is not.
  pub fn is_none(self) -> Bool { match self { Option::Some(_v) => false, Option::None => true } }

  /// The value, or `fallback` if there is none.
  ///
  /// `fallback` is evaluated either way. `unwrap_or_else` takes a closure for
  /// when producing it is expensive.
  pub fn unwrap_or(self, fallback: A) -> A {
    match self { Option::Some(v) => v, Option::None => fallback }
  }

  /// The value, or the result of calling `fallback`.
  ///
  /// The closure is called only when there is nothing, which is the whole
  /// difference from `unwrap_or` — reach for this when producing the fallback
  /// costs something.
  pub fn unwrap_or_else(self, fallback: () -> A) -> A {
    match self { Option::Some(v) => v, Option::None => fallback() }
  }

  /// Turns absence into a failure, which is how an `Option` joins a `raises`
  /// chain.
  pub fn ok_or<E>(self, error: E) -> Result<A, E> {
    match self { Option::Some(v) => Result::Ok(v), Option::None => Result::Err(error) }
  }
}

impl<A, E> Result<A, E> {
  /// Whether this succeeded.
  pub fn is_ok(self) -> Bool { match self { Result::Ok(_v) => true, Result::Err(_e) => false } }

  /// Whether it did not.
  pub fn is_err(self) -> Bool { match self { Result::Ok(_v) => false, Result::Err(_e) => true } }

  /// The value, or `fallback` if there was an error.
  ///
  /// **The error is discarded.** That is the right thing exactly when the
  /// caller has already decided the reason does not change what they do; when
  /// it might, `match`.
  pub fn unwrap_or(self, fallback: A) -> A {
    match self { Result::Ok(v) => v, Result::Err(_e) => fallback }
  }

  /// Discards the error, which is the one direction that cannot fail.
  pub fn ok(self) -> Option<A> {
    match self { Result::Ok(v) => Option::Some(v), Result::Err(_e) => Option::None }
  }

  /// Rewrites the error and leaves the value alone.
  ///
  /// What a function does at the edge of its own vocabulary: a caller should
  /// see the failure in terms of what *they* asked for, not in terms of
  /// whatever was reached to answer it.
  pub fn map_err<F>(self, f: (E) -> F) -> Result<A, F> {
    match self { Result::Ok(v) => Result::Ok(v), Result::Err(e) => Result::Err(f(e)) }
  }
}

/// A value that a log line cannot get at.
///
/// A password, a token, an API key. The leak everybody actually has is not a
/// clever one: it is a `Config` record in a structured log, or a `${}` in a
/// message written while debugging something else, and no review catches it
/// because nothing about the line looks wrong.
///
/// **`Show` prints `<redacted>`, and there is no `ToJson`.** Those two
/// sentences are the whole design, and each is deliberate in a different
/// direction:
///
/// - *With* `Show`, a record holding one still derives `Show`, so the config a
///   service prints at start-up stays printable and the secret in it does not
///   appear. A `Redacted` with no `Show` at all would look stricter and be
///   worse: it makes the containing record unprintable, and the way people
///   answer that is by not wrapping the secret.
/// - *Without* `ToJson`, a record holding one does **not** derive `ToJson`,
///   and the build stops. That is the right place to stop: a type that
///   serialises a secret is a bug, and one that serialises `"<redacted>"` is a
///   payload that fails to round-trip somewhere further away.
///
/// This is where a nominal type earns its keep. Elsewhere the same idea is a
/// `toString` override, which any structured logger walks straight past
/// because it reads fields rather than calling it. Here it is a missing impl,
/// which is a compile error.
///
/// ```khora
/// derive(Show)
/// type Config = { host: String, password: Redacted<String> };
///
/// let settings: Config = { host: "db.internal", password: Redacted::of(secret) };
/// print(settings.show());   // Config { host: db.internal, password: <redacted> }
/// connect(Redacted::expose(settings.password));
/// ```
///
/// Interpolation is closed off separately and for free: `"${key}"` wants a
/// `String` and does not call `Show`, so it does not compile at all. The
/// remaining ways a value reaches a log are `show` and a derived `Show` on
/// something holding it, and this covers both.
///
/// **Deliberately no `Eq`.** Comparing two secrets is a real thing to want and
/// a derived `Eq` would compare them byte by byte and stop at the first
/// difference, which is how a timing side channel gets written by somebody who
/// was not writing one. Anybody who needs the comparison writes `expose` and
/// says so.
pub type Redacted<A> = | Secret(value: A);

impl<A> Redacted<A> {
  /// Wraps a value so that showing it shows nothing.
  pub fn of(value: A) -> Redacted<A> { Redacted::Secret(value) }

  /// The value back.
  ///
  /// **The only way out, and it is meant to be visible.** `expose` at a call
  /// site is a word a reviewer can search for; the leak this type exists to
  /// stop is the one nobody wrote on purpose.
  pub fn expose(self) -> A { match self { Redacted::Secret(value) => value } }
}

impl<A> Show for Redacted<A> {
  /// `<redacted>`, whatever is inside.
  ///
  /// No bound on `A`: this never looks at the value, which is the point, and
  /// requiring `A: Show` would mean a secret you cannot show is a secret you
  /// cannot wrap.
  fn show(self) -> String { match self { Redacted::Secret(_v) => "<redacted>" } }
}

/// Every reason the input was wrong, rather than the first one.
///
/// `Result` is the right shape when the next step depends on the last: it
/// stops, because there is nothing sensible to do with a value that is not
/// there. Validation is the other shape. The fields of a form, the keys of a
/// config, the columns of a row -- these do not depend on each other, and
/// reporting them one restart at a time is a person running the program five
/// times to be told five things it knew the first time.
///
/// `Applicative::map2` is the operation that distinguishes the two, and
/// `std::core`'s own docstring on it has been pointing here since it was
/// written: *"`Option` gives up if either is `None`, and a validation type
/// would collect both failures."*
///
/// ```khora
/// let settings = Validated::map2(
///   integer("PORT"),
///   string("HOST"),
///   fn (port, host) => Settings { port: port, host: host },
/// );
/// ```
///
/// **Not an `Applicative` instance**, though it is one in shape. The instance
/// would need `Validated<_, E>` -- the error parameter fixed and the value
/// parameter free -- and Khora has no partial application of a type
/// constructor. The methods are the same functions under their own names, and
/// the instance can arrive later without changing a call site.
derive(Eq, Show)
pub type Validated<A, E> =
  | Valid(value: A)
  | Invalid(errors: List<E>);

impl<A, E> Validated<A, E> {
  /// A value that was fine.
  pub fn of(value: A) -> Validated<A, E> { Validated::Valid(value) }

  /// One thing wrong.
  pub fn error(e: E) -> Validated<A, E> { Validated::Invalid(List::Cons(e, List::Nil)) }

  /// Whether nothing was wrong.
  pub fn is_valid(self) -> Bool {
    match self { Validated::Valid(_v) => true, Validated::Invalid(_e) => false }
  }

  /// The same value, transformed. Failures pass through untouched.
  pub fn map<B>(self, f: (A) -> B) -> Validated<B, E> {
    match self {
      Validated::Valid(v) => Validated::Valid(f(v)),
      Validated::Invalid(errors) => Validated::Invalid(errors),
    }
  }

  /// Two together, **keeping both sides' failures**.
  ///
  /// This is the whole type. `f` runs only when both succeeded; when either
  /// did not, the answer carries every error from both, left to right, and `f`
  /// is not called. Chained through a record's fields it reports the whole
  /// form in one pass.
  pub fn map2<B, C>(self, other: Validated<B, E>, f: (A, B) -> C) -> Validated<C, E> {
    match self {
      Validated::Valid(a) => match other {
        Validated::Valid(b) => Validated::Valid(f(a, b)),
        Validated::Invalid(errors) => Validated::Invalid(errors),
      },
      Validated::Invalid(left) => match other {
        Validated::Valid(_b) => Validated::Invalid(left),
        Validated::Invalid(right) => Validated::Invalid(List::concat(left, right)),
      },
    }
  }

  /// A second step that can fail, run only if the first did not.
  ///
  /// **Fails fast, and that is not a contradiction.** `map2` collects because
  /// its two sides are independent; this one's second step is written in terms
  /// of the first's value, so there is no second answer to collect when there
  /// is no first value to write it against. Parsing is the shape: `integer`
  /// reads the text and then parses it, and "not set" and "not a number" are
  /// never both true of one variable.
  pub fn and_then<B>(self, f: (A) -> Validated<B, E>) -> Validated<B, E> {
    match self {
      Validated::Valid(v) => f(v),
      Validated::Invalid(errors) => Validated::Invalid(errors),
    }
  }

  /// The failures collapsed into one `Result`, for joining a `raises` chain.
  ///
  /// `List<E>` rather than `E`, because the point of getting here was that
  /// there may be more than one and throwing the rest away at the boundary
  /// would undo the collecting.
  pub fn to_result(self) -> Result<A, List<E>> {
    match self {
      Validated::Valid(v) => Result::Ok(v),
      Validated::Invalid(errors) => Result::Err(errors),
    }
  }

  /// The value, or `fallback` if anything was wrong.
  pub fn unwrap_or(self, fallback: A) -> A {
    match self { Validated::Valid(v) => v, Validated::Invalid(_e) => fallback }
  }
}

// ---------------------------------------------------------------------------
// Containers
// ---------------------------------------------------------------------------

/// A singly-linked list: the sequence with no capacity, no reallocation and
/// no index.
///
/// Cheap at the front and linear everywhere else. `Vector` is the one to reach
/// for when the work is indexing or appending; this is the one to reach for
/// when the work is "each of these, in order", which is most of it.
///
/// `[a, b, c]` builds one — the literal is `Cons(a, Cons(b, Cons(c, Nil)))`
/// and needs `List` in scope, exactly as `0.01d` needs `Decimal`.
pub type List<A> =
  | Nil
  | Cons(head: A, tail: List<A>);

/// A list split down the middle, for `sort`.
pub type Halves<A> = {
  left: List<A>,
  right: List<A>,
};

impl<A: Ord> List<A> {
  /// The same elements, in order.
  ///
  /// A merge sort, because a linked list is what it was invented for: it needs
  /// no indexing, no copying into an array and back, and it is stable — equal
  /// elements keep the order they were given, which is the property a caller
  /// notices the absence of when sorting by one field and expecting the
  /// previous sort to survive.
  ///
  /// `A: Ord` rather than a comparison function, so that `<` on the elements
  /// and `sort` on the list cannot disagree. Sorting by something else is
  /// `sort_by`, which does not exist yet and wants a closure.
  ///
  /// **Its own recursion is the divide, so it goes about `log2(n)` deep** —
  /// twenty frames for a million elements, which is what it now sorts. The
  /// `merge` underneath it used to go one frame per element, and freeing the
  /// intermediate lists used to go one frame per cell; between them they made
  /// this the first `std` function a real workload could kill, at about twelve
  /// thousand elements.
  pub fn sort(self) -> List<A> {
    match self {
      List::Nil => List::Nil,
      List::Cons(only, rest) => match rest {
        // One element is sorted, and stopping here is what keeps the split
        // below from recursing forever on a list it cannot make smaller.
        List::Nil => List::Cons(only, List::Nil),
        List::Cons(second, more) => {
          let halves = List::split(List::Cons(only, List::Cons(second, more)));
          List::merge(halves.left.sort(), halves.right.sort())
        }
      },
    }
  }

  /// The first half and the second, each in the order it was given.
  ///
  /// **By counting to the middle, not by dealing alternately.** Dealing is one
  /// pass and needs no length, and it is what this did first — but it is not
  /// stable, and the test said so. Two equal elements at positions 1 and 2 land
  /// in *different* halves with the later one on the left, and a merge that
  /// breaks its tie towards the left then puts them back the wrong way round.
  ///
  /// The cost is a length and a reversal, both linear, against a sort that is
  /// already linearithmic.
  pub fn split(self) -> Halves<A> {
    List::take_first(self, self.length() / 2, List::Nil)
  }

  /// The first `count` elements and the rest, with `taken` already collected
  /// in reverse.
  ///
  /// `split`'s worker, and public only because `split` is. The accumulator is
  /// what keeps it a single pass.
  fn take_first(self, count: Int, taken: List<A>) -> Halves<A> {
    let mut got = taken;
    let mut rest = self;
    let mut remaining = count;
    let mut walking = count > 0;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) => {
          got = List::Cons(head, got);
          rest = tail;
          remaining = remaining - 1;
          walking = remaining > 0;
        },
      }
    };
    { left: got.reverse(), right: rest }
  }

  /// Two sorted lists, as one.
  ///
  /// `<=` rather than `<` on the tie, which is exactly what makes the sort
  /// stable: an element from the left half goes first when they are equal, and
  /// the left half is the earlier one.
  /// **Written as a loop, because this is where the depth was.** It recursed
  /// once per element -- `Cons(mine, merge(..))` is not a tail call -- so
  /// merging the two halves at the top of the sort took one stack frame for
  /// every element in the list, and a sort of twenty-seven thousand durations
  /// killed the process with nothing on either stream.
  ///
  /// The algorithm is unchanged and so is the stability. What was wrong was
  /// never the merge sort; it was that every walk of a `List` in this library
  /// was as deep as the list was long.
  fn merge(self, other: List<A>) -> List<A> {
    let mut out = List::Nil;
    let mut mine = self;
    let mut theirs = other;
    let mut walking = true;
    while walking {
      match mine {
        // One side is spent, so the other goes on the end whole. `out` is
        // back to front until the last line, so "on the end" is reversed onto
        // the front of it.
        List::Nil => { out = List::reverse_onto(theirs, out); walking = false; },
        List::Cons(head, tail) => match theirs {
          List::Nil => {
            out = List::reverse_onto(List::Cons(head, tail), out);
            walking = false;
          },
          List::Cons(other_head, other_tail) =>
          if head <= other_head {
            out = List::Cons(head, out);
            mine = tail;
          } else {
            out = List::Cons(other_head, out);
            theirs = other_tail;
          },
        },
      }
    };
    out.reverse()
  }
}

impl<A> List<A> {
  /// Whether there is nothing in it.
  ///
  /// Constant time, which `length() == 0` is not.
  pub fn is_empty(self) -> Bool { match self { List::Nil => true, List::Cons(_h, _t) => false } }

  /// How many elements there are.
  ///
  /// **Walks the list.** Nothing here caches it, so a loop that asks each time
  /// round is quadratic — take it once.
  pub fn length(self) -> Int {
    let mut count = 0;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(_h, tail) => { count = count + 1; rest = tail; },
      }
    };
    count
  }

  /// The first element, or `None` for an empty list.
  pub fn head(self) -> Option<A> {
    match self { List::Nil => Option::None, List::Cons(h, _t) => Option::Some(h) }
  }

  /// Prepends, which is the cheap end. Appending walks the whole list, so it
  /// is spelled `concat` and its cost is visible at the call site.
  pub fn push(self, item: A) -> List<A> { List::Cons(item, self) }

  /// `self` followed by `other`.
  ///
  /// Copies `self` and shares `other`, so the cost is the length of the *left*
  /// argument. Building a list by repeatedly concatenating onto the end is the
  /// quadratic way to do it; push and `reverse` once.
  pub fn concat(self, other: List<A>) -> List<A> {
    List::reverse_onto(self.reverse(), other)
  }

  /// The same elements, back to front.
  pub fn reverse(self) -> List<A> { self.reverse_onto(List::Nil) }

  /// `self` reversed, in front of `acc`.
  ///
  /// The accumulating half of `reverse`, and useful on its own: building a
  /// list front-to-back and reversing it at the end is the linear way to do
  /// what `concat` in a loop does quadratically. This is the "at the end".
  pub fn reverse_onto(self, acc: List<A>) -> List<A> {
    let mut out = acc;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) => { out = List::Cons(head, out); rest = tail; },
      }
    };
    out
  }

  /// Combines every element into one value, left to right.
  ///
  /// `step` is called with what has been accumulated so far and the next
  /// element. Summing is `fold(0, fn (a, b) => a + b)`.
  pub fn fold<B>(self, start: B, step: (B, A) -> B) -> B {
    let mut carried = start;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) => { carried = step(carried, head); rest = tail; },
      }
    };
    carried
  }

  /// Whether any element satisfies `wanted`.
  ///
  /// **Stops at the first one**, which is what makes it worth having over a
  /// `fold`: a fold visits everything, and the whole point of asking whether
  /// *any* element matches is that the answer often arrives early.
  pub fn any(self, wanted: (A) -> Bool) -> Bool {
    let mut found = false;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) =>
        if wanted(head) { found = true; walking = false; } else { rest = tail; },
      }
    };
    found
  }

  /// Whether every element satisfies `wanted`. Stops at the first that does not.
  ///
  /// True of the empty list, which is the convention that makes `all` compose:
  /// splitting a list in two and asking each half gives the same answer as
  /// asking the whole, and that fails at the empty case under any other rule.
  pub fn all(self, wanted: (A) -> Bool) -> Bool {
    let mut holds = true;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) =>
        if wanted(head) { rest = tail; } else { holds = false; walking = false; },
      }
    };
    holds
  }

  /// The first element satisfying `wanted`, or nothing.
  pub fn find(self, wanted: (A) -> Bool) -> Option<A> {
    let mut answer = Option::None;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) =>
        if wanted(head) { answer = Option::Some(head); walking = false; } else { rest = tail; },
      }
    };
    answer
  }

  /// The first `count` elements, or all of them if there are fewer.
  ///
  /// Below one is empty rather than an error: `take` is what a caller reaches
  /// for when the count came from somewhere else, and refusing zero would make
  /// every such caller check it first.
  pub fn take(self, count: Int) -> List<A> {
    let mut taken = List::Nil;
    let mut left = count;
    let mut rest = self;
    let mut walking = count > 0;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) => {
          taken = List::Cons(head, taken);
          rest = tail;
          left = left - 1;
          walking = left > 0;
        },
      }
    };
    taken.reverse()
  }

  /// Everything after the first `count` elements.
  pub fn drop(self, count: Int) -> List<A> {
    let mut rest = self;
    let mut left = count;
    let mut walking = count > 0;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(_head, tail) => {
          rest = tail;
          left = left - 1;
          walking = left > 0;
        },
      }
    };
    rest
  }

  /// The element at `index`, counting from zero, or nothing.
  pub fn nth(self, index: Int) -> Option<A> {
    if index < 0 { Option::None } else { List::head(self.drop(index)) }
  }

  /// The last element, or nothing.
  pub fn last(self) -> Option<A> {
    let mut answer = Option::None;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) => { answer = Option::Some(head); rest = tail; },
      }
    };
    answer
  }

  /// The elements `keep` accepts, in the order they were in.
  ///
  /// Inherent rather than a trait method, unlike `map`: `Functor` says how to
  /// change what is *in* a container, and dropping elements changes the
  /// container itself, which is why no lawful `Functor` has a `filter`. There
  /// is a class that does -- `Filterable` -- and one method is not a reason to
  /// introduce one.
  ///
  /// `filter` then `map` is two walks; `fold` is one, and is what to reach for
  /// when that matters.
  pub fn filter(self, keep: (A) -> Bool) -> List<A> {
    let mut kept = List::Nil;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) => {
          if keep(head) { kept = List::Cons(head, kept); };
          rest = tail;
        },
      }
    };
    kept.reverse()
  }
}

// ---------------------------------------------------------------------------
// Iteration
// ---------------------------------------------------------------------------

/// One step of an iteration: the next item and the rest, or the end.
///
/// Khora has no mutable references and no mutable fields, so Rust's
/// `fn next(&mut self) -> Option<Item>` is not expressible. An iterator hands
/// back its successor instead. `for` desugars to this and reads the same.
pub type Step<S, A> =
  | Yield(state: S, item: A)
  | Done;

/// Something a `for` loop can walk.
///
/// One method, and it hands back a successor rather than mutating: see `Step`
/// above for why that shape rather than Rust's. Implementing it is what makes
/// a type usable in `for`.
pub trait Iterator {
  /// What the iteration yields.
  type Item;
  /// The next item and the iterator that follows it, or `Done`.
  fn next(self) -> Step<Self, Self::Item>;
}

/// `Range::Of(from, to)` yields `from` up to but not including `to`.
pub type Range = | Of(from: Int, to: Int);

impl Iterator for Range {
  type Item = Int;
  fn next(self) -> Step<Range, Int> {
    match self {
      Range::Of(from, to) => if from >= to {
        Step::Done
      } else {
        Step::Yield(Range::Of(from + 1, to), from)
      },
    }
  }
}

/// `[a, b, c]`, which is how the literal is written.
///
/// Added because `derive(Show)` walks fields, and a record holding a `List`
/// could not derive one -- so the type people reach for by default was the
/// type that made a struct unprintable. The bound is on the element, so a list
/// of something unshowable is still unshowable, which is the honest answer.
impl<A: Show> Show for List<A> {
  fn show(self) -> String {
    "[" + List::show_rest(self, true) + "]"
  }
}

impl<A: Show> List<A> {
  /// The elements and their separators, without the brackets.
  ///
  /// `first` rather than checking the tail, because a list does not know where
  /// it ends until it gets there and looking ahead would walk it twice.
  fn show_rest(self, first: Bool) -> String {
    let mut out = "";
    let mut leading = first;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) => {
          let lead = if leading { "" } else { ", " };
          out = out + lead + Show::show(head);
          leading = false;
          rest = tail;
        },
      }
    };
    out
  }
}

/// Element by element, and length first where they differ in length.
impl<A: Eq> Eq for List<A> {
  fn eq(self, other: List<A>) -> Bool {
    let mut same = true;
    let mut mine = self;
    let mut theirs = other;
    let mut walking = true;
    while walking {
      match mine {
        // Mine ran out, so they are equal only if theirs did too. An empty
        // block would read as a record literal here, and `is_empty` is
        // constant time and says the same thing.
        List::Nil => { same = List::is_empty(theirs); walking = false; },
        List::Cons(head, tail) => match theirs {
          List::Nil => { same = false; walking = false; },
          List::Cons(other_head, other_tail) =>
          if Eq::eq(head, other_head) {
            mine = tail;
            theirs = other_tail;
          } else {
            same = false;
            walking = false;
          },
        },
      }
    };
    same
  }
}

impl<A: Eq> List<A> {
  /// Whether `wanted` is in the list.
  ///
  /// `A: Eq` rather than a predicate, because `contains` is the question
  /// somebody asks about a value they are holding -- `List::any` is already
  /// there for the predicate.
  pub fn contains(self, wanted: A) -> Bool {
    let mut found = false;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) =>
        if Eq::eq(head, wanted) { found = true; walking = false; } else { rest = tail; },
      }
    };
    found
  }
}

impl<A> List<A> {
  /// Each element's list, laid end to end.
  ///
  /// `map` and then a flatten, written as one pass because the intermediate
  /// list of lists is the only thing the two-step version allocates that
  /// nobody wants.
  pub fn flat_map<B>(self, step: (A) -> List<B>) -> List<B> {
    let mut out = List::Nil;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) => {
          // Reversed onto the accumulator, so the whole thing is reversed once
          // at the end rather than concatenated at every step.
          out = List::reverse_onto(step(head), out);
          rest = tail;
        },
      }
    };
    out.reverse()
  }

  /// Pairs, one from each, stopping at the shorter.
  ///
  /// **Stopping rather than padding**, because there is nothing to pad a
  /// `List<A>` with: `A` is any type and this library has no notion of a
  /// default. A caller who wants the tail of the longer one still has it.
  pub fn zip<B>(self, other: List<B>) -> List<Pair<A, B>> {
    let mut out = List::Nil;
    let mut mine = self;
    let mut theirs = other;
    let mut walking = true;
    while walking {
      match mine {
        List::Nil => { walking = false; },
        List::Cons(head, tail) => match theirs {
          List::Nil => { walking = false; },
          List::Cons(other_head, other_tail) => {
            out = List::Cons({ key: head, value: other_head }, out);
            mine = tail;
            theirs = other_tail;
          },
        },
      }
    };
    out.reverse()
  }
}

impl List<Int> {
  /// Every element added together. Empty is zero.
  ///
  /// `Int` only, and deliberately: a `sum` over anything addable wants a
  /// `Monoid`, and `std::core` has `Functor` and `Applicative` and not that
  /// one yet. Naming the concrete case is honest; a half-general one would
  /// have to be taken back.
  pub fn sum(self) -> Int {
    let mut total = 0;
    let mut rest = self;
    let mut walking = true;
    while walking {
      match rest {
        List::Nil => { walking = false; },
        List::Cons(head, tail) => { total = total + head; rest = tail; },
      }
    };
    total
  }
}

impl<A> Iterator for List<A> {
  type Item = A;
  fn next(self) -> Step<List<A>, A> {
    match self {
      List::Nil => Step::Done,
      List::Cons(h, t) => Step::Yield(t, h),
    }
  }
}

// ---------------------------------------------------------------------------
// Abstracting over containers
// ---------------------------------------------------------------------------

/// A container whose contents can be replaced one for one.
///
/// **Higher-kinded**: `Self` is applied to a type here rather than being one,
/// which is what lets a single `map` serve `Option`, `List` and everything
/// else with a shape. `docs/vision.md` names this as a non-negotiable, and it
/// is the thing Rust's trait system cannot say.
pub trait Functor {
  /// Every element replaced by `f` of it, in the same shape.
  fn map<A, B>(self: Self<A>, f: (A) -> B) -> Self<B>;
}

/// `pure` lifts a value; `map2` combines two containers. `map2` rather than
/// `ap` because `ap` would need a container of *functions*, and reading a
/// signature is easier than reading `Self<(A) -> B>`.
pub trait Applicative: Functor {
  /// One value, in the smallest container that can hold it.
  fn pure<A>(value: A) -> Self<A>;
  /// Two containers combined element-wise by `f`.
  ///
  /// What "combined" means is the instance's to decide: `Option` gives up if
  /// either is `None`, and a validation type would collect both failures.
  fn map2<A, B, C>(self: Self<A>, other: Self<B>, f: (A, B) -> C) -> Self<C>;
}

/// Walks a structure left to right, collecting the effects of each step.
///
/// This is the abstraction Rust cannot express and the reason higher-kinded
/// types are a non-negotiable in `docs/vision.md`: one `traverse` per
/// container serves every `Applicative`.
pub trait Traversable: Functor {
  /// `f` over every element, with the containers turned inside out.
  ///
  /// A `List<A>` and an `(A) -> Option<B>` give an `Option<List<B>>`: one
  /// answer for the whole walk rather than a list of answers. That inversion
  /// is the whole point — it is how "all of these, or the first reason not"
  /// is written once instead of per container.
  fn traverse<A, B, F: Applicative>(self: Self<A>, f: (A) -> F<B>) -> F<Self<B>>;
}

impl Functor for Option {
  fn map<A, B>(self: Option<A>, f: (A) -> B) -> Option<B> {
    match self {
      Option::Some(v) => Option::Some(f(v)),
      Option::None => Option::None,
    }
  }
}

impl Applicative for Option {
  fn pure<A>(value: A) -> Option<A> { Option::Some(value) }
  fn map2<A, B, C>(self: Option<A>, other: Option<B>, f: (A, B) -> C) -> Option<C> {
    match self {
      Option::Some(a) => match other {
        Option::Some(b) => Option::Some(f(a, b)),
        Option::None => Option::None,
      },
      Option::None => Option::None,
    }
  }
}

impl Traversable for Option {
  fn traverse<A, B, F: Applicative>(self: Option<A>, f: (A) -> F<B>) -> F<Option<B>> {
    match self {
      Option::Some(v) => f(v).map(fn b => Option::Some(b)),
      Option::None => F::pure(Option::None),
    }
  }
}

impl Functor for List {
  fn map<A, B>(self: List<A>, f: (A) -> B) -> List<B> {
    match self {
      List::Nil => List::Nil,
      List::Cons(h, t) => List::Cons(f(h), t.map(f)),
    }
  }
}

impl Traversable for List {
  fn traverse<A, B, F: Applicative>(self: List<A>, f: (A) -> F<B>) -> F<List<B>> {
    match self {
      List::Nil => F::pure(List::Nil),
      List::Cons(h, t) => f(h).map2(t.traverse(f), fn (b, rest) => List::Cons(b, rest)),
    }
  }
}

// ---------------------------------------------------------------------------
// Effects — phase 4
// ---------------------------------------------------------------------------
//
// Everything below declares the shape of the effect system. None of it is
// implemented yet; the signatures are here so that the design is written down
// where it will live rather than only in a document.

/// Fails the test this is written in, if `condition` is false.
///
/// Only allowed inside a `test` block, and inside one it needs no `!`. Both
/// halves of that are deliberate: an assertion is the one place a reader of a
/// test already expects control to leave, it is written at every one of them,
/// and a test is not ordinary code. `docs/design/testing.md`.
pub fn assert(condition: Bool);

/// Writes a line to standard output.
///
/// Declared without a body, so it is an extern: the backend dispatches it on
/// the argument's type, because there is no prelude yet to declare three
/// differently-typed printers. It is not an effect, which it eventually should
/// be — writing to a console is exactly the sort of thing a capability is for.
pub fn print(value: String);

/// The empty type. A function whose return type is `Never` does not return
/// normally — it raises, diverges, or transfers control to a handler.
pub type Never;

/// Resource lifetimes.
///
/// A finalizer registered with a scope runs when the enclosing region ends,
/// however it ends: falling off the end, an early `return`, or a raise passing
/// through.
///
/// The operation takes only a thunk. A handler's fields are ordinary closures
/// and a closure is monomorphic, so an operation cannot be generic — and it
/// need not be: `acquire` below is an ordinary generic function that closes
/// over the value and the release, which is where the polymorphism belongs.
pub effect Scope {
  defer: (() -> ()) -> (),
}

/// A region, and the finalizers deferred to it.
///
/// The type is here rather than hidden because `scoped` is written in Khora
/// and has to name it. Reference counted like everything else — which is the
/// whole mechanism: releasing the last reference runs the finalizers, and the
/// paths that release a binding are already the paths a region has to end on.
pub type Region;

/// A fiber that acquires something wants it released by the scope that outlives
/// it, so a `Scope` has to be able to cross — which means the region behind it
/// does. `khora_region_defer` takes a lock for exactly this.
impl Share for Region {}

impl Region {
  /// A new region with nothing deferred into it.
  ///
  /// `scoped` is the way to reach one from ordinary code; this is what
  /// `scoped` calls. Opening one by hand means being responsible for the
  /// binding that ends it.
  pub fn open() -> Region;
  /// Registers `finalizer` to run when this region ends.
  ///
  /// **Reverse order**: the last deferred is the first run, so a finalizer may
  /// depend on one registered before it — a transaction rolled back before the
  /// connection it ran on is closed. Cleanup runs with cancellation held off,
  /// so a finalizer caused by a cancellation is not cut short by it.
  pub fn defer(self, finalizer: () -> ()) -> ();
  /// The region that ends when the program does, released by the entry point
  /// after `main` returns — on the failing path as well as the ordinary one.
  pub fn root() -> Region;
}

impl Scope {
  /// The outermost scope: the one that ends when the program does.
  ///
  /// An entry point has to get a `Scope` from somewhere, and there is nothing
  /// above it to ask. Everything else should take one rather than reach for
  /// this — a library that roots its own scope has decided its caller's
  /// lifetimes for it.
  pub fn root() -> Scope {
    let region = Region::root();
    handler for Scope { defer: fn f => Region::defer(region, f) }
  }
}

/// A running fiber, and the only way to wait for one or stop it.
///
/// Releasing a handle *joins*, so a fiber cannot outlive the binding that
/// holds it — on every path out, including a raise passing through. Put one in
/// a region and the region waits; put it in a block and the block does. That
/// is where structured concurrency comes from, and it needed nothing of its
/// own. `docs/design/fibers.md`.
pub type Fiber<A, 'er>;

/// A handle to a running fiber, and every operation on one is a message to the
/// runtime rather than a write to shared memory. Joining twice is joining once,
/// from either side.
impl<A, 'er> Share for Fiber<A, 'er> {}

impl<A: Share, 'er> Fiber<A, 'er> {
  /// Runs `body` on a fiber of its own.
  ///
  /// The thunk may fail, and a thunk that can is also one that can be
  /// *stopped*: a cancellation travels out on the same tagged return an error
  /// does, so a fiber with no error row has no channel to be interrupted on
  /// and runs to its end.
  ///
  /// `A` must be `Share` for the reason every value crossing a fiber must be:
  /// it is computed on one and read on another, so a thing that cannot be held
  /// twice cannot be an answer. `docs/design/sharing.md`.
  pub fn spawn(body: () -> A raises 'er) -> Fiber<A, 'er>;

  /// Waits for the fiber to finish, and answers what it answered.
  ///
  /// **A failure comes back out here, with its type.** If the fiber raised,
  /// so does this — the whole point of a fiber that returns a value is that
  /// the *caller* decides what a failure means, rather than the runtime
  /// printing a line nobody reads. Joining twice is joining once, and gets the
  /// answer twice.
  ///
  /// **`'r` is the row the body raised**, carried on the handle. That is what
  /// makes this pleasant rather than merely possible:
  ///
  /// ```khora
  /// let count = Fiber::join(Fiber::spawn(fn () => tally(rows)));
  /// //                                                  no `!`, it cannot fail
  ///
  /// let row = Fiber::join(worker)! catch {
  ///   DbError::Timeout => Row::empty(),      // by name, because the row is here
  /// };
  /// ```
  ///
  /// An erased handle would have needed a `!` on every join — including on a
  /// fiber that provably cannot fail — and `catch { _ => .. }` as the only
  /// arm. `docs/design/effect-survey.md` §3.1 records what that cost and why
  /// the row is on the type instead.
  pub fn join(self) -> A raises 'er;

  /// Waits for the fiber, and does not take its answer.
  ///
  /// **`join` is for the answer; this is for the ordering.** They are not the
  /// same wait, and the difference shows up on a fiber that was *cancelled*: a
  /// cancelled fiber has no answer, so a `join` has nothing to hand back and
  /// unwinds the joiner along with it. This one just waits. Reach for it when
  /// what you needed was "not before that finishes", which is most of the time
  /// a fiber is spawned for what it does rather than for what it computes.
  ///
  /// Letting the binding go waits too — that is where structured concurrency
  /// comes from — so this is for the case where the waiting has to happen at a
  /// particular line rather than at the end of a scope.
  pub fn wait(self) -> ();

  /// Asks the fiber to stop at its next cancellation point. Returns at once.
  pub fn cancel(self) -> ();

  /// Stops waiting for the fiber, and asks it to stop.
  ///
  /// **The valve, and there has to be one.** Every other way out of a handle
  /// waits: `join` waits, and so does letting the binding go, which is where
  /// structured concurrency comes from. That is right, and it is also how a
  /// program hangs — one finalizer that never returns holds its nursery, which
  /// holds its parent, up to `main`. `docs/design/scheduler.md` promises both
  /// bounded cancellation latency and that a nursery exit leaves every child
  /// stopped or joined, and those two are in tension exactly here.
  ///
  /// So: signal, and go. The fiber keeps running, its answer is dropped when
  /// it arrives, and a failure it reports afterwards is silent — the program
  /// said it was no longer listening. Without this, a `timeout` over a body
  /// with an uninterruptible tail is a lie: it would promise to return in half
  /// a second and then block on the tail.
  ///
  /// **It cancels as well as detaching**, because a detached fiber nobody asked
  /// to stop is a leak with a nicer name.
  pub fn detach(self) -> ();
}

/// A fixed number of elements, side by side.
///
/// Fixed because growing is a *library* question and this is the primitive one
/// is built out of: `{ mut items: Array<A>, mut len: Int }` is a vector, and
/// it can be written in Khora now that a field can be written.
///
/// Reading an element is a bounds check and a load — no call — because the
/// layout is a contract with the code generator rather than something the
/// runtime hides. What the runtime does own is allocation and release, both of
/// which need the length at run time.
pub type Array<A>;

impl<A> Array<A> {
  /// No elements at all.
  ///
  /// `new` needs a value to fill with and a generic container has none to give
  /// until something has been put in it, so without this there is no way to
  /// write down an empty `Array<A>` — `Array::new(0, fill)` still demands the
  /// `fill` it will never write. That gap is what `Vector<A>` is built on: its
  /// storage starts here and is allocated for real by the first `push`, which
  /// is also the first moment there is a value of `A` to fill with.
  pub fn empty() -> Array<A>;

  // @klint allow inconsistent-constructor
  /// `length` elements, every one of them `fill`.
  ///
  /// **The one place `std` disagrees with its own naming rule.** `new`
  /// means "an empty one of something that grows", and an array does
  /// neither -- `Array::empty` sits above this for the empty case.
  /// `Array::filled(length, fill)` is what the rule asks for, and
  /// renaming a published `std` signature is a compatibility decision
  /// rather than a style one. `docs/design/naming.md` records it.
  pub fn new(length: Int, fill: A) -> Array<A>;
  /// How many elements it has. Fixed at construction; nothing grows an array.
  pub fn length(self) -> Int;
  /// The element at `index`.
  ///
  /// An index outside the array stops the program and says which index and
  /// what length. Same reasoning as trapping on integer overflow: a program
  /// that runs off its own array is wrong, and reading whatever is next in
  /// memory is the least useful possible response.
  pub fn get(self, index: Int) -> A;
  /// Writes `value` at `index`, in place.
  ///
  /// **The one mutation in `core`**, and the reason `Array` is not `Share`:
  /// two fibers writing one array is a data race, so an array crosses into a
  /// fiber only inside a type that says it is safe. `docs/design/sharing.md`.
  ///
  /// An index outside the array stops the program, as `get` does.
  pub fn set(self, index: Int, value: A) -> ();

  /// Whether these bytes are well-formed UTF-8, and so whether
  /// `String::from_bytes` will accept them. Only an `Array<U8>` has an answer.
  pub fn is_utf8(self) -> Bool;

  /// The first `count` elements, copied.
  ///
  /// What a caller does with a buffer it only partly filled: a socket read
  /// says how many bytes arrived, and the rest of the buffer is not part of
  /// the message.
  pub fn prefix(self, count: Int) -> Array<A> {
    let length = Array::length(self);
    // Nothing to copy and — the part that used to trap — nothing to seed the
    // new array with. `Array::new` needs a value of `A`, and the only one to
    // hand is `self`'s first element, which an empty array does not have.
    // Returning `self` is exact: it is already the empty array of the right
    // type. `Array::empty` would serve now that it exists, and would allocate
    // a second header to say the same thing; this stays as it is.
    if length == 0 {
      self
    } else {
      let taken = if count < 0 { 0 } else if count > length { length } else { count };
      let out: Array<A> = Array::new(taken, Array::get(self, 0));
      let mut at = 0;
      while at < taken {
        Array::set(out, at, Array::get(self, at));
        at = at + 1;
      }
      out
    }
  }

  /// Lends the elements to `body` as a pointer and a count, for the duration
  /// of the call and no longer.
  ///
  /// This is how a buffer reaches a foreign function. The count is the number
  /// of *elements* — the same number `length` gives — so a body that wants
  /// bytes multiplies by the element's width itself.
  ///
  /// **The lifetime is the call, and that is the design rather than a
  /// limitation.** A plain `data(self) -> Ptr` would be a dangling pointer
  /// waiting to happen: the array is released at its last use, and that use
  /// would be the `data` call. No wider scope is right either — the innermost
  /// one is wrong for a pointer taken in one branch of an `if`, and the
  /// function's own is wrong for a loop, which would hold one buffer alive per
  /// iteration.
  ///
  /// Only an array of numbers can be lent. An `Array<A>` of Khora objects
  /// holds reference-counted pointers, and handing those across is the mistake
  /// the whole boundary exists to prevent. `docs/design/ffi.md`.
  pub fn with_data<B, 'ef, 'er>(self, body: (Ptr, Int) -> B with 'ef raises 'er) -> B
    with 'ef
    raises 'er;
}

/// Arithmetic that does not trap, and the bits underneath it.
///
/// Ordinary `+`, `-` and `*` **stop the program** when they do not fit: a
/// program that passes its tests and then wraps in production is the failure
/// worth a branch to prevent. These are how you ask for the other behaviour in
/// the places that genuinely want it — a hash, a checksum, a pseudo-random
/// number — by name, so that the trap stays the default without being in the
/// way.
///
/// Methods rather than operators for now. `^`, `&`, `|`, `<<` and `>>` are five
/// new tokens and `>>` has to be told apart from the end of two nested type
/// arguments; none of that is hard and none of it is what a hash was waiting
/// for.
impl Int {
  pub fn wrapping_add(self, other: Int) -> Int;
  pub fn wrapping_sub(self, other: Int) -> Int;
  pub fn wrapping_mul(self, other: Int) -> Int;
  pub fn xor(self, other: Int) -> Int;
  pub fn and(self, other: Int) -> Int;
  pub fn or(self, other: Int) -> Int;
  pub fn shl(self, other: Int) -> Int;
  /// Arithmetic, so a negative number stays negative. A logical shift is what
  /// `Int` cannot express and what an unsigned fixed-width type will.
  pub fn shr(self, other: Int) -> Int;
}

// --- text ------------------------------------------------------------------
//
/// What `split_once` found: the text before the separator, and everything
/// after it.
pub type Split = {
  head: String,
  rest: String,
};
//
// All of it written in Khora, over `String::byte`, `Array<U8>` and
// `String::from_bytes`. Nothing here is an intrinsic, which is the point: if
// slicing a string needed the compiler's help, so would everything above it.

impl String {
  /// The bytes from `from` up to but not including `to`.
  ///
  /// **Byte indices, and no rounding.** A range that splits a character gives
  /// back bytes that are not text, and `from_bytes` stops the program rather
  /// than pretend — which is the honest failure for a caller who sliced by
  /// eye. Indices outside the string are clamped, because "the rest of it" is
  /// what every caller of `slice(i, byte_length(s))` means.
  /// The bytes from `from` up to `to`, clamped to what is there.
  ///
  /// **One allocation and one copy**, which is why it is a compiler intrinsic
  /// rather than the six lines it reads like. Written in Khora it went through
  /// an `Array<U8>` and `String::from_bytes`, so every slice was *two*
  /// allocations, *two* copies and a walk of the bytes to re-check that they
  /// were UTF-8 — 2,915 nanoseconds for eighty bytes. `String::split_once` is
  /// two slices and the request parser is a dozen splits, so this one function
  /// was most of what a server spent its time on.
  ///
  /// **Stops the program if the ends fall inside a character**, the same
  /// bargain `String::byte` makes about an index. The check is two byte reads
  /// rather than a walk: the input is already UTF-8, so the only way out of it
  /// is a cut through a multi-byte character, and that shows up as a
  /// continuation byte at one end or the other.
  pub fn slice(self, from: Int, to: Int) -> String;

  /// Where `needle` first occurs at or after `from`, counting in bytes, or
  /// **-1** if it is nowhere.
  ///
  /// **The one place in this library that answers with a sentinel**, and it
  /// earns it the way `String::byte` earns being able to stop the program:
  /// this is the bottom of the string library, `index_of` is one line above it
  /// and is what everything else calls. A search is the C library's `memmem`,
  /// which says -1, and turning that into an `Option` is work the compiler
  /// cannot do inside an intrinsic — so it is done here, once, in the open.
  ///
  /// `from` exists so that scanning a string does not mean copying it. Walking
  /// a header block by slicing off the front costs a copy of everything left
  /// over, once per header; searching from a cursor copies only the pieces
  /// that are kept.
  ///
  /// An empty needle is found at `from`, which is what every other language
  /// says and what stops `split_once` on an empty separator from running
  /// forever.
  pub fn find(self, needle: String, from: Int) -> Int;

  /// Where `needle` first occurs, or nothing.
  ///
  /// **A compiler intrinsic underneath**, and the reason is a measurement.
  /// Written as a loop over `String::byte` this took 3,180 nanoseconds to find
  /// a six-byte word in eighty bytes — a call and a bounds check per byte, at
  /// every candidate position. Bound to `memmem` but reaching it through
  /// `String::with_data` it still took 500, because the two nested closures
  /// that borrow the bytes are two heap allocations. Going straight to the
  /// runtime call is 40.
  ///
  /// That matters because this is the hottest thing in the request parser:
  /// `split_once` is built on it, and parsing one request is about eight
  /// searches.
  pub fn index_of(self, needle: String) -> Option<Int> {
    let found = String::find(self, needle, 0);
    if found < 0 { Option::None } else { Option::Some(found) }
  }

  pub fn matches_at(self, needle: String, at: Int) -> Bool {
    let count = String::byte_length(needle);
    let mut done = 0;
    let mut same = true;
    while done < count && same {
      if String::byte(self, at + done) == String::byte(needle, done) {
        done = done + 1;
      } else {
        same = false;
      }
    }
    same
  }

  pub fn starts_with(self, prefix: String) -> Bool {
    if String::byte_length(prefix) > String::byte_length(self) {
      false
    } else {
      String::matches_at(self, prefix, 0)
    }
  }

  /// Whether the text ends with `suffix`.
  pub fn ends_with(self, suffix: String) -> Bool {
    let length = String::byte_length(self);
    let wanted = String::byte_length(suffix);
    if wanted > length { false } else { String::matches_at(self, suffix, length - wanted) }
  }

  /// Whether `needle` occurs anywhere.
  ///
  /// The empty string is in everything, which is what `find` already answers
  /// and is the convention every library that has thought about it settled on:
  /// it is the identity of concatenation, and it is at position 0 of anything.
  pub fn contains(self, needle: String) -> Bool { String::find(self, needle, 0) >= 0 }

  /// Whether there are no bytes at all.
  pub fn is_empty(self) -> Bool { String::byte_length(self) == 0 }

  /// The text either side of the first `separator`, or `None` if it is absent.
  ///
  /// One split rather than a list of them, because a list wants an allocation
  /// per piece and every caller here wants the head and the rest. A record
  /// rather than a pair, because `.head` says which one it is and `.0` does
  /// not.
  /// The string without leading or trailing whitespace.
  ///
  /// Space, tab, carriage return and newline -- the four a line of text picks
  /// up on its way through a file or a socket. Not Unicode's full set of space
  /// characters: that list changes with the standard, and a `std` that
  /// silently trimmed a non-breaking space would be surprising in the other
  /// direction.
  ///
  /// The ends move inwards over the original bytes and only what survives is
  /// copied, so trimming nothing costs one slice and no allocation.
  pub fn trim(self) -> String {
    let length = String::byte_length(self);
    let mut start = 0;
    while start < length && String::is_space(String::byte(self, start)) {
      start = start + 1;
    }
    let mut end = length;
    while end > start && String::is_space(String::byte(self, end - 1)) {
      end = end - 1;
    }
    String::slice(self, start, end)
  }

  /// The string with `A`-`Z` written in lower case.
  ///
  /// **ASCII only, and deliberately.** Unicode case folding is locale
  /// dependent -- Turkish `I` lowercases to a dotless `ı`, and German `ß`
  /// upper-cases to two characters -- so a correct `lower` needs a locale and
  /// a table, and neither belongs in `core`. What this is for is comparing a
  /// header name or a file extension, where the input is ASCII by
  /// specification.
  ///
  /// Bytes outside `A`-`Z` are untouched, so text in any encoding passes
  /// through rather than being mangled.
  pub fn lower(self) -> String {
    let length = String::byte_length(self);
    let out: Array<U8> = Array::new(length, 0);
    let mut i = 0;
    while i < length {
      let c = U8::to_int(String::byte(self, i));
      let shifted = if c >= 65 && c <= 90 { c + 32 } else { c };
      Array::set(out, i, U8::of(shifted));
      i = i + 1;
    }
    String::from_bytes(out)
  }

  /// The same text with `a`-`z` shifted to `A`-`Z`.
  ///
  /// ASCII only, for the reason `lower` gives: a case mapping that is right
  /// for every script is a table that changes with the Unicode standard, and
  /// one that is right for *some* scripts silently is worse than one that is
  /// honest about being ASCII. Turkish dotless i is the example everybody
  /// learns this from.
  pub fn upper(self) -> String {
    let length = String::byte_length(self);
    let out: Array<U8> = Array::new(length, 0);
    let mut i = 0;
    while i < length {
      let c = U8::to_int(String::byte(self, i));
      let shifted = if c >= 97 && c <= 122 { c - 32 } else { c };
      Array::set(out, i, U8::of(shifted));
      i = i + 1;
    }
    String::from_bytes(out)
  }

  /// The text with leading whitespace removed.
  pub fn trim_start(self) -> String {
    let length = String::byte_length(self);
    let mut at = 0;
    while at < length && String::is_space(String::byte(self, at)) {
      at = at + 1;
    }
    String::slice(self, at, length)
  }

  /// The text with trailing whitespace removed.
  pub fn trim_end(self) -> String {
    let mut end = String::byte_length(self);
    while end > 0 && String::is_space(String::byte(self, end - 1)) {
      end = end - 1;
    }
    String::slice(self, 0, end)
  }

  /// Every piece between occurrences of `separator`, in order.
  ///
  /// **`n` separators give `n + 1` pieces, always**, which is the rule that
  /// makes splitting and joining inverses: `""` splits to one empty piece,
  /// `"a,"` splits to two of which the second is empty, and `join(split(s, x), x)`
  /// is `s` for every `s`. Dropping empty pieces is a filter the caller can
  /// write and cannot undo.
  ///
  /// An empty separator would match everywhere and split nothing, so it gives
  /// back the whole string as one piece rather than looping.
  pub fn split(self, separator: String) -> List<String> {
    if String::is_empty(separator) {
      List::Cons(self, List::Nil)
    } else {
      List::reverse(String::split_onto(self, separator, 0, List::Nil))
    }
  }

  /// `split`'s loop, building backwards from `at`.
  ///
  /// Backwards and then reversed, because prepending is the cheap end of a
  /// list and appending walks it once per piece — which turns splitting a
  /// thousand-field line into a million steps.
  fn split_onto(self, separator: String, at: Int, so_far: List<String>) -> List<String> {
    let found = String::find(self, separator, at);
    if found < 0 {
      List::Cons(String::slice(self, at, String::byte_length(self)), so_far)
    } else {
      let piece = String::slice(self, at, found);
      String::split_onto(
        self,
        separator,
        found + String::byte_length(separator),
        List::Cons(piece, so_far),
      )
    }
  }

  /// The pieces laid end to end with `separator` between them.
  ///
  /// The inverse of `split` for the same separator, which is the property that
  /// decides both. Written here rather than on `List` because it is about text
  /// and not about lists: a `List<Int>` has no join.
  pub fn join(pieces: List<String>, separator: String) -> String {
    match pieces {
      List::Nil => "",
      List::Cons(head, tail) => match tail {
        List::Nil => head,
        List::Cons(_h, _t) => head + separator + String::join(tail, separator),
      },
    }
  }

  /// Every occurrence of `from` replaced by `to`.
  ///
  /// **Left to right over the original**, so what `to` puts in is never
  /// searched again: replacing `"a"` with `"aa"` doubles each `a` once rather
  /// than looping. An empty `from` matches everywhere and changes nothing,
  /// which is the only answer that terminates.
  pub fn replace(self, from: String, to: String) -> String {
    if String::is_empty(from) {
      self
    } else {
      String::join(String::split(self, from), to)
    }
  }

  /// The text `count` times over. Below one is empty.
  pub fn repeat(self, count: Int) -> String {
    if count < 1 { "" } else { self + String::repeat(self, count - 1) }
  }

  /// Whether a byte is one of the four whitespace characters `trim` removes.
  pub fn is_space(byte: U8) -> Bool {
    byte == 32 || byte == 9 || byte == 13 || byte == 10
  }

  pub fn split_once(self, separator: String) -> Option<Split> {
    match String::index_of(self, separator) {
      Option::None => Option::None,
      Option::Some(at) => Option::Some({
          head: String::slice(self, 0, at),
          rest: String::slice(self, at + String::byte_length(separator), String::byte_length(self)),
        }),
    }
  }
}

/// The shortest text that reads back as the same number.
///
/// Bound rather than written: shortest-round-trip formatting is Ryū or Grisu,
/// a table and a thousand lines, and `docs/design/ecosystem.md` names exactly
/// this kind of thing as something to bind rather than write twice.
extern fn khora_float_text(value: Float, into: Ptr, capacity: Int) -> Int;

impl Float {
  /// The number, written out — `1.5`, `0.1`, `inf`.
  ///
  /// The shortest form that reads back as the same number, which is what a
  /// reader means by "the number" and what `print` on a `Float` already gives.
  /// Thirty-two bytes is always enough for a double; the call says how many it
  /// needed, so a longer answer would be caught rather than truncated.
  pub fn to_string(self) -> String {
    let out: Array<U8> = Array::new(32, 0);
    let written = Array::with_data(out, fn (into, n) => khora_float_text(self, into, n));
    if written > 32 { "?" } else { String::from_bytes(Array::prefix(out, written)) }
  }

  /// The whole part, with nothing rounded.
  ///
  /// **Truncates toward zero** — `2.9` is `2` and `-2.9` is `-2` — which is
  /// what every machine's "convert to integer" does, and what C, Rust and Go
  /// all mean by it. Rounding is a different question with four defensible
  /// answers, so it gets a different function when somebody needs one.
  ///
  /// A number too large for an `Int` clamps to the nearest end, and a `NaN` is
  /// zero. Undefined behaviour is the alternative and is not one.
  pub fn to_int(self) -> Int;
}

/// The most negative `Int`, which has no literal.
///
/// `9223372036854775808` does not fit, and the minus arrives after the number
/// has been read — so the only way to write it down is to walk to it. Wanted
/// by `Int::of_string`, which counts downward so that this number is one it
/// can reach.
fn smallest_int() -> Int { 0 - 9223372036854775807 - 1 }

impl Int {
  /// The number a string spells, or nothing.
  ///
  /// An `Option` rather than a trap, because the text almost always came from
  /// outside — an environment variable, a header, a path segment, a form field
  /// — and "somebody typed it wrong" is a thing to answer with a 400 rather
  /// than to stop the program over.
  ///
  /// Leading `-` and nothing else: no `+`, no underscores, no spaces, no
  /// hexadecimal. A parser that accepts more than the caller expected is how a
  /// configuration value ends up meaning something nobody wrote.
  ///
  /// **Refuses rather than overflows.** `*` and `+` trap in this language, so
  /// a long enough run of digits would have stopped the program — which for
  /// text off a socket is a denial of service with extra steps. The running
  /// total is checked before it is grown instead.
  ///
  /// That check used to be a digit short. It compared the total against a
  /// tenth of the maximum and let an equal one through, so
  /// `"9223372036854775808"` — one past the largest `Int`, and the shape of a
  /// number somebody fat-fingered into a form — grew past the end and stopped
  /// the program, which is the exact thing the paragraph above promises it
  /// does not do.
  ///
  /// **The total is counted downward**, which is the second fix and the reason
  /// the guard is written against `smallest_int` rather than a largest one.
  /// Every `Int` has a negative twin and not every one has a positive twin:
  /// building `9223372036854775808` on the way to `-9223372036854775808` is
  /// how the most negative number becomes unreadable, and it was.
  pub fn of_string(text: String) -> Option<Int> {
    let length = String::byte_length(text);
    let negative = length > 0 && U8::to_int(String::byte(text, 0)) == 45;
    let start = if negative { 1 } else { 0 };
    if start >= length {
      Option::None
    } else {
      let floor = smallest_int();
      let mut at = start;
      let mut total = 0;
      let mut ok = true;
      while at < length {
        let digit = U8::to_int(String::byte(text, at)) - 48;
        // Exactly the room one more digit needs, rather than a tenth and a
        // hope: `total * 10 - digit` stays an `Int` if and only if this holds.
        if digit < 0 || digit > 9 || total < (floor + digit) / 10 {
          ok = false;
          at = length;
        } else {
          total = total * 10 - digit;
          at = at + 1;
        }
      };
      if !ok {
        Option::None
      } else if negative {
        Option::Some(total)
      } else if total == floor {
        // The magnitude fits going down and does not coming back up: this is
        // `9223372036854775808` written without a sign.
        Option::None
      } else {
        Option::Some(0 - total)
      }
    }
  }

  /// The same number as a `Float`.
  ///
  /// Exact up to 2^53 and rounded beyond it, which is IEEE's business rather
  /// than Khora's.
  pub fn to_float(self) -> Float;

  /// The number, written out.
  ///
  /// Needed by anything that puts a number in a message — a `Content-Length`,
  /// a status line, a log — and written here rather than in the runtime
  /// because it is four lines of Khora and a good test of whether they are
  /// pleasant to write.
  /// **The most negative `Int` prints**, which took a second attempt. Taking
  /// its magnitude with `0 - self` overflows — that is the whole peculiarity
  /// of the number — so it stopped the program instead, reporting a
  /// subtraction the caller never wrote. A `Decimal` at that significand could
  /// be built, compared and added, and not shown.
  ///
  /// The digits are walked on whichever side of zero the number is already on,
  /// so nothing is ever negated.
  pub fn to_string(self) -> String {
    if self == 0 {
      "0"
    } else if self < 0 {
      "-" + Int::below_zero(self, "")
    } else {
      Int::digits(self, "")
    }
  }

  /// `self`'s digits, most significant first, accumulated from the least.
  fn digits(self, tail: String) -> String {
    let here = Int::digit(self % 10);
    if self < 10 { here + tail } else { Int::digits(self / 10, here + tail) }
  }

  /// The same, for a negative `self`, without ever making it positive.
  ///
  /// `self % 10` is in `-9..=0` here, so negating *that* is safe where
  /// negating the number is not.
  fn below_zero(self, tail: String) -> String {
    let here = Int::digit(0 - (self % 10));
    if self > 0 - 10 { here + tail } else { Int::below_zero(self / 10, here + tail) }
  }

  fn digit(self) -> String {
    let out: Array<U8> = Array::new(1, 0);
    // `0` is 48, and the digits are consecutive.
    Array::set(out, 0, U8::of(48 + self));
    String::from_bytes(out)
  }
}

/// An opaque machine address: a C `void *`.
///
/// **Not counted, not dereferenceable, and never a pointer into Khora's own
/// heap.** It exists so a foreign library can hand back a handle — a `FILE *`,
/// an `SSL_CTX *` — and be given it again later. Nothing in the language turns
/// a Khora value into one, which is what makes a dangling `Ptr` impossible:
/// every pointer that exists came from the other side, and its lifetime is
/// that side's business.
///
/// Lending a *buffer* across is the harder question and this type deliberately
/// does not answer it. `docs/design/ffi.md`.
pub type Ptr;

impl Ptr {
  /// The null pointer, for the libraries that take one.
  pub fn null() -> Ptr;

  /// Whether this is null — which is how a great many C functions say they
  /// failed.
  pub fn is_null(self) -> Bool;
}

/// A string's bytes.
///
/// **Length and index are both in bytes**, and say so in their names. A
/// `String` is UTF-8, so a character is one to four of these, and a `length`
/// that quietly meant one of the two would be wrong for half its callers and
/// silent about which half. Anything that wants characters wants a decoder,
/// which is a library on top of this rather than a different meaning for the
/// same word.
impl String {
  /// How many bytes the string occupies. Not how many characters it has.
  pub fn byte_length(self) -> Int;

  /// The byte at `index`, counting from zero. Out of range stops the program,
  /// the same as an array.
  pub fn byte(self, index: Int) -> U8;

  /// The same bytes, as a `String`.
  ///
  /// **Stops the program if they are not UTF-8.** The same bargain `get` makes
  /// about an index: the check exists — `Array::is_utf8` — and calling this
  /// without it is the mistake. An `Option` was the alternative and would put
  /// the decision in the wrong place, because what to *do* about bytes that
  /// are not text depends entirely on where they came from.
  pub fn from_bytes(bytes: Array<U8>) -> String;

  /// A copy of the bytes.
  ///
  /// A copy rather than a view, because a string is immutable and an array is
  /// not — a view would let one be edited through the other.
  pub fn bytes(self) -> Array<U8>;

  /// Lends the bytes to `body` as a pointer and a length, for the duration of
  /// the call and no longer.
  ///
  /// Lends the bytes to `body` as a `const char *`: the same bytes with a
  /// zero after them, which is how every function in the C library finds the
  /// end of a string.
  ///
  /// A copy, necessarily — a Khora string knows its length instead of carrying
  /// a terminator, and there is nowhere to append one to a borrowed view. The
  /// copy lives exactly as long as the call.
  ///
  /// A string with a zero inside it is not refused: C will see a shorter
  /// string than Khora has, which is what C strings are.
  pub fn with_c_string<B, 'ef, 'er>(self, body: (Ptr) -> B with 'ef raises 'er) -> B
    with 'ef
    raises 'er;

  /// See `Array::with_data`, which is the same thing and carries the argument
  /// for why the lifetime is a call rather than anything wider.
  pub fn with_data<B, 'ef, 'er>(self, body: (Ptr, Int) -> B with 'ef raises 'er) -> B
    with 'ef
    raises 'er;
}

// --- The fixed-width integers ----------------------------------------------
//
// A table, and it reads like one. Seven types, each with the same ten
// operations, because `Int` alone cannot describe a byte and a byte is what
// every file, socket and string is made of. `docs/design/numbers.md`.
//
// `I64` is not here: it is a second spelling of `Int`, so `impl Int` above is
// its impl too. Two different 64-bit signed integers would mean a conversion
// between them that can never fail and never does anything.
//
// Every conversion goes through `Int` — `U8::of` and `U8::to_int` rather than
// a method for each of the forty-two ordered pairs. `U8` to `U32` is two
// steps, which is more to type and never wrong.

/// An unsigned byte: 0 to 255.
///
/// The one every other type here is in service of — a wire format, a file and
/// a string are all made of these.
impl U8 {
  /// The same number as a `U8`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  pub fn of(value: Int) -> U8;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  pub fn wrapping(value: Int) -> U8;

  /// Every `U8` is an `Int`, so this cannot fail and costs one
  /// instruction.
  pub fn to_int(self) -> Int;

  pub fn wrapping_add(self, other: U8) -> U8;
  pub fn wrapping_sub(self, other: U8) -> U8;
  pub fn wrapping_mul(self, other: U8) -> U8;
  pub fn xor(self, other: U8) -> U8;
  pub fn and(self, other: U8) -> U8;
  pub fn or(self, other: U8) -> U8;
  pub fn shl(self, other: U8) -> U8;
  /// Logical, because the type is unsigned: the vacated bits are zeros
  /// and a large value stays large.
  pub fn shr(self, other: U8) -> U8;
}

/// An unsigned 16-bit integer: 0 to 65,535.
impl U16 {
  /// The same number as a `U16`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  pub fn of(value: Int) -> U16;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  pub fn wrapping(value: Int) -> U16;

  /// Every `U16` is an `Int`, so this cannot fail and costs one
  /// instruction.
  pub fn to_int(self) -> Int;

  pub fn wrapping_add(self, other: U16) -> U16;
  pub fn wrapping_sub(self, other: U16) -> U16;
  pub fn wrapping_mul(self, other: U16) -> U16;
  pub fn xor(self, other: U16) -> U16;
  pub fn and(self, other: U16) -> U16;
  pub fn or(self, other: U16) -> U16;
  pub fn shl(self, other: U16) -> U16;
  /// Logical, because the type is unsigned: the vacated bits are zeros
  /// and a large value stays large.
  pub fn shr(self, other: U16) -> U16;
}

/// An unsigned 32-bit integer: 0 to 4,294,967,295.
impl U32 {
  /// The same number as a `U32`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  pub fn of(value: Int) -> U32;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  pub fn wrapping(value: Int) -> U32;

  /// Every `U32` is an `Int`, so this cannot fail and costs one
  /// instruction.
  pub fn to_int(self) -> Int;

  pub fn wrapping_add(self, other: U32) -> U32;
  pub fn wrapping_sub(self, other: U32) -> U32;
  pub fn wrapping_mul(self, other: U32) -> U32;
  pub fn xor(self, other: U32) -> U32;
  pub fn and(self, other: U32) -> U32;
  pub fn or(self, other: U32) -> U32;
  pub fn shl(self, other: U32) -> U32;
  /// Logical, because the type is unsigned: the vacated bits are zeros
  /// and a large value stays large.
  pub fn shr(self, other: U32) -> U32;
}

/// An unsigned 64-bit integer: 0 to 18,446,744,073,709,551,615.
///
/// The only type here that holds numbers `Int` cannot, which is why it is the
/// only one whose `to_int` can stop the program.
impl U64 {
  /// The same number as a `U64`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  pub fn of(value: Int) -> U64;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  pub fn wrapping(value: Int) -> U64;

  /// `Int` cannot hold every `U64`, so this stops the program above
  /// `Int`'s maximum. `U64::wrapping_to_int` is how to reinterpret the bits
  /// instead.
  pub fn to_int(self) -> Int;

  /// The same bits read as a signed `Int`, so a `U64` above `Int`'s maximum
  /// comes back negative rather than stopping.
  pub fn wrapping_to_int(self) -> Int;

  pub fn wrapping_add(self, other: U64) -> U64;
  pub fn wrapping_sub(self, other: U64) -> U64;
  pub fn wrapping_mul(self, other: U64) -> U64;
  pub fn xor(self, other: U64) -> U64;
  pub fn and(self, other: U64) -> U64;
  pub fn or(self, other: U64) -> U64;
  pub fn shl(self, other: U64) -> U64;
  /// Logical, because the type is unsigned: the vacated bits are zeros
  /// and a large value stays large.
  pub fn shr(self, other: U64) -> U64;
}

/// A signed 8-bit integer: -128 to 127.
impl I8 {
  /// The same number as a `I8`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  pub fn of(value: Int) -> I8;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  pub fn wrapping(value: Int) -> I8;

  /// Every `I8` is an `Int`, so this cannot fail and costs one
  /// instruction.
  pub fn to_int(self) -> Int;

  pub fn wrapping_add(self, other: I8) -> I8;
  pub fn wrapping_sub(self, other: I8) -> I8;
  pub fn wrapping_mul(self, other: I8) -> I8;
  pub fn xor(self, other: I8) -> I8;
  pub fn and(self, other: I8) -> I8;
  pub fn or(self, other: I8) -> I8;
  pub fn shl(self, other: I8) -> I8;
  /// Arithmetic, because the type is signed: a negative number stays
  /// negative.
  pub fn shr(self, other: I8) -> I8;
}

/// A signed 16-bit integer: -32,768 to 32,767.
impl I16 {
  /// The same number as a `I16`, or a stopped program if it does not fit.
  ///
  /// Explicit, like every conversion in Khora: there is no implicit narrowing
  /// anywhere, because a number that silently becomes a different number is
  /// found in production rather than in a test.
  pub fn of(value: Int) -> I16;

  /// The low bits of `value`, whatever they are. The way to ask for
  /// truncation by name, for the wire formats that mean it.
  pub fn wrapping(value: Int) -> I16;

