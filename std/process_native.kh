module std::process;

import std::core::{Array, List, Ptr};
import std::process::shell::{close_pipe, open_pipe, run};

//! Running another program.
//!
//! The last thing on the "not yet" list that a program needs before it can be
//! the thing that drives other things: a build script, a test runner, a
//! deployment step. Until this existed a Khora program could read a file, read
//! the clock and talk to a socket, and the one thing it could not do was ask
//! the machine it was already running on to do something.
//!
//! **A program and a list of arguments, and a shell only if you ask.**
//!
//! `run` and `output` name a program and hand it a `List<String>`. No shell
//! sees them, so a space, a quote, a `;` or a `&&` inside an argument is one
//! argument with punctuation in it — there is nothing left to reinterpret it.
//! An argument that came from a request, a file name or a database is safe to
//! pass, which is the whole reason this shape exists.
//!
//! `shell` is the other one, and it is spelled that way so nobody reaches for
//! it by accident. It hands a *command line* to `cmd.exe` or `/bin/sh` and
//! everything true of a line of shell is true of it — a pipeline works, a glob
//! expands, a redirect redirects, and a file name that came from somewhere
//! untrusted can end the command and start another one. Sometimes that is
//! exactly what a caller wants, and hiding it behind a name that does not say
//! so would be worse than not having it.
//!
//! The rule: **if any part of the command came from outside the program, it is
//! `run` or `output`.** If the whole line is a literal and wants a pipeline, it
//! is `shell`.
//!
//! This is what the earlier version of this module said was missing and could
//! not have: `system` and `popen` are all ISO C offers, and `CreateProcess`
//! takes a `STARTUPINFO` while `posix_spawn` wants a `posix_spawn_file_actions_t`
//! — neither reachable from Khora, because errata 35 says no struct crosses the
//! C ABI. They are reachable from the *runtime*, where Rust's
//! `std::process::Command` is one interface over both, so `khora_spawn_status`
//! and `khora_spawn_capture` are what the two safe operations call.
//!
//! **Still no quoting helper.** An `escaped(argument)` for the `shell` form
//! would be the obvious kindness and it would be a lie: `cmd.exe` and `sh`
//! disagree about backslashes, about carets, about what a quote inside a quote
//! means, and a helper that is subtly wrong on one host is worse than none
//! because it reads as though the problem is handled. A caller with untrusted
//! text has `run`.

// ---------------------------------------------------------------------------
// The interface
// ---------------------------------------------------------------------------

/// Why running something did not work.
///
/// Coarse, for the reason `std::fs`'s `IoError` is: `system` and `popen` report
/// failure as one number with no story attached, and inventing detail that the
/// C library never supplied would be inventing it.
///
/// `NotStarted` is the shell itself refusing to run — *not* "the command was
/// not found", which is a shell that started perfectly well and then exited
/// 127. `NotText` is a command that ran and printed bytes that are not UTF-8,
/// so there is no `String` to hand back; only the two operations that keep the
/// output -- [`Process::output`] and [`Process::shell`] -- can raise it, and
/// [`Process::run`], which keeps none, cannot. `Failed` is raised by
/// [`checked_output`] alone.
///
/// Note what is *not* here: a command that ran and exited non-zero. It ran.
/// Its status is the answer, and a caller who wanted that to be a failure says
/// so by calling [`checked_output`].
pub type ProcessError =
  | NotStarted(command: String)
  | NotText(command: String)
  | Failed(command: String, status: Int);

/// A finished command.
///
/// Both halves together because `popen` gives both for the price of one, and
/// the alternative — a `capture` that returns text and a caller who then wants
/// the status — is a caller running the command twice.
pub type Completed = {
  /// What the command exited with. Zero is the universal "it worked".
  status: Int,
  /// Everything it wrote to its standard output. Its standard *error* is not
  /// captured; it goes wherever this process's does, and a caller who wants it
  /// folded in writes `2>&1` on the end of the command themselves.
  text: String,
};

/// Permission to start another program.
///
/// The reason this is an effect and not two free functions is the reason every
/// other capability in `std` is one, and it is sharper here than most: "this
/// library may run arbitrary commands on your machine" is close to the largest
/// thing a dependency can ask for, and a `with { process: Process }` in a
/// signature is that sentence written where a reviewer will see it. A
/// dependency that does not carry the row cannot start anything, and nothing
/// it imports can either.
///
/// And it is a seam. A test that wanted to exercise a build driver used to
/// have the choice of really invoking a compiler or not testing the thing;
/// here it installs its own handler and the code under test cannot tell:
///
/// ```khora
/// with { process: handler for Process {
///   run: fn (program, arguments) => 0,
///   output: fn (program, arguments) => { status: 0, text: "v1.2.3" },
///   shell: fn command => { status: 0, text: "" },
/// } } {
///   check(version_reported_by("git"));
/// }
/// ```
///
/// Every operation, because a handler supplies the whole effect. The one this
/// example is about is `output`; `run` and `shell` are there because leaving
/// either out is not a smaller handler, it is not a handler.
///
/// That double is also where a test asserts what was *asked for* — capture the
/// command into a `Shared<List<String>>` and the test can say that the driver
/// built the command line it was supposed to, which is the assertion that
/// matters and the one a real subprocess makes impossible to write.
pub effect Process {
  /// Runs `program` with `arguments` and waits, giving what it exited with.
  ///
  /// **No shell.** Each argument crosses whole, so one containing a space, a
  /// quote or a `;` is one argument with punctuation in it. Whatever the
  /// program prints goes to this process's own output, unredirected.
  run: (String, List<String>) -> Int raises ProcessError,
  /// The same, keeping what the program wrote to its standard output.
  output: (String, List<String>) -> Completed raises ProcessError,
  /// Runs a line of *shell*, and everything true of a line of shell is true
  /// of it.
  ///
  /// Named for what it does rather than for what it is used for, because a
  /// caller reaching for it should have to write the word. `run` is the one
  /// for a command built out of anything that came from outside the program.
  shell: (String) -> Completed raises ProcessError,
}

impl Process {
  /// The real machine.
  pub fn real() -> Process {
    handler for Process {
      run: fn (program, arguments) => spawn_status(program, arguments)!,
      output: fn (program, arguments) => spawn_output(program, arguments)!,
      shell: fn command => capture_output(command)!,
    }
  }
}

/// What `command` printed, provided it succeeded.
///
/// The shape most callers actually mean. Reading a version number or a commit
/// hash out of a tool, the branch on the status is not interesting — either it
/// worked and there is text, or it did not and there is nothing useful to do
/// with whatever came out. Written once here rather than as the same three
/// lines at every call site, the way `std::env`'s `variable_or` is.
pub fn checked_output(program: String, arguments: List<String>) -> String
  with { process: Process }
  raises ProcessError
{
  let done = process.output(program, arguments)!;
  if done.status == 0 {
    done.text
  } else {
    raise ProcessError::Failed(program, done.status)
  }
}

// ---------------------------------------------------------------------------
// ISO C
// ---------------------------------------------------------------------------
//
// `fread` and nothing else. The three calls that are spelled differently per
// target live in `std::process::shell`, which is `process_windows.kh` or
// `process_posix.kh` depending on the build; reading bytes out of a `FILE *`
// is the same everywhere and so is here.

extern fn fread(into: Ptr, size: Int, count: Int, file: Ptr) -> Int;

// The runtime's spawn, which is `CreateProcess` or `posix_spawn` behind Rust's
// `std::process::Command`. Not ISO C, and that is why it is a runtime export
// rather than an `extern` binding: neither call can be made from here.
extern fn khora_spawn_status(buffer: Ptr, len: Int, count: Int) -> Int;
extern fn khora_spawn_capture(buffer: Ptr, len: Int, count: Int, out_status: Ptr) -> Int;
extern fn khora_spawn_take(into: Ptr, len: Int) -> ();

/// How much to ask the pipe for at a time.
///
/// A page. The number matters less than it looks: a short read is normal on a
/// pipe and the loop below is written for it, so this is the size of a buffer
/// rather than a promise about how output arrives.
fn chunk() -> Int { 4096 }

/// The program and its arguments as one NUL-separated buffer, program first.
///
/// What the runtime wants, and the shape is the platform's own: `execve` takes
/// NUL-terminated strings, so an argument containing a NUL is not expressible
/// on any target this runs on and splitting on one loses nothing that could
/// have been passed.
fn packed(program: String, arguments: List<String>) -> Array<U8> {
  let parts = List::Cons(program, arguments);
  // `Array::new` fills with zero, so every separator is already there and
  // only the argument bytes have to be written.
  let out: Array<U8> = Array::new(packed_size(parts, 0), 0);
  let _end = fill(out, parts, 0);
  out
}

/// The bytes `packed` needs: every argument and a separator after each.
fn packed_size(parts: List<String>, so_far: Int) -> Int {
  match parts {
    List::Nil => so_far,
    List::Cons(head, tail) => packed_size(tail, so_far + String::byte_length(head) + 1),
  }
}

/// Writes each argument at `at`, leaving the zero between them alone.
///
/// **Byte by byte rather than through a joined string**, because Khora has no
/// escape for a NUL: `"\u{0}"` is five characters beginning with a backslash,
/// and the first version of this built a buffer with that in it between every
/// argument. It type-checked, it ran, and every command failed to start.
fn fill(out: Array<U8>, parts: List<String>, at: Int) -> Int {
  match parts {
    List::Nil => at,
    List::Cons(head, tail) => {
      let length = String::byte_length(head);
      let mut i = 0;
      while i < length {
        Array::set(out, at + i, String::byte(head, i));
        i = i + 1;
      };
      fill(out, tail, at + length + 1)
    }
  }
}

/// How many arguments `packed` will describe.
fn packed_count(arguments: List<String>) -> Int { 1 + List::length(arguments) }

/// Runs a program with no shell, and gives its exit status.
fn spawn_status(program: String, arguments: List<String>) -> Int raises ProcessError {
  let buffer = packed(program, arguments);
  let status = Array::with_data(buffer, fn (at, size) =>
    khora_spawn_status(at, size, packed_count(arguments)));
  started(program, status)!
}

/// The same, keeping what the program printed.
///
/// Three calls to the runtime rather than one: the output's length is not
/// known until the child has finished, and generated code cannot allocate
/// against a length it has not been told. So the run answers the size, this
/// makes somewhere to put it, and `khora_spawn_take` fills it in.
fn spawn_output(program: String, arguments: List<String>) -> Completed raises ProcessError {
  let buffer = packed(program, arguments);
  let status: Array<U8> = Array::new(8, 0);
  let size = Array::with_data(buffer, fn (at, len) =>
    Array::with_data(status, fn (out, _n) =>
      khora_spawn_capture(at, len, packed_count(arguments), out)));
  if size < 0 {
    raise ProcessError::NotStarted(program)
  } else {
    let bytes: Array<U8> = Array::new(size, 0);
    Array::with_data(bytes, fn (into, _n) => khora_spawn_take(into, size));
    if Array::is_utf8(bytes) {
      { status: read_status(status), text: String::from_bytes(bytes) }
    } else {
      raise ProcessError::NotText(program)
    }
  }
}

/// The eight bytes `khora_spawn_capture` wrote, as the number they are.
///
/// Little-endian, which is every target this compiles for -- `docs/design/
/// targets.md` lists x86-64 and aarch64 and nothing else. A big-endian port
/// would find this and the assertion that says so.
fn read_status(bytes: Array<U8>) -> Int {
  let mut value = 0;
  let mut i = 7;
  while i >= 0 {
    value = Int::or(Int::shl(value, 8), U8::to_int(Array::get(bytes, i)));
    i = i - 1;
  };
  // Eight bytes of a signed status, read back as one.
  if value > 9223372036854775807 { 0 - 1 } else { value }
}

/// Turns "the shell would not start" into the error, and anything else into
/// the status it is.
fn started(command: String, status: Int) -> Int raises ProcessError {
  if status < 0 { raise ProcessError::NotStarted(command) } else { status }
}

fn capture_output(command: String) -> Completed raises ProcessError {
  let pipe = open_pipe(command);
  if Ptr::is_null(pipe) {
    raise ProcessError::NotStarted(command)
  } else {
    // Every path from here reaches `close_pipe` before it can raise, which is
    // why there is no `Region` around this the way `std::fs` has one: the
    // draining loop has no failure of its own to report, and the two questions
    // that can fail — was it a status, was it text — are both asked afterwards.
    // A `spawn` with more to go wrong in the middle will want the region.
    let bytes = drain(pipe);
    let status = started(command, close_pipe(pipe))!;
    if Array::is_utf8(bytes) {
      { status: status, text: String::from_bytes(bytes) }
    } else {
      raise ProcessError::NotText(command)
    }
  }
}

/// Everything the pipe has, read until it ends.
///
/// **A `while` loop and a buffer that doubles, not a recursion per chunk.**
/// The recursive version reads better and is a stack overflow with a size on
/// it: `String::slice` in `std::core` recursed once per byte and took the
/// process out at around nine kilobytes, which is less output than `dir`
/// produces. Output has no length known in advance — that is the difference
/// between a pipe and a file, and why `std::fs` can ask `ftell` how much to
/// allocate and this cannot — so the only two honest options are a cap or a
/// buffer that grows, and a cap on what another program is allowed to say is
/// not a decision this module gets to make.
fn drain(pipe: Ptr) -> Array<U8> {
  let scratch: Array<U8> = Array::new(chunk(), 0);
  let mut out: Array<U8> = Array::new(chunk(), 0);
  let mut filled = 0;
  let mut going = true;
  while going {
    let read = Array::with_data(scratch, fn (into, n) => fread(into, 1, n, pipe));
    if read <= 0 {
      // Zero is the end of the stream and a short read is not, so this is the
      // only thing that ends the loop. `fread` cannot distinguish end-of-file
      // from a failure without `ferror`, and for a pipe the two lead to the
      // same place: there is no more.
      going = false;
    } else {
      out = grown(out, filled + read);
      copy_into(scratch, out, read, filled);
      filled = filled + read;
    }
  }
  Array::prefix(out, filled)
}

/// `old` if it already has room for `needed` bytes, or a bigger copy of it.
///
/// Doubling, so that reading n bytes costs a linear number of copies overall.
/// Growing by one chunk each time would make a megabyte of output a quarter of
/// a million element copies, which is the accident that makes a subprocess
/// wrapper mysteriously slow on exactly the commands worth wrapping.
///
/// Answering "already big enough" with `old` itself rather than leaving the
/// test at the call site keeps the loop above to one statement per step: the
/// common case allocates nothing, and it is the same expression either way.
fn grown(old: Array<U8>, needed: Int) -> Array<U8> {
  let have = Array::length(old);
  if have >= needed {
    old
  } else {
    let mut size = have;
    while size < needed {
      size = size * 2;
    }
    let bigger: Array<U8> = Array::new(size, 0);
    copy_into(old, bigger, have, 0);
    bigger
  }
}

fn copy_into(from: Array<U8>, into: Array<U8>, count: Int, offset: Int) -> () {
  let mut i = 0;
  while i < count {
    Array::set(into, offset + i, Array::get(from, i));
    i = i + 1;
  }
}
