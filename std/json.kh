module std::json;

import std::core::{Array, List, Map, Option, Pair, Result, Show};

//! JSON, written in Khora.
//!
//! Nothing here is an intrinsic and nothing here is foreign: the encoder walks
//! bytes with `String::byte` and the parser is recursive descent over the same.
//! That is the point as much as the module is — if reading a config file needed
//! the compiler's help, so would every format above it.
//!
//! **Runs of ordinary text are copied with `String::slice`, never byte by
//! byte.** A lone continuation byte is not valid UTF-8, so `String::from_bytes`
//! on one stops the program; slicing at an escape is safe because every byte
//! JSON escapes is below 128 and so never appears inside a multi-byte
//! character. Getting that wrong is a crash on the first non-English string,
//! which is exactly the input nobody tests with.

/// A JSON value.
///
/// `Number` is a `Float` because that is what JSON has — the specification
/// says "number" and means a double, and a separate integer case would be a
/// distinction the format cannot round-trip. A caller who wants an `Int` asks
/// for one with `Float::to_int`.
pub type Json =
  | Null
  | Bool(value: Bool)
  | Number(value: Float)
  | Text(value: String)
  | Array(items: List<Json>)
  | Object(fields: Map<String, Json>);

/// Where the parser stopped and what it wanted there.
///
/// A record rather than a variant, because every failure has both halves and a
/// variant per expectation would be a list of the parser's internals. The
/// offset is in **bytes**, which is what `String::byte` counts and what a
/// caller can slice with.
pub type JsonError = {
  at: Int,
  expected: String,
};

/// Why a JSON value could not become the type a caller asked for.
///
/// Parsing and decoding are different failures. `JsonError` says the input was
/// not JSON; this says valid JSON had the wrong shape. `path` runs from the
/// outside in: `List::Cons("account", List::Cons("currency", List::Nil))`
/// identifies `account.currency`. Keeping it structured means an HTTP layer
/// can render it however its own API promises rather than scraping a message.
pub type DecodeError =
  | At(path: List<String>, expected: String, found: String);

/// A value that has one unambiguous JSON representation.
pub trait ToJson {
  /// This value as JSON. Cannot fail: a type either has a representation or
  /// does not implement this.
  fn to_json(self) -> Json;
}

/// A value that can be recovered from JSON, or explains where the shape
/// stopped agreeing.
///
/// A failure rather than an `Option`: absence and the wrong kind are different
/// facts to an API client, and a nested field has to retain its path.
pub trait FromJson {
  /// Reads a value back, or says where the shape stopped agreeing.
  fn from_json(value: Json) -> Self raises DecodeError;
}

/// Decodes as the type the surrounding expression asks for.
///
/// This is also the bridge used by generic container implementations: `A` is
/// a type parameter, while the trait function itself is selected from the
/// expected return type.
pub fn decode<A: FromJson>(value: Json) -> A raises DecodeError {
  FromJson::from_json(value)!
}

/// One field of an object, in the order `entries` happened to find it.
pub type Field = {
  name: String,
  value: Json,
};

/// One object member. Chiefly useful to generated encoders, and preferable to
/// making an otherwise context-free record literal guess that it is a `Field`.
pub fn member(name: String, value: Json) -> Field { { name: name, value: value } }

// ---------------------------------------------------------------------------
// Values and traits used by `derive(ToJson, FromJson)`
// ---------------------------------------------------------------------------

impl ToJson for Json {
  fn to_json(self) -> Json { self }
}

impl FromJson for Json {
  fn from_json(value: Json) -> Json raises DecodeError { value }
}

impl ToJson for String {
  fn to_json(self) -> Json { Json::Text(self) }
}

impl FromJson for String {
  fn from_json(value: Json) -> String raises DecodeError {
    match value {
      Json::Text(text) => text,
      other => raise wrong(other, "string"),
    }
  }
}

impl ToJson for Bool {
  fn to_json(self) -> Json { Json::Bool(self) }
}

impl FromJson for Bool {
  fn from_json(value: Json) -> Bool raises DecodeError {
    match value {
      Json::Bool(flag) => flag,
      other => raise wrong(other, "boolean"),
    }
  }
}

impl ToJson for Float {
  fn to_json(self) -> Json { Json::Number(self) }
}

impl FromJson for Float {
  fn from_json(value: Json) -> Float raises DecodeError {
    match value {
      Json::Number(number) => number,
      other => raise wrong(other, "number"),
    }
  }
}

impl ToJson for Int {
  fn to_json(self) -> Json { Json::Number(Int::to_float(self)) }
}

impl FromJson for Int {
  fn from_json(value: Json) -> Int raises DecodeError {
    match value {
      // The float's shortest round-tripping text has neither a fraction nor
      // an exponent exactly when it is an integer `Int::of_string` can hold.
      // Parsing that text also refuses overflow instead of relying on the
      // clamping semantics of `Float::to_int`.
      Json::Number(number) => match Int::of_string(Float::to_string(number)) {
        Option::Some(whole) => whole,
        Option::None => raise wrong(Json::Number(number), "whole number in the range of Int"),
      },
      other => raise wrong(other, "whole number in the range of Int"),
    }
  }
}

impl<A: ToJson> ToJson for Option<A> {
  fn to_json(self) -> Json {
    match self {
      Option::None => Json::Null,
      Option::Some(value) => value.to_json(),
    }
  }
}

impl<A: FromJson> FromJson for Option<A> {
  fn from_json(value: Json) -> Option<A> raises DecodeError {
    match value {
      Json::Null => Option::None,
      other => Option::Some(decode(other)!),
    }
  }
}

impl<A: ToJson> ToJson for List<A> {
  fn to_json(self) -> Json { Json::Array(to_json_items(self)) }
}

fn to_json_items<A: ToJson>(items: List<A>) -> List<Json> {
  match items {
    List::Nil => List::Nil,
    List::Cons(head, tail) => List::Cons(head.to_json(), to_json_items(tail)),
  }
}

impl<A: FromJson> FromJson for List<A> {
  fn from_json(value: Json) -> List<A> raises DecodeError {
    match value {
      Json::Array(items) => from_json_items(items, 0)!,
      other => raise wrong(other, "array"),
    }
  }
}

fn from_json_items<A: FromJson>(items: List<Json>, at: Int) -> List<A>
  raises DecodeError
{
  match items {
    List::Nil => List::Nil,
    List::Cons(head, tail) => {
      let decoded: A = decode(head)! catch {
        DecodeError::At(path, expected, found) =>
          raise DecodeError::At(List::Cons(Int::to_string(at), path), expected, found),
      };
      List::Cons(decoded, from_json_items(tail, at + 1)!)
    },
  }
}

/// Builds an object from fields in declaration order.
///
/// The map intentionally forgets that order, as every other object built by
/// this module does. This is exported because a derived impl lives in the
/// module that declared its type; it is useful to handwritten encoders too.
pub fn object(fields: List<Field>) -> Json {
  let out: Map<String, Json> = Map::new();
  put_fields(out, fields);
  Json::Object(out)
}

fn put_fields(out: Map<String, Json>, fields: List<Field>) -> () {
  match fields {
    List::Nil => (),
    List::Cons(field, rest) => {
      Map::insert(out, field.name, field.value);
      put_fields(out, rest)
    },
  }
}

/// Reads and decodes one required object field, retaining its path on failure.
pub fn field_as<A: FromJson>(value: Json, name: String) -> A raises DecodeError {
  match value {
    Json::Object(fields) => match Map::get(fields, name) {
      Option::None =>
        raise DecodeError::At(List::Cons(name, List::Nil), "present field", "missing"),
      Option::Some(found) => decode(found)! catch {
        DecodeError::At(path, expected, actual) =>
          raise DecodeError::At(List::Cons(name, path), expected, actual),
      },
    },
    other => raise wrong(other, "object"),
  }
}

/// The stable representation of a derived variant.
///
/// Every case, including a payload-free one, is adjacent-tagged in the same
/// shape: `{ "case": "Circle", "fields": [3] }`. Uniformity is more useful
/// than saving two punctuation marks on a unit case, and positional fields
/// work for both named and unnamed case payloads.
pub fn variant(case_name: String, fields: List<Json>) -> Json {
  object(List::Cons(
      { name: "case", value: Json::Text(case_name) },
      List::Cons({ name: "fields", value: Json::Array(fields) }, List::Nil)))
}

/// The case tag of a derived variant.
pub fn variant_case(value: Json) -> String raises DecodeError {
  field_as(value, "case")!
}

/// Checks the payload count before a generated constructor reads it.
pub fn variant_arity(value: Json, expected: Int) -> () raises DecodeError {
  let fields: List<Json> = field_as(value, "fields")!;
  let found = List::length(fields);
  if found == expected {
    ()
  } else {
    raise DecodeError::At(
      List::Cons("fields", List::Nil),
      Int::to_string(expected) + " field(s)",
      Int::to_string(found) + " field(s)")
  }
}

/// Decodes one positional payload of a derived variant.
pub fn variant_field<A: FromJson>(value: Json, wanted: Int) -> A raises DecodeError {
  let fields: List<Json> = field_as(value, "fields")!;
  match item_at(fields, wanted) {
    Option::None => raise DecodeError::At(
      List::Cons("fields", List::Cons(Int::to_string(wanted), List::Nil)),
      "present field",
      "missing"),
    Option::Some(found) => decode(found)! catch {
      DecodeError::At(path, expected, actual) => raise DecodeError::At(
        List::Cons("fields", List::Cons(Int::to_string(wanted), path)), expected, actual),
    },
  }
}

/// Reports a case tag no generated decoder recognizes.
pub fn unknown_variant<A>(found: String, expected: String) -> A raises DecodeError {
  raise DecodeError::At(List::Cons("case", List::Nil), expected, found)
}

fn item_at<A>(items: List<A>, wanted: Int) -> Option<A> {
  match items {
    List::Nil => Option::None,
    List::Cons(head, tail) =>
      if wanted == 0 { Option::Some(head) } else { item_at(tail, wanted - 1) },
  }
}

fn wrong(value: Json, expected: String) -> DecodeError {
  DecodeError::At(List::Nil, expected, kind(value))
}

fn kind(value: Json) -> String {
  match value {
    Json::Null => "null",
    Json::Bool(_) => "boolean",
    Json::Number(_) => "number",
    Json::Text(_) => "string",
    Json::Array(_) => "array",
    Json::Object(_) => "object",
  }
}

// ---------------------------------------------------------------------------
// Reaching into a value
// ---------------------------------------------------------------------------

impl Json {
  /// The field, if this is an object and it has one.
  ///
  /// The one accessor that earns its place twice over: reaching into an object
  /// is what almost every consumer of a parsed document does, and writing the
  /// `match` by hand at each step turns three levels of nesting into fifteen
  /// lines.
  pub fn field(self, name: String) -> Option<Json> {
    match self {
      Json::Object(fields) => Map::get(fields, name),
      _ => Option::None,
    }
  }

  /// The rest are one per shape, so that a caller can ask "is it what I
  /// expected" without a `match` whose other arms it does not care about.
  /// `Option` rather than a failure, because a document being the wrong shape
  /// is the caller's business to name — this module does not know what the
  /// field was for.
  pub fn text(self) -> Option<String> {
    match self { Json::Text(value) => Option::Some(value), _ => Option::None }
  }

  /// The number here, or `None` if this is something else.
  ///
  /// **No coercion**, as with `text`: the string `"3"` is not a number, and a
  /// library that read it as one would hide the day a client started quoting
  /// its integers.
  pub fn number(self) -> Option<Float> {
    match self { Json::Number(value) => Option::Some(value), _ => Option::None }
  }

  /// The boolean here, or `None`.
  pub fn boolean(self) -> Option<Bool> {
    match self { Json::Bool(value) => Option::Some(value), _ => Option::None }
  }

  /// The elements, if this is an array. `None` for anything else, including an
  /// object — a JSON array and a JSON object are different things.
  pub fn items(self) -> Option<List<Json>> {
    match self { Json::Array(items) => Option::Some(items), _ => Option::None }
  }

  /// Whether this is `null`, which is a question rather than a value.
  ///
  /// A JSON `null` and a missing field are different, and both are worth
  /// telling apart from a present value: `is_null` answers the first.
  pub fn is_null(self) -> Bool {
    match self { Json::Null => true, _ => false }
  }

  /// Every field of an object, or the empty list.
  ///
  /// **By name, not by the order the document wrote them.** A `Map` is a
  /// hash table and forgets the order its keys arrived in, so a parsed
  /// document cannot round-trip field-for-field whatever this does. That is
  /// the same trade every language whose JSON object is a hash makes — Go's
  /// `map[string]any`, Python before 3.7 — and it buys `field` in constant
  /// time, which is what consumers actually do with a document.
  ///
  /// What it *can* promise, and now does, is that the order is the **same
  /// every time**. Bucket order is not: it depends on how many keys there are
  /// and changes when the map grows, so two runs over the same document could
  /// print its fields differently. That makes a golden test over an encoded
  /// document impossible to write and a diff between two API responses
  /// unreadable, which is what this was reported for.
  ///
  /// Sorted rather than insertion order, because insertion order is the one
  /// thing a hash map genuinely cannot recover — keeping it would mean
  /// `Object` carrying a `List<Field>` beside the map, and paying for the
  /// order on every document whether or not anybody looks at it.
  pub fn entries(self) -> List<Field> {
    match self {
      Json::Object(fields) => sorted_fields(fields),
      _ => List::Nil,
    }
  }
}

/// Every field of an object, by name.
///
/// **Through `Map::entries` rather than the map's buckets.** This module used
/// to walk `fields.buckets` itself, with a note saying the fix was a
/// `Map::entries` in `std::core` and that this was the caller justifying one.
/// It exists now, so the coupling is gone.
///
/// `fold` rather than `map` to build the list, because `List::map` recurses
/// once per element and a document is whatever size it arrived as. The fold
/// reverses, which the sort settles anyway.
fn sorted_fields(fields: Map<String, Json>) -> List<Field> {
  let named = List::fold(Map::entries(fields), List::Nil, fn (out, pair) =>
    List::Cons({ name: pair.key, value: pair.value }, out));
  List::sort_by(named, fn (l, r) => l.name.cmp(r.name))
}

// ---------------------------------------------------------------------------
// Writing
// ---------------------------------------------------------------------------

/// The value, as JSON text.
///
/// Compact: no spaces and no newlines. Pretty-printing is a second function
/// when something wants one, rather than a flag that doubles every branch
/// below.
pub fn encode(value: Json) -> String {
  match value {
    Json::Null => "null",
    Json::Bool(flag) => if flag { "true" } else { "false" },
    Json::Number(number) => Float::to_string(number),
    Json::Text(text) => quote(text),
    Json::Array(items) => "[" + encoded_items(items, "") + "]",
    Json::Object(fields) => "{" + encoded_fields(sorted_fields(fields), "") + "}",
  }
}

impl Show for Json {
  fn show(self) -> String { encode(self) }
}

/// The separator goes *before* each element and starts empty, which is how a
/// comma lands between every pair and after none of them without a count.
fn encoded_items(items: List<Json>, separator: String) -> String {
  match items {
    List::Nil => "",
    List::Cons(head, tail) => separator + encode(head) + encoded_items(tail, ","),
  }
}

fn encoded_fields(fields: List<Field>, separator: String) -> String {
  match fields {
    List::Nil => "",
    List::Cons(head, tail) =>
      separator + quote(head.name) + ":" + encode(head.value) + encoded_fields(tail, ","),
  }
}

/// A string, quoted and escaped.
fn quote(text: String) -> String {
  "\"" + escaped(text, 0, 0) + "\""
}

/// Copies from `run` forward, emitting an escape wherever one is needed.
///
/// `run` is the start of the stretch that needs nothing; `at` is the cursor.
/// Everything between them is copied in one `slice` when the cursor reaches a
/// byte that has to be written differently, so ordinary text costs one copy per
/// escape rather than one per character.
fn escaped(text: String, run: Int, at: Int) -> String {
  if at >= String::byte_length(text) {
    String::slice(text, run, at)
  } else {
    match escape_for(U8::to_int(String::byte(text, at))) {
      Option::None => escaped(text, run, at + 1),
      Option::Some(escape) =>
        String::slice(text, run, at) + escape + escaped(text, at + 1, at + 1),
    }
  }
}

/// How a byte has to be written, or `None` if it stands for itself.
///
/// The short forms for the five JSON names them, and everything else below a
/// space goes out as `\u00XX` — a control character written literally is legal
/// in almost no parser and is the kind of output that fails only at the far
/// end. `/` is *not* escaped: JSON allows `\/` and nothing requires it, and
/// escaping it makes every URL in a document unreadable.
fn escape_for(byte: Int) -> Option<String> {
  if byte == 34 {
    Option::Some("\\\"")
  } else if byte == 92 {
    Option::Some("\\\\")
  } else if byte == 10 {
    Option::Some("\\n")
  } else if byte == 13 {
    Option::Some("\\r")
  } else if byte == 9 {
    Option::Some("\\t")
  } else if byte == 8 {
    Option::Some("\\b")
  } else if byte == 12 {
    Option::Some("\\f")
  } else if byte < 32 {
    Option::Some("\\u00" + hex_digit(byte / 16) + hex_digit(byte % 16))
  } else {
    Option::None
  }
}

/// One lowercase hex digit. Lowercase because `\u001f` is what every other
/// encoder writes, and a document that differs only in case reads as changed.
fn hex_digit(value: Int) -> String {
  byte_text(if value < 10 { 48 + value } else { 87 + value })
}

/// A single byte as text.
///
/// Only ever called with a byte below 128, where one byte is one character and
/// `from_bytes` cannot object.
fn byte_text(value: Int) -> String {
  let out: Array<U8> = Array::new(1, 0);
  Array::set(out, 0, U8::of(value));
  String::from_bytes(out)
}

// ---------------------------------------------------------------------------
// Reading
// ---------------------------------------------------------------------------

/// What a parse step produced and where it stopped.
///
/// Three of these rather than one generic `Parsed<A>`, because a record with a
/// type parameter would be the same three fields with a longer name at every
/// use, and the parser never mixes them up.
type Value = { json: Json, at: Int };
type Scanned = { text: String, at: Int };
type Floated = { number: Float, at: Int };
type Items = { items: List<Json>, at: Int };
type Fields = { fields: Map<String, Json>, at: Int };

/// A whole document.
///
/// Trailing text is an error rather than ignored: `{"a":1} oops` is a mistake
/// somebody wants told about, and a parser that stops at the first complete
/// value hides it.
pub fn parse(text: String) -> Result<Json, JsonError> {
  match value_at(text, skip_space(text, 0)) {
    Result::Err(why) => Result::Err(why),
    Result::Ok(found) => {
      let end = skip_space(text, found.at);
      if end >= String::byte_length(text) {
        Result::Ok(found.json)
      } else {
        Result::Err({ at: end, expected: "the end of the document" })
      }
    },
  }
}

fn value_at(text: String, at: Int) -> Result<Value, JsonError> {
  if at >= String::byte_length(text) {
    Result::Err({ at: at, expected: "a value" })
  } else {
    let byte = U8::to_int(String::byte(text, at));
    if byte == 110 {
      word_at(text, at, "null", Json::Null)
    } else if byte == 116 {
      word_at(text, at, "true", Json::Bool(true))
    } else if byte == 102 {
      word_at(text, at, "false", Json::Bool(false))
    } else if byte == 34 {
      match string_at(text, at) {
        Result::Err(why) => Result::Err(why),
        Result::Ok(found) => Result::Ok({ json: Json::Text(found.text), at: found.at }),
      }
    } else if byte == 91 {
      array_at(text, at)
    } else if byte == 123 {
      object_at(text, at)
    } else if byte == 45 || (byte >= 48 && byte <= 57) {
      number_at(text, at)
    } else {
      Result::Err({ at: at, expected: "a value" })
    }
  }
}

/// `null`, `true` or `false`, matched whole.
fn word_at(text: String, at: Int, word: String, value: Json) -> Result<Value, JsonError> {
  let end = at + String::byte_length(word);
  if String::slice(text, at, end) == word {
    Result::Ok({ json: value, at: end })
  } else {
    Result::Err({ at: at, expected: word })
  }
}

fn skip_space(text: String, at: Int) -> Int {
  if at >= String::byte_length(text) {
    at
  } else {
    let byte = U8::to_int(String::byte(text, at));
    // The four JSON calls whitespace, and no others: a vertical tab between
    // two values is a malformed document rather than a formatting choice.
    if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
      skip_space(text, at + 1)
    } else {
      at
    }
  }
}

// --- strings ---------------------------------------------------------------

/// A quoted string, starting at its opening quote.
fn string_at(text: String, at: Int) -> Result<Scanned, JsonError> {
  if at >= String::byte_length(text) || U8::to_int(String::byte(text, at)) != 34 {
    Result::Err({ at: at, expected: "a string" })
  } else {
    inside_at(text, at + 1, at + 1, "")
  }
}

/// The same run-copying as `escaped`, in the other direction.
fn inside_at(text: String, run: Int, at: Int, done: String) -> Result<Scanned, JsonError> {
  if at >= String::byte_length(text) {
    Result::Err({ at: at, expected: "a closing quote" })
  } else {
    let byte = U8::to_int(String::byte(text, at));
    if byte == 34 {
      Result::Ok({ text: done + String::slice(text, run, at), at: at + 1 })
    } else if byte == 92 {
      let so_far = done + String::slice(text, run, at);
      match escape_at(text, at + 1) {
        Result::Err(why) => Result::Err(why),
        Result::Ok(found) => inside_at(text, found.at, found.at, so_far + found.text),
      }
    } else {
      inside_at(text, run, at + 1, done)
    }
  }
}

/// What one escape stands for, given the position just past its backslash.
fn escape_at(text: String, at: Int) -> Result<Scanned, JsonError> {
  if at >= String::byte_length(text) {
    Result::Err({ at: at, expected: "an escape" })
  } else {
    let byte = U8::to_int(String::byte(text, at));
    if byte == 34 {
      Result::Ok({ text: "\"", at: at + 1 })
    } else if byte == 92 {
      Result::Ok({ text: "\\", at: at + 1 })
    } else if byte == 47 {
      Result::Ok({ text: "/", at: at + 1 })
    } else if byte == 110 {
      Result::Ok({ text: "\n", at: at + 1 })
    } else if byte == 114 {
      Result::Ok({ text: "\r", at: at + 1 })
    } else if byte == 116 {
      Result::Ok({ text: "\t", at: at + 1 })
    } else if byte == 98 {
      // Khora's own string literals have no `\b` or `\f`, so these two are
      // built from their byte rather than written.
      Result::Ok({ text: byte_text(8), at: at + 1 })
    } else if byte == 102 {
      Result::Ok({ text: byte_text(12), at: at + 1 })
    } else if byte == 117 {
      unicode_at(text, at + 1)
    } else {
      Result::Err({ at: at, expected: "one of \" \\ / b f n r t u" })
    }
  }
}

/// `\uXXXX`, and the surrogate pair that follows it when there is one.
///
/// A pair is not optional to support: JSON has no other way to write a
/// character outside the basic plane, so a parser that stops at the first half
/// cannot read an emoji — and refusing it while claiming to read JSON would be
/// the wrong kind of honest.
fn unicode_at(text: String, at: Int) -> Result<Scanned, JsonError> {
  match hex4(text, at) {
    Option::None => Result::Err({ at: at, expected: "four hex digits" }),
    Option::Some(first) =>
      if first >= 55296 && first <= 56319 {
        // A high surrogate. The low half has to be the very next escape.
        if String::slice(text, at + 4, at + 6) == "\\u" {
          match hex4(text, at + 6) {
            Option::None => Result::Err({ at: at + 6, expected: "four hex digits" }),
            Option::Some(second) =>
              if second >= 56320 && second <= 57343 {
                let joined = 65536 + (first - 55296) * 1024 + (second - 56320);
                Result::Ok({ text: utf8_of(joined), at: at + 10 })
              } else {
                Result::Err({ at: at + 6, expected: "the low half of a surrogate pair" })
              },
          }
        } else {
          Result::Err({ at: at + 4, expected: "the low half of a surrogate pair" })
        }
      } else if first >= 56320 && first <= 57343 {
        Result::Err({ at: at, expected: "a character, not a low surrogate on its own" })
      } else {
        Result::Ok({ text: utf8_of(first), at: at + 4 })
      },
  }
}

/// Four hex digits as a number, or `None` if they are not four hex digits.
fn hex4(text: String, at: Int) -> Option<Int> {
  if at + 4 > String::byte_length(text) {
    Option::None
  } else {
    hex_run(text, at, 4, 0)
  }
}

fn hex_run(text: String, at: Int, left: Int, acc: Int) -> Option<Int> {
  if left == 0 {
    Option::Some(acc)
  } else {
    match hex_value(U8::to_int(String::byte(text, at))) {
      Option::None => Option::None,
      Option::Some(digit) => hex_run(text, at + 1, left - 1, acc * 16 + digit),
    }
  }
}

fn hex_value(byte: Int) -> Option<Int> {
  if byte >= 48 && byte <= 57 {
    Option::Some(byte - 48)
  } else if byte >= 97 && byte <= 102 {
    Option::Some(byte - 87)
  } else if byte >= 65 && byte <= 70 {
    Option::Some(byte - 55)
  } else {
    Option::None
  }
}

/// A code point, as its UTF-8 bytes.
///
/// Written out rather than bound, because the encoding is four lines of
/// shifting and the alternative is a foreign call for something that has no
/// platform in it.
fn utf8_of(point: Int) -> String {
  if point < 128 {
    byte_text(point)
  } else if point < 2048 {
    two_bytes(192 + Int::shr(point, 6), 128 + Int::and(point, 63))
  } else if point < 65536 {
    three_bytes(
      224 + Int::shr(point, 12),
      128 + Int::and(Int::shr(point, 6), 63),
      128 + Int::and(point, 63),
    )
  } else {
    four_bytes(
      240 + Int::shr(point, 18),
      128 + Int::and(Int::shr(point, 12), 63),
      128 + Int::and(Int::shr(point, 6), 63),
      128 + Int::and(point, 63),
    )
  }
}

fn two_bytes(first: Int, second: Int) -> String {
  let out: Array<U8> = Array::new(2, 0);
  Array::set(out, 0, U8::of(first));
  Array::set(out, 1, U8::of(second));
  String::from_bytes(out)
}

fn three_bytes(first: Int, second: Int, third: Int) -> String {
  let out: Array<U8> = Array::new(3, 0);
  Array::set(out, 0, U8::of(first));
  Array::set(out, 1, U8::of(second));
  Array::set(out, 2, U8::of(third));
  String::from_bytes(out)
}

fn four_bytes(first: Int, second: Int, third: Int, fourth: Int) -> String {
  let out: Array<U8> = Array::new(4, 0);
  Array::set(out, 0, U8::of(first));
  Array::set(out, 1, U8::of(second));
  Array::set(out, 2, U8::of(third));
  Array::set(out, 3, U8::of(fourth));
  String::from_bytes(out)
}

// --- numbers ---------------------------------------------------------------

/// A number: an optional sign, digits, an optional fraction, an optional
/// exponent.
///
/// Accumulated as a `Float` throughout, including the whole part. An `Int`
/// accumulator would be exact for small numbers and **stop the program** on a
/// long one, because `*` traps on overflow — and a parser that dies on input
/// it was handed is not a parser. A float saturates to infinity instead, which
/// is what the format says a number too large to represent becomes.
fn number_at(text: String, at: Int) -> Result<Value, JsonError> {
  let negative = U8::to_int(String::byte(text, at)) == 45;
  let start = if negative { at + 1 } else { at };
  let whole = digits_at(text, start, 0.0);
  if whole.at == start {
    Result::Err({ at: start, expected: "a digit" })
  } else {
    match fraction_at(text, whole.at, whole.number) {
      Result::Err(why) => Result::Err(why),
      Result::Ok(with_fraction) => match exponent_at(text, with_fraction.at, with_fraction.number) {
        Result::Err(why) => Result::Err(why),
        Result::Ok(done) => Result::Ok({
            json: Json::Number(if negative { 0.0 - done.number } else { done.number }),
            at: done.at,
          }),
      },
    }
  }
}

fn digits_at(text: String, at: Int, acc: Float) -> Floated {
  if at >= String::byte_length(text) {
    { number: acc, at: at }
  } else {
    let byte = U8::to_int(String::byte(text, at));
    if byte >= 48 && byte <= 57 {
      digits_at(text, at + 1, acc * 10.0 + Int::to_float(byte - 48))
    } else {
      { number: acc, at: at }
    }
  }
}

/// `.` followed by at least one digit, or nothing at all.
///
/// `1.` is refused. JSON's grammar requires a digit after the point, and
/// accepting it would mean this parser reads documents that others reject —
/// which is worse than strictness, because the difference shows up at the far
/// end of a pipeline.
fn fraction_at(text: String, at: Int, whole: Float) -> Result<Floated, JsonError> {
  if at < String::byte_length(text) && U8::to_int(String::byte(text, at)) == 46 {
    let found = digits_at(text, at + 1, 0.0);
    if found.at == at + 1 {
      Result::Err({ at: at + 1, expected: "a digit after the decimal point" })
    } else {
      let places = found.at - (at + 1);
      Result::Ok({ number: whole + found.number / power_of_ten(places), at: found.at })
    }
  } else {
    Result::Ok({ number: whole, at: at })
  }
}

fn exponent_at(text: String, at: Int, mantissa: Float) -> Result<Floated, JsonError> {
  if at >= String::byte_length(text) {
    Result::Ok({ number: mantissa, at: at })
  } else {
    let marker = U8::to_int(String::byte(text, at));
    if marker != 101 && marker != 69 {
      Result::Ok({ number: mantissa, at: at })
    } else {
      let sign = sign_at(text, at + 1);
      let found = digits_at(text, sign.at, 0.0);
      if found.at == sign.at {
        Result::Err({ at: sign.at, expected: "a digit in the exponent" })
      } else {
        // `to_int` clamps rather than trapping, so `1e999999999999999999` is a
        // large exponent rather than a stopped program.
        let places = Float::to_int(found.number);
        let scale = power_of_ten(places);
        Result::Ok({
            number: if sign.number < 0.0 { mantissa / scale } else { mantissa * scale },
            at: found.at,
          })
      }
    }
  }
}

/// `+`, `-`, or neither. `-1.0` and `1.0` stand for the sign so that the
/// caller can branch on a number rather than on a `Bool` it has to name.
fn sign_at(text: String, at: Int) -> Floated {
  if at >= String::byte_length(text) {
    { number: 1.0, at: at }
  } else {
    let byte = U8::to_int(String::byte(text, at));
    if byte == 45 {
      { number: 0.0 - 1.0, at: at + 1 }
    } else if byte == 43 {
      { number: 1.0, at: at + 1 }
    } else {
      { number: 1.0, at: at }
    }
  }
}

/// Ten to the `n`, saturating.
///
/// Capped at 400 because a double runs out at about 1e308 and every exponent
/// past that is the same infinity — without the cap a document could ask this
/// to recurse a billion times.
fn power_of_ten(n: Int) -> Float {
  if n <= 0 {
    1.0
  } else if n > 400 {
    power_of_ten(400)
  } else {
    10.0 * power_of_ten(n - 1)
  }
}

// --- arrays and objects ----------------------------------------------------

fn array_at(text: String, at: Int) -> Result<Value, JsonError> {
  let first = skip_space(text, at + 1);
  if first < String::byte_length(text) && U8::to_int(String::byte(text, first)) == 93 {
    Result::Ok({ json: Json::Array(List::Nil), at: first + 1 })
  } else {
    match items_at(text, first, List::Nil) {
      Result::Err(why) => Result::Err(why),
      Result::Ok(found) =>
      // Reversed because each item was prepended, which is the cheap end of a
      // list and the only one worth walking to.
        Result::Ok({ json: Json::Array(List::reverse(found.items)), at: found.at }),
    }
  }
}

fn items_at(text: String, at: Int, acc: List<Json>) -> Result<Items, JsonError> {
  match value_at(text, at) {
    Result::Err(why) => Result::Err(why),
    Result::Ok(found) => {
      let with_it = List::Cons(found.json, acc);
      let next = skip_space(text, found.at);
      if next >= String::byte_length(text) {
        Result::Err({ at: next, expected: "a comma or a closing bracket" })
      } else {
        let byte = U8::to_int(String::byte(text, next));
        if byte == 44 {
          items_at(text, skip_space(text, next + 1), with_it)
        } else if byte == 93 {
          Result::Ok({ items: with_it, at: next + 1 })
        } else {
          Result::Err({ at: next, expected: "a comma or a closing bracket" })
        }
      }
    },
  }
}

fn object_at(text: String, at: Int) -> Result<Value, JsonError> {
  let first = skip_space(text, at + 1);
  let empty: Map<String, Json> = Map::new();
  if first < String::byte_length(text) && U8::to_int(String::byte(text, first)) == 125 {
    Result::Ok({ json: Json::Object(empty), at: first + 1 })
  } else {
    match members_at(text, first, empty) {
      Result::Err(why) => Result::Err(why),
      Result::Ok(found) => Result::Ok({ json: Json::Object(found.fields), at: found.at }),
    }
  }
}

/// **A repeated key keeps the last one.** JSON does not say what should
/// happen, and every parser has to choose; last-wins is what a `Map` does for
/// free and what the majority of implementations do, so a document that
/// disagrees disagrees with them too.
fn members_at(text: String, at: Int, acc: Map<String, Json>) -> Result<Fields, JsonError> {
  match string_at(text, at) {
    Result::Err(why) => Result::Err(why),
    Result::Ok(name) => {
      let colon = skip_space(text, name.at);
      if colon >= String::byte_length(text) || U8::to_int(String::byte(text, colon)) != 58 {
        Result::Err({ at: colon, expected: "a colon" })
      } else {
        match value_at(text, skip_space(text, colon + 1)) {
          Result::Err(why) => Result::Err(why),
          Result::Ok(found) => {
            Map::insert(acc, name.text, found.json);
            let next = skip_space(text, found.at);
            if next >= String::byte_length(text) {
              Result::Err({ at: next, expected: "a comma or a closing brace" })
            } else {
              let byte = U8::to_int(String::byte(text, next));
              if byte == 44 {
                members_at(text, skip_space(text, next + 1), acc)
              } else if byte == 125 {
                Result::Ok({ fields: acc, at: next + 1 })
              } else {
                Result::Err({ at: next, expected: "a comma or a closing brace" })
              }
            }
          },
        }
      }
    },
  }
}
