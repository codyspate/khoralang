module std::permissions;

import std::core::{List, Option, Split};
import std::permissions::grants::{fs_read, fs_write};

//! What the manifest allows, as data the program carries.
//!
//! `[permissions]` in `khora.toml` says which paths a package may read and
//! write. The answer itself lives in `std::permissions::grants`, which
//! `khora build` writes; this module is the part that decides what an answer
//! means, and `std::fs`'s real handlers consult it before touching a file.
//!
//! **The grants are compiled in, not read at run time.** A file the program
//! consults for its own permissions is a file an attacker edits; a list the
//! compiler wrote into the binary is one nothing at run time can widen.
//! `docs/design/permissions.md`.
//!
//! # Why this is a file you can read rather than a check inside the compiler
//!
//! The compiler contributes *data*. Everything that decides whether a path is
//! allowed is here, in Khora, and can be read, tested and stepped through --
//! which is the whole reason the enforcement is not a pass in `khora-types`
//! that nobody outside the compiler can see. The design document is explicit
//! about it: "ordinary Khora in a module you can read, not a second
//! enforcement engine hidden in the compiler".
//!
//! # What it says when nothing is configured
//!
//! Everything. **A missing `[permissions]` table grants everything**, which is
//! opt-in tightening rather than a tax on starting -- the same bargain Rust
//! makes with `unsafe`. The default below is the one a program with no
//! manifest, or no `[permissions.fs]`, compiles with, and `khora build`
//! narrows it only when the manifest asks.

/// Whether any grant covers `path`.
///
/// The glob dialect is `.gitignore`'s, because it is the one everybody already
/// has in their fingers:
///
/// - `*` matches within one path segment and stops at a separator.
/// - `**` matches across separators, so `data/**` covers `data/a/b.txt` --
///   though not `data` itself, which is `.gitignore`'s reading too.
/// - Everything else matches itself.
///
/// Separators are normalized first, so a grant written with `/` covers a
/// Windows path spelled with `\\`. `granted_path` in `khora-manifest` answers
/// the same question for the compiler and the two have to agree; the tests
/// name the cases where agreement is not obvious.
pub fn granted(grants: List<String>, path: String) -> Bool {
  let wanted = normalized(path);
  List::fold(grants, false, fn (found, grant) =>
    found || matches(normalized(grant), wanted, true))
}

/// Whether any grant covers `name`.
///
/// For things that are not paths -- an environment variable, a command --
/// where there are no segments and so **`*` spans everything**. `DATABASE_*`
/// covers `DATABASE_URL`, and `*` covers all of them.
///
/// `granted_name` in `khora-manifest` answers the same question for the
/// compiler, and the two are tested against one table.
pub fn granted_name(grants: List<String>, name: String) -> Bool {
  List::fold(grants, false, fn (found, grant) => found || matches(grant, name, false))
}

/// Whether any grant covers `host`, which is `name` or `name:port`.
///
/// Two rules, and both are the reading that costs a newcomer least:
///
/// - **`*` spans dots**, so `*.internal` covers `db.eu.internal` and not only
///   `db.internal`. That is what a Content-Security-Policy origin means by it;
///   the one-label reading belongs to TLS certificates, and surprising
///   somebody into a denied connection is the worse failure.
/// - **A grant with no port covers every port**, which is what Deno's
///   `--allow-net=example.com` does. `:*` says the same thing explicitly.
pub fn granted_host(grants: List<String>, host: String) -> Bool {
  let asked = split_port(host);
  List::fold(grants, false, fn (found, grant) => found || host_matches(grant, asked))
}

/// One grant against one host.
fn host_matches(grant: String, asked: Split) -> Bool {
  let allowed = split_port(grant);
  let port_ok =
  String::byte_length(allowed.rest) == 0
  || allowed.rest == "*"
  || allowed.rest == asked.rest;
  port_ok && matches(allowed.head, asked.head, false)
}

/// `name:port` split at the **last** colon, with an empty `rest` for no port.
///
/// The last rather than the first, so an IPv6 literal keeps its colons in the
/// name where they belong. `Split` is reused rather than an `Option` because
/// the absent case is "no port", and an empty string says that without a
/// second shape to unwrap.
fn split_port(text: String) -> Split {
  match last_byte_of(text, String::byte_length(text) - 1, fn b => b == 58) {
    Option::None => { head: text, rest: "" },
    Option::Some(at) =>
    { head: String::slice(text, 0, at), rest: String::slice(text, at + 1, String::byte_length(text)) },
  }
}

/// One spelling of a path, so a grant and a request can be compared.
///
/// Two things are levelled, and both were reported as traps by somebody who
/// hit them:
///
/// - **`\\` becomes `/`**, so a grant written with forward slashes covers a
///   path Windows spelled with back ones.
/// - **A `.` segment is dropped**, so `./data/**` grants `data/foo.txt` and
///   `data/**` grants `./data/foo.txt`. Before this, the `./` was significant
///   on both sides: two readers of `capabilities.md` wrote the example's
///   `read = ["./data/**"]` into a manifest, opened `data/foo.txt`, and were
///   refused by a grant that looks like it says yes.
///
/// **`..` is deliberately not resolved.** Dropping `a/../b` to `b` is only
/// correct if `a` exists and is a directory rather than a link, which is a
/// question about the filesystem — and a normalizer that guessed would widen
/// a grant, which is the one direction a permission check must never be wrong
/// in. A path containing `..` is compared as written and will usually be
/// refused, which is the safe answer.
///
/// **Nor is anything resolved against a working directory or a package root.**
/// A grant is matched against the path the program passes, so a program that
/// builds its paths from its own arguments needs a grant wide enough to cover
/// what its users will type. `docs/design/permissions.md` records why that is
/// the boundary and what it costs a CLI.
pub fn normalized(path: String) -> String {
  without_dots(swap_byte(path, 0, ""))
}

/// `./a` and `a/./b` are `a` and `a/b`.
///
/// Rebuilt from the pieces rather than by replacing `/./`, because replacing
/// leaves `a/././b` half done — the second `/./` overlaps the first one's
/// output, which is the bug every string-replacing path cleaner has.
///
/// A path that is nothing but `.` stays `.`: it names the current directory,
/// and turning it into the empty string would make it match nothing rather
/// than what it says.
fn without_dots(path: String) -> String {
  let kept = List::filter(String::split(path, "/"), fn piece => !piece.eq("."));
  if List::is_empty(kept) { path } else { String::join(kept, "/") }
}

/// Rebuilds `text` with every `\\` written as `/`.
fn swap_byte(text: String, at: Int, acc: String) -> String {
  if at >= String::byte_length(text) {
    acc
  } else {
    let here = String::slice(text, at, at + 1);
    let next = if String::byte(text, at) == 92 { "/" } else { here };
    swap_byte(text, at + 1, "${acc}${next}")
  }
}

/// The index of the last byte `wanted` accepts, walking back from `at`.
///
/// Backwards because the caller wants the *last* colon, and `String::find`
/// only goes the other way. A private copy rather than a `String` method:
/// `std::fs` has the same three lines for the same reason, and two callers is
/// not yet an argument for widening `core`'s surface.
fn last_byte_of(text: String, at: Int, wanted: (U8) -> Bool) -> Option<Int> {
  if at < 0 {
    Option::None
  } else if wanted(String::byte(text, at)) {
    Option::Some(at)
  } else {
    last_byte_of(text, at - 1, wanted)
  }
}

/// Whether one pattern covers one value.
///
/// `segmented` is what a single `*` may not cross: `true` stops it at `/`, for
/// a path, and `false` lets it span anything, for a name or a host. `**` spans
/// regardless. This is `boundary: Option<char>` in `khora-manifest`'s `glob`,
/// spelled as the only two answers anybody passes.
fn matches(pattern: String, path: String, segmented: Bool) -> Bool {
  walk(pattern, 0, path, 0, segmented)
}

/// The matcher, as two cursors.
///
/// Written as explicit indices rather than by slicing, because slicing a
/// string builds one: a pattern of `n` characters against a path of `m` would
/// allocate on every step, and this is called on every file operation.
fn walk(pattern: String, p: Int, path: String, s: Int, segmented: Bool) -> Bool {
  let plen = String::byte_length(pattern);
  let slen = String::byte_length(path);
  if p >= plen {
    // The pattern is spent: it matched exactly when the path is too.
    s >= slen
  } else if is_double_star(pattern, p) {
    // `**` may consume anything, separators included. Try the shortest first
    // and grow, which terminates because the path is finite.
    let after = skip_double_star(pattern, p);
    any_suffix(pattern, after, path, s, segmented)
  } else if String::byte(pattern, p) == 42 {
    // A single `*` stops at a separator only where there are segments.
    if segmented {
      any_within_segment(pattern, p + 1, path, s, segmented)
    } else {
      any_suffix(pattern, p + 1, path, s, segmented)
    }
  } else if s < slen && String::byte(pattern, p) == String::byte(path, s) {
    walk(pattern, p + 1, path, s + 1, segmented)
  } else {
    false
  }
}

/// Whether `**` can be made to work by consuming `path` from `s` onwards.
fn any_suffix(pattern: String, after: Int, path: String, s: Int, segmented: Bool) -> Bool {
  if walk(pattern, after, path, s, segmented) {
    true
  } else if s >= String::byte_length(path) {
    false
  } else {
    any_suffix(pattern, after, path, s + 1, segmented)
  }
}

/// The same for a single `*`, which may not cross a separator.
fn any_within_segment(pattern: String, after: Int, path: String, s: Int, segmented: Bool) -> Bool {
  if walk(pattern, after, path, s, segmented) {
    true
  } else if s >= String::byte_length(path) || String::byte(path, s) == 47 {
    false
  } else {
    any_within_segment(pattern, after, path, s + 1, segmented)
  }
}

/// Whether the pattern has `**` at `p`.
fn is_double_star(pattern: String, p: Int) -> Bool {
  String::byte(pattern, p) == 42
  && p + 1 < String::byte_length(pattern)
  && String::byte(pattern, p + 1) == 42
}

/// Just past a `**`.
///
/// **The separator after it is not eaten**, and that is a decision rather than
/// an omission. Eating it would make `data/**` cover `data` itself; leaving it
/// means `data/**` covers what is *inside* `data`, which is what the same
/// pattern means in `.gitignore` and what `granted_path` in `khora-manifest`
/// already does. Two matchers answering one question have to agree, and the
/// compiler's is the one a manifest is checked against.
fn skip_double_star(_pattern: String, p: Int) -> Int {
  p + 2
}
