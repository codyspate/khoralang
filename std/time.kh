module std::time;

//! Dates and times as people write them, rather than as a machine counts them.
//!
//! `Clock` gives `unix_millis` and `monotonic_millis` and that is the whole of
//! time in `std` until this module. An instant is enough to measure something
//! and not enough to say when it happened: reconciliation is bucketed by value
//! date and settlement date, a report covers a month, and a log line is read by
//! somebody who wants to know what day it was. None of that is expressible in
//! milliseconds since 1970.
//!
//! # What is here and what is deliberately not
//!
//! The **types** are here — a civil date, a time of day, the two together, and
//! a fixed offset from UTC — because they are vocabulary. Two libraries that
//! disagree about what a date is cannot exchange one, and
//! [The ecosystem design note](https://github.com/codyspate/khoralang/blob/main/docs/design/ecosystem.md) reserves exactly that case for `std`.
//!
//! The **time zone database is not**, and cannot be. It is a dataset: Egypt
//! changes its rules, IANA cuts a release, and every binary already shipped is
//! wrong about the future. Nothing behind this document's compatibility promise
//! can be updated four times a year. So `std` owns `Offset` — the answer — and
//! a package or the host owns the rules that produce one.
//!
//! That is not a limitation dressed up. A program that stores UTC and renders
//! with an offset it was handed is correct forever; a program that bakes in
//! zone rules is wrong the next time a government moves a clock.
//!
//! # The proleptic Gregorian calendar, everywhere
//!
//! One calendar, extended backwards past its adoption, which is what ISO 8601
//! and every database mean by a date. Years before 1 are negative and year zero
//! exists — again ISO's convention, and the one that makes arithmetic work
//! without a special case nobody remembers.

import std::core::{Eq, Option, Ord, Ordering, Show};

/// A date on the proleptic Gregorian calendar.
///
/// `month` is 1 to 12 and `day` is 1 to the length of that month. Construct
/// through `Date::of`, which checks; the fields are public because a date is
/// its three numbers and hiding them would only mean writing three accessors.
pub type Date = {
  year: Int,
  month: Int,
  day: Int,
};

/// A time of day, to the millisecond.
///
/// **No leap seconds.** `second` is 0 to 59, and a minute is sixty seconds
/// here as it is in every database and every wire format worth naming. A
/// calendar that admitted 23:59:60 would push that into every comparison and
/// every subtraction to be correct about something almost nothing observes.
pub type Time = {
  hour: Int,
  minute: Int,
  second: Int,
  milli: Int,
};

/// A date and a time, with no zone attached.
///
/// **Not an instant.** "The fourteenth at nine in the morning" is a different
/// kind of thing from "one and a half billion seconds after 1970": one names a
/// position on a calendar and the other names a moment, and turning either
/// into the other needs an offset. Keeping them apart is what stops a program
/// silently treating local wall time as UTC — the mistake that puts a
/// midnight-boundary report a day out twice a year.
pub type DateTime = {
  date: Date,
  time: Time,
};

/// Minutes east of UTC.
///
/// `Offset::utc()` is zero, India is `+330`, and `-300` is New York in winter.
/// **A fixed number, not a zone**: a zone is a rule that says which offset
/// applies on a given date, and that rule is a dataset this module refuses to
/// carry. A caller gets one of these from a package or from the host and hands
/// it here.
pub type Offset = {
  minutes: Int,
};

/// Days in `month` of `year`, which is only interesting for February.
pub fn days_in_month(year: Int, month: Int) -> Int {
  if month == 2 {
    if is_leap(year) { 29 } else { 28 }
  } else if month == 4 || month == 6 || month == 9 || month == 11 {
    30
  } else {
    31
  }
}

/// Whether `year` has a twenty-ninth of February.
///
/// Divisible by four, except centuries, except every fourth century. The rule
/// is written out rather than looked up because it is three comparisons and
/// every reader can check it.
pub fn is_leap(year: Int) -> Bool {
  if year % 4 != 0 { false }
  else if year % 100 != 0 { true }
  else { year % 400 == 0 }
}

impl Date {
  /// A date, or `None` if there is no such day.
  ///
  /// The thirty-first of February is refused rather than rolled forward into
  /// March. Rolling is a policy — some systems clamp, some wrap, some raise —
  /// and a library that picked silently would be picking for a caller who
  /// nearly always has bad input rather than an interesting question.
  pub fn of(year: Int, month: Int, day: Int) -> Option<Date> {
    if month < 1 || month > 12 || day < 1 || day > days_in_month(year, month) {
      Option::None
    } else {
      Option::Some({ year: year, month: month, day: day })
    }
  }

  /// A date written `2026-08-25`, or `None`.
  ///
  /// Exactly four digits, two, two, hyphen-separated, and the day has to exist
  /// -- `2026-02-30` is `None` for the same reason `Date::of` refuses it. What
  /// `Show` prints, read back.
  pub fn of_string(text: String) -> Option<Date> {
    if String::byte_length(text) != 10 || !separated(text, 4, 45) || !separated(text, 7, 45) {
      Option::None
    } else {
      match digits(text, 0, 4) {
        Option::None => Option::None,
        Option::Some(year) => match digits(text, 5, 2) {
          Option::None => Option::None,
          Option::Some(month) => match digits(text, 8, 2) {
            Option::None => Option::None,
            Option::Some(day) => Date::of(year, month, day),
          },
        },
      }
    }
  }

  /// Days since the first of January 1970, which may be negative.
  ///
  /// Howard Hinnant's `days_from_civil`, which is the algorithm every modern
  /// date library uses: it is exact for the whole range of an `Int`, it needs
  /// no table, and its shifts of the year and month are what remove the leap
  /// day from the middle of the calculation by moving March to the start of
  /// the year.
  pub fn to_days(self) -> Int {
    let year = if self.month <= 2 { self.year - 1 } else { self.year };
    let era = if year >= 0 { year / 400 } else { (year - 399) / 400 };
    let year_of_era = year - era * 400;
    let shifted = if self.month > 2 { self.month - 3 } else { self.month + 9 };
    let day_of_year = (153 * shifted + 2) / 5 + self.day - 1;
    let day_of_era =
      year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year;
    era * 146097 + day_of_era - 719468
  }

  /// The date `days` after the first of January 1970.
  ///
  /// The inverse of `to_days`, and the other half of Hinnant's pair.
  pub fn of_days(days: Int) -> Date {
    let shifted = days + 719468;
    let era = if shifted >= 0 { shifted / 146097 } else { (shifted - 146096) / 146097 };
    let day_of_era = shifted - era * 146097;
    let year_of_era =
      (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365;
    let year = year_of_era + era * 400;
    let day_of_year =
      day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
    let month_shifted = (5 * day_of_year + 2) / 153;
    let day = day_of_year - (153 * month_shifted + 2) / 5 + 1;
    let month = if month_shifted < 10 { month_shifted + 3 } else { month_shifted - 9 };
    { year: if month <= 2 { year + 1 } else { year }, month: month, day: day }
  }

  /// The date `days` later, which may be earlier if `days` is negative.
  pub fn add_days(self, days: Int) -> Date {
    Date::of_days(Date::to_days(self) + days)
  }

  /// How many days from `self` to `other`, negative if `other` is earlier.
  pub fn days_until(self, other: Date) -> Int {
    Date::to_days(other) - Date::to_days(self)
  }

  /// Monday is 1 and Sunday is 7, which is ISO 8601's numbering.
  ///
  /// The first of January 1970 was a Thursday, which is where the 3 comes
  /// from: it is day zero and Thursday is 4, so the offset that lands Monday
  /// on 1 is three.
  pub fn weekday(self) -> Int {
    let shifted = (Date::to_days(self) + 3) % 7;
    if shifted < 0 { shifted + 8 } else { shifted + 1 }
  }
}

impl Time {
  /// A time of day, or `None` if there is no such moment.
  pub fn of(hour: Int, minute: Int, second: Int, milli: Int) -> Option<Time> {
    if hour < 0 || hour > 23 || minute < 0 || minute > 59
    || second < 0 || second > 59 || milli < 0 || milli > 999 {
      Option::None
    } else {
      Option::Some({ hour: hour, minute: minute, second: second, milli: milli })
    }
  }

  /// A time written `09:05:00` or `09:05:00.123`, or `None`.
  ///
  /// **The fraction is optional and everything else is not**, which is ISO
  /// 8601's own rule rather than a leniency: `HH:MM:SS` is a complete time and
  /// the fraction is an extension of it. `Show` always prints three digits, so
  /// what it writes reads back; what arrives from somewhere else usually has
  /// no fraction at all.
  ///
  /// More than three fractional digits are refused rather than rounded. This
  /// type holds milliseconds, and a library that silently dropped the
  /// microseconds off a timestamp would be losing data in a way nothing later
  /// could notice.
  pub fn of_string(text: String) -> Option<Time> {
    let length = String::byte_length(text);
    let fractional = if length == 8 { 0 } else { length - 9 };
    if (length != 8 && (length < 10 || length > 12))
    || !separated(text, 2, 58) || !separated(text, 5, 58)
    || (length != 8 && !separated(text, 8, 46)) {
      Option::None
    } else {
      match digits(text, 0, 2) {
        Option::None => Option::None,
        Option::Some(hour) => match digits(text, 3, 2) {
          Option::None => Option::None,
          Option::Some(minute) => match digits(text, 6, 2) {
            Option::None => Option::None,
            Option::Some(second) => match milliseconds(text, fractional) {
              Option::None => Option::None,
              Option::Some(milli) => Time::of(hour, minute, second, milli),
            },
          },
        },
      }
    }
  }

  /// Midnight.
  pub fn midnight() -> Time { { hour: 0, minute: 0, second: 0, milli: 0 } }

  /// Milliseconds since midnight.
  pub fn to_millis(self) -> Int {
    ((self.hour * 60 + self.minute) * 60 + self.second) * 1000 + self.milli
  }

  /// The time `millis` after midnight, which must be inside one day.
  pub fn of_millis(millis: Int) -> Time {
    {
      hour: millis / 3600000,
      minute: (millis / 60000) % 60,
      second: (millis / 1000) % 60,
      milli: millis % 1000,
    }
  }
}

impl Offset {
  /// No offset at all.
  pub fn utc() -> Offset { { minutes: 0 } }

  /// `minutes` east of UTC. Positive is ahead, negative is behind.
  pub fn of_minutes(minutes: Int) -> Offset { { minutes: minutes } }

  /// An offset written `+05:30`, `-05:00` or `Z`, or `None`.
  ///
  /// **`Z` is accepted although `Show` prints `+00:00`.** It is not a second
  /// format -- it is ISO 8601's own spelling of this exact value, and it is
  /// what every wire format in the world writes. Refusing it would mean a
  /// parser that cannot read the timestamps it is for.
  pub fn of_string(text: String) -> Option<Offset> {
    if text.eq("Z") {
      Option::Some(Offset::utc())
    } else {
      let sign = if String::starts_with(text, "-") { 0 - 1 } else { 1 };
      if String::byte_length(text) != 6
      || (!String::starts_with(text, "+") && !String::starts_with(text, "-"))
      || !separated(text, 3, 58) {
        Option::None
      } else {
        match digits(text, 1, 2) {
          Option::None => Option::None,
          Option::Some(hours) => match digits(text, 4, 2) {
            Option::None => Option::None,
            Option::Some(minutes) =>
              if hours > 23 || minutes > 59 {
                Option::None
              } else {
                Option::Some(Offset::of_minutes(sign * (hours * 60 + minutes)))
              },
          },
        }
      }
    }
  }
}

impl DateTime {
  /// The moment `millis` after 1970, as UTC says it.
  ///
  /// **Flooring, not truncating**, which is the whole of what makes dates
  /// before 1970 come out right: `-1` millisecond is the last millisecond of
  /// 1969, not the first of 1970 with a minus sign. Truncating division puts
  /// it a whole day out, and it is the bug this function exists to not have.
  pub fn of_unix_millis(millis: Int) -> DateTime {
    let day = 86400000;
    let days = if millis >= 0 { millis / day } else { (millis - (day - 1)) / day };
    let rest = millis - days * day;
    { date: Date::of_days(days), time: Time::of_millis(rest) }
  }

  /// Milliseconds since 1970, reading `self` as UTC.
  pub fn to_unix_millis(self) -> Int {
    Date::to_days(self.date) * 86400000 + Time::to_millis(self.time)
  }

  /// A timestamp written `2026-08-25T09:05:00` or `...T09:05:00.123`, or
  /// `None`.
  ///
  /// **No zone, because this type has none.** A trailing `Z` or `+05:30` is
  /// refused here rather than ignored -- silently dropping it would turn a
  /// moment into a different moment, which is the one mistake a date library
  /// must not make quietly. `DateTime::instant_of_string` reads the zoned form
  /// and gives back the instant it names.
  pub fn of_string(text: String) -> Option<DateTime> {
    match String::index_of(text, "T") {
      Option::None => Option::None,
      Option::Some(at) =>
        match Date::of_string(String::slice(text, 0, at)) {
          Option::None => Option::None,
          Option::Some(date) =>
            match Time::of_string(String::slice(text, at + 1, String::byte_length(text))) {
              Option::None => Option::None,
              Option::Some(time) => Option::Some({ date: date, time: time }),
            },
        },
    }
  }

  /// The instant a *zoned* timestamp names, as milliseconds since 1970.
  ///
  /// `2026-08-25T09:05:00Z`, `2026-08-25T09:05:00.123+05:30`. The zone is
  /// required: this is the function for reading what somebody else wrote, and
  /// a timestamp with no zone does not name an instant. Use `of_string` for
  /// that, which gives back the wall clock it actually is.
  ///
  /// An `Int` rather than a `DateTime` because that is what the moment *is* --
  /// converting it back to a wall clock needs a zone, and the caller has one
  /// in mind or they would not be asking.
  pub fn instant_of_string(text: String) -> Option<Int> {
    let length = String::byte_length(text);
    let split =
      if String::ends_with(text, "Z") {
        Option::Some(length - 1)
      } else {
        // The sign of an offset, which is the only `+` or `-` that can appear
        // after the date -- and the date's own hyphens are all before the `T`.
        match String::index_of(text, "T") {
          Option::None => Option::None,
          Option::Some(t) => {
            let plus = String::find(text, "+", t);
            let minus = String::find(text, "-", t);
            let at = if plus >= 0 { plus } else { minus };
            if at < 0 { Option::None } else { Option::Some(at) }
          }
        }
      };
    match split {
      Option::None => Option::None,
      Option::Some(at) =>
        match DateTime::of_string(String::slice(text, 0, at)) {
          Option::None => Option::None,
          Option::Some(when) =>
            match Offset::of_string(String::slice(text, at, length)) {
              Option::None => Option::None,
              Option::Some(offset) => Option::Some(DateTime::from_offset(when, offset)),
            },
        },
    }
  }

  /// The moment `seconds` after 1970, as UTC says it.
  ///
  /// Beside the millisecond pair because **a Unix timestamp is usually
  /// seconds**: that is what `extract(epoch)` gives, what a JSON API sends,
  /// and what a log line carries. Multiplying by a thousand at every call site
  /// is the kind of thing that is right until once it is not.
  pub fn of_unix_seconds(seconds: Int) -> DateTime {
    DateTime::of_unix_millis(seconds * 1000)
  }

  /// Seconds since 1970, reading `self` as UTC.
  ///
  /// **Floored, so a moment before 1970 rounds towards the past** and not
  /// towards zero. `-1` millisecond is second `-1`, which is the second that
  /// contains it, and truncating division would answer `0` -- a whole second
  /// on the wrong side of the epoch.
  pub fn to_unix_seconds(self) -> Int {
    let millis = DateTime::to_unix_millis(self);
    if millis >= 0 { millis / 1000 } else { (millis - 999) / 1000 }
  }

  /// The same moment, seen from `offset`.
  ///
  /// The one place a zone enters, and it enters as a number somebody else
  /// worked out.
  pub fn at_offset(millis: Int, offset: Offset) -> DateTime {
    DateTime::of_unix_millis(millis + offset.minutes * 60000)
  }

  /// Milliseconds since 1970, reading `self` as a wall clock at `offset`.
  pub fn from_offset(self, offset: Offset) -> Int {
    DateTime::to_unix_millis(self) - offset.minutes * 60000
  }
}

impl Eq for Date {
  fn eq(self, other: Date) -> Bool {
    self.year == other.year && self.month == other.month && self.day == other.day
  }
}

impl Ord for Date {
  fn cmp(self, other: Date) -> Ordering {
    let mine = Date::to_days(self);
    let theirs = Date::to_days(other);
    if mine < theirs { Ordering::Less }
    else if mine == theirs { Ordering::Equal }
    else { Ordering::Greater }
  }
}

impl Eq for Time {
  fn eq(self, other: Time) -> Bool {
    Time::to_millis(self) == Time::to_millis(other)
  }
}

impl Ord for Time {
  fn cmp(self, other: Time) -> Ordering {
    let mine = Time::to_millis(self);
    let theirs = Time::to_millis(other);
    if mine < theirs { Ordering::Less }
    else if mine == theirs { Ordering::Equal }
    else { Ordering::Greater }
  }
}

impl Show for Date {
  /// ISO 8601: `2026-08-25`. Zero-padded, because a date that is sometimes
  /// nine characters and sometimes ten does not sort as text and half the
  /// world sorts dates as text.
  fn show(self) -> String {
    padded(self.year, 4) + "-" + padded(self.month, 2) + "-" + padded(self.day, 2)
  }
}

impl Show for Time {
  /// ISO 8601: `09:05:00.000`. The milliseconds are always there, for the same
  /// reason the zeros are.
  fn show(self) -> String {
    padded(self.hour, 2) + ":" + padded(self.minute, 2) + ":" + padded(self.second, 2)
    + "." + padded(self.milli, 3)
  }
}

impl Show for DateTime {
  /// ISO 8601 with a `T`, and no zone — because there is none. A `Z` here
  /// would be a claim this type does not make.
  fn show(self) -> String {
    self.date.show() + "T" + self.time.show()
  }
}

impl Show for Offset {
  /// `+00:00`, `+05:30`, `-05:00`.
  fn show(self) -> String {
    let sign = if self.minutes < 0 { "-" } else { "+" };
    let magnitude = if self.minutes < 0 { 0 - self.minutes } else { self.minutes };
    sign + padded(magnitude / 60, 2) + ":" + padded(magnitude % 60, 2)
  }
}

/// The `width` digits at `at`, or `None` if any of them is not a digit.
///
/// Written here rather than reached for through `Int::of_string`, which
/// accepts a leading `-` and a string of any length: a fixed-width field that
/// silently took `-1` or `7` where two digits belong is how a parser stops
/// being strict without anybody deciding it should.
fn digits(text: String, at: Int, width: Int) -> Option<Int> {
  let mut i = 0;
  let mut total = 0;
  let mut ok = true;
  while i < width {
    let byte = U8::to_int(String::byte(text, at + i));
    if byte < 48 || byte > 57 {
      ok = false;
      i = width;
    } else {
      total = total * 10 + (byte - 48);
      i = i + 1;
    }
  };
  if ok { Option::Some(total) } else { Option::None }
}

/// Whether the byte at `at` is `expected`.
fn separated(text: String, at: Int, expected: Int) -> Bool {
  at < String::byte_length(text) && U8::to_int(String::byte(text, at)) == expected
}

/// The fraction after the `.`, as whole milliseconds.
///
/// One, two or three digits: `.1` is a hundred milliseconds and not one, which
/// is what a decimal fraction means and the mistake a right-to-left reader
/// makes. More than three is refused rather than rounded -- see `of_string`.
fn milliseconds(text: String, width: Int) -> Option<Int> {
  if width == 0 {
    Option::Some(0)
  } else if width > 3 {
    Option::None
  } else {
    match digits(text, 9, width) {
      Option::None => Option::None,
      Option::Some(value) =>
        Option::Some(if width == 1 { value * 100 } else { if width == 2 { value * 10 } else { value } }),
    }
  }
}

/// `value` as text, zero-padded to `width`, with any sign in front.
fn padded(value: Int, width: Int) -> String {
  let negative = value < 0;
  let magnitude = if negative { 0 - value } else { value };
  let digits = zeros(Int::to_string(magnitude), width);
  if negative { "-" + digits } else { digits }
}

/// `text` with leading zeros until it is `width` long.
fn zeros(text: String, width: Int) -> String {
  if String::byte_length(text) >= width { text } else { zeros("0" + text, width) }
}
