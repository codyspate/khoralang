module std::ai;

//! Model inference as a capability, and tensors whose shapes are checked.
//!
//! Two things that look unrelated and are the same argument. A program that
//! calls a model is a program that reaches the network, spends money and
//! returns something different every time, so `LLMService` is an effect and
//! the `with` clause says which functions can do it. A program that multiplies
//! two tensors is a program where a shape mismatch is discoverable before it
//! runs, so `Tensor` carries its device, its shape and its element type in
//! the type and `matmul` unifies the shared dimension.
//!
//! # What this is not
//!
//! **Not an implementation of anything.** There is no HTTP here, no tokenizer,
//! no BLAS. `docs/design/ecosystem.md` puts numeric kernels and vendor clients
//! in packages for the reason it puts database drivers there: what belongs in
//! `std` is the vocabulary two packages must agree on to exchange a value, and
//! the effect declaration that lets a caller say what it needs without naming
//! a provider.
//!
//! `extract` is the shape of the whole module. A caller writes
//! `let report: Report = extract(prompt)!` and `LLMService` never learns that
//! reports exist -- the handler answers `complete: Prompt -> String`, and
//! `Extract` turns that string into the type the call site asked for.

import std::core::{List, Option, Show};

/// Where a tensor's memory lives.
///
/// Carried in the type, so a program that multiplies a CPU tensor by a GPU one
/// is refused rather than copying silently. Provisional along with the rest of
/// this module.
export type Device =
  | Cpu
  | Cuda(device_id: Int)
  | Metal
  | Npu;

/// The kind of an element type: what may appear as a tensor's `T`.
///
/// A kind rather than a type — nothing is a value of `Scalar`. It exists so
/// that `Tensor<D, Shape, T>` can say what `T` is allowed to be.
export type Scalar;

/// The kind of a shape: what may appear as a tensor's `Shape`.
///
/// `(M, K)` is a value of this kind, not a value of any type. Matching two
/// shapes is ordinary unification, which is what makes a mismatched product a
/// type error.
export type Tuple;

/// Thirty-two-bit floating point, as an element type.
export type F32;

/// A tensor, with its device, its shape and its element type in the type.
///
/// **The shape is not a runtime field.** `Tensor<Cpu, (1536), F32>` and
/// `Tensor<Cpu, (768), F32>` are different types, so a dimension mismatch is
/// discovered by the checker rather than asserted at the first multiply. That
/// is the whole argument for this being in `std` while the kernels are not:
/// the vocabulary two packages must agree on is here, and the arithmetic is
/// somebody else's.
export type Tensor<D: Device, Shape: Tuple, T: Scalar>;

/// A one-dimensional CPU tensor of a known width.
///
/// The shape a vector database and an embedding model have to agree on, spelled
/// once: `Embedding<1536, F32>`.
export type Embedding<const Dim: Int, T: Scalar> = Tensor<Device::Cpu, (Dim), T>;

impl<D: Device, Shape: Tuple, T: Scalar> Tensor<D, Shape, T> {
  /// A tensor of the given shape, every element zero.
  ///
  /// The shape is passed as a value and read back as a type, which is what
  /// makes `Embedding<1536, F32>` and `Tensor::zeros((1536))` the same thing
  /// said twice. Provisional along with the rest of this module.
  export fn zeros(shape: Shape) -> Tensor<D, Shape, T>;
}

/// The matrix product, with the shared dimension checked by the type system.
///
/// `K` appears in both arguments, so it has to unify: an `(M, K)` times a
/// `(J, N)` does not compile, and no assertion runs to discover it. Declared
/// rather than implemented — `docs/design/ecosystem.md` puts the kernel in a
/// package.
export fn matmul<D: Device, const M: Int, const K: Int, const N: Int, T: Scalar>(
  a: Tensor<D, (M, K), T>,
  b: Tensor<D, (K, N), T>
) -> Tensor<D, (M, N), T>;

/// One turn of a conversation: who said it, and what they said.
///
/// `role` is text rather than a variant type deliberately. Providers disagree
/// about the set — `system`, `user`, `assistant`, `tool`, `developer` — and a
/// variant here would have to be widened by `std` every time one of them added
/// a word.
export type Message = {
  role: String,
  content: String,
};

/// What is sent to a model: standing instructions, a conversation, and how
/// much variation to allow.
///
/// Built by piping rather than by filling in a record, so a half-built prompt
/// is never a value anybody holds. See the `impl` below.
export type Prompt = {
  system_instructions: Option<String>,
  messages: List<Message>,
  temperature: Float,
};

/// Built by piping: `Prompt::new() |> Prompt::system(..) |> Prompt::user(..)`.
/// Each returns a new prompt rather than mutating one, so a half-built prompt
/// cannot be shared and then changed underneath its other holder.
impl Prompt {
  /// An empty prompt: no instructions, no messages, temperature one.
  export fn new() -> Prompt {
    { system_instructions: Option::None, messages: List::Nil, temperature: 1.0 }
  }

  /// Replaces the system instructions; the last one written wins.
  export fn system(self, instructions: String) -> Prompt {
    {
      system_instructions: Option::Some(instructions),
      messages: self.messages,
      temperature: self.temperature,
    }
  }

  /// Adds a turn from the person asking.
  export fn user(self, message: String) -> Prompt {
    Prompt::saying(self, "user", message)
  }

  /// Adds a turn from the model, which is how a conversation is replayed.
  export fn assistant(self, message: String) -> Prompt {
    Prompt::saying(self, "assistant", message)
  }

  /// Adds a turn under any role. `user` and `assistant` are this with the two
  /// roles every provider agrees on.
  export fn saying(self, role: String, content: String) -> Prompt {
    {
      system_instructions: self.system_instructions,
      messages: List::Cons({ role: role, content: content }, self.messages),
      temperature: self.temperature,
    }
  }

  /// Sets how much variation to allow. Zero is as close to deterministic as a
  /// provider offers, which is not a promise any of them makes.
  export fn at_temperature(self, temperature: Float) -> Prompt {
    {
      system_instructions: self.system_instructions,
      messages: self.messages,
      temperature: temperature,
    }
  }

  /// The prompt, with a description of what the answer should look like
  /// appended. What `extract` puts between a caller's request and the model.
  ///
  /// `S: Show` because a spec has to reach the model as words, and `Show` is
  /// how a type already says how it reads.
  fn describing(self, spec: String) -> Prompt {
    Prompt::saying(self, "user", "Answer with exactly this shape: " + spec)
  }
}

/// Why a model call did not produce an answer.
///
/// Coarse on purpose, on the same reasoning `std::db`'s `DbError` gives: every
/// provider numbers its failures differently, and a `std` that picked one
/// would be wrong for the second. `RateLimited` carries the wait because a
/// caller can act on it; the rest carry text.
export type ModelError =
  | ContextLengthExceeded(max_tokens: Int)
  | RateLimited(retry_after_ms: Int)
  | InferenceEngineFailure(msg: String)
  | SchemaExtractionError(details: String);

/// A type a model can be asked to produce: how to describe it, and how to read
/// the answer back.
///
/// `Spec` is deliberately the type's own business — a JSON schema, a grammar, a
/// set of examples — because `extract` only has to hand it over. `parse` is the
/// other half, and was missing: something has to turn the model's text into a
/// value, and before now nothing said what.
export trait Extract {
  /// How this type describes itself to a model — a JSON schema, a grammar, a
  /// set of examples. Its own business; `extract` only hands it over.
  type Spec;
  /// The description. Called without a value, because there is not one yet:
  /// describing the answer is what comes before asking for it.
  fn spec() -> Self::Spec;

  /// The spec, as the words that reach the model.
  ///
  /// Separate from `spec` because `Spec` is any type at all and something has
  /// to turn it into text. `type Spec: Show` would say it in one place instead
  /// — it parses, and the bound does not reach a `Self::Spec` projection, so
  /// the projection is reported as not implementing `Show` however the trait
  /// is written. A gap worth closing; until it is, this is the honest spelling.
  fn described() -> String;
  /// The answer, read back. `ModelError::SchemaExtractionError` when the text
  /// is not what the spec asked for, which is the ordinary case rather than an
  /// exceptional one — a model is allowed to be wrong.
  fn parse(text: String) -> Self raises ModelError;
}

/// Inference is a capability, not a value: a function that classifies text
/// declares `with { ai: LLMService }`, and the caller decides what serves it.
///
/// **Two operations, and both are rank-1.** A model takes a prompt and returns
/// text, or takes text and returns numbers; that is the whole of what it does,
/// and it is the whole of what belongs here. Asking for a typed answer is
/// `extract` below — a generic *function* over this effect, because an
/// operation is a field of a handler and a field has one type.
/// `docs/design/polymorphic-operations.md`.
///
/// Keeping the effect this small is what makes a mock one line: return a
/// string. It used to have to fabricate whatever the caller asked for, which
/// tests the mock rather than the code under it.
export effect LLMService {
  complete: Prompt -> String raises ModelError,
  /// The raw vector, at whatever width the model produces. `embed` below is
  /// the shape-safe reading of it.
  embed_raw: String -> List<Float> raises ModelError,
}

/// A typed answer from the model.
///
/// The call every caller wants — `let report = extract(prompt)!` — and the
/// reason `LLMService` does not have to know that reports exist. `A` is chosen
/// by the caller, which is what makes this a function rather than an
/// operation: a generic function is specialized at each call site, and a field
/// of a handler cannot be.
export fn extract<A: Extract>(prompt: Prompt) -> A
  with { ai: LLMService }
  raises ModelError
{
  let described = Prompt::describing(prompt, A::described());
  A::parse(ai.complete(described)!)!
}

/// An embedding of a known width.
///
/// **The width is the model's, not the caller's.** Nobody can choose to get 768
/// numbers out of a model that returns 1536, so asking for a `Dim` is asking a
/// question, and a `Dim` that does not match the answer is a `ModelError`. The
/// old declaration made it a caller-chosen parameter, which said otherwise.
export fn embed<const Dim: Int>(text: String) -> Embedding<Dim, F32>
  with { ai: LLMService }
  raises ModelError;

/// How alike two embeddings are, from -1 to 1.
///
/// **Both must have the same width**, and the type says so rather than a
/// length check discovering it: comparing a 1536-wide embedding with a
/// 768-wide one is refused by the checker. Declared rather than implemented,
/// like `matmul` — the arithmetic belongs in a package.
export fn cosine_similarity<const Dim: Int>(
  a: Embedding<Dim, F32>,
  b: Embedding<Dim, F32>
) -> Float;
