module std::net::http;

import std::core::{Array, Fiber, List, Map, Never, Nursery, Option, SharedFn, Show, Split, nursery};
import std::net::socket::{accept_on, invalid_handle, listen_on, receive, set_receive_timeout, shut, start, transmit};

// HTTP/1.1, over the sockets in `std::net::socket`.
//
// The specification does not define `std::net::http`; the shape here was
// reconstructed from how the reference application uses it, and every line
// below it is Khora over `String::slice`, `String::index_of` and `Map`.
//
// What it does: a request line with its query string, headers, a body read to
// the length the headers promised, routing on method and path with `:name`
// segments, and a response that can carry headers of its own.
//
// What it does not: chunked transfer, keep-alive, TLS, content negotiation,
// or multipart bodies. Each is absent deliberately rather than forgotten.
//
// It does answer on a fiber per connection, which took a language feature to
// reach rather than a line here: see `Router::serve_once`.

export type Method =
  | Get
  | Post
  | Put
  | Patch
  | Delete;

impl Method {
  fn of(text: String) -> Option<Method> {
    if text == "GET" {
      Option::Some(Method::Get)
    } else if text == "POST" {
      Option::Some(Method::Post)
    } else if text == "PUT" {
      Option::Some(Method::Put)
    } else if text == "PATCH" {
      Option::Some(Method::Patch)
    } else if text == "DELETE" {
      Option::Some(Method::Delete)
    } else {
      Option::None
    }
  }

  fn same(self, other: Method) -> Bool {
    Method::rank(self) == Method::rank(other)
  }

  fn rank(self) -> Int {
    match self {
      Method::Get => 0,
      Method::Post => 1,
      Method::Put => 2,
      Method::Patch => 3,
      Method::Delete => 4,
    }
  }
}

/// The path parameters a route matched: `/analyze/:account_id` against
/// `/analyze/acc_9921` binds `account_id`.
export type Params = {
  bound: Map<String, String>,
};

impl Params {
  fn empty() -> Params { { bound: Map::new() } }

  /// `Option::None` when the route did not declare that parameter, which is a
  /// programming error the type makes you notice rather than an empty string.
  fn get(self, name: String) -> Option<String> {
    Map::get(self.bound, name)
  }
}

export type Request = {
  method: Method,
  /// The path with the query string taken off: `/analyze/acc_1?deep=true` has
  /// a path of `/analyze/acc_1`. Routes match against this, so mounting
  /// `/analyze/:id` does not stop working the moment a client adds a
  /// parameter.
  path: String,
  params: Params,
  /// Decoded once, when the request arrives, rather than on every lookup — a
  /// handler that reads three parameters should not decode the query three
  /// times.
  queries: Map<String, String>,
  /// Keyed by the **lowercased** name, because HTTP header names are
  /// case-insensitive and a map is not. Folding the case here rather than in
  /// `header` means two headers differing only in case collide on arrival,
  /// which is the correct reading: they are the same header.
  headers: Map<String, String>,
  body: String,
};

impl Request {
  /// A GET request for `path`, with no parameters matched yet. Chiefly for
  /// tests: a real one arrives from a socket.
  fn get(path: String) -> Request {
    Request::of(Method::Get, path, "")
  }

  fn post(path: String, body: String) -> Request {
    Request::of(Method::Post, path, body)
  }

  /// The query string is honoured here too, so a hand-built request behaves
  /// like one off the wire. A test that writes `Request::get("/x?a=1")` and
  /// finds no `a` would be testing the constructor rather than the code.
  fn of(method: Method, target: String, body: String) -> Request {
    let split = split_target(target);
    {
      method: method,
      path: split.head,
      params: Params::empty(),
      queries: parse_query(split.rest),
      headers: Map::new(),
      body: body,
    }
  }

  /// A query parameter, already percent-decoded.
  ///
  /// A parameter written with no `=` — `/x?verbose` — is present with an empty
  /// value, which is how every server reads it and what lets a handler ask
  /// "was this requested" rather than "what does it say".
  fn query(self, name: String) -> Option<String> {
    Map::get(self.queries, name)
  }

  /// A header, by a name in any case.
  ///
  /// `Host`, `host` and `HOST` are one header. The RFC says so, and this is
  /// the half of it that everybody gets wrong.
  fn header(self, name: String) -> Option<String> {
    Map::get(self.headers, lowered(name))
  }
}

/// One header on the way out.
export type Header = {
  name: String,
  value: String,
};

export type Response = {
  status: Int,
  body: String,
  content_type: String,
  /// Anything beyond the three a response always carries. A list rather than a
  /// map, because `Set-Cookie` may legitimately appear more than once and a
  /// map would silently keep only the last.
  headers: List<Header>,
};

impl Response {
  /// Serializes `body` and sends it with the given status.
  ///
  /// `A: Show` rather than a JSON encoder, because there is no JSON module yet
  /// and `Show` is the trait a type already uses to say how it reads. When
  /// there is one, this is where it goes and nothing above it changes.
  fn json<A: Show>(status: Int, body: A) -> Response {
    { status: status, body: body.show(), content_type: "application/json", headers: List::Nil }
  }

  fn text(status: Int, body: String) -> Response {
    { status: status, body: body, content_type: "text/plain", headers: List::Nil }
  }

  /// The same response with one more header on it.
  ///
  /// A new response rather than a mutated one, like `Prompt`'s builders and
  /// for the same reason: a half-built response cannot be shared and then
  /// changed underneath its other holder.
  fn with_header(self, name: String, value: String) -> Response {
    {
      status: self.status,
      body: self.body,
      content_type: self.content_type,
      headers: List::Cons({ name: name, value: value }, self.headers),
    }
  }

  /// The response, as bytes on the wire.
  fn rendered(self) -> String {
    "HTTP/1.1 " + Int::to_string(self.status) + " " + Response::reason(self.status) + "\r\n"
    + "Content-Type: " + self.content_type + "\r\n"
    + "Content-Length: " + Int::to_string(String::byte_length(self.body)) + "\r\n"
    + Response::extra(self.headers)
    + "Connection: close\r\n"
    + "\r\n"
    + self.body
  }

  /// The caller's own headers. `with_header` prepends, so the most recently
  /// added is written first — which no client cares about, and saying so here
  /// is cheaper than reversing a list to make it look tidy.
  fn extra(headers: List<Header>) -> String {
    match headers {
      List::Nil => "",
      List::Cons(h, rest) => h.name + ": " + h.value + "\r\n" + Response::extra(rest),
    }
  }

  /// The reason phrase for a status.
  ///
  /// The ones a service actually sends, which turned out to be more than the
  /// five this had: the link shortener answered a redirect and got
  /// `HTTP/1.1 302 Unknown` on the wire. A phrase is advisory — every client
  /// reads the number — but one that says `Unknown` about a status the server
  /// deliberately chose reads as a bug to whoever is holding the packet
  /// capture, and it was.
  fn reason(status: Int) -> String {
    if status == 200 {
      "OK"
    } else if status == 201 {
      "Created"
    } else if status == 204 {
      "No Content"
    } else if status == 301 {
      "Moved Permanently"
    } else if status == 302 {
      "Found"
    } else if status == 304 {
      "Not Modified"
    } else if status == 401 {
      "Unauthorized"
    } else if status == 403 {
      "Forbidden"
    } else if status == 405 {
      "Method Not Allowed"
    } else if status == 409 {
      "Conflict"
    } else if status == 422 {
      "Unprocessable Content"
    } else if status == 429 {
      "Too Many Requests"
    } else if status == 400 {
      "Bad Request"
    } else if status == 404 {
      "Not Found"
    } else if status == 413 {
      "Payload Too Large"
    } else if status == 500 {
      "Internal Server Error"
    } else {
      "Unknown"
    }
  }
}

export type HttpError =
  | BindFailed(port: Int)
  | MalformedRequest(details: String);

// ---------------------------------------------------------------------------
// Bytes and text
// ---------------------------------------------------------------------------
//
// Written with `while` rather than as folds. Everything else in `std` walks a
// string by recursion, and for a few dozen characters that is the nicer shape
// — but a header block is thousands of bytes and one stack frame each buys
// nothing.

/// `text` with every ASCII letter in lower case.
///
/// ASCII only, deliberately: this exists for header names, which the RFC
/// restricts to ASCII, and case in every other alphabet is a question no
/// answer to which fits in six lines.
fn lowered(text: String) -> String {
  let length = String::byte_length(text);
  if length == 0 {
    ""
  } else {
    let out: Array<U8> = Array::new(length, 0);
    let mut i = 0;
    while i < length {
      let c = U8::to_int(String::byte(text, i));
      let shifted = if c >= 65 && c <= 90 { c + 32 } else { c };
      Array::set(out, i, U8::of(shifted));
      i = i + 1;
    }
    String::from_bytes(out)
  }
}

/// `text` without leading or trailing spaces and tabs.
fn trimmed(text: String) -> String {
  let length = String::byte_length(text);
  let mut start = 0;
  while start < length && blank(String::byte(text, start)) {
    start = start + 1;
  }
  let mut end = length;
  while end > start && blank(String::byte(text, end - 1)) {
    end = end - 1;
  }
  String::slice(text, start, end)
}

fn blank(byte: U8) -> Bool {
  let c = U8::to_int(byte);
  c == 32 || c == 9
}

/// The leading digits of `text`, as a number.
///
/// Stops at the first character that is not a digit, and at a value no server
/// should be asked to hold. The cap is not politeness: `value * 10` **traps**
/// on overflow, so a twenty-digit `Content-Length` would stop the process
/// rather than the request. Refusing to read past it turns a crash into a 413.
fn digits_of(text: String) -> Int {
  let length = String::byte_length(text);
  let mut value = 0;
  let mut i = 0;
  let mut going = true;
  while going && i < length {
    let c = U8::to_int(String::byte(text, i));
    if c >= 48 && c <= 57 && value <= 100000000 {
      value = value * 10 + (c - 48);
      i = i + 1;
    } else {
      going = false;
    }
  }
  value
}

/// One hex digit's value, or `None` for anything else.
fn hex_value(byte: U8) -> Option<Int> {
  let c = U8::to_int(byte);
  if c >= 48 && c <= 57 {
    Option::Some(c - 48)
  } else if c >= 97 && c <= 102 {
    Option::Some(c - 87)
  } else if c >= 65 && c <= 70 {
    Option::Some(c - 55)
  } else {
    Option::None
  }
}

/// The byte that two hex digits at `at` spell, if they are two hex digits.
fn hex_pair(text: String, at: Int) -> Option<Int> {
  if at + 1 >= String::byte_length(text) {
    Option::None
  } else {
    match hex_value(String::byte(text, at)) {
      Option::None => Option::None,
      Option::Some(high) => match hex_value(String::byte(text, at + 1)) {
        Option::None => Option::None,
        Option::Some(low) => Option::Some(high * 16 + low),
      },
    }
  }
}

/// `%20` becomes a space, and so does `+`.
///
/// A `%` not followed by two hex digits stays a literal `%`. Refusing the
/// whole parameter would be defensible and is not what any browser or server
/// does, and a query string is not the place to be the only strict one.
///
/// The decoded form is never longer than the encoded one, so a buffer of the
/// input's length is always enough and there is nothing to grow.
export fn percent_decode(text: String) -> String {
  let length = String::byte_length(text);
  if length == 0 {
    ""
  } else {
    let out: Array<U8> = Array::new(length, 0);
    let mut at = 0;
    let mut written = 0;
    while at < length {
      let here = U8::to_int(String::byte(text, at));
      if here == 37 {
        match hex_pair(text, at + 1) {
          Option::Some(value) => {
            Array::set(out, written, U8::of(value));
            written = written + 1;
            at = at + 3;
          },
          Option::None => {
            Array::set(out, written, String::byte(text, at));
            written = written + 1;
            at = at + 1;
          },
        };
      } else if here == 43 {
        Array::set(out, written, U8::of(32));
        written = written + 1;
        at = at + 1;
      } else {
        Array::set(out, written, String::byte(text, at));
        written = written + 1;
        at = at + 1;
      }
    }
    // A valid escape can spell a byte that is not text — `%FF` is not UTF-8 —
    // and `from_bytes` stops the program rather than pretend. A parameter
    // nobody can read as text is dropped instead of taking the server with it.
    let taken = Array::prefix(out, written);
    if Array::is_utf8(taken) { String::from_bytes(taken) } else { "" }
  }
}

// ---------------------------------------------------------------------------
// Parsing
// ---------------------------------------------------------------------------

/// A request read off the wire.
export fn parse(text: String) -> Option<Request> {
  match String::split_once(text, "\r\n") {
    Option::None => Option::None,
    Option::Some(lines) => match parse_request_line(lines.head) {
      Option::None => Option::None,
      Option::Some(head) => {
        let split = split_target(head.target);
        Option::Some({
            method: head.method,
            path: split.head,
            params: Params::empty(),
            queries: parse_query(split.rest),
            headers: parse_headers(lines.rest),
            body: body_of(lines.rest),
          })
      },
    },
  }
}

export type RequestLine = {
  method: Method,
  /// The request target as written, query string and all. `parse` splits it;
  /// keeping it whole here means a caller reading a request line for its own
  /// reasons gets what the client actually sent.
  target: String,
};

fn parse_request_line(line: String) -> Option<RequestLine> {
  match String::split_once(line, " ") {
    Option::None => Option::None,
    Option::Some(after_method) => match Method::of(after_method.head) {
      Option::None => Option::None,
      Option::Some(method) => match String::split_once(after_method.rest, " ") {
        // `GET /path` with no version is still a request line worth honouring.
        Option::None => Option::Some({ method: method, target: after_method.rest }),
        Option::Some(after_path) => Option::Some({ method: method, target: after_path.head }),
      },
    },
  }
}

/// The path and the query string, either side of the first `?`.
fn split_target(target: String) -> Split {
  match String::split_once(target, "?") {
    Option::None => { head: target, rest: "" },
    Option::Some(parts) => parts,
  }
}

/// `a=1&b=hello%20world` as a map, decoded.
fn parse_query(text: String) -> Map<String, String> {
  let out: Map<String, String> = Map::new();
  fill_query(out, text);
  out
}

fn fill_query(out: Map<String, String>, text: String) -> () {
  if String::byte_length(text) == 0 {
  } else {
    match String::split_once(text, "&") {
      Option::None => add_pair(out, text),
      Option::Some(parts) => {
        add_pair(out, parts.head);
        fill_query(out, parts.rest);
      },
    };
  }
}

fn add_pair(out: Map<String, String>, pair: String) -> () {
  if String::byte_length(pair) == 0 {
  } else {
    match String::split_once(pair, "=") {
      Option::None => Map::insert(out, percent_decode(pair), ""),
      Option::Some(kv) => Map::insert(out, percent_decode(kv.head), percent_decode(kv.rest)),
    };
  }
}

/// The headers, keyed by their lowercased names.
///
/// `rest` is everything after the request line; anything past the blank line
/// is the body and is not looked at here.
fn parse_headers(rest: String) -> Map<String, String> {
  let out: Map<String, String> = Map::new();
  let block = match String::index_of(rest, "\r\n\r\n") {
    Option::None => rest,
    Option::Some(at) => String::slice(rest, 0, at),
  };
  fill_headers(out, block);
  out
}

fn fill_headers(out: Map<String, String>, block: String) -> () {
  if String::byte_length(block) == 0 {
  } else {
    match String::split_once(block, "\r\n") {
      Option::None => add_header(out, block),
      Option::Some(parts) => {
        add_header(out, parts.head);
        fill_headers(out, parts.rest);
      },
    };
  }
}

fn add_header(out: Map<String, String>, line: String) -> () {
  match String::split_once(line, ":") {
    // A line with no colon is not a header. Dropping it rather than failing
    // the whole request is what a server does with a client's small mistakes.
    Option::None => (),
    Option::Some(parts) => Map::insert(out, lowered(parts.head), trimmed(parts.rest)),
  };
}

/// Everything after the blank line, or nothing.
fn body_of(rest: String) -> String {
  match String::index_of(rest, "\r\n\r\n") {
    Option::None => "",
    Option::Some(at) => String::slice(rest, at + 4, String::byte_length(rest)),
  }
}

// ---------------------------------------------------------------------------
// Reading a whole request
// ---------------------------------------------------------------------------

/// The most a request may be. Anything longer gets a 413.
///
/// The buffer is allocated once at this size and never grows, which is what
/// makes a lying `Content-Length` harmless: the header is a promise about what
/// is coming, not an instruction to allocate.
///
/// **Eight kilobytes because that is where the stack runs out, not because
/// eight kilobytes is a sensible maximum request.** `String::slice`,
/// `String::index_of` and `String::matches_at` in `std::core` each recurse once
/// per byte, so parsing a request of around nine thousand bytes overflows the
/// stack and takes the process with it — measured, not guessed: 8000 answers
/// and 9000 does not.
///
/// Raising this needs those three rewritten as loops. Until then a limit that
/// is under the cliff turns a crashed server into a 413, which is the whole of
/// what this number is for.
fn limit() -> Int { 8192 }

/// How many bytes to ask the socket for at a time.
fn chunk() -> Int { 4096 }

/// Reads one request into `into`, and says how many bytes arrived.
///
/// Stops at whichever comes first: the body is as long as `Content-Length`
/// promised, the peer closed, the buffer filled, or the read deadline passed.
///
/// **It used to stop on a short read as well, and that was a real interop
/// failure.** A client is allowed to write its headers and its body separately
/// — .NET's `HttpClient` does, and so does anything that sets a body from a
/// stream — and the pause between the two reads as the end of the request. The
/// server then answered `400` about a body that had not arrived yet, *before*
/// the client had finished sending it. Reproduced with a socket and a
/// three-hundred-millisecond sleep; curl never showed it, because curl writes
/// small requests in one go.
///
/// The rule was there for a reason, which is why it survived: `receive` blocks,
/// so "keep reading until the request is complete" and "keep reading forever"
/// are the same loop when the client stops talking. What makes the honest
/// version safe is the deadline `serve_connection` sets before calling this —
/// a client that goes quiet gets its socket closed instead of parking a fiber
/// for the life of the process.
fn read_request(connection: Int, into: Array<U8>) -> Int {
  let scratch: Array<U8> = Array::new(chunk(), 0);
  let mut filled = 0;
  // Negative until the headers are complete, then the whole request's length.
  let mut want = 0 - 1;
  // Whether `Content-Length` promised more than the buffer holds.
  let mut oversized = false;
  let mut going = true;
  while going {
    if want >= 0 && filled >= want {
      going = false;
    } else if want > Array::length(into) {
      // A promise bigger than the buffer cannot be kept, so there is nothing
      // to wait for: the answer is 413 whatever else arrives. Deciding it here
      // rather than after the deadline is what keeps a client claiming four
      // gigabytes from holding a connection open for ten seconds — which is
      // exactly what it did the first time this loop was allowed to wait.
      oversized = true;
      going = false;
    } else if filled >= Array::length(into) {
      going = false;
    } else {
      // Zero is the peer closing, negative is the read failing — and with a
      // deadline set, "failing" includes "nothing arrived in time", which is
      // what stops this waiting on a client that has gone away.
      let read = receive(connection, scratch);
      if read <= 0 {
        going = false;
      } else {
        let room = Array::length(into) - filled;
        let taken = if read > room { room } else { read };
        copy_at(scratch, into, taken, filled);
        filled = filled + taken;
        if want < 0 {
          want = wanted(into, filled);
        }
      }
    }
  }
  // A full buffer is how `answer_bytes` recognises a request that is too big,
  // and a promise too big to keep means the same thing — so it is reported the
  // same way rather than by a second channel. Nothing reads the buffer on that
  // path; the 413 is decided before anything is parsed.
  if oversized { Array::length(into) } else { filled }
}

fn copy_at(from: Array<U8>, into: Array<U8>, count: Int, offset: Int) -> () {
  let mut i = 0;
  while i < count {
    Array::set(into, offset + i, Array::get(from, i));
    i = i + 1;
  }
}

/// How long the whole request should be, or negative while the headers are
/// still arriving.
fn wanted(bytes: Array<U8>, filled: Int) -> Int {
  let after = end_of_headers(bytes, filled);
  if after < 0 {
    0 - 1
  } else {
    let head = Array::prefix(bytes, after);
    // Header bytes that are not text are a request nobody can answer, and
    // saying it ends here turns that into a 400 rather than a trap inside
    // `from_bytes`.
    if Array::is_utf8(head) {
      after + content_length(String::from_bytes(head))
    } else {
      after
    }
  }
}

/// Where the body starts, or negative if the blank line has not arrived.
///
/// Searched over bytes rather than text, because the headers are only complete
/// once this says so: converting first would mean converting a fragment, and a
/// fragment can split a character.
fn end_of_headers(bytes: Array<U8>, filled: Int) -> Int {
  let mut i = 0;
  let mut found = 0 - 1;
  while found < 0 && i + 3 < filled {
    if U8::to_int(Array::get(bytes, i)) == 13
    && U8::to_int(Array::get(bytes, i + 1)) == 10
    && U8::to_int(Array::get(bytes, i + 2)) == 13
    && U8::to_int(Array::get(bytes, i + 3)) == 10 {
      found = i + 4;
    } else {
      i = i + 1;
    }
  }
  found
}

fn content_length(head: String) -> Int {
  match String::split_once(head, "\r\n") {
    Option::None => 0,
    Option::Some(lines) => match Map::get(parse_headers(lines.rest), "content-length") {
      Option::None => 0,
      Option::Some(value) => digits_of(value),
    },
  }
}

// ---------------------------------------------------------------------------
// Routing
// ---------------------------------------------------------------------------

/// Whether `path` matches `pattern`, and what its `:name` segments bound.
///
/// Segment by segment, because that is what a `:name` matches — one segment,
/// never a `/`. A pattern and a path of different lengths do not match, which
/// is what keeps `/a/:b` from swallowing `/a/b/c`.
export fn matches(pattern: String, path: String) -> Option<Params> {
  match_segments(pattern, path, Map::new())
}

fn match_segments(pattern: String, path: String, bound: Map<String, String>) -> Option<Params> {
  let here = segment(pattern);
  let mine = segment(path);
  if String::byte_length(here.head) == 0 && String::byte_length(mine.head) == 0 {
    if String::byte_length(here.rest) == 0 && String::byte_length(mine.rest) == 0 {
      Option::Some({ bound: bound })
    } else {
      match_segments(here.rest, mine.rest, bound)
    }
  } else if String::starts_with(here.head, ":") {
    if String::byte_length(mine.head) == 0 {
      Option::None
    } else {
      Map::insert(bound, String::slice(here.head, 1, String::byte_length(here.head)), mine.head);
      finish_match(here.rest, mine.rest, bound)
    }
  } else if here.head == mine.head {
    finish_match(here.rest, mine.rest, bound)
  } else {
    Option::None
  }
}

fn finish_match(pattern: String, path: String, bound: Map<String, String>) -> Option<Params> {
  if String::byte_length(pattern) == 0 && String::byte_length(path) == 0 {
    Option::Some({ bound: bound })
  } else if String::byte_length(pattern) == 0 || String::byte_length(path) == 0 {
    Option::None
  } else {
    match_segments(pattern, path, bound)
  }
}

/// The next `/`-separated piece, and what follows it.
fn segment(text: String) -> Split {
  let without_slash =
  if String::starts_with(text, "/") { String::slice(text, 1, String::byte_length(text)) }
  else { text };
  match String::split_once(without_slash, "/") {
    Option::None => { head: without_slash, rest: "" },
    Option::Some(parts) => parts,
  }
}

// ---------------------------------------------------------------------------
// The router
// ---------------------------------------------------------------------------

/// One mounted route.
///
/// The handler is a `SharedFn` rather than a plain closure, and that is what
/// lets a router be answered on a fiber of its own. A closure's captures are
/// not in its type, so a record holding one can never be handed to another
/// fiber; `SharedFn::of` checks the captures where the closure is written and
/// hands back something that has forgotten it was ever a closure.
///
/// It also takes the capabilities out of the router's type. A handler closes
/// over what it needs at the mount site, so there is no `'r` left for a `Route`
/// to carry — `Router<'e>` says only how its handlers can fail.
export type Route<'e> = {
  method: Method,
  pattern: String,
  handler: SharedFn<Request, Response, 'e>,
};

/// A router carries its handlers' failures, so mounting a route that can fail
/// against the database widens the router's own error row.
export type Router<'e> = {
  routes: List<Route<'e>>,
};

/// Mounting is written `router |> Router::post(..)`, so the router is the
/// first parameter of each. They are the type's own functions rather than free
/// ones so that the pipeline reads as a chain against `Router` and cannot
/// collide with another module's `get`.
impl Router {
  fn new<'e>() -> Router<'e> { { routes: List::Nil } }

  fn post<'e>(
    router: Router<'e>,
    route: String,
    handler: SharedFn<Request, Response, 'e>
  ) -> Router<'e> {
    { routes: List::Cons({ method: Method::Post, pattern: route, handler: handler }, router.routes) }
  }

  fn get<'e>(
    router: Router<'e>,
    route: String,
    handler: SharedFn<Request, Response, 'e>
  ) -> Router<'e> {
    { routes: List::Cons({ method: Method::Get, pattern: route, handler: handler }, router.routes) }
  }

  /// Serves until the process stops, on a fiber per connection.
  fn listen<'e>(router: Router<'e>, port: Int) -> ()
    raises 'e + HttpError
  {
    if start() {
    } else {
      raise HttpError::BindFailed(port)
    };
    let server = listen_on(port);
    if server == invalid_handle() {
      raise HttpError::BindFailed(port)
    } else {
      // Announced so that whatever started this knows the port is open. A
      // caller that wants silence can have a quieter one when there is
      // something to configure it with.
      print("listening on " + Int::to_string(port));
      // The nursery is opened here rather than asked of the caller: that a
      // server answers on a fiber per connection is its own business.
      //
      // Written as a lambda, which needed
      // `docs/design/capability-passing.md`: the thunk requires a nursery that
      // does not exist where it is written, so `nursery` supplies one when it
      // calls it. Until that landed this was the handler spelled out by hand,
      // because a lambda's requirement row was always empty.
      nursery(fn () => Router::serve_forever(router, server)!)!
    }
  }

  /// Accepts for as long as the process lives.
  fn serve_forever<'e>(router: Router<'e>, server: Int) -> ()
    with { nursery: Nursery }
    raises 'e + HttpError
  {
    Router::serve_once(router, server)!;
    Router::serve_forever(router, server)!
  }

  /// Accepts one connection and hands it to a fiber of its own.
  ///
  /// **This is what `SharedFn` bought.** A closure's captures are not in its
  /// type, so a `Router` holding plain closures could never cross into a fiber
  /// and the server answered one caller at a time. Certifying each handler
  /// where it is mounted makes the route an ordinary shareable record, and the
  /// thunk below closes over the whole router without anything special being
  /// said about routers. `docs/design/sharing.md`.
  ///
  /// The nursery is what makes it structured rather than merely concurrent: an
  /// adopted fiber cannot outlive it, so leaving `listen` — by a raise, or by
  /// cancellation — deals with the connections still being answered instead of
  /// abandoning them.
  fn serve_once<'e>(router: Router<'e>, server: Int) -> ()
    with { nursery: Nursery }
    raises 'e + HttpError
  {
    let connection = accept_on(server);
    if connection == invalid_handle() {
    } else {
      nursery.adopt(Fiber::spawn(fn () => Router::serve_connection(router, connection)));
    }
  }

  /// One connection, from the first byte to the close.
  ///
  /// What a fiber runs, and it does not fail: a fiber has nobody to hand a
  /// failure to, and a connection nothing closes is a descriptor leaked for the
  /// life of the process. So whatever the handler raised becomes a 500 and the
  /// socket is shut either way.
  ///
  /// The arm is `_`, because `'e` is whatever the mounted handlers raise and
  /// this function cannot name a constructor of it. Catching *whatever* is the
  /// one thing naming constructors cannot express, and the reason a total
  /// wildcard arm exists at all.
  fn serve_connection<'e>(router: Router<'e>, connection: Int) -> () {
    // Before anything is read. `read_request` keeps reading until the request
    // is complete, which is the only correct thing to do and is also how a
    // fiber gets parked forever by a client that stops talking. Ten seconds is
    // long enough that no real client notices and short enough that a
    // half-open connection is not a leak.
    set_receive_timeout(connection, 10000);
    Router::answer_on(router, connection) catch {
      _ => {
        transmit(connection, Response::rendered(Response::text(500, "handler failed")));
      },
    };
    shut(connection)
  }

  /// Reads one request off `connection` and writes the answer back.
  fn answer_on<'e>(router: Router<'e>, connection: Int) -> ()
    raises 'e
  {
    let buffer: Array<U8> = Array::new(limit(), 0);
    let filled = read_request(connection, buffer);
    let answer = Router::answer_bytes(router, buffer, filled)!;
    transmit(connection, Response::rendered(answer));
  }

  /// The answer to what arrived, whatever state it arrived in.
  fn answer_bytes<'e>(router: Router<'e>, buffer: Array<U8>, filled: Int) -> Response
    raises 'e
  {
    if filled <= 0 {
      Response::text(400, "empty request")
    } else if filled >= limit() {
      // The buffer filled before the request ended. Whether the client lied
      // about its length or simply sent too much, the answer is the same.
      Response::text(413, "request too large")
    } else {
      let taken = Array::prefix(buffer, filled);
      if Array::is_utf8(taken) {
        Router::answer(router, String::from_bytes(taken))!
      } else {
        Response::text(400, "request was not text")
      }
    }
  }

  /// What to send back for this request text.
  fn answer<'e>(router: Router<'e>, text: String) -> Response
    raises 'e
  {
    match parse(text) {
      Option::None => Response::text(400, "malformed request"),
      Option::Some(request) => Router::dispatch(router.routes, request)!,
    }
  }

  fn dispatch<'e>(routes: List<Route<'e>>, request: Request) -> Response
    raises 'e
  {
    match routes {
      List::Nil => Response::text(404, "no route for " + request.path),
      List::Cons(route, rest) =>
      if Method::same(route.method, request.method) {
        match matches(route.pattern, request.path) {
          Option::Some(params) =>
          SharedFn::call(route.handler, {
              method: request.method,
              path: request.path,
              params: params,
              queries: request.queries,
              headers: request.headers,
              body: request.body,
            })!,
          Option::None => Router::dispatch(rest, request)!,
        }
      } else {
        Router::dispatch(rest, request)!
      },
    }
  }
}

fn print(value: String);
