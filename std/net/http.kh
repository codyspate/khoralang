module std::net::http;

import std::core::{Never, Scope};

// The specification does not define `std::net::http`; these signatures are
// reconstructed from how the reference application uses them, and are marked
// provisional in `docs/errata.md`.

export type Method =
  | Get
  | Post
  | Put
  | Patch
  | Delete;

export type Params;
export type Json;

export type Request = {
  method: Method,
  path: String,
  params: Params,
  body: String,
};

export type Response;

export type HttpError =
  | BindFailed(port: Int)
  | MalformedRequest(details: String);

/// A router carries the capabilities its handlers need, so mounting a route
/// that talks to the database widens the router's own requirement row.
export type Router<- R, + E>;

export fn new() -> Router<{}, Never>;

export fn post<'r1, 'r2, 'e1, 'e2>(
  router: Router<'r1, 'e1>,
  route: String,
  handler: Request -> Response with 'r2 raises 'e2
) -> Router<{ 'r1 | 'r2 }, 'e1 + 'e2>;

export fn get<'r1, 'r2, 'e1, 'e2>(
  router: Router<'r1, 'e1>,
  route: String,
  handler: Request -> Response with 'r2 raises 'e2
) -> Router<{ 'r1 | 'r2 }, 'e1 + 'e2>;

/// Binding a socket is a scoped resource: the listener is released when the
/// enclosing region exits, including under interruption.
export fn listen<'r, 'e>(router: Router<'r, 'e>, port: Int) -> ()
  with { 'r | scope: Scope }
  raises 'e + HttpError;
