module std::net::socket;

import std::core::{Array, Ptr};

// Sockets, on macOS.
//
// The same module as `socket_linux.kh` and `socket_windows.kh`, and only one of
// the three is ever in a build. Against the Linux one there are exactly two
// differences, both of them below and both of them BSD's rather than Apple's:
// a `sockaddr_in` begins with a length byte, and the socket-option numbers are
// the BSD ones. Everything else — the calls, the sizes, the byte order — is the
// same, which is why this file is otherwise a copy.
//
// **A copy, and that is the mechanism working as designed.** File suffixes
// select a whole file (`khora-db::selected_for_target`), so a target that
// differs in two lines still needs a file of its own. `_posix` exists for the
// case where Linux and macOS agree completely, and sockets are not that case.
// The cost is that a fix to one of these belongs in both.
//
// **No struct crosses the boundary.** `bind` wants a `sockaddr_in`, which is
// sixteen bytes; those sixteen bytes are laid out here, in an `Array<U8>`, and
// lent as a `Ptr` for exactly the duration of the call. `docs/design/ffi.md`.

extern fn socket(family: I32, kind: I32, protocol: I32) -> I32;
extern fn bind(handle: I32, address: Ptr, length: I32) -> I32;
extern fn listen(handle: I32, backlog: I32) -> I32;
extern fn accept(handle: I32, address: Ptr, length: Ptr) -> I32;
extern fn recv(handle: I32, into: Ptr, length: Int, flags: I32) -> Int;
extern fn send(handle: I32, from: Ptr, length: Int, flags: I32) -> Int;
extern fn close(handle: I32) -> I32;
extern fn shutdown(handle: I32, how: I32) -> I32;
extern fn setsockopt(handle: I32, level: I32, name: I32, value: Ptr, length: I32) -> I32;

/// A failed call returns -1, and a handle is never negative.
export fn invalid_handle() -> Int { 0 - 1 }

/// Nothing to start. Present so that a caller reads the same on both targets.
export fn start() -> Bool { true }

/// A socket listening on `port`, or [`invalid_handle`].
export fn listen_on(port: Int) -> Int {
  // AF_INET, SOCK_STREAM, IPPROTO_TCP — 2, 1 and 6 here as on Linux.
  let handle = socket(I32::of(2), I32::of(1), I32::of(6));
  if I32::to_int(handle) < 0 {
    invalid_handle()
  } else {
    let address = sockaddr_in(port);
    let bound = Array::with_data(address, fn (bytes, n) => bind(handle, bytes, I32::of(16)));
    if bound == I32::of(0) && listen(handle, I32::of(16)) == I32::of(0) {
      I32::to_int(handle)
    } else {
      close(handle);
      invalid_handle()
    }
  }
}

/// The sixteen bytes of a `sockaddr_in` bound to every interface.
///
/// **This is the first of the two differences from Linux.** BSD splits what
/// Linux spends on a two-byte `sin_family`: a one-byte length first, then a
/// one-byte family. Writing Linux's layout here puts `AF_INET` in `sin_len` and
/// zero in `sin_family`, which is a `bind` that fails with nothing to read.
///
/// ```text
/// 0..1   sin_len     16, the size of this structure
/// 1..2   sin_family  AF_INET
/// 2..4   sin_port    network order, which is big-endian
/// 4..8   sin_addr    INADDR_ANY, which is zero
/// 8..16  padding
/// ```
fn sockaddr_in(port: Int) -> Array<U8> {
  let out: Array<U8> = Array::new(16, 0);
  Array::set(out, 0, 16);
  Array::set(out, 1, 2);
  Array::set(out, 2, U8::of(Int::and(Int::shr(port, 8), 255)));
  Array::set(out, 3, U8::of(Int::and(port, 255)));
  out
}

/// Waits for a connection. [`invalid_handle`] if the wait failed.
export fn accept_on(server: Int) -> Int {
  let taken = accept(I32::of(server), Ptr::null(), Ptr::null());
  if I32::to_int(taken) < 0 { invalid_handle() } else { I32::to_int(taken) }
}

/// How long a read will wait before giving up, in milliseconds.
///
/// **The second difference.** `SOL_SOCKET` is `0xffff` here and 1 on Linux, and
/// `SO_RCVTIMEO` is `0x1006` rather than 20 — BSD numbers the options from a
/// different base. The *value* is the same shape: a `struct timeval`, sixteen
/// bytes, seconds then microseconds.
///
/// macOS makes `tv_usec` a 32-bit `suseconds_t` where Linux makes it 64, so the
/// structure is eight bytes plus four plus four of padding rather than eight
/// and eight. Writing a whole word at offset 8 is right either way on a
/// little-endian machine — the microseconds land in the low half and zero lands
/// in the padding — and every macOS Khora targets is little-endian.
export fn set_receive_timeout(handle: Int, millis: Int) -> Bool {
  let value: Array<U8> = Array::new(16, 0);
  write_word(value, 0, millis / 1000);
  write_word(value, 8, (millis % 1000) * 1000);
  let outcome = Array::with_data(value, fn (from, n) =>
    I32::to_int(setsockopt(I32::of(handle), I32::of(65535), I32::of(4102), from, I32::of(n))));
  outcome == 0
}

/// A 64-bit value, least significant byte first, which is this target's order.
fn write_word(into: Array<U8>, at: Int, value: Int) -> () {
  let mut i = 0;
  while i < 8 {
    Array::set(into, at + i, U8::of(Int::and(Int::shr(value, i * 8), 255)));
    i = i + 1;
  }
}

/// Reads what has arrived into `buffer`, and says how many bytes that was.
///
/// Zero means the other end closed; negative means the read failed.
export fn receive(connection: Int, buffer: Array<U8>) -> Int {
  Array::with_data(buffer, fn (into, n) => recv(I32::of(connection), into, n, I32::of(0)))
}

/// Writes `text`, and says how many bytes went. Negative if the write failed.
export fn transmit(connection: Int, text: String) -> Int {
  String::with_data(text, fn (from, n) => send(I32::of(connection), from, n, I32::of(0)))
}

/// Closes a connection, letting the other end finish first.
///
/// The same reasoning as the other two files, and the same shape: closing while
/// the peer is still writing sends an RST, which discards the answer the peer
/// had not read yet. `SHUT_WR` is 1 here too.
export fn shut(handle: Int) -> () {
  shutdown(I32::of(handle), I32::of(1));
  drain(handle, 8);
  close(I32::of(handle));
}

/// Reads and discards what is still arriving, at most `rounds` times.
fn drain(handle: Int, rounds: Int) -> () {
  if rounds <= 0 {
  } else {
    let leftovers: Array<U8> = Array::new(1024, 0);
    let read = receive(handle, leftovers);
    if read <= 0 {} else { drain(handle, rounds - 1) }
  }
}
