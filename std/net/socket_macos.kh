module std::net::socket;

import std::core::{Array, Ptr};

//! # On macOS
//!
//! Two differences from Linux, both of them BSD's rather than Apple's: a
//! `sockaddr_in` begins with a length byte where the Linux one puts the low half
//! of the family, and the socket-option numbers are the BSD ones. Everything
//! else -- the calls, the sizes, the byte order -- is the same, which is why this
//! file is otherwise a copy of `socket_linux.kh`.
//!
//! **A copy, and that is the mechanism working as designed.** A file suffix
//! selects a whole file, so a target that differs in two lines still needs a
//! file of its own. `_posix` exists for the case where Linux and macOS agree
//! completely, and sockets are not that case. The cost is that a fix to one of
//! these usually belongs in both.

extern fn socket(family: I32, kind: I32, protocol: I32) -> I32;
extern fn bind(handle: I32, address: Ptr, length: I32) -> I32;
extern fn listen(handle: I32, backlog: I32) -> I32;
extern fn close(handle: I32) -> I32;
extern fn shutdown(handle: I32, how: I32) -> I32;

// The runtime's socket calls, which suspend a fiber rather than a worker.
//
// A `recv` that would have blocked used to block the thread, which was right
// while a fiber *was* a thread. Now it is one of many on a worker, and a
// blocked worker is every fiber queued behind it as well. These do the same
// call and, when it would block, hand the worker back and wait on the reactor.
// Off a scheduler they block the calling thread exactly as before, so a
// program that spawns nothing behaves as it always did.
//
// `khora_net_prepare` is what makes a socket non-blocking, and it is called
// once per socket rather than once per operation because it is a syscall and a
// read is not. `crates/khora-rt/src/net.rs`, and `docs/design/scheduler.md`
// §2.
extern fn khora_net_prepare(handle: I32) -> I32;
extern fn khora_net_recv(handle: I32, into: Ptr, length: Int) -> Int;
extern fn khora_net_recv_now(handle: I32, into: Ptr, length: Int) -> Int;
extern fn khora_net_send(handle: I32, from: Ptr, length: Int) -> Int;
extern fn khora_net_accept(handle: I32, address: Ptr, length: Ptr) -> I32;
extern fn khora_net_set_timeout(handle: I32, millis: Int) -> I32;
extern fn khora_net_forget(handle: I32) -> ();
extern fn khora_net_connect(host: Ptr, host_len: Int, port: Int) -> Int;

/// A failed call returns -1, and a handle is never negative.
pub fn invalid_handle() -> Int { 0 - 1 }

/// Nothing to start. Present so that a caller reads the same on both targets.
pub fn start() -> Bool { true }

/// A socket listening on `port`, or [`invalid_handle`].
pub fn listen_on(port: Int) -> Int {
  // AF_INET, SOCK_STREAM, IPPROTO_TCP — 2, 1 and 6 here as on Linux.
  let handle = socket(I32::of(2), I32::of(1), I32::of(6));
  // Non-blocking from here on, so that a fiber waiting for a connection gives
  // its worker back. A listener that could not be prepared is still a working
  // listener — the retry loops in the runtime simply never see a would-block —
  // so this is not worth failing over.
  khora_net_prepare(handle);
  if I32::to_int(handle) < 0 {
    invalid_handle()
  } else {
    let address = sockaddr_in(port);
    let bound = Array::with_data(address, fn (bytes, n) => bind(handle, bytes, I32::of(16)));
    // **511, not 16.** The backlog is the queue of connections the kernel has
    // accepted and this program has not yet taken, which is to say it *is* the
    // buffer `bounded_nursery` means when it says overload "becomes latency
    // instead of collapse": a server bounded to 256 concurrent connections
    // absorbs a burst here or refuses it at the TCP layer, where a client sees
    // a failed connect rather than a slow answer.
    //
    // It was 16, which is smaller than any of the bounds above it, and a load
    // test of twenty-four clients found it by hanging. 511 is nginx's default
    // and the number every kernel clamps to its own maximum, so it is a
    // request rather than an assertion about the machine.
    if bound == I32::of(0) && listen(handle, I32::of(511)) == I32::of(0) {
      I32::to_int(handle)
    } else {
      close(handle);
      invalid_handle()
    }
  }
}

/// The sixteen bytes of a `sockaddr_in` bound to every interface.
///
/// **This is the first of the two differences from Linux.** BSD splits what
/// Linux spends on a two-byte `sin_family`: a one-byte length first, then a
/// one-byte family. Writing Linux's layout here puts `AF_INET` in `sin_len` and
/// zero in `sin_family`, which is a `bind` that fails with nothing to read.
///
/// ```text
/// 0..1   sin_len     16, the size of this structure
/// 1..2   sin_family  AF_INET
/// 2..4   sin_port    network order, which is big-endian
/// 4..8   sin_addr    INADDR_ANY, which is zero
/// 8..16  padding
/// ```
fn sockaddr_in(port: Int) -> Array<U8> {
  let out: Array<U8> = Array::new(16, 0);
  Array::set(out, 0, 16);
  Array::set(out, 1, 2);
  Array::set(out, 2, U8::of(Int::and(Int::shr(port, 8), 255)));
  Array::set(out, 3, U8::of(Int::and(port, 255)));
  out
}

/// Waits for a connection. [`invalid_handle`] if the wait failed.
pub fn accept_on(server: Int) -> Int {
  let taken = khora_net_accept(I32::of(server), Ptr::null(), Ptr::null());
  if I32::to_int(taken) < 0 { invalid_handle() } else {
    // Prepared here rather than inside the runtime's `accept`, so that every
    // decision about a new socket is in one visible place instead of half
    // here and half there.
    khora_net_prepare(taken);
    I32::to_int(taken)
  }
}

/// How long a read will wait before giving up, in milliseconds.
///
/// **The second difference.** `SOL_SOCKET` is `0xffff` here and 1 on Linux, and
/// `SO_RCVTIMEO` is `0x1006` rather than 20 — BSD numbers the options from a
/// different base. The *value* is the same shape: a `struct timeval`, sixteen
/// bytes, seconds then microseconds.
///
/// **No longer `SO_RCVTIMEO`, and it could not be.** The kernel's option
/// applies to a call that would have blocked, and a socket the reactor drives
/// never has one — so it goes silently inert the moment the socket is
/// prepared, and the slow client it exists to shed would park a fiber for ever
/// instead. The runtime keeps the deadline and a scheduler timer enforces it.
///
/// This is also the end of a small platform difference: macOS makes `tv_usec`
/// a 32-bit `suseconds_t` where Linux makes it 64, so the `timeval` this used
/// to build was laid out differently on each. A deadline in milliseconds is
/// the same number everywhere.
pub fn set_receive_timeout(handle: Int, millis: Int) -> Bool {
  khora_net_set_timeout(I32::of(handle), millis) == I32::of(0)
}

/// Reads what has arrived into `buffer`, and says how many bytes that was.
///
/// Zero means the other end closed; negative means the read failed.
pub fn receive(connection: Int, buffer: Array<U8>) -> Int {
  Array::with_data(buffer, fn (into, n) => khora_net_recv(I32::of(connection), into, n))
}

/// Writes `text`, and says how many bytes went. Negative if the write failed.
pub fn transmit(connection: Int, text: String) -> Int {
  String::with_data(text, fn (from, n) => khora_net_send(I32::of(connection), from, n))
}

/// Opens a connection to `host` on `port`, or [`invalid_handle`].
///
/// **The first thing here that starts a conversation.** Everything else in this
/// module grew from serving: `listen_on`, `accept_on`, and nothing that dials.
/// A database driver is the first caller that needs the other direction.
///
/// `host` may be a name or an address; resolution, address family and the
/// platform's own resolver are the runtime's, which is why this is one extern
/// rather than `getaddrinfo` and two `sockaddr` layouts written three times.
/// [The ffi design note](https://github.com/codyspate/khoralang/blob/main/docs/design/ffi.md) is the boundary and `khora_net_connect` is on the far
/// side of it.
///
/// **It blocks the fiber's worker while it connects.** A DNS lookup is not
/// something the reactor can wait on. That is once per connection against many
/// queries, which is the right thing to get wrong first — a known cost rather
/// than one left to be found.
pub fn connect_to(host: String, port: Int) -> Int {
  String::with_data(host, fn (from, n) => khora_net_connect(from, n, port))
}

/// Writes bytes, and says how many went. Negative if the write failed.
///
/// [`transmit`] takes a `String`, which is right for a protocol made of text
/// and wrong for one made of bytes: a wire protocol frames its messages with a
/// length nobody wrote as characters. Postgres is the first caller, and a
/// `String` would have meant deciding what its bytes mean on the way through.
pub fn transmit_bytes(connection: Int, bytes: Array<U8>) -> Int {
  Array::with_data(bytes, fn (from, n) => khora_net_send(I32::of(connection), from, n))
}

/// Closes a connection, letting the other end finish first.
///
/// The same reasoning as the other two files, and the same shape: closing while
/// the peer is still writing sends an RST, which discards the answer the peer
/// had not read yet. `SHUT_WR` is 1 here too.
///
/// **The drain takes what has already arrived and never waits for more.** A
/// peer that holds the connection open and says nothing would otherwise hold
/// `shut` until the kernel abandoned the half-closed connection by itself,
/// which here is `tcp_fin_timeout` — sixty seconds by default.
pub fn shut(handle: Int) -> () {
  shutdown(I32::of(handle), I32::of(1));
  drain(handle, 8);
  // The runtime remembers this socket's receive deadline, and handles are
  // reused: without this, the next connection handed the same number would
  // inherit it.
  khora_net_forget(I32::of(handle));
  close(I32::of(handle));
}

/// Reads what has already arrived, without waiting for more.
///
/// Zero means the other end closed; negative means the read failed **or would
/// have blocked**, which are one answer here because a caller does the same
/// thing with both.
pub fn receive_now(connection: Int, buffer: Array<U8>) -> Int {
  Array::with_data(buffer, fn (into, n) => khora_net_recv_now(I32::of(connection), into, n))
}

/// Reads and discards what has already arrived, at most `rounds` times.
fn drain(handle: Int, rounds: Int) -> () {
  if rounds <= 0 {
  } else {
    let leftovers: Array<U8> = Array::new(1024, 0);
    let read = receive_now(handle, leftovers);
    if read <= 0 {} else { drain(handle, rounds - 1) }
  }
}
