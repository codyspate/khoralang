module std::net::socket;

import std::core::{Array, Eq, Ptr, Show};
import std::permissions::{granted_listen, may_dial, unbracketed};
import std::permissions::grants::{listen as listen_grants, network};

//! # On Windows
//!
//! The Berkeley names with Winsock's differences: `WSAStartup` before anything
//! else -- which is what `start` is for, and why it is not a no-op here --
//! `closesocket` rather than `close`, and a `SOCKET` that is a pointer-sized
//! handle rather than a small `int`.

extern fn WSAStartup(version: U16, data: Ptr) -> I32;
extern fn socket(family: I32, kind: I32, protocol: I32) -> Int;
extern fn bind(handle: Int, address: Ptr, length: I32) -> I32;
extern fn listen(handle: Int, backlog: I32) -> I32;
extern fn closesocket(handle: Int) -> I32;
extern fn shutdown(handle: Int, how: I32) -> I32;

// The runtime's socket calls, which suspend a fiber rather than a worker.
//
// A `recv` that would have blocked used to block the thread, which was right
// while a fiber *was* a thread. Now it is one of many on a worker, and a
// blocked worker is every fiber queued behind it as well. These do the same
// call and, when it would block, hand the worker back and wait on the reactor.
// Off a scheduler they block the calling thread exactly as before, so a
// program that spawns nothing behaves as it always did.
//
// `khora_net_prepare` is what makes a socket non-blocking, and it is called
// once per socket rather than once per operation because it is a syscall and a
// read is not. `crates/khora-rt/src/net.rs`, and `docs/design/scheduler.md`
// §2.
extern fn khora_net_prepare(handle: Int) -> I32;
extern fn khora_net_recv(handle: Int, into: Ptr, length: Int) -> Int;
extern fn khora_net_recv_now(handle: Int, into: Ptr, length: Int) -> Int;
extern fn khora_net_send(handle: Int, from: Ptr, length: Int) -> Int;
extern fn khora_net_accept(handle: Int, address: Ptr, length: Ptr) -> Int;
extern fn khora_net_set_timeout(handle: Int, millis: Int) -> I32;
extern fn khora_net_forget(handle: Int) -> ();
extern fn khora_net_connect(host: Ptr, host_len: Int, port: Int, deadline: Int) -> Int;
extern fn khora_net_set_deadline(handle: Int, deadline: Int) -> I32;
extern fn khora_net_expired(handle: Int) -> I32;
extern fn khora_net_close(handle: Int) -> I32;
extern fn khora_net_local_port(handle: Int) -> Int;
extern fn khora_net_peer_port(handle: Int) -> Int;
extern fn khora_net_accepted_open() -> Int;

/// `INVALID_SOCKET` is `(SOCKET)~0`, which read as a signed handle is -1.
pub fn invalid_handle() -> Int { -1 }

/// Winsock has to be told which version of itself to be, once per process.
///
/// `MAKEWORD(2, 2)` is 0x0202. The 512 bytes are a `WSADATA`, which the call
/// fills in and nothing here reads — it is an out-parameter that has to exist.
pub fn start() -> Bool {
  let data: Array<U8> = Array::new(512, 0);
  Array::with_data(data, fn (buffer, _n) => WSAStartup(U16::of(514), buffer) == I32::of(0))
}

/// A socket listening on `port` on every IPv4 interface, or
/// [`invalid_handle`] when the bind or the listen fails or `port` is not
/// 0 to 65535.
///
/// **`[permissions] listen` governs this**, and is checked before anything
/// is made, against `0.0.0.0:<port>`: the address as it is bound, every
/// interface, so `8080` and `8000-8099` in a manifest cover it. Port `0`,
/// which lets the operating system choose, is covered by `0` or `*` alone. A
/// refusal raises `SocketError::Denied` with that address -- the same case a
/// refused connect raises, so the key to change is `listen` because this is
/// the call that raised it -- and no socket is made, so nothing is bound and
/// the port stays free.
///
/// **A port outside 0 to 65535 binds nothing**, under any grant: it is not a
/// port, and the sixteen bits a socket address holds would have bound
/// another one (`70000` is 4464) that `*` then covered.
///
/// **Nothing that can stop runs after the socket is made**, so a fiber
/// canceled inside this call either has no socket yet or gets it back, and
/// `acquire(listen_on(port)!, fn s => shut(s))` always closes what it opened.
/// The socket is made last, inside the lambda that lends the address,
/// because that lambda checks for a cancellation when it is entered. The
/// check raises before it.
pub fn listen_on(port: Int) -> Int raises SocketError {
  if port < 0 || port > 65535 {
    invalid_handle()
  } else if !may_listen(port) {
    raise SocketError::Denied(every_interface(port))
  } else {
    let address = sockaddr_in(port);
    Array::with_data(address, fn (bytes, _n) => listening(bytes))
  }
}

/// [`listen_on`]'s calls, with the address already lent. Calls no function
/// value, so nothing in it can stop.
fn listening(address: Ptr) -> Int {
  // AF_INET, SOCK_STREAM, IPPROTO_TCP.
  let handle = socket(I32::of(2), I32::of(1), I32::of(6));
  // Non-blocking from here on, so that a fiber waiting for a connection gives
  // its worker back. A listener that could not be prepared is still a working
  // listener — the retry loops in the runtime simply never see a would-block —
  // so this is not worth failing over.
  khora_net_prepare(handle);
  if handle == invalid_handle() {
    handle
  } else {
    // **No `SO_REUSEADDR` here, deliberately, unlike Linux and macOS.**
    //
    // The other two set it so that restarting a service inside the `TIME_WAIT`
    // window works. On Windows the same option means something else: it lets a
    // *live* socket be bound over, which Microsoft's own documentation calls
    // hijacking and says makes a server "not secure". Windows does not refuse
    // the rebind this would be working around, so setting it would buy a
    // vulnerability and fix nothing.
    //
    // `SO_EXCLUSIVEADDRUSE` is the option a Windows server is supposed to set,
    // and it is a separate decision from this one: it would make two Khora
    // services on one port fail earlier and more clearly rather than changing
    // what works today.
    let bound = bind(handle, address, I32::of(16));
    // **511, not 16.** The backlog is the queue of connections the kernel has
    // accepted and this program has not yet taken, which is to say it *is* the
    // buffer `bounded_nursery` means when it says overload "becomes latency
    // instead of collapse": a server bounded to 256 concurrent connections
    // absorbs a burst here or refuses it at the TCP layer, where a client sees
    // a failed connect rather than a slow answer.
    //
    // It was 16, which is smaller than any of the bounds above it, and a load
    // test of twenty-four clients found it by hanging. 511 is nginx's default
    // and the number every kernel clamps to its own maximum, so it is a
    // request rather than an assertion about the machine.
    if bound == I32::of(0) && listen(handle, I32::of(511)) == I32::of(0) {
      handle
    } else {
      closesocket(handle);
      invalid_handle()
    }
  }
}

/// The sixteen bytes of a `sockaddr_in` bound to every interface.
///
/// ```text
/// 0..2   sin_family  AF_INET, native order
/// 2..4   sin_port    network order, which is big-endian
/// 4..8   sin_addr    INADDR_ANY, which is zero
/// 8..16  padding
/// ```
///
/// Written out rather than bound, because a struct cannot cross the C ABI and
/// sixteen bytes is not worth a runtime function. The port is the only part
/// that is not a constant, and its two bytes are the one place a reader has to
/// remember that the network is big-endian and the machine is not.
fn sockaddr_in(port: Int) -> Array<U8> {
  let out: Array<U8> = Array::new(16, 0);
  Array::set(out, 0, 2);
  Array::set(out, 2, U8::of(Int::and(Int::shr(port, 8), 255)));
  Array::set(out, 3, U8::of(Int::and(port, 255)));
  out
}

/// Waits for a connection. [`invalid_handle`] if the wait failed.
pub fn accept_on(server: Int) -> Int {
  let taken = khora_net_accept(server, Ptr::null(), Ptr::null());
  if taken < 0 { taken } else {
    // Prepared here rather than inside the runtime's `accept`, so that every
    // decision about a new socket is in one visible place instead of half
    // here and half there.
    khora_net_prepare(taken);
    taken
  }
}

/// How long a read will wait before giving up, in milliseconds.
///
/// **A server needs this or it has no way to stop listening to a client that
/// has stopped talking.** Reading until the request is complete is the only
/// correct thing to do — a client is allowed to send its headers and its body
/// in separate writes, and most do — but "until complete" and "forever" are
/// the same loop without a deadline, and a fiber parked in `recv` is a fiber
/// that never comes back.
///
/// Windows takes a `DWORD` of milliseconds here, where Berkeley takes a
/// `struct timeval`. Same option, two shapes, which is why this lives beside
/// the other target-specific pieces rather than next to `receive`.
///
/// **No longer `SO_RCVTIMEO`, and it could not be.** Winsock's option applies
/// to a call that would have blocked, and a socket the reactor drives never
/// has one — so it goes silently inert the moment the socket is prepared, and
/// the client this exists to shed would park a fiber for ever instead.
///
/// The runtime keeps the deadline and a scheduler timer enforces it. A read
/// that runs out still comes back negative, which is what every caller here
/// already treats as a connection to give up on.
pub fn set_receive_timeout(handle: Int, millis: Int) -> Bool {
  khora_net_set_timeout(handle, millis) == I32::of(0)
}

/// Holds every later read and write on `handle` to `clock.monotonic_millis()`
/// reaching `deadline`. Negative clears it.
///
/// **One bound for a whole exchange**, where [`set_receive_timeout`] bounds
/// each read on its own and is renewed by every byte, so a peer that sends
/// one byte a second never trips it. Both apply when both are set: a read
/// gives up at whichever comes first, and comes back negative.
pub fn set_deadline(handle: Int, deadline: Int) -> Bool {
  khora_net_set_deadline(handle, deadline) == I32::of(0)
}

/// Whether the deadline from [`set_deadline`] is what ended a read or write
/// on this connection.
///
/// **The read's own account, not the clock's.** A read that came back
/// negative just after the deadline may have failed for another reason --
/// the peer reset the connection in the last millisecond -- and a caller
/// telling a timeout from a broken peer by the time would call that a
/// timeout. This says what the read itself gave up on. It stays true until
/// the deadline is set again.
pub fn expired(handle: Int) -> Bool {
  khora_net_expired(handle) == I32::of(1)
}

/// Reads what has arrived into `buffer`, and says how many bytes that was.
///
/// Zero means the other end closed; negative means the read failed.
pub fn receive(connection: Int, buffer: Array<U8>) -> Int {
  Array::with_data(buffer, fn (into, n) =>
    khora_net_recv(connection, into, n))
}

/// Writes all of `text`, waiting for room when the peer is slow, and says how
/// many bytes went: every one of them, or a negative number if the write
/// failed. After a failure some of `text` may have gone, so the connection is
/// no longer in step with its peer.
///
/// A peer that has reset the connection (a killed client, a load balancer)
/// is a failed write like any other: the write returns a negative number,
/// and no `SIGPIPE` stops the program.
pub fn transmit(connection: Int, text: String) -> Int {
  String::with_data(text, fn (from, n) =>
    khora_net_send(connection, from, n))
}

/// Why [`connect_to`], [`connect_by`] or [`listen_on`] has no socket to give.
///
/// **What this prevents: a refusal read as a socket.** A failure answered as
/// a negative number is a failure every caller has to remember to test for,
/// and one that tests the wrong number carries on with a handle that is not
/// one. Raised, it cannot be missed, and the handle a connect does give back
/// is always a connected socket. [`listen_on`] raises only the refusal: a
/// bind the operating system refuses is still [`invalid_handle`].
///
/// `host` is `name:port`, as the caller wrote the name, which is what a grant
/// in `[permissions] network` is written against; for [`listen_on`] it is
/// `0.0.0.0:<port>`, the address a grant in `[permissions] listen` covers.
///
/// **The value does not say which key refused it; the call does.** A refused
/// [`connect_to`] or [`connect_by`] is `[permissions] network`, and a refused
/// [`listen_on`] is `[permissions] listen`, and `Denied(0.0.0.0:8080)` prints
/// the same from either. A caller that reports one should name the key from
/// the call it made.
derive(Show, Eq)
pub type SocketError =
  /// The manifest does not grant this, so nothing was looked up, dialed or
  /// bound: from a connect, `[permissions] network` does not grant `host`;
  /// from [`listen_on`], `[permissions] listen` does not grant the address.
  ///
  /// **Its own case rather than `Unreachable`**, for the reason
  /// `IoError::Denied` is: `Unreachable` sends the reader to DNS or a
  /// firewall, and this one is a line in `khora.toml`.
  | Denied(host: String)
  /// The name did not resolve, or nothing at any address it resolved to
  /// accepted the connection.
  | Unreachable(host: String)
  /// The deadline given to [`connect_by`] passed before the connection was
  /// made.
  ///
  /// Only when the deadline is what ended it, as the runtime reports it, so
  /// a refusal that arrives in the deadline's last millisecond is still
  /// `Unreachable`. Separate because a caller acts on it differently: a host
  /// that refused may refuse again, while a call that ran out of time mostly
  /// wants a longer budget.
  | TimedOut(host: String);

/// Opens a connection to `host` on `port`, and answers the connected socket.
///
/// Raises `SocketError::Denied` when `[permissions] network` does not grant
/// the host, and `SocketError::Unreachable` when the name does not resolve or nothing
/// at any of its addresses accepts. Every failure raises, so the handle that
/// comes back is always a socket and no caller has a number to test.
///
/// **The first thing here that starts a conversation.** Everything else in this
/// module grew from serving: `listen_on`, `accept_on`, and nothing that dials.
/// A database driver is the first caller that needs the other direction.
///
/// **`[permissions] network` is checked first**, against `host:port` as
/// written, with the rule `HttpClient::send` uses: a grant with no port covers
/// every port, and `*` spans dots. A refused host is not looked up and not
/// dialed, so nothing on the network hears what the program wanted.
///
/// `host` may be a name or an address, and an IPv6 address may be written in
/// brackets as a URL writes it -- `[::1]` -- or without; `[::1]:5432` in a
/// manifest covers both. Resolution,
/// address family and the
/// platform's own resolver are the runtime's, which is why this is one extern
/// rather than `getaddrinfo` and two `sockaddr` layouts written three times.
/// [The ffi design note](https://github.com/codyspate/khoralang/blob/main/docs/design/ffi.md) is the boundary and `khora_net_connect` is on the far
/// side of it. Every address the name resolves to is tried in turn, and the
/// first that accepts is the connection.
///
/// **A cancellation point, and it costs the fiber's worker nothing while it
/// waits.** The connect waits on the reactor, as `accept_on` does, so a fiber
/// canceled while dialing a host that never answers stops at once rather
/// than when the operating system gives up, which can be minutes. A name
/// lookup cannot be waited on that way; it runs on the blocking pool, and a
/// canceled caller stops waiting for it and leaves it to finish alone.
pub fn connect_to(host: String, port: Int) -> Int raises SocketError {
  if !may_reach(host, port) {
    raise SocketError::Denied(authority(host, port))
  } else {
    // The extern itself rather than `connect_by`, so that the compiler sees a
    // runtime export called right here and checks for a cancel at this call.
    let handle = String::with_data(unbracketed(host), fn (from, n) => khora_net_connect(from, n, port, -1));
    if handle >= 0 { handle } else { raise not_connected(handle, host, port) }
  }
}

/// [`connect_to`], giving up once `clock.monotonic_millis()` reaches
/// `deadline`, which raises `SocketError::TimedOut`.
///
/// The deadline covers the lookup and the connect. It is an instant rather
/// than a length, so that a caller with one budget for several steps hands
/// each the same number. Negative means none. The connection that comes back
/// carries no deadline; [`set_deadline`] puts one on it.
///
/// `[permissions] network` governs this, as it does [`connect_to`]: a
/// refusal is `SocketError::Denied` before anything is looked up.
pub fn connect_by(host: String, port: Int, deadline: Int) -> Int raises SocketError {
  if !may_reach(host, port) {
    raise SocketError::Denied(authority(host, port))
  } else {
    let handle = String::with_data(unbracketed(host), fn (from, n) => khora_net_connect(from, n, port, deadline));
    if handle >= 0 { handle } else { raise not_connected(handle, host, port) }
  }
}

/// The `SocketError` for `khora_net_connect`'s negative answer: -2 when the
/// deadline ended the connect, and -1 for every other way it failed.
///
/// **The runtime's account, not the clock's**, so a refusal that lands in
/// the deadline's last millisecond is `Unreachable` and not `TimedOut`.
fn not_connected(answer: Int, host: String, port: Int) -> SocketError {
  if answer == -2 {
    SocketError::TimedOut(authority(host, port))
  } else {
    SocketError::Unreachable(authority(host, port))
  }
}

/// `host:port`, as a grant in `[permissions] network` would name it.
///
/// An IPv6 address written without brackets gets them, so that `::1` on
/// 5432 reads `[::1]:5432` -- the spelling a manifest needs -- and not
/// `::1:5432`, which says neither which port nor which address.
fn authority(host: String, port: Int) -> String {
  if String::contains(host, ":") && !String::starts_with(host, "[") {
    "[${host}]:${Int::to_string(port)}"
  } else {
    "${host}:${Int::to_string(port)}"
  }
}

/// How many connections [`accept_on`] has returned that nothing has closed
/// yet, across the whole program.
///
/// **For a test that a connection it refused was closed.** A handle dropped
/// without [`shut`] shows only in the process's descriptor table, which
/// Windows cannot list; this count is kept by the runtime on every system.
///
/// What it costs: nothing extra, since the runtime keeps the count for every
/// accept anyway. It counts every fiber's accepts, so a test reads it where
/// nothing else is accepting.
pub fn accepted_open() -> Int {
  khora_net_accepted_open()
}

/// Whether `accepted`, a connection [`accept_on`] returned, is the other end
/// of `dialed`, a connection this program made with [`connect_to`] or
/// [`connect_by`].
///
/// **What this prevents: a program that dials its own listener being handed
/// somebody else's connection as its own.** macOS and Windows let a wildcard
/// listener share a port with another program's specific one, so what the
/// listener accepts need not be what this program dialed. The two are one
/// connection exactly when the accepted end's peer port is the dialed end's
/// own port. False for a handle that is not a connected socket.
///
/// What it costs: two system calls, `getpeername` and `getsockname`.
pub fn connected_to(accepted: Int, dialed: Int) -> Bool {
  let theirs = khora_net_peer_port(accepted);
  theirs >= 0 && theirs == khora_net_local_port(dialed)
}

/// Whether `[permissions] network` lets this program dial `host` on `port`.
/// `host` may be an IPv6 literal with or without brackets; a host with any
/// other bracket in it is refused. `std::permissions::may_dial` says why.
fn may_reach(host: String, port: Int) -> Bool {
  may_dial(network(), host, port)
}

/// Whether `[permissions] listen` lets this program bind `port` on every
/// IPv4 interface, which is what [`listen_on`] binds.
fn may_listen(port: Int) -> Bool {
  granted_listen(listen_grants(), every_interface(port))
}

/// `0.0.0.0:<port>`: the address [`listen_on`] binds, as a grant in
/// `[permissions] listen` names it.
fn every_interface(port: Int) -> String {
  "0.0.0.0:${Int::to_string(port)}"
}

/// Writes all of `bytes`, and says how many went: every one of them, or a
/// negative number if the write failed, as for [`transmit`].
///
/// [`transmit`] takes a `String`, which is right for a protocol made of text
/// and wrong for one made of bytes: a wire protocol frames its messages with a
/// length nobody wrote as characters.
pub fn transmit_bytes(connection: Int, bytes: Array<U8>) -> Int {
  Array::with_data(bytes, fn (from, n) => khora_net_send(connection, from, n))
}

/// Closes a connection, letting the other end finish first.
///
/// **A bare close is a lost answer.** Closing while the peer is still writing
/// sends an RST, and an RST discards whatever the peer had not read yet —
/// including the response just written to it. It surfaces as a client reporting
/// no answer at all, only under load, only sometimes: exactly what refusing an
/// oversized request with a 413 does, because the server decides at eight
/// kilobytes and the client is still sending the ninth.
///
/// So: say there is nothing more coming, read off what is still arriving until
/// the peer stops, and only then close. `SD_SEND` is 1.
///
/// The drain takes what has **already** arrived and never waits for more, and
/// that is the bound. A read that suspends until something comes would hold
/// `shut` for as long as a peer keeps the connection open and says nothing —
/// which is until the kernel abandons the half-closed connection by itself,
/// two minutes on Windows and one on Linux. A receive deadline shortens that
/// wait wherever a caller has set one, and most callers have not.
pub fn shut(handle: Int) -> () {
  shutdown(handle, I32::of(1));
  drain(handle, 8);
  // The runtime remembers this socket's receive deadline, and handles are
  // reused: without this, the next connection handed the same number would
  // inherit it.
  khora_net_forget(handle);
  khora_net_close(handle);
}

/// Reads what has already arrived, without waiting for more.
///
/// Zero means the other end closed. Negative means nothing can be read now:
/// `-1` because nothing has arrived yet, anything lower because the read
/// failed (the peer reset the connection, say). A caller that only wants to
/// stop reading treats every negative alike; one checking whether a
/// connection is still usable tells them apart with `nothing_yet`. The one
/// to reach for when the bytes are worth waiting for is `receive`; this is
/// for `shut`, which wants only what is already in hand.
pub fn receive_now(connection: Int, buffer: Array<U8>) -> Int {
  Array::with_data(buffer, fn (into, n) => khora_net_recv_now(connection, into, n))
}

/// Whether a `receive_now` result means only that nothing has arrived yet.
///
/// **What this prevents: a reset connection taken for a quiet one.** Both
/// answer `receive_now` with a negative; only this one is still usable, and
/// writing to the other ends the process on the platforms that raise
/// `SIGPIPE`.
pub fn nothing_yet(read: Int) -> Bool { read == -1 }

/// Reads and discards what has already arrived, at most `rounds` times.
fn drain(handle: Int, rounds: Int) -> () {
  if rounds <= 0 {
  } else {
    let leftovers: Array<U8> = Array::new(1024, 0);
    let read = receive_now(handle, leftovers);
    if read <= 0 {} else { drain(handle, rounds - 1) }
  }
}
