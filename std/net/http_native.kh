module std::net::http;

import std::core::{Array, ChildFailed, Eq, Fiber, List, Map, Nursery, Option, Result, Scope, SharedFn, Show, Split, acquire, attempt, bounded_nursery, scoped};
import std::permissions::{granted_host};
import std::permissions::grants::{network};
import std::net::socket::{accept_on, connect_to, invalid_handle, listen_on, receive, set_receive_timeout, shut, start, transmit};
import std::net::tls::{TlsClient, TlsConnection, TlsError, TlsServer, client as tls_client, connect as tls_connect, receive as tls_receive, secure, server as tls_server, set_receive_timeout as tls_set_receive_timeout, shut as tls_shut, transmit as tls_transmit};
import std::json::{encode};
import std::schema::{Encode, Raw};

//! HTTP/1.1, over the sockets in `std::net::socket`. Both directions.
//!
//! The specification does not define `std::net::http`; the shape here was
//! reconstructed from how the reference application uses it, and every line
//! below it is Khora over `String::slice`, `String::index_of` and `Map`.
//!
//! **Answering**: a request line with its query string, headers, a body read
//! to the length the headers promised, routing on method and path with `:name`
//! segments, and a response that can carry headers of its own. On a fiber per
//! connection, which took a language feature to reach rather than a line here
//! — see `Router::serve_once`.
//!
//! **Asking**: `HttpClient`, a capability, from `Call` to `Answer`. A service
//! that cannot call another service is not one, and this half arrived a long
//! way after the first.
//!
//! What neither does: content negotiation, multipart bodies, compression, or
//! following a redirect. Each is absent deliberately rather than forgotten.
//! Chunked transfer is *read* by the client and not written by the server,
//! which is the split real traffic has: a response of unknown length is
//! ordinary and a request of unknown length is not.
//!
//! A connection is reached through a `Transport`, which is three closures, so
//! that the serving path is written once, `Router::listen` and
//! `Router::listen_tls` differ only in what they hand it, and the client
//! reuses both without knowing which it has.

/// The five verbs this server routes on.
///
/// Not every verb HTTP defines: `HEAD`, `OPTIONS` and `TRACE` are answered by
/// the server rather than routed to a handler, and a method nobody can mount a
/// route for is not worth a case here. `of` returns `None` for the rest, which
/// becomes a 400 rather than a panic.
pub type Method =
  | Get
  | Post
  | Put
  | Patch
  | Delete;

impl Method {
  /// The method this text names, or `None`.
  ///
  /// Case-sensitive, because HTTP methods are: `get` is not `GET`, and a
  /// server that accepted it would be lenient about the one part of the
  /// request line that has never been ambiguous.
  pub fn of(text: String) -> Option<Method> {
    if text == "GET" {
      Option::Some(Method::Get)
    } else if text == "POST" {
      Option::Some(Method::Post)
    } else if text == "PUT" {
      Option::Some(Method::Put)
    } else if text == "PATCH" {
      Option::Some(Method::Patch)
    } else if text == "DELETE" {
      Option::Some(Method::Delete)
    } else {
      Option::None
    }
  }

  /// Whether these are the same method.
  ///
  /// `Method` predates `derive(Eq)` reaching this file; `rank` is what it
  /// compares on.
  pub fn same(self, other: Method) -> Bool {
    Method::rank(self) == Method::rank(other)
  }

  /// A number per method, so `same` has something to compare.
  ///
  /// **Not a wire value and not an order.** Nothing outside this module should
  /// read it; it exists because comparing two variants needed one integer.
  fn rank(self) -> Int {
    match self {
      Method::Get => 0,
      Method::Post => 1,
      Method::Put => 2,
      Method::Patch => 3,
      Method::Delete => 4,
    }
  }
}

/// The path parameters a route matched: `/analyze/:account_id` against
/// `/analyze/acc_9921` binds `account_id`.
pub type Params = {
  bound: Map<String, String>,
};

impl Params {
  /// No parameters bound. What a route with no `:name` in it matches with.
  pub fn empty() -> Params { { bound: Map::new() } }

  /// `Option::None` when the route did not declare that parameter, which is a
  /// programming error the type makes you notice rather than an empty string.
  pub fn get(self, name: String) -> Option<String> {
    Map::get(self.bound, name)
  }
}

/// One request, parsed: the verb, the path, what the route bound, the query,
/// the headers and the body.
///
/// **Everything is decoded on arrival**, once. A handler reading three query
/// parameters and two headers does no parsing at all — the maps below are
/// already built, and the header names are already lowercased.
pub type Request = {
  method: Method,
  /// The path with the query string taken off: `/analyze/acc_1?deep=true` has
  /// a path of `/analyze/acc_1`. Routes match against this, so mounting
  /// `/analyze/:id` does not stop working the moment a client adds a
  /// parameter.
  path: String,
  params: Params,
  /// Decoded once, when the request arrives, rather than on every lookup — a
  /// handler that reads three parameters should not decode the query three
  /// times.
  queries: Map<String, String>,
  /// Keyed by the **lowercased** name, because HTTP header names are
  /// case-insensitive and a map is not. Folding the case here rather than in
  /// `header` means two headers differing only in case collide on arrival,
  /// which is the correct reading: they are the same header.
  headers: Map<String, String>,
  body: String,
};

impl Request {
  /// A GET request for `path`, with no parameters matched yet. Chiefly for
  /// tests: a real one arrives from a socket.
  pub fn get(path: String) -> Request {
    Request::of(Method::Get, path, "")
  }

  /// A POST to `path` carrying `body`. For tests, like `get`.
  pub fn post(path: String, body: String) -> Request {
    Request::of(Method::Post, path, body)
  }

  /// The query string is honoured here too, so a hand-built request behaves
  /// like one off the wire. A test that writes `Request::get("/x?a=1")` and
  /// finds no `a` would be testing the constructor rather than the code.
  pub fn of(method: Method, target: String, body: String) -> Request {
    let split = split_target(target);
    {
      method: method,
      path: split.head,
      params: Params::empty(),
      queries: parse_query(split.rest),
      headers: Map::new(),
      body: body,
    }
  }

  /// A query parameter, already percent-decoded.
  ///
  /// A parameter written with no `=` — `/x?verbose` — is present with an empty
  /// value, which is how every server reads it and what lets a handler ask
  /// "was this requested" rather than "what does it say".
  pub fn query(self, name: String) -> Option<String> {
    Map::get(self.queries, name)
  }

  /// A header, by a name in any case.
  ///
  /// `Host`, `host` and `HOST` are one header. The RFC says so, and this is
  /// the half of it that everybody gets wrong.
  pub fn header(self, name: String) -> Option<String> {
    Map::get(self.headers, lowered(name))
  }
}

/// One header on the way out.
pub type Header = {
  name: String,
  value: String,
};

/// What a handler answers with: a status, a body, its type, and any extra
/// headers.
///
/// `json` and `text` build the two common ones. `with_header` adds to either,
/// and returns a new response rather than changing the one it was given.
pub type Response = {
  status: Int,
  body: String,
  content_type: String,
  /// Anything beyond the three a response always carries. A list rather than a
  /// map, because `Set-Cookie` may legitimately appear more than once and a
  /// map would silently keep only the last.
  headers: List<Header>,
};

impl Response {
  /// Encodes `body` as JSON and sends it with the given status.
  ///
  /// `A: Encode`, so a derived record, a `Json` built by hand and a list of
  /// `Rejection`s all serve: `Response::json(422, problems)` is the body a
  /// client reads a refused request from. A record holding a secret has no
  /// `Encode`, so it cannot be sent by accident.
  pub fn json<A: Encode>(status: Int, body: A) -> Response {
    {
      status: status,
      body: encode(Raw::to_json(body.encode())),
      content_type: "application/json",
      headers: List::Nil,
    }
  }

  /// `body` as `text/plain`, with the given status.
  pub fn text(status: Int, body: String) -> Response {
    { status: status, body: body, content_type: "text/plain", headers: List::Nil }
  }

  /// The same response with one more header on it.
  ///
  /// A new response rather than a mutated one: a half-built response cannot be
  /// shared and then changed underneath its other holder.
  pub fn with_header(self, name: String, value: String) -> Response {
    {
      status: self.status,
      body: self.body,
      content_type: self.content_type,
      headers: List::Cons({ name: name, value: value }, self.headers),
    }
  }

  /// The response, as bytes on the wire.
  pub fn rendered(self) -> String { Response::rendered_keeping(self, false) }

  /// The same, saying whether the connection is staying open.
  ///
  /// **Reuse is worth two orders of magnitude and nothing else here is.**
  /// Measured on this machine, one server answering the same request: 6,116 a
  /// second on a fresh connection each time, 1,129,782 on one held open. The
  /// handshake, the teardown and the port churn were the whole cost; the
  /// server was never the bottleneck. That is also why comparing this to a
  /// server benchmarked with keep-alive was comparing two different questions.
  ///
  /// `Content-Length` is on every response already, which is what makes this
  /// safe: a client knows where the body ends and where the next answer
  /// begins without the connection closing to tell it.
  pub fn rendered_keeping(self, keep: Bool) -> String {
    "HTTP/1.1 " + Int::to_string(self.status) + " " + Response::reason(self.status) + "\r\n"
    + "Content-Type: " + self.content_type + "\r\n"
    + "Content-Length: " + Int::to_string(String::byte_length(self.body)) + "\r\n"
    + Response::extra(self.headers)
    + (if keep { "Connection: keep-alive\r\n" } else { "Connection: close\r\n" })
    + "\r\n"
    + self.body
  }

  /// The caller's own headers. `with_header` prepends, so the most recently
  /// added is written first — which no client cares about, and saying so here
  /// is cheaper than reversing a list to make it look tidy.
  fn extra(headers: List<Header>) -> String {
    match headers {
      List::Nil => "",
      List::Cons(h, rest) => h.name + ": " + h.value + "\r\n" + Response::extra(rest),
    }
  }

  /// The reason phrase for a status.
  ///
  /// The ones a service actually sends, which has twice turned out to be more
  /// than the list had. The link shortener answered a redirect and got
  /// `HTTP/1.1 302 Unknown` on the wire; later a service under load answered
  /// 503 and got the same. A phrase is advisory — every client reads the
  /// number — but one that says `Unknown` about a status the server
  /// deliberately chose reads as a bug to whoever is holding the packet
  /// capture, and it was.
  ///
  /// **The whole of 5xx is here now**, because that is the family a server
  /// sends about *itself*: 503 under backpressure, 502 and 504 from anything
  /// with a proxy in front of it, 501 for a method it does not implement.
  /// Those are the lines somebody reads at three in the morning.
  ///
  /// A `match` rather than a chain of `else if`s. Twenty-seven of them in a
  /// row is a table pretending to be control flow, and a table should look
  /// like one -- the numbers are in order here, so a missing status is
  /// something a reader can see rather than something they have to search for.
  ///
  /// 413 stays "Payload Too Large" although RFC 9110 renames it "Content Too
  /// Large". That is a wire string somebody may be matching on, and changing
  /// it is a decision of its own rather than something to slip into a list of
  /// additions.
  pub fn reason(status: Int) -> String {
    match status {
      200 => "OK",
      201 => "Created",
      202 => "Accepted",
      204 => "No Content",
      301 => "Moved Permanently",
      302 => "Found",
      304 => "Not Modified",
      400 => "Bad Request",
      401 => "Unauthorized",
      402 => "Payment Required",
      403 => "Forbidden",
      404 => "Not Found",
      405 => "Method Not Allowed",
      406 => "Not Acceptable",
      409 => "Conflict",
      410 => "Gone",
      413 => "Payload Too Large",
      415 => "Unsupported Media Type",
      422 => "Unprocessable Content",
      428 => "Precondition Required",
      429 => "Too Many Requests",
      431 => "Request Header Fields Too Large",
      500 => "Internal Server Error",
      501 => "Not Implemented",
      502 => "Bad Gateway",
      503 => "Service Unavailable",
      504 => "Gateway Timeout",
      _other => "Unknown",
    }
  }
}

/// What can go wrong that is the *server's* problem rather than a client's.
///
/// A malformed request from a client is answered with a 400 and never reaches
/// here — that is a response, not an error. These two are the cases where
/// there is nobody to answer: the port would not bind, or a request could not
/// be read at all.
derive(Show, Eq)
pub type HttpError =
  | BindFailed(port: Int)
  | MalformedRequest(details: String);

// ---------------------------------------------------------------------------
// Bytes and text
// ---------------------------------------------------------------------------
//
// Written with `while` rather than as folds. Everything else in `std` walks a
// string by recursion, and for a few dozen characters that is the nicer shape
// — but a header block is thousands of bytes and one stack frame each buys
// nothing.

/// `text` with every ASCII letter in lower case.
///
/// ASCII only, deliberately: this exists for header names, which the RFC
/// restricts to ASCII, and case in every other alphabet is a question no
/// answer to which fits in six lines.
fn lowered(text: String) -> String {
  lowered_between(text, 0, String::byte_length(text))
}

/// `text[from .. to]`, lowercased.
///
/// **Takes a range rather than a string** so that the caller does not have to
/// cut one out first. A header name is read out of the middle of the request
/// exactly once, and slicing it before lowercasing it would allocate a string
/// whose only use is to be walked and thrown away.
fn lowered_between(text: String, from: Int, to: Int) -> String {
  let count = to - from;
  if count <= 0 {
    ""
  } else {
    let out: Array<U8> = Array::new(count, 0);
    let mut i = 0;
    while i < count {
      let c = U8::to_int(String::byte(text, from + i));
      let shifted = if c >= 65 && c <= 90 { c + 32 } else { c };
      Array::set(out, i, U8::of(shifted));
      i = i + 1;
    }
    String::from_bytes(out)
  }
}

/// `text` without leading or trailing spaces and tabs.
fn trimmed(text: String) -> String {
  trimmed_between(text, 0, String::byte_length(text))
}

/// `text[from .. to]` without leading or trailing spaces and tabs.
///
/// The same reasoning as `lowered_between`, and it pays better: the ends move
/// inwards over the original bytes and only the part that survives is ever
/// copied.
fn trimmed_between(text: String, from: Int, to: Int) -> String {
  let mut start = from;
  while start < to && blank(String::byte(text, start)) {
    start = start + 1;
  }
  let mut end = to;
  while end > start && blank(String::byte(text, end - 1)) {
    end = end - 1;
  }
  String::slice(text, start, end)
}

fn blank(byte: U8) -> Bool {
  let c = U8::to_int(byte);
  c == 32 || c == 9
}

/// The leading digits of `text`, as a number.
///
/// Stops at the first character that is not a digit, and at a value no server
/// should be asked to hold. The cap is not politeness: `value * 10` **traps**
/// on overflow, so a twenty-digit `Content-Length` would stop the process
/// rather than the request. Refusing to read past it turns a crash into a 413.
fn digits_of(text: String) -> Int {
  let length = String::byte_length(text);
  let mut value = 0;
  let mut i = 0;
  let mut going = true;
  while going && i < length {
    let c = U8::to_int(String::byte(text, i));
    if c >= 48 && c <= 57 && value <= 100000000 {
      value = value * 10 + (c - 48);
      i = i + 1;
    } else {
      going = false;
    }
  }
  value
}

/// One hex digit's value, or `None` for anything else.
fn hex_value(byte: U8) -> Option<Int> {
  let c = U8::to_int(byte);
  if c >= 48 && c <= 57 {
    Option::Some(c - 48)
  } else if c >= 97 && c <= 102 {
    Option::Some(c - 87)
  } else if c >= 65 && c <= 70 {
    Option::Some(c - 55)
  } else {
    Option::None
  }
}

/// The byte that two hex digits at `at` spell, if they are two hex digits.
fn hex_pair(text: String, at: Int) -> Option<Int> {
  if at + 1 >= String::byte_length(text) {
    Option::None
  } else {
    match hex_value(String::byte(text, at)) {
      Option::None => Option::None,
      Option::Some(high) => match hex_value(String::byte(text, at + 1)) {
        Option::None => Option::None,
        Option::Some(low) => Option::Some(high * 16 + low),
      },
    }
  }
}

/// `%20` becomes a space, and so does `+`.
///
/// A `%` not followed by two hex digits stays a literal `%`. Refusing the
/// whole parameter would be defensible and is not what any browser or server
/// does, and a query string is not the place to be the only strict one.
///
/// The decoded form is never longer than the encoded one, so a buffer of the
/// input's length is always enough and there is nothing to grow.
pub fn percent_decode(text: String) -> String {
  let length = String::byte_length(text);
  if length == 0 {
    ""
  } else {
    let out: Array<U8> = Array::new(length, 0);
    let mut at = 0;
    let mut written = 0;
    while at < length {
      let here = U8::to_int(String::byte(text, at));
      if here == 37 {
        match hex_pair(text, at + 1) {
          Option::Some(value) => {
            Array::set(out, written, U8::of(value));
            written = written + 1;
            at = at + 3;
          },
          Option::None => {
            Array::set(out, written, String::byte(text, at));
            written = written + 1;
            at = at + 1;
          },
        };
      } else if here == 43 {
        Array::set(out, written, U8::of(32));
        written = written + 1;
        at = at + 1;
      } else {
        Array::set(out, written, String::byte(text, at));
        written = written + 1;
        at = at + 1;
      }
    }
    // A valid escape can spell a byte that is not text — `%FF` is not UTF-8 —
    // and `from_bytes` stops the program rather than pretend. A parameter
    // nobody can read as text is dropped instead of taking the server with it.
    let taken = Array::prefix(out, written);
    if Array::is_utf8(taken) { String::from_bytes(taken) } else { "" }
  }
}

// ---------------------------------------------------------------------------
// Parsing
// ---------------------------------------------------------------------------

/// A request read off the wire.
pub fn parse(text: String) -> Option<Request> {
  match String::split_once(text, "\r\n") {
    Option::None => Option::None,
    Option::Some(lines) => match parse_request_line(lines.head) {
      Option::None => Option::None,
      Option::Some(head) => {
        let split = split_target(head.target);
        Option::Some({
            method: head.method,
            path: split.head,
            params: Params::empty(),
            queries: parse_query(split.rest),
            headers: parse_headers(lines.rest),
            body: body_of(lines.rest),
          })
      },
    },
  }
}

/// The first line of a request, before the target has been split.
///
/// Public because a caller parsing a request for its own reasons wants the
/// target as the client wrote it; `Request` carries the split version.
pub type RequestLine = {
  method: Method,
  /// The request target as written, query string and all. `parse` splits it;
  /// keeping it whole here means a caller reading a request line for its own
  /// reasons gets what the client actually sent.
  target: String,
};

fn parse_request_line(line: String) -> Option<RequestLine> {
  match String::split_once(line, " ") {
    Option::None => Option::None,
    Option::Some(after_method) => match Method::of(after_method.head) {
      Option::None => Option::None,
      Option::Some(method) => match String::split_once(after_method.rest, " ") {
        // `GET /path` with no version is still a request line worth honouring.
        Option::None => Option::Some({ method: method, target: after_method.rest }),
        Option::Some(after_path) => Option::Some({ method: method, target: after_path.head }),
      },
    },
  }
}

/// The path and the query string, either side of the first `?`.
fn split_target(target: String) -> Split {
  match String::split_once(target, "?") {
    Option::None => { head: target, rest: "" },
    Option::Some(parts) => parts,
  }
}

/// `a=1&b=hello%20world` as a map, decoded.
fn parse_query(text: String) -> Map<String, String> {
  let out: Map<String, String> = Map::new();
  fill_query(out, text);
  out
}

/// Every `name=value` in `text`, added to `out`.
///
/// A cursor for the reason `fill_headers` gives: a query string is as long as
/// the client wants it to be, and splitting off the front copies the rest of it
/// once per parameter.
fn fill_query(out: Map<String, String>, text: String) -> () {
  let end = String::byte_length(text);
  let mut at = 0;
  while at < end {
    let found = String::find(text, "&", at);
    let pair_end = if found < 0 { end } else { found };
    add_pair(out, text, at, pair_end);
    at = pair_end + 1;
  }
}

/// One `name=value` out of `pair[from .. to]`.
fn add_pair(out: Map<String, String>, pair: String, from: Int, to: Int) -> () {
  if from < to {
    let equals = String::find(pair, "=", from);
    if equals < 0 || equals >= to {
      // `?flag` with no value is the flag being present, which is what a
      // caller reading it as a switch expects.
      Map::insert(out, decoded_between(pair, from, to), "");
    } else {
      Map::insert(
        out,
        decoded_between(pair, from, equals),
        decoded_between(pair, equals + 1, to),
      );
    };
  }
}

/// `percent_decode` of `text[from .. to]`.
///
/// This one does cut the piece out, unlike its neighbours: a decoder has to
/// look at every byte anyway, so there is nothing to save by handing it a range
/// instead — and the piece it is given is a name or a value, not the whole
/// remaining query.
fn decoded_between(text: String, from: Int, to: Int) -> String {
  percent_decode(String::slice(text, from, to))
}

/// The headers, keyed by their lowercased names.
///
/// `rest` is everything after the request line; anything past the blank line
/// is the body and is not looked at here.
fn parse_headers(rest: String) -> Map<String, String> {
  let out: Map<String, String> = Map::new();
  let end = match String::index_of(rest, "\r\n\r\n") {
    Option::None => String::byte_length(rest),
    Option::Some(at) => at,
  };
  fill_headers(out, rest, end);
  out
}

/// Every header line in `block[.. end]`, added to `out`.
///
/// **A cursor rather than a split.** Written as `split_once` and recursion this
/// copied the whole of what was left over on every line: fifty headers meant
/// fifty copies of a shrinking block, which is quadratic in a number the client
/// chooses. Now the only strings built are the ones that are kept — the name
/// and the value — and the block itself is read in place.
fn fill_headers(out: Map<String, String>, block: String, end: Int) -> () {
  let mut at = 0;
  while at < end {
    let found = String::find(block, "\r\n", at);
    // No terminator before the end of the block: the last line runs to it.
    let line_end = if found < 0 || found > end { end } else { found };
    add_header(out, block, at, line_end);
    at = line_end + 2;
  }
}

/// One header out of `line[from .. to]`, if that is what it is.
fn add_header(out: Map<String, String>, line: String, from: Int, to: Int) -> () {
  let colon = String::find(line, ":", from);
  // A line with no colon is not a header. Dropping it rather than failing the
  // whole request is what a server does with a client's small mistakes.
  if colon >= 0 && colon < to {
    Map::insert(out, lowered_between(line, from, colon), trimmed_between(line, colon + 1, to));
  }
}

/// Everything after the blank line, or nothing.
fn body_of(rest: String) -> String {
  match String::index_of(rest, "\r\n\r\n") {
    Option::None => "",
    Option::Some(at) => String::slice(rest, at + 4, String::byte_length(rest)),
  }
}

// ---------------------------------------------------------------------------
// Reading a whole request
// ---------------------------------------------------------------------------

/// The most a request may be, headers and body together, unless a caller
/// says otherwise.
///
/// Eight kilobytes is what a buffer costs per connection, and a connection is
/// what a fiber costs — so this is the number that decides how many callers a
/// server can hold, not a guess about how big a request is. `Connection::holding`
/// takes another.
///
/// The buffer is allocated once at this size and never grows, which is what
/// makes a lying `Content-Length` harmless: the header is a promise about what
/// is coming, not an instruction to allocate.
///
/// **Eight kilobytes is a policy, not a limit of the parser.** Nothing here
/// recurses per byte or per line, so a larger request is refused because the
/// limit says so rather than because the parser cannot manage it: a
/// 39,808-byte request carrying 2,001 headers parses and answers when the
/// limit is raised to admit it.
///
/// The number stays at eight kilobytes anyway, which is what nginx and most
/// others allow, because the question it answers changed rather than
/// disappeared. It is no longer "how much can we survive" but "how much may an
/// unauthenticated client make a server hold", and that is a smaller number
/// than the one the stack would now permit.
pub fn default_limit() -> Int { 8192 }

fn limit() -> Int { default_limit() }

/// How many bytes to ask the socket for at a time.
fn chunk() -> Int { 4096 }

/// How to speak to one client, whatever is underneath.
///
/// **Three closures rather than a socket handle**, because a plain connection
/// and a TLS one differ in exactly these three operations and in nothing else
/// the router does. Before this the serving path took an `Int`, which is a
/// socket, and there was no way to put a handshake in front of it without
/// writing the whole path twice.
///
/// The cost is two indirect calls per request — one read, one write — against a
/// parse that performs several hundred reference-count operations. It did not
/// move the benchmark.
///
/// A record of closures is what an `effect` compiles to anyway
/// ([the effect-runtime design note](https://github.com/codyspate/khoralang/blob/main/docs/design/effect-runtime.md) §2), and this is not one only because a
/// transport belongs to a connection rather than to a computation: two fibers
/// serve two clients at once, and a capability installed by `with` would be
/// one of them.
pub type Transport = {
  /// Bytes into the buffer: how many, 0 when the peer closed, or -1.
  receive: (Array<U8>) -> Int,
  /// The text, all of it, or -1.
  transmit: (String) -> Int,
  /// Ends the conversation and releases whatever is underneath.
  shut: () -> (),
};

/// A transport over a plain socket.
pub fn over_socket(connection: Int) -> Transport {
  {
    receive: fn buffer => receive(connection, buffer),
    transmit: fn text => transmit(connection, text),
    shut: fn () => shut(connection),
  }
}

/// A transport over a secured connection.
///
/// The socket is the TLS connection's now — `secure` took it and `shut` closes
/// it — so there is nothing here that closes it a second time.
pub fn over_tls(connection: TlsConnection) -> Transport {
  {
    receive: fn buffer => tls_receive(connection, buffer),
    transmit: fn text => tls_transmit(connection, text),
    shut: fn () => tls_shut(connection),
  }
}

/// Reads one request into `into`, and says how many bytes arrived.
///
/// Stops at whichever comes first: the body is as long as `Content-Length`
/// promised, the peer closed, the buffer filled, or the read deadline passed.
///
/// **It used to stop on a short read as well, and that was a real interop
/// failure.** A client is allowed to write its headers and its body separately
/// — .NET's `HttpClient` does, and so does anything that sets a body from a
/// stream — and the pause between the two reads as the end of the request. The
/// server then answered `400` about a body that had not arrived yet, *before*
/// the client had finished sending it. Reproduced with a socket and a
/// three-hundred-millisecond sleep; curl never showed it, because curl writes
/// small requests in one go.
///
/// The rule was there for a reason, which is why it survived: `receive` blocks,
/// so "keep reading until the request is complete" and "keep reading forever"
/// are the same loop when the client stops talking. What makes the honest
/// version safe is the deadline `serve_connection` sets before calling this —
/// a client that goes quiet gets its socket closed instead of parking a fiber
/// for the life of the process.
fn read_request(transport: Transport, into: Array<U8>, from: Int) -> Int {
  let scratch: Array<U8> = Array::new(chunk(), 0);
  // What the last request on this connection left behind. A client is allowed
  // to send the next one before reading the last answer, so the bytes after a
  // request's end are not spare — they are the beginning of the next.
  let mut filled = from;
  // Whether `Content-Length` promised more than the buffer holds.
  let mut oversized = false;
  // What was carried over may already be a whole request.
  let mut want = request_length(into, filled);
  let mut going = true;
  while going {
    if want >= 0 && filled >= want {
      going = false;
    } else if want > Array::length(into) {
      // A promise bigger than the buffer cannot be kept, so there is nothing
      // to wait for: the answer is 413 whatever else arrives. Deciding it here
      // rather than after the deadline is what keeps a client claiming four
      // gigabytes from holding a connection open for ten seconds — which is
      // exactly what it did the first time this loop was allowed to wait.
      oversized = true;
      going = false;
    } else if filled >= Array::length(into) {
      going = false;
    } else {
      // Zero is the peer closing, negative is the read failing — and with a
      // deadline set, "failing" includes "nothing arrived in time", which is
      // what stops this waiting on a client that has gone away.
      let read = transport.receive(scratch);
      if read <= 0 {
        going = false;
      } else {
        let room = Array::length(into) - filled;
        let taken = if read > room { room } else { read };
        copy_at(scratch, into, taken, filled);
        filled = filled + taken;
        if want < 0 {
          want = request_length(into, filled);
        }
      }
    }
  }
  // A full buffer is how `answer_bytes` recognises a request that is too big,
  // and a promise too big to keep means the same thing — so it is reported the
  // same way rather than by a second channel. Nothing reads the buffer on that
  // path; the 413 is decided before anything is parsed.
  if oversized { Array::length(into) } else { filled }
}

/// Moves `count` bytes from `at` to the front, for the next request to grow on.
fn shift_down(buffer: Array<U8>, at: Int, count: Int) -> () {
  let mut i = 0;
  while i < count {
    Array::set(buffer, i, Array::get(buffer, at + i));
    i = i + 1;
  }
}

fn copy_at(from: Array<U8>, into: Array<U8>, count: Int, offset: Int) -> () {
  let mut i = 0;
  while i < count {
    Array::set(into, offset + i, Array::get(from, i));
    i = i + 1;
  }
}

/// How long the whole request should be, or negative while the headers are
/// still arriving.
///
/// **The framing primitive.** A reader needs to know when to stop, and HTTP
/// answers that in two parts: the headers end at a blank line, and
/// `Content-Length` says how much follows. Getting it wrong is not a bug that
/// shows up in testing — it is a request truncated at a packet boundary, or two
/// requests read as one — which is why this is exported rather than left for
/// each framework to derive again.
///
/// [`Connection`] is this with a buffer around it, and is what most callers
/// want.
pub fn request_length(bytes: Array<U8>, filled: Int) -> Int {
  let after = end_of_headers(bytes, filled);
  if after < 0 {
    0 - 1
  } else {
    let head = Array::prefix(bytes, after);
    // Header bytes that are not text are a request nobody can answer, and
    // saying it ends here turns that into a 400 rather than a trap inside
    // `from_bytes`.
    if Array::is_utf8(head) {
      after + content_length(String::from_bytes(head))
    } else {
      after
    }
  }
}

/// Where the body starts, or negative if the blank line has not arrived.
///
/// Searched over bytes rather than text, because the headers are only complete
/// once this says so: converting first would mean converting a fragment, and a
/// fragment can split a character.
fn end_of_headers(bytes: Array<U8>, filled: Int) -> Int {
  let mut i = 0;
  let mut found = 0 - 1;
  while found < 0 && i + 3 < filled {
    if U8::to_int(Array::get(bytes, i)) == 13
    && U8::to_int(Array::get(bytes, i + 1)) == 10
    && U8::to_int(Array::get(bytes, i + 2)) == 13
    && U8::to_int(Array::get(bytes, i + 3)) == 10 {
      found = i + 4;
    } else {
      i = i + 1;
    }
  }
  found
}

fn content_length(head: String) -> Int {
  match String::split_once(head, "\r\n") {
    Option::None => 0,
    Option::Some(lines) => match Map::get(parse_headers(lines.rest), "content-length") {
      Option::None => 0,
      Option::Some(value) => digits_of(value),
    },
  }
}

// ---------------------------------------------------------------------------
// Routing
// ---------------------------------------------------------------------------

/// Whether `path` matches `pattern`, and what its `:name` segments bound.
///
/// Segment by segment, because that is what a `:name` matches — one segment,
/// never a `/`. A pattern and a path of different lengths do not match, which
/// is what keeps `/a/:b` from swallowing `/a/b/c`.
// ---------------------------------------------------------------------------
// Reading requests off a connection
// ---------------------------------------------------------------------------

/// One connection, read a request at a time.
///
/// **This is the layer between a socket and a router**, and it is public
/// because a router is a matter of taste and this is not. Framing a request
/// correctly — reading until it is whole, honouring `Content-Length`, holding
/// what a pipelined client sent early, refusing one that will not fit — is the
/// same work whatever shape the framework above it has, and it is the work that
/// fails in production rather than in testing.
///
/// `Router` is written against this and has no privileged access to anything
/// below it. A framework with a different shape — middleware chain, effect
/// handler, one function per method — starts here and owes nothing to `Router`.
///
/// **Nothing here spawns.** A connection is read by whoever calls `next`, on
/// whatever fiber that is. `Router` gives each connection a fiber in its accept
/// loop and that is a decision of the accept loop, not of this type: a server
/// that answers one caller at a time, or hands connections to a pool, is
/// written against exactly this.
pub type Connection = {
  transport: Transport,
  buffer: Array<U8>,
  /// Bytes of the *next* request that arrived with the last one. A pipelining
  /// client sends two without waiting, and the second must not be dropped.
  mut carried: Int,
};

/// What reading a connection produced.
pub type Incoming =
  /// A whole request, and whether the client asked to keep the connection open.
  ///
  /// The flag is read from the `Connection` header here rather than by the
  /// caller, because the caller would have to fold the header's case and this
  /// has already done it.
  | Arrived(request: Request, keep: Bool)
  /// The peer closed, or the read deadline passed. There is nothing to answer
  /// and nothing to send.
  | Ended
  /// Nothing usable arrived: send this and close.
  ///
  /// A client that could not be understood cannot be trusted about where its
  /// next request begins, so the connection cannot be reused whatever the
  /// `Connection` header said.
  | Rejected(response: Response);

impl Connection {
  /// Over a transport, holding at most [`default_limit`] bytes per request.
  pub fn over(transport: Transport) -> Connection {
    Connection::holding(transport, default_limit())
  }

  /// The same, with a cap of your own.
  ///
  /// The buffer is allocated once for the connection rather than once per
  /// request, so this is what one caller costs in memory for as long as they
  /// are connected.
  pub fn holding(transport: Transport, most: Int) -> Connection {
    let buffer: Array<U8> = Array::new(most, 0);
    { transport: transport, buffer: buffer, carried: 0 }
  }

  /// Reads until one request is whole, and says what arrived.
  ///
  /// Blocks. Whether that blocks a thread, a fiber or the only thread there is
  /// belongs to the caller — see the note on [`Connection`].
  pub fn next(self) -> Incoming {
    let filled = read_request(self.transport, self.buffer, self.carried);
    let want = request_length(self.buffer, filled);
    // Whether what is in the buffer is already a whole request.
    let whole = want > 0 && want <= filled;
    // **A read that added nothing is not always the end.** `read_request`
    // returns immediately when the carry is already a whole request, which is
    // what a pipelining client produces: two requests in one packet, the
    // second sitting in the buffer while the first is answered. Reading
    // "nothing new arrived" as "the client has gone" dropped it, and no test
    // with `curl` in it could see that — `curl` waits for each answer before
    // sending the next, so the carry is always empty.
    if filled <= 0 || (filled == self.carried && !whole) {
      // The client closed, or the deadline passed.
      Incoming::Ended
    } else {
      // A request whose length is not yet known is taken to be everything
      // read so far, which is either a request without a body or one that
      // will fail the size check below.
      let length = if whole { want } else { filled };
      if length >= Array::length(self.buffer) {
        // The buffer filled before the request ended. Whether the client lied
        // about its length or simply sent too much, the answer is the same.
        Incoming::Rejected(Response::text(413, "request too large"))
      } else {
        let taken = Array::prefix(self.buffer, length);
        // Held before parsing, so `next` leaves the connection ready whatever
        // the parse decides. `prefix` copied, so moving the buffer underneath
        // is safe.
        self.carried = filled - length;
        shift_down(self.buffer, length, self.carried);
        if Array::is_utf8(taken) {
          Connection::understood(String::from_bytes(taken))
        } else {
          Incoming::Rejected(Response::text(400, "request was not text"))
        }
      }
    }
  }

  /// Parses one request, or the 400 to answer it with.
  ///
  /// Everything a connection needs to decide before a handler runs: whether
  /// the bytes were a request at all, and — from the headers the parser has
  /// already folded — whether the client asked to keep the connection.
  pub fn understood(text: String) -> Incoming {
    match parse(text) {
      Option::None => Incoming::Rejected(Response::text(400, "malformed request")),
      Option::Some(request) => {
        // Read off the headers the parser already folded and indexed, rather
        // than searched for in the raw bytes. Scanning them again cost a copy
        // of the whole request and a second pass to lower its case, on every
        // request, for an answer that was already sitting in a map. Worth
        // 3.4% — a note here once said "about a fifth", which was a guess
        // written down as though it had been measured.
        let keep = match Request::header(request, "connection") {
          Option::None => true,
          Option::Some(said) => lowered(said) != "close",
        };
        Incoming::Arrived(request, keep)
      },
    }
  }

  /// Renders `response` and sends it.
  ///
  /// `keep` decides the `Connection` header, and is what [`Incoming::Arrived`]
  /// reported unless the caller has its own reason to close.
  ///
  /// The two travel together because they are decided together: the answer's
  /// status and the request's `Connection` header are both known once, at the
  /// point the request has been parsed, and working either out again afterwards
  /// means reading the request a second time.
  pub fn reply(self, response: Response, keep: Bool) -> Int {
    self.transport.transmit(Response::rendered_keeping(response, keep))
  }

  /// Ends the conversation and releases the transport.
  pub fn shut(self) -> () {
    self.transport.shut()
  }
}

/// Whether `path` matches `pattern`, and what its `:name` segments bound.
///
/// `/analyze/:id` against `/analyze/acc_9921` binds `id`. `None` when the
/// shapes disagree, which is how the router moves on to the next route.
///
/// Exported so a program can route somewhere other than through `Router` —
/// a WebSocket upgrade, a second listener — without reimplementing the one
/// piece of matching that has to agree with the server's.
pub fn matches(pattern: String, path: String) -> Option<Params> {
  match_segments(pattern, path, Map::new())
}

fn match_segments(pattern: String, path: String, bound: Map<String, String>) -> Option<Params> {
  let here = segment(pattern);
  let mine = segment(path);
  if String::byte_length(here.head) == 0 && String::byte_length(mine.head) == 0 {
    if String::byte_length(here.rest) == 0 && String::byte_length(mine.rest) == 0 {
      Option::Some({ bound: bound })
    } else {
      match_segments(here.rest, mine.rest, bound)
    }
  } else if String::starts_with(here.head, ":") {
    if String::byte_length(mine.head) == 0 {
      Option::None
    } else {
      Map::insert(bound, String::slice(here.head, 1, String::byte_length(here.head)), mine.head);
      finish_match(here.rest, mine.rest, bound)
    }
  } else if here.head == mine.head {
    finish_match(here.rest, mine.rest, bound)
  } else {
    Option::None
  }
}

fn finish_match(pattern: String, path: String, bound: Map<String, String>) -> Option<Params> {
  if String::byte_length(pattern) == 0 && String::byte_length(path) == 0 {
    Option::Some({ bound: bound })
  } else if String::byte_length(pattern) == 0 || String::byte_length(path) == 0 {
    Option::None
  } else {
    match_segments(pattern, path, bound)
  }
}

/// The next `/`-separated piece, and what follows it.
fn segment(text: String) -> Split {
  let without_slash =
    if String::starts_with(text, "/") { String::slice(text, 1, String::byte_length(text)) }
    else { text };
  match String::split_once(without_slash, "/") {
    Option::None => { head: without_slash, rest: "" },
    Option::Some(parts) => parts,
  }
}

// ---------------------------------------------------------------------------
// The router
// ---------------------------------------------------------------------------

/// One mounted route.
///
/// The handler is a `SharedFn` rather than a plain closure, and that is what
/// lets a router be answered on a fiber of its own. A closure's captures are
/// not in its type, so a record holding one can never be handed to another
/// fiber; `SharedFn::of` checks the captures where the closure is written and
/// hands back something that has forgotten it was ever a closure.
///
/// It also takes the capabilities out of the router's type. A handler closes
/// over what it needs at the mount site, so there is no `'r` left for a `Route`
/// to carry — `Router<'er>` says only how its handlers can fail.
pub type Route<'er> = {
  method: Method,
  pattern: String,
  handler: SharedFn<Request, Response, 'er>,
};

/// A router carries its handlers' failures, so mounting a route that can fail
/// against the database widens the router's own error row.
pub type Router<'er> = {
  routes: List<Route<'er>>,
};

/// Mounting is written `router |> Router::post(..)`, so the router is the
/// first parameter of each. They are the type's own functions rather than free
/// ones so that the pipeline reads as a chain against `Router` and cannot
/// collide with another module's `get`.
///
/// One per method, over a general `on` that takes the method as a value. Both
/// are worth having: the named five are what a pipeline reads best with, and
/// `on` is what stops the set being closed — a router with only the verbs
/// somebody thought to write helpers for is the shape this had before, and it
/// made a REST service unwritable.
impl Router {
  /// A router with no routes. The start of the pipeline.
  pub fn new<'er>() -> Router<'er> { { routes: List::Nil } }

  /// Mounts `handler` at `route` for `method`.
  ///
  /// **The general one, and the five below are it with a name.** A router that
  /// could only mount the methods somebody had written a helper for is a
  /// router that stops at whatever its first caller needed — which is what
  /// this one did, for months, with `get` and `post` and no way to say `PUT`
  /// at all. The named five exist because `Router::get(..)` reads better in a
  /// pipeline than `Router::on(Method::Get, ..)`, not because they are the
  /// only ones allowed.
  ///
  /// Later mounts are tried first, because each prepends. Mounting the same
  /// route twice is allowed and the second one wins, which is worth knowing
  /// rather than an invariant anything enforces.
  pub fn on<'er>(
    router: Router<'er>,
    method: Method,
    route: String,
    handler: SharedFn<Request, Response, 'er>
  ) -> Router<'er> {
    { routes: List::Cons({ method: method, pattern: route, handler: handler }, router.routes) }
  }

  /// Mounts `handler` at `route` for GET.
  pub fn get<'er>(
    router: Router<'er>,
    route: String,
    handler: SharedFn<Request, Response, 'er>
  ) -> Router<'er> {
    Router::on(router, Method::Get, route, handler)
  }

  /// Mounts `handler` at `route` for POST.
  pub fn post<'er>(
    router: Router<'er>,
    route: String,
    handler: SharedFn<Request, Response, 'er>
  ) -> Router<'er> {
    Router::on(router, Method::Post, route, handler)
  }

  /// Mounts `handler` at `route` for PUT.
  pub fn put<'er>(
    router: Router<'er>,
    route: String,
    handler: SharedFn<Request, Response, 'er>
  ) -> Router<'er> {
    Router::on(router, Method::Put, route, handler)
  }

  /// Mounts `handler` at `route` for PATCH.
  pub fn patch<'er>(
    router: Router<'er>,
    route: String,
    handler: SharedFn<Request, Response, 'er>
  ) -> Router<'er> {
    Router::on(router, Method::Patch, route, handler)
  }

  /// Mounts `handler` at `route` for DELETE.
  ///
  /// `delete` rather than `remove`, because the method is spelled `DELETE` and
  /// a router's job is to say what the wire says.
  pub fn delete<'er>(
    router: Router<'er>,
    route: String,
    handler: SharedFn<Request, Response, 'er>
  ) -> Router<'er> {
    Router::on(router, Method::Delete, route, handler)
  }

  /// **405 when the path exists under another method, 404 when it does not.**
  ///
  /// A router with one verb per path can answer 404 to everything and nobody
  /// notices. With five it becomes a real distinction: a client that sends
  /// `POST` to a path mounted `GET` has found the route and used it wrongly,
  /// and telling it "no such path" sends whoever is debugging to look at their
  /// URL rather than at their verb.
  ///
  /// The `Allow` header is required by HTTP for a 405 — a bare 405 is a
  /// refusal that does not say what would have worked.
  fn unmatched<'er>(all: List<Route<'er>>, request: Request) -> Response {
    let allowed = Router::allowing(all, request.path, "");
    if String::byte_length(allowed) == 0 {
      Response::text(404, "no route for " + request.path)
    } else {
      Response::with_header(
        Response::text(405, method_name(request.method) + " is not allowed for " + request.path),
        "Allow",
        allowed,
      )
    }
  }

  /// Every method mounted at a path that matches, comma-separated.
  ///
  /// Deduplicated by substring, which is safe for exactly these five names:
  /// none of `GET`, `POST`, `PUT`, `PATCH` and `DELETE` contains another. A
  /// sixth verb would have to check that again, so the check is written here
  /// rather than assumed anywhere else.
  fn allowing<'er>(routes: List<Route<'er>>, path: String, so_far: String) -> String {
    match routes {
      List::Nil => so_far,
      List::Cons(route, rest) =>
        match matches(route.pattern, path) {
          Option::None => Router::allowing(rest, path, so_far),
          Option::Some(_params) => {
            let name = method_name(route.method);
            let next =
              if String::byte_length(so_far) == 0 {
                name
              } else {
                match String::index_of(so_far, name) {
                  Option::Some(_at) => so_far,
                  Option::None => so_far + ", " + name,
                }
              };
            Router::allowing(rest, path, next)
          }
        },
    }
  }

  /// Serves until the process stops, on a fiber per connection.
  ///
  /// **This writes one line to standard output** — `listening on <port>` — once
  /// the port is open. It is a readiness signal: something started this process
  /// and wants to know when it can connect, and a line on stdout is what every
  /// supervisor and test harness can already read without being taught a
  /// protocol.
  ///
  /// A server whose output is structured logs does not want it, because it
  /// arrives on the same stream in a different format and everything parsing
  /// that stream has to be taught about it. `listen_quietly` is this without
  /// the line.
  pub fn listen<'er>(router: Router<'er>, port: Int) -> ()
    raises 'er + HttpError + ChildFailed
  {
    let server = Router::bound(port)!;
    // Announced before the loop rather than after it, because after never
    // comes: `serving` returns when the process stops.
    print("listening on " + Int::to_string(port));
    Router::serving(router, server)!
  }

  /// `listen`, without the line on standard output.
  ///
  /// **For a server whose output is structured.** One unsolicited line is not
  /// much, but it is on the same stream as the logs and is not in their format.
  /// A caller here announces readiness however the rest of its output does — or
  /// not at all, for a service behind a health check that answers the question
  /// better anyway.
  pub fn listen_quietly<'er>(router: Router<'er>, port: Int) -> ()
    raises 'er + HttpError + ChildFailed
  {
    Router::serving(router, Router::bound(port)!)!
  }

  /// The serving half, over a socket that is already bound.
  ///
  /// Shared by both entry points so that the bound above and the region below
  /// are decided once. Everything either of them does differently happens
  /// before this is called.
  fn serving<'er>(router: Router<'er>, server: Int) -> ()
    raises 'er + HttpError + ChildFailed
  {
    // The nursery is opened here rather than asked of the caller: that a
    // server answers on a fiber per connection is its own business.
    //
    // Written as a lambda, which needed
    // `docs/design/capability-passing.md`: the thunk requires a nursery that
    // does not exist where it is written, so `nursery` supplies one when it
    // calls it. Until that landed this was the handler spelled out by hand,
    // because a lambda's requirement row was always empty.
    // Bounded, because the connections come from outside. A fiber is an
    // operating-system thread today and costs about 33 KB, so an unbounded
    // nursery here would meet its ceiling by exhausting memory; this one
    // meets it by accepting more slowly, and the backlog holds the rest.
    //
    // **256 is a connection bound, not a concurrency bound**, and the two
    // are one number here deliberately. A connection that has been accepted
    // is a fiber, and that fiber is inside the handler for as long as the
    // handler runs; there is no second, smaller pool that handlers queue
    // for. So `256` is the most connections served at once *and* the most
    // handlers running at once.
    //
    // Measured 2026-09-02: the server saturates well below it. Throughput
    // is flat from 16 connections to 128 — 176k, 180k, 177k, 176k requests
    // a second — while the median request takes 70, 159, 344 and 724
    // microseconds. Constant throughput with latency proportional to the
    // queue is a saturated server, so past about 16 connections this bound
    // is not what limits the rate; raising it would lengthen the queue and
    // lower it would shed load sooner. It costs about 33 KB per fiber, and
    // 400 concurrent connections were measured at 13 MB.
    //
    // A handler that waits on something scarcer than the server — a
    // database pool, a rate-limited API — wants its own smaller bound
    // around that work rather than a smaller number here. See
    // `/docs/cookbook/bounded-concurrency/`.
    // **The region is opened here rather than asked of the caller.** The
    // socket's whole life is this call, so the scope that closes it belongs
    // in this call; requiring `scope` from every caller would be a breaking
    // change that bought nothing.
    scoped(fn () => Router::held_open(router, server)!)!
  }

  /// The serving loop, with the listening socket registered for release.
  ///
  /// **Registered rather than closed after the loop, because the loop does not
  /// end.** It is left by the process stopping, by a raise, or by this fiber
  /// being cancelled, and only a region runs on all three. Without it a
  /// cancelled `listen` left the port bound for the life of the process, which
  /// is what a test that stops a server and binds the port again sees.
  fn held_open<'er>(router: Router<'er>, server: Int) -> ()
    with { scope: Scope }
    raises 'er + HttpError + ChildFailed
  {
    let held = acquire(server, fn s => shut(s));
    bounded_nursery(256, fn () => Router::serve_forever(router, held)!)!
  }

  /// The same, over TLS.
  ///
  /// Takes the certificate chain and the key as PEM rather than as paths: a
  /// server that reads its own files has decided where they live, and the two
  /// deployments that matter — a file on disk and a secret handed in by the
  /// platform — disagree about that.
  ///
  /// The configuration is released when the caller's scope ends, which for a
  /// server is usually the program's.
  ///
  /// ```khora
  /// import std::fs::{FsRead, read_text};
  /// import std::net::http::{Router, listen_tls};
  ///
  /// pub fn main() -> Int {
  ///   with { reads: FsRead::real() } {
  ///     Router::new()
  ///       |> Router::get("/health", SharedFn::of(fn _ => Response::ok("ok")))
  ///       |> Router::listen_tls(8443, read_text("cert.pem")!, read_text("key.pem")!)
  ///   };
  ///   0
  /// }
  /// ```
  ///
  /// PEM text rather than paths, because a certificate arrives from a file, a
  /// secret store or an ACME client, and only one of those is a path.
  pub fn listen_tls<'er>(router: Router<'er>, port: Int, certificate: String, key: String) -> ()
    with { scope: Scope }
    raises 'er + HttpError + TlsError + ChildFailed
  {
    let settings = tls_server(certificate, key)!;
    let server = Router::bound(port)!;
    print("listening on " + Int::to_string(port) + ", over TLS");
    bounded_nursery(256, fn () => Router::serve_secured(router, server, settings)!)!
  }

  /// A listening socket on `port`, announced by the caller.
  pub fn bound<'ef>(port: Int) -> Int raises HttpError {
    if start() {
    } else {
      raise HttpError::BindFailed(port)
    };
    let server = listen_on(port);
    if server == invalid_handle() { raise HttpError::BindFailed(port) } else { server }
  }

  /// `serve_forever` over TLS: accepts, handshakes, and serves on a fiber
  /// each.
  ///
  /// A failed handshake ends that fiber quietly rather than the loop — on a
  /// public port it is the ordinary case, not an incident.
  ///
  /// ```khora
  /// import std::net::socket::{listen_on};
  /// import std::net::tls::{server};
  ///
  /// fn serve(router: Router<'er>) -> () with { scope: Scope } raises TlsError {
  ///   let settings = server(certificate, key)!;
  ///   Router::serve_secured(router, listen_on(8443), settings)
  /// }
  /// ```
  ///
  /// The socket is already bound, which is what this has that `listen_tls`
  /// does not: a caller that wants the port opened on its own terms -- an
  /// inherited descriptor, a chosen backlog -- hands one over here.
  pub fn serve_secured<'er>(router: Router<'er>, server: Int, settings: TlsServer) -> ()
    with { nursery: Nursery }
    raises 'er + HttpError
  {
    let connection = accept_on(server);
    if connection == invalid_handle() {
    } else {
      set_receive_timeout(connection, 10000);
      nursery.adopt(Fiber::spawn(fn () => Router::secure_and_serve(router, connection, settings)));
    };
    Router::serve_secured(router, server, settings)!
  }

  /// One connection, handshaken and then served.
  ///
  /// A failed handshake is the ordinary case on a public port — a scanner, a
  /// browser sent to `http://` — so it ends this fiber quietly. `secure` has
  /// already closed the socket.
  fn secure_and_serve<'er>(router: Router<'er>, connection: Int, settings: TlsServer) -> () {
    match attempt(fn () => secure(settings, connection)!) {
      Result::Err(_) => (),
      Result::Ok(secured) => Router::serve_connection(router, over_tls(secured)),
    }
  }

  /// Accepts connections on `server` until the process stops.
  ///
  /// `listen` is the one to call: it binds the port and then this. Taking an
  /// already-bound socket is for a caller that wants to bind it themselves —
  /// a test on port zero, a socket inherited from a supervisor.
  ///
  /// ```khora
  /// import std::net::http::{Router};
  /// import std::net::socket::{listen_on};
  ///
  /// pub fn main() -> Int {
  ///   Router::new()
  ///     |> Router::get("/health", SharedFn::of(fn _ => Response::ok("ok")))
  ///     |> Router::serve_forever(listen_on(8080));
  ///   0
  /// }
  /// ```
  ///
  /// It does not return. A connection is served on a fiber of its own, and a
  /// trap inside a handler ends that fiber rather than the server.
  pub fn serve_forever<'er>(router: Router<'er>, server: Int) -> ()
    with { nursery: Nursery }
    raises 'er + HttpError
  {
    Router::serve_once(router, server)!;
    Router::serve_forever(router, server)!
  }

  /// Accepts one connection and hands it to a fiber of its own.
  ///
  /// **This is what `SharedFn` bought.** A closure's captures are not in its
  /// type, so a `Router` holding plain closures could never cross into a fiber
  /// and the server answered one caller at a time. Certifying each handler
  /// where it is mounted makes the route an ordinary shareable record, and the
  /// thunk below closes over the whole router without anything special being
  /// said about routers.
  ///
  /// The nursery is what makes it structured rather than merely concurrent: an
  /// adopted fiber cannot outlive it, so leaving `listen` — by a raise, or by
  /// cancellation — deals with the connections still being answered instead of
  /// abandoning them.
  ///
  /// **A fiber is an operating-system thread today**, so this is
  /// thread-per-connection and should be read as such: fine for a service with
  /// tens or hundreds of concurrent callers, and the wrong shape for tens of
  /// thousands. Nothing here changes when fibers become stackful coroutines on
  /// a scheduler — [the fibers design note](https://github.com/codyspate/khoralang/blob/main/docs/design/fibers.md) promises a program cannot tell which
  /// it has — so the ceiling is the runtime's to raise and not this module's.
  /// Until it does, the honest position is a bounded number of connections
  /// rather than an event loop that happens not to be written yet.
  fn serve_once<'er>(router: Router<'er>, server: Int) -> ()
    with { nursery: Nursery }
    raises 'er + HttpError
  {
    let connection = accept_on(server);
    if connection == invalid_handle() {
    } else {
      // The deadline goes on the socket before anything wraps it, because a
      // handshake can hang exactly as a request can.
      set_receive_timeout(connection, 10000);
      nursery.adopt(Fiber::spawn(fn () =>
          Router::serve_connection(router, over_socket(connection))));
    }
  }

  /// One connection, from the first byte to the close.
  ///
  /// What a fiber runs, and it does not fail: a fiber has nobody to hand a
  /// failure to, and a connection nothing closes is a descriptor leaked for the
  /// life of the process. So whatever the handler raised becomes a 500 and the
  /// socket is shut either way.
  ///
  /// The arm is `_`, because `'e` is whatever the mounted handlers raise and
  /// this function cannot name a constructor of it. Catching *whatever* is the
  /// one thing naming constructors cannot express, and the reason a total
  /// wildcard arm exists at all.
  ///
  /// **The close is registered rather than written after the catch**, because
  /// the catch does not cover the third way out. A fiber serving a connection
  /// can be cancelled -- by its nursery ending, or by the server shutting down
  /// -- and cancellation unwinds without running the line below the block. The
  /// region runs on every exit, which is the whole reason `Scope` exists.
  ///
  /// Registered *instead of*, not as well as: `shut` on a TLS transport frees
  /// the session, so closing twice is a double free rather than a wasted call.
  fn serve_connection<'er>(router: Router<'er>, transport: Transport) -> () {
    scoped(fn () => Router::served(router, transport))
  }

  /// The body of `serve_connection`, inside the region that closes the socket.
  fn served<'er>(router: Router<'er>, transport: Transport) -> ()
    with { scope: Scope }
  {
    acquire(transport, fn t => t.shut());
    // Before anything is read. `read_request` keeps reading until the request
    // is complete, which is the only correct thing to do and is also how a
    // fiber gets parked forever by a client that stops talking. Ten seconds is
    // long enough that no real client notices and short enough that a
    // half-open connection is not a leak.
    Router::answer_on(router, transport) catch {
      _ => {
        transport.transmit(Response::rendered(Response::text(500, "handler failed")));
      },
    }
  }

  /// Answers every request on one connection, until the client stops.
  ///
  /// **Written against the public [`Connection`], with nothing reserved.** A
  /// framework of a different shape writes this loop itself and is not missing
  /// anything: the reading, the framing and the refusals are all above.
  pub fn answer_on<'er>(router: Router<'er>, transport: Transport) -> ()
    raises 'er
  {
    let connection = Connection::over(transport);
    let mut going = true;
    while going {
      match Connection::next(connection) {
        Incoming::Ended => going = false,
        Incoming::Rejected(response) => {
          Connection::reply(connection, response, false);
          going = false
        },
        Incoming::Arrived(request, keep) => {
          let response = Router::dispatch(router.routes, request)!;
          Connection::reply(connection, response, keep);
          going = keep
        },
      }
    }
  }

  /// What to send back for this request text.
  fn dispatch<'er>(routes: List<Route<'er>>, request: Request) -> Response
    raises 'er
  {
    Router::taking(routes, routes, request)!
  }

  /// `left` is what is still to try; `all` is the whole table.
  ///
  /// The second one is kept for the sake of the answer when nothing matches:
  /// a path that exists under a *different* method is a different failure from
  /// a path that does not exist, and telling them apart needs the table again
  /// once the walk has run out.
  fn taking<'er>(
    left: List<Route<'er>>,
    all: List<Route<'er>>,
    request: Request,
  ) -> Response
    raises 'er
  {
    match left {
      List::Nil => Router::unmatched(all, request),
      List::Cons(route, rest) =>
        if Method::same(route.method, request.method) {
          match matches(route.pattern, request.path) {
            Option::Some(params) =>
              SharedFn::call(route.handler, {
                  method: request.method,
                  path: request.path,
                  params: params,
                  queries: request.queries,
                  headers: request.headers,
                  body: request.body,
                })!,
            Option::None => Router::taking(rest, all, request)!,
          }
        } else {
          Router::taking(rest, all, request)!
        },
    }
  }
}

fn print(value: String);

// ---------------------------------------------------------------------------
// Calling somebody else
// ---------------------------------------------------------------------------

//! Everything above this line answers requests. Everything below makes them.
//!
//! **Four message types rather than two**, and the asymmetry is the point. A
//! request that *arrives* carries route parameters and a decoded query that a
//! caller has no use for; a request that *leaves* carries a URL, which an
//! arriving one has already been split into pieces. Reading headers wants a
//! `Map` keyed by lowercased name; writing them wants a list, because
//! `Set-Cookie` may repeat. So: `Request` and `Response` for the server,
//! `Call` and `Answer` for the client, and no type pretending to be two things.

/// Where a call is going.
pub type Url = {
  /// Whether to put TLS in front of the socket.
  secure: Bool,
  host: String,
  port: Int,
  /// Path and query, together, beginning with `/`. What goes on the request
  /// line unchanged — a client that re-encodes what it was given is a client
  /// that breaks somebody's signed URL.
  target: String,
};

/// A request this program is making.
pub type Call = {
  method: Method,
  url: String,
  /// A list rather than a map, matching `Response`: two headers of the same
  /// name are legal on the way out and a map would keep one.
  headers: List<Header>,
  body: String,
};

/// What came back.
///
/// Headers keyed by the **lowercased** name, as `Request`'s are and for the
/// same reason: HTTP header names are case-insensitive and a map is not.
pub type Answer = {
  status: Int,
  headers: Map<String, String>,
  body: String,
};

/// What can go wrong reaching somebody else.
///
/// Separate from `HttpError`, which is what goes wrong *being* a server —
/// a port that would not bind, a request that could not be read. Nothing that
/// matches one has any use for the cases of the other.
derive(Show, Eq)
pub type CallError =
  /// The URL could not be read.
  | BadUrl(String)
  /// No connection: the name did not resolve, or nothing answered.
  | Unreachable(String)
  /// The TLS handshake did not complete.
  | Insecure(String)
  /// The peer went away before the answer was whole.
  | Closed(String)
  /// Something arrived and it was not an HTTP answer this can read.
  | Malformed(String)
  /// The answer was longer than the client was willing to hold.
  | TooLarge(Int)
  /// The manifest does not grant this host.
  ///
  /// **Its own case, not `Unreachable`.** The two send a reader to different
  /// places: `Unreachable` is DNS, a firewall, a service that is down, and
  /// `Denied` is `[permissions] network` in `khora.toml`. Reported as
  /// `host:port` so the line that would allow it can be copied out of the
  /// message.
  | Denied(String);

/// Making requests, as a capability.
///
/// **An effect rather than a function**, for the reason `std::db`'s `Db` is
/// one. A program that says `with { http: HttpClient }` can be handed a
/// recording double in a test, a client that only reaches one host, or one
/// wrapped for tracing — and every caller above is unchanged, because a
/// capability *is* an interception point. [The observability design note](https://github.com/codyspate/khoralang/blob/main/docs/design/observability.md) shows
/// the wrapper.
///
/// One operation. `Call` carries everything a request is, so a second would
/// only be a shorter way to build one, and `Call::get` is already that.
pub effect HttpClient {
  send: (Call) -> Result<Answer, CallError>,
}

impl Call {
  /// A GET of `url`, with no headers of its own.
  pub fn get(url: String) -> Call {
    { method: Method::Get, url: url, headers: List::Nil, body: "" }
  }

  /// A POST of `body`, with no content type.
  ///
  /// Deliberately none: a POST of form data and a POST of JSON differ in
  /// exactly that header, and guessing it for the caller is how a client ends
  /// up sending `application/json` over a form. `json` below is the one that
  /// guesses, because there the name says what it guessed.
  pub fn post(url: String, body: String) -> Call {
    { method: Method::Post, url: url, headers: List::Nil, body: body }
  }

  /// A POST of `body` as `application/json`.
  pub fn json(url: String, body: String) -> Call {
    Call::with_header(Call::post(url, body), "Content-Type", "application/json")
  }

  /// Any method, which is what the four above are shorthand for.
  pub fn of(method: Method, url: String, body: String) -> Call {
    { method: method, url: url, headers: List::Nil, body: body }
  }

  /// The same call with one more header on it.
  ///
  /// A new call rather than a changed one, like `Response::with_header` and
  /// for the same reason: a half-built request cannot be shared and then
  /// altered underneath whoever else is holding it.
  pub fn with_header(self, name: String, value: String) -> Call {
    {
      method: self.method,
      url: self.url,
      headers: List::Cons({ name: name, value: value }, self.headers),
      body: self.body,
    }
  }
}

impl Answer {
  /// The header under `name`, matched without regard to case.
  pub fn header(self, name: String) -> Option<String> {
    Map::get(self.headers, lowered(name))
  }

  /// Whether the status is one of the 2xx.
  ///
  /// Not "did the call work" — a 404 arrived successfully and is not `ok`,
  /// and a `CallError` is the other thing entirely.
  pub fn ok(self) -> Bool {
    self.status >= 200 && self.status < 300
  }
}

/// How much of an answer this client will hold, when nobody says otherwise.
///
/// 64 KiB, and it is a buffer allocated per call rather than per connection —
/// a hundred fibers each making a request is a hundred of these at once, which
/// is why it is not measured in megabytes. `HttpClient::bounded` raises it for
/// a caller who knows they are fetching something bigger.
pub fn default_answer_limit() -> Int { 65536 }

/// How long to wait for bytes that are not arriving, in milliseconds.
///
/// **On both paths now.** It was the plain one only, because
/// `set_receive_timeout` takes a socket and a TLS session owns its socket
/// rather than handing it back -- so a TLS server that accepted the connection
/// and then said nothing held the fiber until the process ended.
/// `std::net::tls` sets the deadline on the socket underneath, and `dial` uses
/// it for `https` exactly as it does for `http`.
pub fn default_answer_timeout() -> Int { 30000 }

impl HttpClient {
  /// A client that really connects, holding up to `default_answer_limit`.
  pub fn real() -> HttpClient {
    HttpClient::bounded(default_answer_limit())
  }

  /// The same, holding up to `limit` bytes of answer.
  pub fn bounded(limit: Int) -> HttpClient {
    handler for HttpClient {
      send: fn call => perform(call, limit),
    }
  }
}

/// One call, start to finish.
///
/// Connect, write, read until the answer is whole, close. **No connection is
/// kept**, which is why every request carries `Connection: close` — see the
/// note on `render` for what that costs and what it buys.
fn perform(call: Call, limit: Int) -> Result<Answer, CallError> {
  match parse_url(call.url) {
    Option::None => Result::Err(CallError::BadUrl(call.url)),
    // **Checked after the URL is parsed and before anything is dialled.**
    // After, because the host is not known until then and a grant is about the
    // host rather than the text somebody wrote; before, because the point of
    // the grant is that no connection is attempted -- a refusal that has
    // already resolved a name and opened a socket has already told the network
    // what this program wanted.
    Option::Some(url) if !granted_host(network(), authority_of(url)) =>
      Result::Err(CallError::Denied(authority_of(url))),
    // **A region per call**, because `std::net::tls`'s client is registered
    // with `acquire` and ends with the scope that made it. The whole
    // conversation happens inside it, so the trust store outlives the session
    // that was opened from it.
    Option::Some(url) => scoped(fn () => attempted(url, call, limit)),
  }
}

/// `host:port`, which is what a grant is written against.
///
/// The port is always spelled out even when it is the scheme's default, so
/// that a grant of `example.com:443` matches a URL written without one. A
/// grant with no port covers every port, so the ordinary case is unaffected
/// either way.
fn authority_of(url: Url) -> String {
  "${url.host}:${Int::to_string(url.port)}"
}

/// One call, with a scope to hold the trust store.
fn attempted(url: Url, call: Call, limit: Int) -> Result<Answer, CallError>
  with { scope: Scope }
{
  match dial(url) {
    Result::Err(why) => Result::Err(why),
    // **Registered, for the reason `serve_connection` registers its own.** A
    // call cancelled mid-`converse` used to leave the socket open, and over
    // TLS the session with it; the scope this already runs in closes both
    // however the call ends.
    Result::Ok(transport) => {
      let held = acquire(transport, fn t => t.shut());
      converse(held, call, url, limit)
    },
  }
}

/// Opens a transport to `url`, secured or not.
///
/// **The trust store is built per call**, which is the second cost of having
/// no connection pool and is named beside the first on `render`. Loading the
/// operating system's roots is comparable to the handshake it precedes, so
/// while every call is already paying for a handshake it is not the thing to
/// fix first — and both are fixed by the same pool.
fn dial(url: Url) -> Result<Transport, CallError>
  with { scope: Scope }
{
  if url.secure {
    match attempt(fn () => tls_connect(tls_client()!, url.host, url.port)!) {
      Result::Err(why) => Result::Err(CallError::Insecure(tls_reason(why))),
      Result::Ok(session) => {
        // The same deadline the plain path gets, and for the same reason: a
        // peer that accepts and then says nothing must not hold this fiber
        // for the life of the process.
        tls_set_receive_timeout(session, default_answer_timeout());
        Result::Ok(over_tls(session))
      },
    }
  } else {
    let socket = connect_to(url.host, url.port);
    if socket == invalid_handle() {
      Result::Err(CallError::Unreachable(url.host + ":" + Int::to_string(url.port)))
    } else {
      set_receive_timeout(socket, default_answer_timeout());
      Result::Ok(over_socket(socket))
    }
  }
}

/// What a `TlsError` says, in one line.
fn tls_reason(why: TlsError) -> String {
  match why {
    TlsError::BadCertificate => "the certificate chain was not readable",
    TlsError::BadKey => "the key was not readable",
    TlsError::Handshake => "the handshake failed",
    TlsError::Unreachable(host) => host,
  }
}

/// Write the request, read the answer.
fn converse(
  transport: Transport, call: Call, url: Url, limit: Int
) -> Result<Answer, CallError> {
  if transport.transmit(render(call, url)) < 0 {
    Result::Err(CallError::Closed("the request could not be sent"))
  } else {
    match read_answer(transport, limit) {
      Result::Err(why) => Result::Err(why),
      Result::Ok(text) => parse_answer(text),
    }
  }
}

/// The request, as bytes on the wire.
///
/// **`Connection: close` on every request**, which is the one decision here
/// worth arguing about. It costs a TCP handshake — and a TLS handshake — per
/// call, which for a chatty caller is most of the time spent. What it buys is
/// that the answer is framed by the close: no keep-alive state, no pipelining,
/// no half-read connection returned to a pool in an unknown state, and no
/// second implementation of the framing rules that the `Content-Length` path
/// already gets right.
///
/// A pool belongs here eventually and the shape is known — `postgres::pool` is
/// a channel of connections with a fiber owning each, and nothing about it was
/// specific to Postgres. It is not this commit.
///
/// `Host` omits the port when it is the scheme's default, because some servers
/// route on the header verbatim and `example.com:443` is not `example.com`.
fn render(call: Call, url: Url) -> String {
  let host = if url.port == default_port(url.secure) {
    url.host
  } else {
    url.host + ":" + Int::to_string(url.port)
  };
  method_name(call.method) + " " + url.target + " HTTP/1.1\r\n"
  + "Host: " + host + "\r\n"
  + "Content-Length: " + Int::to_string(String::byte_length(call.body)) + "\r\n"
  + "Connection: close\r\n"
  + rendered_headers(call.headers)
  + "\r\n"
  + call.body
}

/// The caller's own headers, one per line.
fn rendered_headers(headers: List<Header>) -> String {
  match headers {
    List::Nil => "",
    List::Cons(head, rest) =>
      head.name + ": " + head.value + "\r\n" + rendered_headers(rest),
  }
}

/// The verb as it goes on the wire.
fn method_name(method: Method) -> String {
  match method {
    Method::Get => "GET",
    Method::Post => "POST",
    Method::Put => "PUT",
    Method::Patch => "PATCH",
    Method::Delete => "DELETE",
  }
}

fn default_port(secure: Bool) -> Int { if secure { 443 } else { 80 } }

// ---------------------------------------------------------------------------
// Reading an answer
// ---------------------------------------------------------------------------

/// Reads until the answer is whole, or until the peer stops talking.
///
/// Three ways an answer can end and all three are here, because a client meets
/// all three in a morning: a `Content-Length`, a chunked body ending in a
/// zero-length chunk, or the connection closing. The server upstairs needs
/// only the first, which is why this loop is not that one.
fn read_answer(transport: Transport, limit: Int) -> Result<String, CallError> {
  let into: Array<U8> = Array::new(limit, 0);
  let scratch: Array<U8> = Array::new(chunk(), 0);
  let mut filled = 0;
  let mut want = 0 - 1;
  let mut closed = false;
  let mut full = false;
  let mut going = true;
  while going {
    if want >= 0 && filled >= want {
      going = false;
    } else if filled >= Array::length(into) {
      full = true;
      going = false;
    } else {
      let read = transport.receive(scratch);
      if read <= 0 {
        closed = true;
        going = false;
      } else {
        let room = Array::length(into) - filled;
        let taken = if read > room { room } else { read };
        copy_at(scratch, into, taken, filled);
        filled = filled + taken;
        if want < 0 { want = answer_length(into, filled); }
      }
    }
  };
  if full && (want < 0 || want > Array::length(into)) {
    Result::Err(CallError::TooLarge(limit))
  } else if filled == 0 {
    Result::Err(CallError::Closed("nothing came back"))
  } else if closed && want >= 0 && filled < want {
    Result::Err(CallError::Closed("the answer stopped short of its length"))
  } else {
    Result::Ok(String::from_bytes(Array::prefix(into, filled)))
  }
}

/// How long the whole answer is, or -1 while that is not yet knowable.
///
/// Mirrors `request_length` and differs in the one way responses differ:
/// `Transfer-Encoding: chunked` frames the body instead of a length, and an
/// answer with neither is framed by the close.
fn answer_length(bytes: Array<U8>, filled: Int) -> Int {
  let after = end_of_headers(bytes, filled);
  if after < 0 {
    0 - 1
  } else {
    let head = String::from_bytes(Array::prefix(bytes, after));
    if is_chunked(head) {
      let body = String::from_bytes(Array::prefix(bytes, filled));
      let ends = chunked_end(body, after);
      if ends < 0 { 0 - 1 } else { ends }
    } else {
      match declared_length(head) {
        Option::None => 0 - 1,
        Option::Some(length) => after + length,
      }
    }
  }
}

/// Whether the head says the body is chunked.
///
/// Substring rather than equality: the header is a *list*, and
/// `gzip, chunked` is legal and means chunked. Nothing here decompresses, so a
/// `gzip` body arrives as bytes the caller must deal with — named in the module
/// note rather than pretended about.
fn is_chunked(head: String) -> Bool {
  match String::split_once(head, "\r\n") {
    Option::None => false,
    Option::Some(lines) => match Map::get(parse_headers(lines.rest), "transfer-encoding") {
      Option::None => false,
      Option::Some(value) => String::index_of(lowered(value), "chunked").is_some(),
    },
  }
}

/// `Content-Length`, or `None` when the head does not carry one.
///
/// Distinct from the server's `content_length`, which answers zero for a
/// missing header. For a *response* the difference matters: no header means
/// "read until I close", and reading zero bytes instead would return an empty
/// body for every HTTP/1.0 answer.
fn declared_length(head: String) -> Option<Int> {
  match String::split_once(head, "\r\n") {
    Option::None => Option::None,
    Option::Some(lines) => match Map::get(parse_headers(lines.rest), "content-length") {
      Option::None => Option::None,
      Option::Some(value) => Option::Some(digits_of(value)),
    },
  }
}

/// Where a chunked body ends, counting from the start of the whole answer, or
/// -1 while the terminating chunk has not arrived.
fn chunked_end(text: String, from: Int) -> Int {
  let mut at = from;
  let mut answer = 0 - 1;
  let mut going = true;
  while going {
    match chunk_header(text, at) {
      Option::None => going = false,
      Option::Some(header) => {
        if header.size == 0 {
          // The last chunk, then a trailer section ending in a blank line.
          match String::index_of(String::slice(text, header.after, String::byte_length(text)), "\r\n") {
            Option::None => going = false,
            Option::Some(_) => {
              answer = trailer_end(text, header.after);
              going = false;
            },
          }
        } else {
          let next = header.after + header.size + 2;
          if next > String::byte_length(text) { going = false } else { at = next }
        }
      },
    }
  };
  answer
}

/// One chunk's size, and where its data begins.
type ChunkHeader = { size: Int, after: Int };

/// Reads `1a3\r\n`, or `1a3;ext=1\r\n`, at `at`.
fn chunk_header(text: String, at: Int) -> Option<ChunkHeader> {
  let length = String::byte_length(text);
  if at >= length {
    Option::None
  } else {
    let line = String::find(text, "\r\n", at);
    if line < 0 {
      Option::None
    } else {
      let raw = String::slice(text, at, line);
      // A chunk size may carry extensions after a `;`. Nothing uses them and
      // ignoring them is what the specification asks for.
      let digits = match String::index_of(raw, ";") {
        Option::None => raw,
        Option::Some(semi) => String::slice(raw, 0, semi),
      };
      match hex_of(trimmed(digits)) {
        Option::None => Option::None,
        Option::Some(size) => Option::Some({ size: size, after: line + 2 }),
      }
    }
  }
}

/// Where the trailer section after the final chunk ends.
fn trailer_end(text: String, from: Int) -> Int {
  let rest = String::slice(text, from, String::byte_length(text));
  match String::index_of(rest, "\r\n\r\n") {
    // No trailers: the final chunk's CRLF is immediately the terminating one.
    Option::None => if String::starts_with(rest, "\r\n") { from + 2 } else { 0 - 1 },
    Option::Some(at) => if at == 0 { from + 2 } else { from + at + 4 },
  }
}

/// A hexadecimal number, or `None` if it is not one.
fn hex_of(text: String) -> Option<Int> {
  let length = String::byte_length(text);
  if length == 0 {
    Option::None
  } else {
    let mut at = 0;
    let mut total = 0;
    let mut ok = true;
    while at < length {
      match hex_value(String::byte(text, at)) {
        Option::None => { ok = false; at = length },
        Option::Some(value) => {
          total = total * 16 + value;
          at = at + 1
        },
      }
    };
    if ok { Option::Some(total) } else { Option::None }
  }
}

/// Splits an answer into its status, its headers and its body.
fn parse_answer(text: String) -> Result<Answer, CallError> {
  match String::split_once(text, "\r\n") {
    Option::None => Result::Err(CallError::Malformed("no status line")),
    Option::Some(first) => match status_of(first.head) {
      Option::None => Result::Err(CallError::Malformed(first.head)),
      Option::Some(status) => {
        let headers = parse_headers(first.rest);
        let body = body_of(first.rest);
        let whole = if is_chunked(text) { dechunked(body) } else { body };
        Result::Ok({ status: status, headers: headers, body: whole })
      },
    },
  }
}

/// The number in `HTTP/1.1 200 OK`.
///
/// The version is checked as far as `HTTP/1.`, and no further: a server that
/// answers `HTTP/1.0` to a `1.1` request is doing something legal, and a
/// client that refused it would be wrong about the specification rather than
/// strict.
fn status_of(line: String) -> Option<Int> {
  if String::starts_with(line, "HTTP/1.") {
    match String::split_once(String::slice(line, 9, String::byte_length(line)), " ") {
      // `HTTP/1.1 200` with no phrase is legal; the phrase is advisory.
      Option::None => Option::None,
      Option::Some(rest) => Option::Some(digits_of(trimmed(rest.head))),
    }
  } else {
    Option::None
  }
}

/// A chunked body, with the framing taken back out.
///
/// **The pieces are collected and joined once.** Appending each chunk to what
/// had arrived so far copied the whole body per chunk, so a ten-megabyte
/// response in eight-kilobyte chunks moved something like six gigabytes to
/// assemble ten. `String::join` pairs, so it moves the body about a dozen
/// times instead — and the chunks arrive in order, so collecting them front to
/// back and reversing once is the linear way to hold them.
fn dechunked(body: String) -> String {
  let mut at = 0;
  let mut pieces: List<String> = List::Nil;
  let mut going = true;
  while going {
    match chunk_header(body, at) {
      Option::None => going = false,
      Option::Some(header) => {
        if header.size == 0 {
          going = false
        } else {
          let end = header.after + header.size;
          if end > String::byte_length(body) {
            going = false
          } else {
            pieces = List::Cons(String::slice(body, header.after, end), pieces);
            at = end + 2
          }
        }
      },
    }
  };
  String::join(List::reverse(pieces), "")
}

// ---------------------------------------------------------------------------
// URLs
// ---------------------------------------------------------------------------

/// Reads `https://host:port/path?query`.
///
/// **Only what a client needs to dial and ask.** No fragment, because a
/// fragment never leaves the browser; no userinfo, because credentials in a
/// URL are deprecated and accepting them would mean deciding how to encode
/// them; and no normalisation of the path, because a server may have signed
/// exactly the bytes it was given.
pub fn parse_url(text: String) -> Option<Url> {
  match String::split_once(text, "://") {
    Option::None => Option::None,
    Option::Some(split) => {
      let scheme = lowered(split.head);
      if scheme == "http" || scheme == "https" {
        let secure = scheme == "https";
        let cut = String::find(split.rest, "/", 0);
        let authority = if cut < 0 {
          split.rest
        } else {
          String::slice(split.rest, 0, cut)
        };
        let target = if cut < 0 {
          "/"
        } else {
          String::slice(split.rest, cut, String::byte_length(split.rest))
        };
        match split_authority(authority, secure) {
          Option::None => Option::None,
          Option::Some(endpoint) =>
            Option::Some({
                secure: secure,
                host: endpoint.host,
                port: endpoint.port,
                target: target,
              }),
        }
      } else {
        Option::None
      }
    },
  }
}

/// A host and a port, however the authority spelled them.
type Where = { host: String, port: Int };

/// `host`, `host:port`, `[::1]` or `[::1]:port`.
fn split_authority(authority: String, secure: Bool) -> Option<Where> {
  if String::byte_length(authority) == 0 {
    Option::None
  } else if String::starts_with(authority, "[") {
    let close = String::find(authority, "]", 0);
    if close < 0 {
      Option::None
    } else {
      let host = String::slice(authority, 1, close);
      let rest = String::slice(authority, close + 1, String::byte_length(authority));
      if String::byte_length(rest) == 0 {
        Option::Some({ host: host, port: default_port(secure) })
      } else if String::starts_with(rest, ":") {
        port_of(host, String::slice(rest, 1, String::byte_length(rest)), secure)
      } else {
        Option::None
      }
    }
  } else {
    match String::split_once(authority, ":") {
      Option::None => Option::Some({ host: authority, port: default_port(secure) }),
      Option::Some(split) => port_of(split.head, split.rest, secure),
    }
  }
}

/// A port that has to be digits, because `host:` and `host:abc` are mistakes
/// worth naming rather than defaulting past.
fn port_of(host: String, text: String, _secure: Bool) -> Option<Where> {
  let length = String::byte_length(text);
  if length == 0 || String::byte_length(host) == 0 {
    Option::None
  } else {
    let mut at = 0;
    let mut ok = true;
    while at < length {
      let byte = U8::to_int(String::byte(text, at));
      if byte < 48 || byte > 57 { ok = false };
      at = at + 1
    };
    if ok {
      let port = digits_of(text);
      if port > 0 && port < 65536 {
        Option::Some({ host: host, port: port })
      } else {
        Option::None
      }
    } else {
      Option::None
    }
  }
}
