module std::net::http;

import std::core::{Array, Fiber, List, Map, Never, Nursery, Option, Result, Scope, SharedFn, Show, Split, attempt, bounded_nursery};
import std::net::socket::{accept_on, invalid_handle, listen_on, receive, set_receive_timeout, shut, start, transmit};
import std::net::tls::{TlsConnection, TlsError, TlsServer, receive as tls_receive, secure, server as tls_server, shut as tls_shut, transmit as tls_transmit};

//! HTTP/1.1, over the sockets in `std::net::socket`.
//!
//! The specification does not define `std::net::http`; the shape here was
//! reconstructed from how the reference application uses it, and every line
//! below it is Khora over `String::slice`, `String::index_of` and `Map`.
//!
//! What it does: a request line with its query string, headers, a body read to
//! the length the headers promised, routing on method and path with `:name`
//! segments, and a response that can carry headers of its own.
//!
//! What it does not: chunked transfer, content negotiation, or multipart
//! bodies. Each is absent deliberately rather than forgotten. Keep-alive and
//! TLS *are* here — the comment said otherwise for a while after each arrived.
//!
//! A connection is reached through a `Transport`, which is three closures, so
//! that the serving path is written once and `Router::listen` and
//! `Router::listen_tls` differ only in what they hand it.
//!
//! It does answer on a fiber per connection, which took a language feature to
//! reach rather than a line here: see `Router::serve_once`.

/// The five verbs this server routes on.
///
/// Not every verb HTTP defines: `HEAD`, `OPTIONS` and `TRACE` are answered by
/// the server rather than routed to a handler, and a method nobody can mount a
/// route for is not worth a case here. `of` returns `None` for the rest, which
/// becomes a 400 rather than a panic.
pub type Method =
  | Get
  | Post
  | Put
  | Patch
  | Delete;

impl Method {
  /// The method this text names, or `None`.
  ///
  /// Case-sensitive, because HTTP methods are: `get` is not `GET`, and a
  /// server that accepted it would be lenient about the one part of the
  /// request line that has never been ambiguous.
  pub fn of(text: String) -> Option<Method> {
    if text == "GET" {
      Option::Some(Method::Get)
    } else if text == "POST" {
      Option::Some(Method::Post)
    } else if text == "PUT" {
      Option::Some(Method::Put)
    } else if text == "PATCH" {
      Option::Some(Method::Patch)
    } else if text == "DELETE" {
      Option::Some(Method::Delete)
    } else {
      Option::None
    }
  }

  /// Whether these are the same method.
  ///
  /// `Method` predates `derive(Eq)` reaching this file; `rank` is what it
  /// compares on.
  pub fn same(self, other: Method) -> Bool {
    Method::rank(self) == Method::rank(other)
  }

  /// A number per method, so `same` has something to compare.
  ///
  /// **Not a wire value and not an order.** Nothing outside this module should
  /// read it; it exists because comparing two variants needed one integer.
  fn rank(self) -> Int {
    match self {
      Method::Get => 0,
      Method::Post => 1,
      Method::Put => 2,
      Method::Patch => 3,
      Method::Delete => 4,
    }
  }
}

/// The path parameters a route matched: `/analyze/:account_id` against
/// `/analyze/acc_9921` binds `account_id`.
pub type Params = {
  bound: Map<String, String>,
};

impl Params {
  /// No parameters bound. What a route with no `:name` in it matches with.
  pub fn empty() -> Params { { bound: Map::new() } }

  /// `Option::None` when the route did not declare that parameter, which is a
  /// programming error the type makes you notice rather than an empty string.
  pub fn get(self, name: String) -> Option<String> {
    Map::get(self.bound, name)
  }
}

/// One request, parsed: the verb, the path, what the route bound, the query,
/// the headers and the body.
///
/// **Everything is decoded on arrival**, once. A handler reading three query
/// parameters and two headers does no parsing at all — the maps below are
/// already built, and the header names are already lowercased.
pub type Request = {
  method: Method,
  /// The path with the query string taken off: `/analyze/acc_1?deep=true` has
  /// a path of `/analyze/acc_1`. Routes match against this, so mounting
  /// `/analyze/:id` does not stop working the moment a client adds a
  /// parameter.
  path: String,
  params: Params,
  /// Decoded once, when the request arrives, rather than on every lookup — a
  /// handler that reads three parameters should not decode the query three
  /// times.
  queries: Map<String, String>,
  /// Keyed by the **lowercased** name, because HTTP header names are
  /// case-insensitive and a map is not. Folding the case here rather than in
  /// `header` means two headers differing only in case collide on arrival,
  /// which is the correct reading: they are the same header.
  headers: Map<String, String>,
  body: String,
};

impl Request {
  /// A GET request for `path`, with no parameters matched yet. Chiefly for
  /// tests: a real one arrives from a socket.
  pub fn get(path: String) -> Request {
    Request::of(Method::Get, path, "")
  }

  /// A POST to `path` carrying `body`. For tests, like `get`.
  pub fn post(path: String, body: String) -> Request {
    Request::of(Method::Post, path, body)
  }

  /// The query string is honoured here too, so a hand-built request behaves
  /// like one off the wire. A test that writes `Request::get("/x?a=1")` and
  /// finds no `a` would be testing the constructor rather than the code.
  pub fn of(method: Method, target: String, body: String) -> Request {
    let split = split_target(target);
    {
      method: method,
      path: split.head,
      params: Params::empty(),
      queries: parse_query(split.rest),
      headers: Map::new(),
      body: body,
    }
  }

  /// A query parameter, already percent-decoded.
  ///
  /// A parameter written with no `=` — `/x?verbose` — is present with an empty
  /// value, which is how every server reads it and what lets a handler ask
  /// "was this requested" rather than "what does it say".
  pub fn query(self, name: String) -> Option<String> {
    Map::get(self.queries, name)
  }

  /// A header, by a name in any case.
  ///
  /// `Host`, `host` and `HOST` are one header. The RFC says so, and this is
  /// the half of it that everybody gets wrong.
  pub fn header(self, name: String) -> Option<String> {
    Map::get(self.headers, lowered(name))
  }
}

/// One header on the way out.
pub type Header = {
  name: String,
  value: String,
};

/// What a handler answers with: a status, a body, its type, and any extra
/// headers.
///
/// `json` and `text` build the two common ones. `with_header` adds to either,
/// and returns a new response rather than changing the one it was given.
pub type Response = {
  status: Int,
  body: String,
  content_type: String,
  /// Anything beyond the three a response always carries. A list rather than a
  /// map, because `Set-Cookie` may legitimately appear more than once and a
  /// map would silently keep only the last.
  headers: List<Header>,
};

impl Response {
  /// Serializes `body` and sends it with the given status.
  ///
  /// `A: Show` rather than a JSON encoder, because there is no JSON module yet
  /// and `Show` is the trait a type already uses to say how it reads. When
  /// there is one, this is where it goes and nothing above it changes.
  pub fn json<A: Show>(status: Int, body: A) -> Response {
    { status: status, body: body.show(), content_type: "application/json", headers: List::Nil }
  }

  /// `body` as `text/plain`, with the given status.
  pub fn text(status: Int, body: String) -> Response {
    { status: status, body: body, content_type: "text/plain", headers: List::Nil }
  }

  /// The same response with one more header on it.
  ///
  /// A new response rather than a mutated one, like `Prompt`'s builders and
  /// for the same reason: a half-built response cannot be shared and then
  /// changed underneath its other holder.
  pub fn with_header(self, name: String, value: String) -> Response {
    {
      status: self.status,
      body: self.body,
      content_type: self.content_type,
      headers: List::Cons({ name: name, value: value }, self.headers),
    }
  }

  /// The response, as bytes on the wire.
  pub fn rendered(self) -> String { Response::rendered_keeping(self, false) }

  /// The same, saying whether the connection is staying open.
  ///
  /// **Reuse is worth two orders of magnitude and nothing else here is.**
  /// Measured on this machine, one server answering the same request: 6,116 a
  /// second on a fresh connection each time, 1,129,782 on one held open. The
  /// handshake, the teardown and the port churn were the whole cost; the
  /// server was never the bottleneck. That is also why comparing this to a
  /// server benchmarked with keep-alive was comparing two different questions.
  ///
  /// `Content-Length` is on every response already, which is what makes this
  /// safe: a client knows where the body ends and where the next answer
  /// begins without the connection closing to tell it.
  pub fn rendered_keeping(self, keep: Bool) -> String {
    "HTTP/1.1 " + Int::to_string(self.status) + " " + Response::reason(self.status) + "\r\n"
    + "Content-Type: " + self.content_type + "\r\n"
    + "Content-Length: " + Int::to_string(String::byte_length(self.body)) + "\r\n"
    + Response::extra(self.headers)
    + (if keep { "Connection: keep-alive\r\n" } else { "Connection: close\r\n" })
    + "\r\n"
    + self.body
  }

  /// The caller's own headers. `with_header` prepends, so the most recently
  /// added is written first — which no client cares about, and saying so here
  /// is cheaper than reversing a list to make it look tidy.
  fn extra(headers: List<Header>) -> String {
    match headers {
      List::Nil => "",
      List::Cons(h, rest) => h.name + ": " + h.value + "\r\n" + Response::extra(rest),
    }
  }

  /// The reason phrase for a status.
  ///
  /// The ones a service actually sends, which turned out to be more than the
  /// five this had: the link shortener answered a redirect and got
  /// `HTTP/1.1 302 Unknown` on the wire. A phrase is advisory — every client
  /// reads the number — but one that says `Unknown` about a status the server
  /// deliberately chose reads as a bug to whoever is holding the packet
  /// capture, and it was.
  pub fn reason(status: Int) -> String {
    if status == 200 {
      "OK"
    } else if status == 201 {
      "Created"
    } else if status == 204 {
      "No Content"
    } else if status == 301 {
      "Moved Permanently"
    } else if status == 302 {
      "Found"
    } else if status == 304 {
      "Not Modified"
    } else if status == 401 {
      "Unauthorized"
    } else if status == 403 {
      "Forbidden"
    } else if status == 405 {
      "Method Not Allowed"
    } else if status == 409 {
      "Conflict"
    } else if status == 422 {
      "Unprocessable Content"
    } else if status == 429 {
      "Too Many Requests"
    } else if status == 400 {
      "Bad Request"
    } else if status == 404 {
      "Not Found"
    } else if status == 413 {
      "Payload Too Large"
    } else if status == 500 {
      "Internal Server Error"
    } else {
      "Unknown"
    }
  }
}

/// What can go wrong that is the *server's* problem rather than a client's.
///
/// A malformed request from a client is answered with a 400 and never reaches
/// here — that is a response, not an error. These two are the cases where
/// there is nobody to answer: the port would not bind, or a request could not
/// be read at all.
pub type HttpError =
  | BindFailed(port: Int)
  | MalformedRequest(details: String);

// ---------------------------------------------------------------------------
// Bytes and text
// ---------------------------------------------------------------------------
//
// Written with `while` rather than as folds. Everything else in `std` walks a
// string by recursion, and for a few dozen characters that is the nicer shape
// — but a header block is thousands of bytes and one stack frame each buys
// nothing.

/// `text` with every ASCII letter in lower case.
///
/// ASCII only, deliberately: this exists for header names, which the RFC
/// restricts to ASCII, and case in every other alphabet is a question no
/// answer to which fits in six lines.
fn lowered(text: String) -> String {
  lowered_between(text, 0, String::byte_length(text))
}

/// `text[from .. to]`, lowercased.
///
/// **Takes a range rather than a string** so that the caller does not have to
/// cut one out first. A header name is read out of the middle of the request
/// exactly once, and slicing it before lowercasing it would allocate a string
/// whose only use is to be walked and thrown away.
fn lowered_between(text: String, from: Int, to: Int) -> String {
  let count = to - from;
  if count <= 0 {
    ""
  } else {
    let out: Array<U8> = Array::new(count, 0);
    let mut i = 0;
    while i < count {
      let c = U8::to_int(String::byte(text, from + i));
      let shifted = if c >= 65 && c <= 90 { c + 32 } else { c };
      Array::set(out, i, U8::of(shifted));
      i = i + 1;
    }
    String::from_bytes(out)
  }
}

/// `text` without leading or trailing spaces and tabs.
fn trimmed(text: String) -> String {
  trimmed_between(text, 0, String::byte_length(text))
}

/// `text[from .. to]` without leading or trailing spaces and tabs.
///
/// The same reasoning as `lowered_between`, and it pays better: the ends move
/// inwards over the original bytes and only the part that survives is ever
/// copied.
fn trimmed_between(text: String, from: Int, to: Int) -> String {
  let mut start = from;
  while start < to && blank(String::byte(text, start)) {
    start = start + 1;
  }
  let mut end = to;
  while end > start && blank(String::byte(text, end - 1)) {
    end = end - 1;
  }
  String::slice(text, start, end)
}

fn blank(byte: U8) -> Bool {
  let c = U8::to_int(byte);
  c == 32 || c == 9
}

/// The leading digits of `text`, as a number.
///
/// Stops at the first character that is not a digit, and at a value no server
/// should be asked to hold. The cap is not politeness: `value * 10` **traps**
/// on overflow, so a twenty-digit `Content-Length` would stop the process
/// rather than the request. Refusing to read past it turns a crash into a 413.
fn digits_of(text: String) -> Int {
  let length = String::byte_length(text);
  let mut value = 0;
  let mut i = 0;
  let mut going = true;
  while going && i < length {
    let c = U8::to_int(String::byte(text, i));
    if c >= 48 && c <= 57 && value <= 100000000 {
      value = value * 10 + (c - 48);
      i = i + 1;
    } else {
      going = false;
    }
  }
  value
}

/// One hex digit's value, or `None` for anything else.
fn hex_value(byte: U8) -> Option<Int> {
  let c = U8::to_int(byte);
  if c >= 48 && c <= 57 {
    Option::Some(c - 48)
  } else if c >= 97 && c <= 102 {
    Option::Some(c - 87)
  } else if c >= 65 && c <= 70 {
    Option::Some(c - 55)
  } else {
    Option::None
  }
}

/// The byte that two hex digits at `at` spell, if they are two hex digits.
fn hex_pair(text: String, at: Int) -> Option<Int> {
  if at + 1 >= String::byte_length(text) {
    Option::None
  } else {
    match hex_value(String::byte(text, at)) {
      Option::None => Option::None,
      Option::Some(high) => match hex_value(String::byte(text, at + 1)) {
        Option::None => Option::None,
        Option::Some(low) => Option::Some(high * 16 + low),
      },
    }
  }
}

/// `%20` becomes a space, and so does `+`.
///
/// A `%` not followed by two hex digits stays a literal `%`. Refusing the
/// whole parameter would be defensible and is not what any browser or server
/// does, and a query string is not the place to be the only strict one.
///
/// The decoded form is never longer than the encoded one, so a buffer of the
/// input's length is always enough and there is nothing to grow.
pub fn percent_decode(text: String) -> String {
  let length = String::byte_length(text);
  if length == 0 {
    ""
  } else {
    let out: Array<U8> = Array::new(length, 0);
    let mut at = 0;
    let mut written = 0;
    while at < length {
      let here = U8::to_int(String::byte(text, at));
      if here == 37 {
        match hex_pair(text, at + 1) {
          Option::Some(value) => {
            Array::set(out, written, U8::of(value));
            written = written + 1;
            at = at + 3;
          },
          Option::None => {
            Array::set(out, written, String::byte(text, at));
            written = written + 1;
            at = at + 1;
          },
        };
      } else if here == 43 {
        Array::set(out, written, U8::of(32));
        written = written + 1;
        at = at + 1;
      } else {
        Array::set(out, written, String::byte(text, at));
        written = written + 1;
        at = at + 1;
      }
    }
    // A valid escape can spell a byte that is not text — `%FF` is not UTF-8 —
    // and `from_bytes` stops the program rather than pretend. A parameter
    // nobody can read as text is dropped instead of taking the server with it.
    let taken = Array::prefix(out, written);
    if Array::is_utf8(taken) { String::from_bytes(taken) } else { "" }
  }
}

// ---------------------------------------------------------------------------
// Parsing
// ---------------------------------------------------------------------------

/// A request read off the wire.
pub fn parse(text: String) -> Option<Request> {
  match String::split_once(text, "\r\n") {
    Option::None => Option::None,
    Option::Some(lines) => match parse_request_line(lines.head) {
      Option::None => Option::None,
      Option::Some(head) => {
        let split = split_target(head.target);
        Option::Some({
            method: head.method,
            path: split.head,
            params: Params::empty(),
            queries: parse_query(split.rest),
            headers: parse_headers(lines.rest),
            body: body_of(lines.rest),
          })
      },
    },
  }
}

/// The first line of a request, before the target has been split.
///
/// Public because a caller parsing a request for its own reasons wants the
/// target as the client wrote it; `Request` carries the split version.
pub type RequestLine = {
  method: Method,
  /// The request target as written, query string and all. `parse` splits it;
  /// keeping it whole here means a caller reading a request line for its own
  /// reasons gets what the client actually sent.
  target: String,
};

fn parse_request_line(line: String) -> Option<RequestLine> {
  match String::split_once(line, " ") {
    Option::None => Option::None,
    Option::Some(after_method) => match Method::of(after_method.head) {
      Option::None => Option::None,
      Option::Some(method) => match String::split_once(after_method.rest, " ") {
        // `GET /path` with no version is still a request line worth honouring.
        Option::None => Option::Some({ method: method, target: after_method.rest }),
        Option::Some(after_path) => Option::Some({ method: method, target: after_path.head }),
      },
    },
  }
}

/// The path and the query string, either side of the first `?`.
fn split_target(target: String) -> Split {
  match String::split_once(target, "?") {
    Option::None => { head: target, rest: "" },
    Option::Some(parts) => parts,
  }
}

/// `a=1&b=hello%20world` as a map, decoded.
fn parse_query(text: String) -> Map<String, String> {
  let out: Map<String, String> = Map::new();
  fill_query(out, text);
  out
}

/// Every `name=value` in `text`, added to `out`.
///
/// A cursor for the reason `fill_headers` gives: a query string is as long as
/// the client wants it to be, and splitting off the front copies the rest of it
/// once per parameter.
fn fill_query(out: Map<String, String>, text: String) -> () {
  let end = String::byte_length(text);
  let mut at = 0;
  while at < end {
    let found = String::find(text, "&", at);
    let pair_end = if found < 0 { end } else { found };
    add_pair(out, text, at, pair_end);
    at = pair_end + 1;
  }
}

/// One `name=value` out of `pair[from .. to]`.
fn add_pair(out: Map<String, String>, pair: String, from: Int, to: Int) -> () {
  if from < to {
    let equals = String::find(pair, "=", from);
    if equals < 0 || equals >= to {
      // `?flag` with no value is the flag being present, which is what a
      // caller reading it as a switch expects.
      Map::insert(out, decoded_between(pair, from, to), "");
    } else {
      Map::insert(
        out,
        decoded_between(pair, from, equals),
        decoded_between(pair, equals + 1, to),
      );
    };
  }
}

/// `percent_decode` of `text[from .. to]`.
///
/// This one does cut the piece out, unlike its neighbours: a decoder has to
/// look at every byte anyway, so there is nothing to save by handing it a range
/// instead — and the piece it is given is a name or a value, not the whole
/// remaining query.
fn decoded_between(text: String, from: Int, to: Int) -> String {
  percent_decode(String::slice(text, from, to))
}

/// The headers, keyed by their lowercased names.
///
/// `rest` is everything after the request line; anything past the blank line
/// is the body and is not looked at here.
fn parse_headers(rest: String) -> Map<String, String> {
  let out: Map<String, String> = Map::new();
  let end = match String::index_of(rest, "\r\n\r\n") {
    Option::None => String::byte_length(rest),
    Option::Some(at) => at,
  };
  fill_headers(out, rest, end);
  out
}

/// Every header line in `block[.. end]`, added to `out`.
///
/// **A cursor rather than a split.** Written as `split_once` and recursion this
/// copied the whole of what was left over on every line: fifty headers meant
/// fifty copies of a shrinking block, which is quadratic in a number the client
/// chooses. Now the only strings built are the ones that are kept — the name
/// and the value — and the block itself is read in place.
fn fill_headers(out: Map<String, String>, block: String, end: Int) -> () {
  let mut at = 0;
  while at < end {
    let found = String::find(block, "\r\n", at);
    // No terminator before the end of the block: the last line runs to it.
    let line_end = if found < 0 || found > end { end } else { found };
    add_header(out, block, at, line_end);
    at = line_end + 2;
  }
}

/// One header out of `line[from .. to]`, if that is what it is.
fn add_header(out: Map<String, String>, line: String, from: Int, to: Int) -> () {
  let colon = String::find(line, ":", from);
  // A line with no colon is not a header. Dropping it rather than failing the
  // whole request is what a server does with a client's small mistakes.
  if colon >= 0 && colon < to {
    Map::insert(out, lowered_between(line, from, colon), trimmed_between(line, colon + 1, to));
  }
}

/// Everything after the blank line, or nothing.
fn body_of(rest: String) -> String {
  match String::index_of(rest, "\r\n\r\n") {
    Option::None => "",
    Option::Some(at) => String::slice(rest, at + 4, String::byte_length(rest)),
  }
}

// ---------------------------------------------------------------------------
// Reading a whole request
// ---------------------------------------------------------------------------

/// The most a request may be. Anything longer gets a 413.
///
/// The buffer is allocated once at this size and never grows, which is what
/// makes a lying `Content-Length` harmless: the header is a promise about what
/// is coming, not an instruction to allocate.
///
/// **Eight kilobytes is now a policy, and it used to be a workaround.** The
/// note that stood here said the number was where the stack ran out, because
/// `String::slice`, `String::index_of` and `String::matches_at` each recursed
/// once per byte and a nine-thousand-byte request took the process with it.
/// All three are loops or intrinsics now, and `fill_headers` walks a cursor
/// instead of calling itself per line, so the cliff is gone: measured again,
/// a 39,808-byte request carrying 2,001 headers parses and answers.
///
/// The number stays at eight kilobytes anyway, which is what nginx and most
/// others allow, because the question it answers changed rather than
/// disappeared. It is no longer "how much can we survive" but "how much may an
/// unauthenticated client make a server hold", and that is a smaller number
/// than the one the stack would now permit.
/// The most a request may be, headers and body together, unless a caller
/// says otherwise.
///
/// Eight kilobytes is what a buffer costs per connection, and a connection is
/// what a fiber costs — so this is the number that decides how many callers a
/// server can hold, not a guess about how big a request is. `Connection::holding`
/// takes another.
pub fn default_limit() -> Int { 8192 }

fn limit() -> Int { default_limit() }

/// How many bytes to ask the socket for at a time.
fn chunk() -> Int { 4096 }

/// Reads one request into `into`, and says how many bytes arrived.
///
/// Stops at whichever comes first: the body is as long as `Content-Length`
/// promised, the peer closed, the buffer filled, or the read deadline passed.
///
/// **It used to stop on a short read as well, and that was a real interop
/// failure.** A client is allowed to write its headers and its body separately
/// — .NET's `HttpClient` does, and so does anything that sets a body from a
/// stream — and the pause between the two reads as the end of the request. The
/// server then answered `400` about a body that had not arrived yet, *before*
/// the client had finished sending it. Reproduced with a socket and a
/// three-hundred-millisecond sleep; curl never showed it, because curl writes
/// small requests in one go.
///
/// The rule was there for a reason, which is why it survived: `receive` blocks,
/// so "keep reading until the request is complete" and "keep reading forever"
/// are the same loop when the client stops talking. What makes the honest
/// version safe is the deadline `serve_connection` sets before calling this —
/// a client that goes quiet gets its socket closed instead of parking a fiber
/// for the life of the process.
/// How to speak to one client, whatever is underneath.
///
/// **Three closures rather than a socket handle**, because a plain connection
/// and a TLS one differ in exactly these three operations and in nothing else
/// the router does. Before this the serving path took an `Int`, which is a
/// socket, and there was no way to put a handshake in front of it without
/// writing the whole path twice.
///
/// The cost is two indirect calls per request — one read, one write — against a
/// parse that performs several hundred reference-count operations. It did not
/// move the benchmark.
///
/// A record of closures is what an `effect` compiles to anyway
/// (`docs/design/effect-runtime.md` §2), and this is not one only because a
/// transport belongs to a connection rather than to a computation: two fibers
/// serve two clients at once, and a capability installed by `with` would be
/// one of them.
pub type Transport = {
  /// Bytes into the buffer: how many, 0 when the peer closed, or -1.
  receive: (Array<U8>) -> Int,
  /// The text, all of it, or -1.
  transmit: (String) -> Int,
  /// Ends the conversation and releases whatever is underneath.
  shut: () -> (),
};

/// A transport over a plain socket.
pub fn over_socket(connection: Int) -> Transport {
  {
    receive: fn buffer => receive(connection, buffer),
    transmit: fn text => transmit(connection, text),
    shut: fn () => shut(connection),
  }
}

/// A transport over a secured connection.
///
/// The socket is the TLS connection's now — `secure` took it and `shut` closes
/// it — so there is nothing here that closes it a second time.
pub fn over_tls(connection: TlsConnection) -> Transport {
  {
    receive: fn buffer => tls_receive(connection, buffer),
    transmit: fn text => tls_transmit(connection, text),
    shut: fn () => tls_shut(connection),
  }
}

fn read_request(transport: Transport, into: Array<U8>, from: Int) -> Int {
  let scratch: Array<U8> = Array::new(chunk(), 0);
  // What the last request on this connection left behind. A client is allowed
  // to send the next one before reading the last answer, so the bytes after a
  // request's end are not spare — they are the beginning of the next.
  let mut filled = from;
  // Whether `Content-Length` promised more than the buffer holds.
  let mut oversized = false;
  // What was carried over may already be a whole request.
  let mut want = request_length(into, filled);
  let mut going = true;
  while going {
    if want >= 0 && filled >= want {
      going = false;
    } else if want > Array::length(into) {
      // A promise bigger than the buffer cannot be kept, so there is nothing
      // to wait for: the answer is 413 whatever else arrives. Deciding it here
      // rather than after the deadline is what keeps a client claiming four
      // gigabytes from holding a connection open for ten seconds — which is
      // exactly what it did the first time this loop was allowed to wait.
      oversized = true;
      going = false;
    } else if filled >= Array::length(into) {
      going = false;
    } else {
      // Zero is the peer closing, negative is the read failing — and with a
      // deadline set, "failing" includes "nothing arrived in time", which is
      // what stops this waiting on a client that has gone away.
      let read = transport.receive(scratch);
      if read <= 0 {
        going = false;
      } else {
        let room = Array::length(into) - filled;
        let taken = if read > room { room } else { read };
        copy_at(scratch, into, taken, filled);
        filled = filled + taken;
        if want < 0 {
          want = request_length(into, filled);
        }
      }
    }
  }
  // A full buffer is how `answer_bytes` recognises a request that is too big,
  // and a promise too big to keep means the same thing — so it is reported the
  // same way rather than by a second channel. Nothing reads the buffer on that
  // path; the 413 is decided before anything is parsed.
  if oversized { Array::length(into) } else { filled }
}

/// Moves `count` bytes from `at` to the front, for the next request to grow on.
fn shift_down(buffer: Array<U8>, at: Int, count: Int) -> () {
  let mut i = 0;
  while i < count {
    Array::set(buffer, i, Array::get(buffer, at + i));
    i = i + 1;
  }
}

fn copy_at(from: Array<U8>, into: Array<U8>, count: Int, offset: Int) -> () {
  let mut i = 0;
  while i < count {
    Array::set(into, offset + i, Array::get(from, i));
    i = i + 1;
  }
}

/// How long the whole request should be, or negative while the headers are
/// still arriving.
/// How many bytes the request starting at 0 is, or 0 if it has not all
/// arrived.
///
/// **The framing primitive.** A reader needs to know when to stop, and HTTP
/// answers that in two parts: the headers end at a blank line, and
/// `Content-Length` says how much follows. Getting it wrong is not a bug that
/// shows up in testing — it is a request truncated at a packet boundary, or two
/// requests read as one — which is why this is exported rather than left for
/// each framework to derive again.
///
/// [`Connection`] is this with a buffer around it, and is what most callers
/// want.
pub fn request_length(bytes: Array<U8>, filled: Int) -> Int {
  let after = end_of_headers(bytes, filled);
  if after < 0 {
    0 - 1
  } else {
    let head = Array::prefix(bytes, after);
    // Header bytes that are not text are a request nobody can answer, and
    // saying it ends here turns that into a 400 rather than a trap inside
    // `from_bytes`.
    if Array::is_utf8(head) {
      after + content_length(String::from_bytes(head))
    } else {
      after
    }
  }
}

/// Where the body starts, or negative if the blank line has not arrived.
///
/// Searched over bytes rather than text, because the headers are only complete
/// once this says so: converting first would mean converting a fragment, and a
/// fragment can split a character.
fn end_of_headers(bytes: Array<U8>, filled: Int) -> Int {
  let mut i = 0;
  let mut found = 0 - 1;
  while found < 0 && i + 3 < filled {
    if U8::to_int(Array::get(bytes, i)) == 13
    && U8::to_int(Array::get(bytes, i + 1)) == 10
    && U8::to_int(Array::get(bytes, i + 2)) == 13
    && U8::to_int(Array::get(bytes, i + 3)) == 10 {
      found = i + 4;
    } else {
      i = i + 1;
    }
  }
  found
}

fn content_length(head: String) -> Int {
  match String::split_once(head, "\r\n") {
    Option::None => 0,
    Option::Some(lines) => match Map::get(parse_headers(lines.rest), "content-length") {
      Option::None => 0,
      Option::Some(value) => digits_of(value),
    },
  }
}

// ---------------------------------------------------------------------------
// Routing
// ---------------------------------------------------------------------------

/// Whether `path` matches `pattern`, and what its `:name` segments bound.
///
/// Segment by segment, because that is what a `:name` matches — one segment,
/// never a `/`. A pattern and a path of different lengths do not match, which
/// is what keeps `/a/:b` from swallowing `/a/b/c`.
// ---------------------------------------------------------------------------
// Reading requests off a connection
// ---------------------------------------------------------------------------

/// One connection, read a request at a time.
///
/// **This is the layer between a socket and a router**, and it is public
/// because a router is a matter of taste and this is not. Framing a request
/// correctly — reading until it is whole, honouring `Content-Length`, holding
/// what a pipelined client sent early, refusing one that will not fit — is the
/// same work whatever shape the framework above it has, and it is the work that
/// fails in production rather than in testing.
///
/// `Router` is written against this and has no privileged access to anything
/// below it. A framework with a different shape — middleware chain, effect
/// handler, one function per method — starts here and owes nothing to `Router`.
///
/// **Nothing here spawns.** A connection is read by whoever calls `next`, on
/// whatever fiber that is. `Router` gives each connection a fiber in its accept
/// loop and that is a decision of the accept loop, not of this type: a server
/// that answers one caller at a time, or hands connections to a pool, is
/// written against exactly this.
pub type Connection = {
  transport: Transport,
  buffer: Array<U8>,
  /// Bytes of the *next* request that arrived with the last one. A pipelining
  /// client sends two without waiting, and the second must not be dropped.
  mut carried: Int,
};

/// What reading a connection produced.
pub type Incoming =
  /// A whole request, and whether the client asked to keep the connection open.
  ///
  /// The flag is read from the `Connection` header here rather than by the
  /// caller, because the caller would have to fold the header's case and this
  /// has already done it.
  | Arrived(request: Request, keep: Bool)
  /// The peer closed, or the read deadline passed. There is nothing to answer
  /// and nothing to send.
  | Ended
  /// Nothing usable arrived: send this and close.
  ///
  /// A client that could not be understood cannot be trusted about where its
  /// next request begins, so the connection cannot be reused whatever the
  /// `Connection` header said.
  | Rejected(response: Response);

impl Connection {
  /// Over a transport, holding at most [`default_limit`] bytes per request.
  pub fn over(transport: Transport) -> Connection {
    Connection::holding(transport, default_limit())
  }

  /// The same, with a cap of your own.
  ///
  /// The buffer is allocated once for the connection rather than once per
  /// request, so this is what one caller costs in memory for as long as they
  /// are connected.
  pub fn holding(transport: Transport, most: Int) -> Connection {
    let buffer: Array<U8> = Array::new(most, 0);
    { transport: transport, buffer: buffer, carried: 0 }
  }

  /// Reads until one request is whole, and says what arrived.
  ///
  /// Blocks. Whether that blocks a thread, a fiber or the only thread there is
  /// belongs to the caller — see the note on [`Connection`].
  pub fn next(self) -> Incoming {
    let filled = read_request(self.transport, self.buffer, self.carried);
    let want = request_length(self.buffer, filled);
    // Whether what is in the buffer is already a whole request.
    let whole = want > 0 && want <= filled;
    // **A read that added nothing is not always the end.** `read_request`
    // returns immediately when the carry is already a whole request, which is
    // what a pipelining client produces: two requests in one packet, the
    // second sitting in the buffer while the first is answered. Reading
    // "nothing new arrived" as "the client has gone" dropped it, and no test
    // with `curl` in it could see that — `curl` waits for each answer before
    // sending the next, so the carry is always empty.
    if filled <= 0 || (filled == self.carried && !whole) {
      // The client closed, or the deadline passed.
      Incoming::Ended
    } else {
      // A request whose length is not yet known is taken to be everything
      // read so far, which is either a request without a body or one that
      // will fail the size check below.
      let length = if whole { want } else { filled };
      if length >= Array::length(self.buffer) {
        // The buffer filled before the request ended. Whether the client lied
        // about its length or simply sent too much, the answer is the same.
        Incoming::Rejected(Response::text(413, "request too large"))
      } else {
        let taken = Array::prefix(self.buffer, length);
        // Held before parsing, so `next` leaves the connection ready whatever
        // the parse decides. `prefix` copied, so moving the buffer underneath
        // is safe.
        self.carried = filled - length;
        shift_down(self.buffer, length, self.carried);
        if Array::is_utf8(taken) {
          Connection::understood(String::from_bytes(taken))
        } else {
          Incoming::Rejected(Response::text(400, "request was not text"))
        }
      }
    }
  }

  /// Parses one request, or the 400 to answer it with.
  ///
  /// Everything a connection needs to decide before a handler runs: whether
  /// the bytes were a request at all, and — from the headers the parser has
  /// already folded — whether the client asked to keep the connection.
  pub fn understood(text: String) -> Incoming {
    match parse(text) {
      Option::None => Incoming::Rejected(Response::text(400, "malformed request")),
      Option::Some(request) => {
        // Read off the headers the parser already folded and indexed, rather
        // than searched for in the raw bytes. Scanning them again cost a copy
        // of the whole request and a second pass to lower its case, on every
        // request, for an answer that was already sitting in a map. Worth
        // 3.4% — a note here once said "about a fifth", which was a guess
        // written down as though it had been measured.
        let keep = match Request::header(request, "connection") {
          Option::None => true,
          Option::Some(said) => lowered(said) != "close",
        };
        Incoming::Arrived(request, keep)
      },
    }
  }

  /// Renders `response` and sends it.
  ///
  /// `keep` decides the `Connection` header, and is what [`Incoming::Arrived`]
  /// reported unless the caller has its own reason to close.
  pub fn reply(self, response: Response, keep: Bool) -> Int {
    self.transport.transmit(Response::rendered_keeping(response, keep))
  }

  /// Ends the conversation and releases the transport.
  pub fn shut(self) -> () {
    self.transport.shut()
  }
}

/// Whether `path` matches `pattern`, and what its `:name` segments bound.
///
/// `/analyze/:id` against `/analyze/acc_9921` binds `id`. `None` when the
/// shapes disagree, which is how the router moves on to the next route.
///
/// Exported so a program can route somewhere other than through `Router` —
/// a WebSocket upgrade, a second listener — without reimplementing the one
/// piece of matching that has to agree with the server's.
pub fn matches(pattern: String, path: String) -> Option<Params> {
  match_segments(pattern, path, Map::new())
}

fn match_segments(pattern: String, path: String, bound: Map<String, String>) -> Option<Params> {
  let here = segment(pattern);
  let mine = segment(path);
  if String::byte_length(here.head) == 0 && String::byte_length(mine.head) == 0 {
    if String::byte_length(here.rest) == 0 && String::byte_length(mine.rest) == 0 {
      Option::Some({ bound: bound })
    } else {
      match_segments(here.rest, mine.rest, bound)
    }
  } else if String::starts_with(here.head, ":") {
    if String::byte_length(mine.head) == 0 {
      Option::None
    } else {
      Map::insert(bound, String::slice(here.head, 1, String::byte_length(here.head)), mine.head);
      finish_match(here.rest, mine.rest, bound)
    }
  } else if here.head == mine.head {
    finish_match(here.rest, mine.rest, bound)
  } else {
    Option::None
  }
}

fn finish_match(pattern: String, path: String, bound: Map<String, String>) -> Option<Params> {
  if String::byte_length(pattern) == 0 && String::byte_length(path) == 0 {
    Option::Some({ bound: bound })
  } else if String::byte_length(pattern) == 0 || String::byte_length(path) == 0 {
    Option::None
  } else {
    match_segments(pattern, path, bound)
  }
}

/// The next `/`-separated piece, and what follows it.
fn segment(text: String) -> Split {
  let without_slash =
  if String::starts_with(text, "/") { String::slice(text, 1, String::byte_length(text)) }
  else { text };
  match String::split_once(without_slash, "/") {
    Option::None => { head: without_slash, rest: "" },
    Option::Some(parts) => parts,
  }
}

// ---------------------------------------------------------------------------
// The router
// ---------------------------------------------------------------------------

/// One mounted route.
///
/// The handler is a `SharedFn` rather than a plain closure, and that is what
/// lets a router be answered on a fiber of its own. A closure's captures are
/// not in its type, so a record holding one can never be handed to another
/// fiber; `SharedFn::of` checks the captures where the closure is written and
/// hands back something that has forgotten it was ever a closure.
///
/// It also takes the capabilities out of the router's type. A handler closes
/// over what it needs at the mount site, so there is no `'r` left for a `Route`
/// to carry — `Router<'e>` says only how its handlers can fail.
pub type Route<'e> = {
  method: Method,
  pattern: String,
  handler: SharedFn<Request, Response, 'e>,
};

/// A router carries its handlers' failures, so mounting a route that can fail
/// against the database widens the router's own error row.
pub type Router<'e> = {
  routes: List<Route<'e>>,
};

/// A response, and whether the connection that asked for it is staying open.
///
/// The two travel together because they are decided together: the answer's
/// status and the request's `Connection` header are both known once, at the
/// point the request has been parsed, and working either out again afterwards
/// means reading the request a second time.
/// Mounting is written `router |> Router::post(..)`, so the router is the
/// first parameter of each. They are the type's own functions rather than free
/// ones so that the pipeline reads as a chain against `Router` and cannot
/// collide with another module's `get`.
impl Router {
  /// A router with no routes. The start of the pipeline.
  pub fn new<'e>() -> Router<'e> { { routes: List::Nil } }

  /// Mounts `handler` at `route` for POST.
  ///
  /// Later mounts are tried first, because each prepends. Mounting the same
  /// route twice is allowed and the second one wins, which is worth knowing
  /// rather than an invariant anything enforces.
  pub fn post<'e>(
    router: Router<'e>,
    route: String,
    handler: SharedFn<Request, Response, 'e>
  ) -> Router<'e> {
    { routes: List::Cons({ method: Method::Post, pattern: route, handler: handler }, router.routes) }
  }

  /// Mounts `handler` at `route` for GET.
  pub fn get<'e>(
    router: Router<'e>,
    route: String,
    handler: SharedFn<Request, Response, 'e>
  ) -> Router<'e> {
    { routes: List::Cons({ method: Method::Get, pattern: route, handler: handler }, router.routes) }
  }

  /// Serves until the process stops, on a fiber per connection.
  pub fn listen<'e>(router: Router<'e>, port: Int) -> ()
    raises 'e + HttpError
  {
    if start() {
    } else {
      raise HttpError::BindFailed(port)
    };
    let server = listen_on(port);
    if server == invalid_handle() {
      raise HttpError::BindFailed(port)
    } else {
      // Announced so that whatever started this knows the port is open. A
      // caller that wants silence can have a quieter one when there is
      // something to configure it with.
      print("listening on " + Int::to_string(port));
      // The nursery is opened here rather than asked of the caller: that a
      // server answers on a fiber per connection is its own business.
      //
      // Written as a lambda, which needed
      // `docs/design/capability-passing.md`: the thunk requires a nursery that
      // does not exist where it is written, so `nursery` supplies one when it
      // calls it. Until that landed this was the handler spelled out by hand,
      // because a lambda's requirement row was always empty.
      // Bounded, because the connections come from outside. A fiber is an
      // operating-system thread today and costs about 33 KB, so an unbounded
      // nursery here would meet its ceiling by exhausting memory; this one
      // meets it by accepting more slowly, and the backlog holds the rest.
      //
      // 256 is a working number rather than a tuned one: comfortably inside
      // what was measured to be fine — 400 concurrent connections cost 401
      // threads and 13 MB, still answering in 14 ms — and comfortably below
      // where thread-per-connection stops being reasonable at all.
      bounded_nursery(256, fn () => Router::serve_forever(router, server)!)!
    }
  }

  /// Accepts for as long as the process lives.
  /// The same, over TLS.
  ///
  /// Takes the certificate chain and the key as PEM rather than as paths: a
  /// server that reads its own files has decided where they live, and the two
  /// deployments that matter — a file on disk and a secret handed in by the
  /// platform — disagree about that.
  ///
  /// The configuration is released when the caller's scope ends, which for a
  /// server is usually the program's.
  pub fn listen_tls<'e>(router: Router<'e>, port: Int, certificate: String, key: String) -> ()
    with { scope: Scope }
    raises 'e + HttpError + TlsError
  {
    let settings = tls_server(certificate, key)!;
    let server = Router::bound(port)!;
    print("listening on " + Int::to_string(port) + ", over TLS");
    bounded_nursery(256, fn () => Router::serve_secured(router, server, settings)!)!
  }

  /// A listening socket on `port`, announced by the caller.
  pub fn bound<'e>(port: Int) -> Int raises HttpError {
    if start() {
    } else {
      raise HttpError::BindFailed(port)
    };
    let server = listen_on(port);
    if server == invalid_handle() { raise HttpError::BindFailed(port) } else { server }
  }

  /// `serve_forever` over TLS: accepts, handshakes, and serves on a fiber
  /// each.
  ///
  /// A failed handshake ends that fiber quietly rather than the loop — on a
  /// public port it is the ordinary case, not an incident.
  pub fn serve_secured<'e>(router: Router<'e>, server: Int, settings: TlsServer) -> ()
    with { nursery: Nursery }
    raises 'e + HttpError
  {
    let connection = accept_on(server);
    if connection == invalid_handle() {
    } else {
      set_receive_timeout(connection, 10000);
      nursery.adopt(Fiber::spawn(fn () => Router::secure_and_serve(router, connection, settings)));
    };
    Router::serve_secured(router, server, settings)!
  }

  /// One connection, handshaken and then served.
  ///
  /// A failed handshake is the ordinary case on a public port — a scanner, a
  /// browser sent to `http://` — so it ends this fiber quietly. `secure` has
  /// already closed the socket.
  fn secure_and_serve<'e>(router: Router<'e>, connection: Int, settings: TlsServer) -> () {
    match attempt(fn () => secure(settings, connection)!) {
      Result::Err(_) => (),
      Result::Ok(secured) => Router::serve_connection(router, over_tls(secured)),
    }
  }

  /// Accepts connections on `server` until the process stops.
  ///
  /// `listen` is the one to call: it binds the port and then this. Taking an
  /// already-bound socket is for a caller that wants to bind it themselves —
  /// a test on port zero, a socket inherited from a supervisor.
  pub fn serve_forever<'e>(router: Router<'e>, server: Int) -> ()
    with { nursery: Nursery }
    raises 'e + HttpError
  {
    Router::serve_once(router, server)!;
    Router::serve_forever(router, server)!
  }

  /// Accepts one connection and hands it to a fiber of its own.
  ///
  /// **This is what `SharedFn` bought.** A closure's captures are not in its
  /// type, so a `Router` holding plain closures could never cross into a fiber
  /// and the server answered one caller at a time. Certifying each handler
  /// where it is mounted makes the route an ordinary shareable record, and the
  /// thunk below closes over the whole router without anything special being
  /// said about routers. `docs/design/sharing.md`.
  ///
  /// The nursery is what makes it structured rather than merely concurrent: an
  /// adopted fiber cannot outlive it, so leaving `listen` — by a raise, or by
  /// cancellation — deals with the connections still being answered instead of
  /// abandoning them.
  ///
  /// **A fiber is an operating-system thread today**, so this is
  /// thread-per-connection and should be read as such: fine for a service with
  /// tens or hundreds of concurrent callers, and the wrong shape for tens of
  /// thousands. Nothing here changes when fibers become stackful coroutines on
  /// a scheduler — `docs/design/fibers.md` promises a program cannot tell which
  /// it has — so the ceiling is the runtime's to raise and not this module's.
  /// Until it does, the honest position is a bounded number of connections
  /// rather than an event loop that happens not to be written yet.
  fn serve_once<'e>(router: Router<'e>, server: Int) -> ()
    with { nursery: Nursery }
    raises 'e + HttpError
  {
    let connection = accept_on(server);
    if connection == invalid_handle() {
    } else {
      // The deadline goes on the socket before anything wraps it, because a
      // handshake can hang exactly as a request can.
      set_receive_timeout(connection, 10000);
      nursery.adopt(Fiber::spawn(fn () =>
          Router::serve_connection(router, over_socket(connection))));
    }
  }

  /// One connection, from the first byte to the close.
  ///
  /// What a fiber runs, and it does not fail: a fiber has nobody to hand a
  /// failure to, and a connection nothing closes is a descriptor leaked for the
  /// life of the process. So whatever the handler raised becomes a 500 and the
  /// socket is shut either way.
  ///
  /// The arm is `_`, because `'e` is whatever the mounted handlers raise and
  /// this function cannot name a constructor of it. Catching *whatever* is the
  /// one thing naming constructors cannot express, and the reason a total
  /// wildcard arm exists at all.
  fn serve_connection<'e>(router: Router<'e>, transport: Transport) -> () {
    // Before anything is read. `read_request` keeps reading until the request
    // is complete, which is the only correct thing to do and is also how a
    // fiber gets parked forever by a client that stops talking. Ten seconds is
    // long enough that no real client notices and short enough that a
    // half-open connection is not a leak.
    Router::answer_on(router, transport) catch {
      _ => {
        transport.transmit(Response::rendered(Response::text(500, "handler failed")));
      },
    };
    transport.shut()
  }

  /// Answers every request on one connection, until the client stops.
  ///
  /// **Written against the public [`Connection`], with nothing reserved.** A
  /// framework of a different shape writes this loop itself and is not missing
  /// anything: the reading, the framing and the refusals are all above.
  pub fn answer_on<'e>(router: Router<'e>, transport: Transport) -> ()
    raises 'e
  {
    let connection = Connection::over(transport);
    let mut going = true;
    while going {
      match Connection::next(connection) {
        Incoming::Ended => going = false,
        Incoming::Rejected(response) => {
          Connection::reply(connection, response, false);
          going = false
        },
        Incoming::Arrived(request, keep) => {
          let response = Router::dispatch(router.routes, request)!;
          Connection::reply(connection, response, keep);
          going = keep
        },
      }
    }
  }

  /// What to send back for this request text.
  fn dispatch<'e>(routes: List<Route<'e>>, request: Request) -> Response
    raises 'e
  {
    match routes {
      List::Nil => Response::text(404, "no route for " + request.path),
      List::Cons(route, rest) =>
      if Method::same(route.method, request.method) {
        match matches(route.pattern, request.path) {
          Option::Some(params) =>
          SharedFn::call(route.handler, {
              method: request.method,
              path: request.path,
              params: params,
              queries: request.queries,
              headers: request.headers,
              body: request.body,
            })!,
          Option::None => Router::dispatch(rest, request)!,
        }
      } else {
        Router::dispatch(rest, request)!
      },
    }
  }
}

fn print(value: String);
