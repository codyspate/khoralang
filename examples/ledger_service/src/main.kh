module ledger_service::main;

import std::core::{ChildFailed, Fibers, List, Map, Option, Result, SharedFn, Show, Validated, print};
import std::db::{Cell, Db, DbError, Row, transaction};
import std::schema::{Decode, Rejection, list};
import std::clock::{Clock};
import std::env::{Env, EnvError, variable_or};
import std::json::{Json, JsonError, parse};
import std::net::http::{HttpError, Params, Request, Response, Router};
import std::trace::{Tracer, around_result, text};
import postgres::db::{Settings};
import postgres::pool::{Pool, open as open_pool, with_db};

// A ledger, and the third program here meant to be *run* rather than to
// demonstrate a feature. Roadmap 13.18.
//
// `link_shortener` answers HTTP from a store in memory. This one answers HTTP
// from PostgreSQL, under tracing, over a connection pool — which is the
// combination a production service actually is, and the combination nothing
// in this repository had put together. Everything it uses landed in the last
// few days: bound parameters, the `Db` capability, the channel the capability
// is built on, and the pool the channel makes almost free.
//
// What it does:
//
//   POST /entries    {"account": "...", "amount": 1250, "memo": "..."}
//   GET  /entries?account=...            -> that account's entries, newest first
//   GET  /balance/:account               -> one number, computed by the server
//   GET  /health                         -> whether the database answers
//
// Amounts are integer minor units — pence, cents — and never floats.
// `docs/design/numbers.md` is emphatic about why, and a ledger is the example
// it uses.
//
// What it does not do: authentication, pagination, or currency. Each is absent
// because it would add a shape already exercised elsewhere.

// ---------------------------------------------------------------------------
// What an entry is
// ---------------------------------------------------------------------------

/// **`Decode` is derived, and a query's rows are read through it** -- by
/// column name, every problem reported, which is what replaced forty lines
/// of matching cells by position and dropping the row that did not fit.
derive(Show, Decode)
pub type Entry = {
  id: Int,
  account: String,
  /// Minor units. See the note at the head of this file.
  amount: Int,
  memo: String,
};

impl Entry {
  /// The JSON a client sees.
  fn as_json(self) -> Json {
    let fields = Map::new();
    Map::insert(fields, "id", Json::of_int(self.id));
    Map::insert(fields, "account", Json::Text(self.account));
    Map::insert(fields, "amount", Json::of_int(self.amount));
    Map::insert(fields, "memo", Json::Text(self.memo));
    Json::Object(fields)
  }
}

// ---------------------------------------------------------------------------
// Reading a row
// ---------------------------------------------------------------------------
//
// **A surprise is a failure rather than a zero.** A row that does not have
// the shape the query asked for means the database and this file disagree,
// and the useful thing to do about that is say so at the edge — not to serve
// a plausible-looking entry with an amount of nothing. `Entry` reads itself
// through its derived schema; the one cell read by position is the balance.

fn cell_at(cells: List<Cell>, index: Int) -> Option<Cell> {
  let mut rest = cells;
  let mut at = 0;
  let mut found: Option<Cell> = Option::None;
  let mut going = true;
  while going {
    match rest {
      List::Nil => going = false,
      List::Cons(head, tail) => {
        if at == index {
          found = Option::Some(head);
          going = false
        } else {
          at = at + 1;
          rest = tail
        }
      },
    }
  };
  found
}

fn number_at(cells: List<Cell>, index: Int) -> Option<Int> {
  match cell_at(cells, index) {
    Option::Some(Cell::Number(n)) => Option::Some(n),
    Option::Some(_) => Option::None,
    Option::None => Option::None,
  }
}

/// Every row, read by column name through `Entry`'s schema.
///
/// A row that does not fit fails the request with the row's index in the
/// message, `[2].amount should be a whole number`, rather than being dropped:
/// a database that has drifted from this file is a thing to know, and a
/// listing that was quietly one entry short is how nobody knew.
fn entries_of(rows: List<Row>) -> Validated<List<Entry>, Rejection> {
  list(Entry::schema()).decode(Row::sequence(rows))
}

// ---------------------------------------------------------------------------
// The statements
// ---------------------------------------------------------------------------
//
// **Every value is a bound parameter.** Not one of these builds SQL by
// concatenation. Database authority stays in the capability row, so these
// functions say what they need without accepting a connection argument.

/// Written the way it would be in a migration, which is what the backtick
/// literal is for.
const SCHEMA: String = `
  create table if not exists entries (
    id serial primary key,
    account text not null,
    amount int4 not null,
    memo text not null
  )
`;

fn insert_entry(account: String, amount: Int, memo: String) -> Result<Int, DbError>
  with { db: Db }
{
  let values =
    List::Cons(Cell::Text(account),
      List::Cons(Cell::Number(amount),
        List::Cons(Cell::Text(memo), List::Nil)));
  db.execute("insert into entries (account, amount, memo) values ($1, $2, $3)", values)
}

fn entries_for(account: String) -> Result<List<Row>, DbError>
  with { db: Db }
{
  db.query(
    "select id::int4, account, amount, memo from entries where account = $1 order by id desc",
    List::Cons(Cell::Text(account), List::Nil),
  )
}

/// The balance, summed **by the server**.
///
/// `coalesce` because `sum` over no rows is NULL rather than zero, and an
/// account nobody has posted to has a balance of nothing rather than no
/// balance.
fn balance_for(account: String) -> Result<List<Row>, DbError>
  with { db: Db }
{
  db.query(
    "select coalesce(sum(amount), 0)::int4 from entries where account = $1",
    List::Cons(Cell::Text(account), List::Nil),
  )
}

fn health_query() -> Result<List<Row>, DbError>
  with { db: Db }
{
  db.query("select 1::int4", List::Nil)
}

fn ensure_schema() -> Result<Int, DbError>
  with { db: Db }
{
  db.execute(SCHEMA, List::Nil)
}

// ---------------------------------------------------------------------------
// Turning a failure into a response
// ---------------------------------------------------------------------------

/// What a client is told, and what it is not.
///
/// **The engine's message does not cross the boundary.** A `DbError` can carry
/// a constraint name, a column, a hint about the schema; a client asking for a
/// balance has no use for any of it and an attacker has several. The status
/// carries the actionable part — 400 when the request was wrong, 503 when the
/// database was — and the detail belongs in the span.
fn refused(why: DbError) -> Response {
  let fields = Map::new();
  match why {
    DbError::Rejected(_) => {
      Map::insert(fields, "error", Json::Text("the request could not be satisfied"));
      Response::json(400, Json::Object(fields))
    },
    DbError::Disconnected(_) => {
      Map::insert(fields, "error", Json::Text("the ledger is unavailable"));
      Response::json(503, Json::Object(fields))
    },
    DbError::RolledBack(_) => {
      Map::insert(fields, "error", Json::Text("the change was rolled back"));
      Response::json(409, Json::Object(fields))
    },
  }
}

fn json_list(items: List<Json>) -> Response {
  Response::json(200, Json::Array(items))
}

// ---------------------------------------------------------------------------
// The routes
// ---------------------------------------------------------------------------

/// `POST /entries` — one entry, in a transaction.
///
/// A single insert does not need a transaction and has one anyway, because
/// this is the shape a second statement gets added to and the version without
/// one is the version somebody extends without noticing. `transaction` rolls
/// back when the body fails, including when the fiber running it is cancelled
/// — which is roadmap 13.3 and the half that is still the server's rather than
/// Khora's.
fn create(pool: Pool, tracer: Tracer, request: Request) -> Response {
  match parse(request.body) {
    Result::Err(_) => Response::text(400, "the body is not JSON"),
    Result::Ok(document) => match posted(document) {
      Option::None => Response::text(400, "expected account, amount and memo"),
      Option::Some(entry) => stored(pool, tracer, entry),
    },
  }
}

/// The three fields, or nothing. A memo is optional and defaults to empty; an
/// account and an amount are not.
fn posted(document: Json) -> Option<Entry> {
  match Json::field(document, "account") {
    Option::Some(Json::Text(account)) => match Json::field(document, "amount") {
      // **`Json::integer`, not a `Float` and back.** A ledger amount is in
      // minor units, so `Float::to_int(amount)` was the whole of #142 sitting
      // in the reference application: an entry above 2^53 posted the wrong
      // number, quietly, in the example that exists to show money being
      // handled properly.
      Option::Some(written) => match Json::integer(written) {
        Option::None => Option::None,
        Option::Some(amount) => {
          let memo = match Json::field(document, "memo") {
            Option::Some(Json::Text(written)) => written,
            Option::Some(_) => "",
            Option::None => "",
          };
          Option::Some({ id: 0, account: account, amount: amount, memo: memo })
        },
      },
      Option::None => Option::None,
    },
    Option::Some(_) => Option::None,
    Option::None => Option::None,
  }
}

fn store_entry(entry: Entry) -> Result<Int, DbError>
  with { db: Db }
{
  transaction(fn () => insert_entry(entry.account, entry.amount, entry.memo))
}

fn stored(pool: Pool, tracer: Tracer, entry: Entry) -> Response {
  let attempted = around_result(tracer, "entries.create", fn () =>
    with_db(pool, fn () => store_entry(entry)));

  match attempted {
    Result::Err(why) => refused(why),
    Result::Ok(inner) => match inner {
      Result::Err(why) => refused(why),
      Result::Ok(_) => {
        let fields = Map::new();
        Map::insert(fields, "stored", Json::Bool(true));
        Map::insert(fields, "account", Json::Text(entry.account));
        Response::json(201, Json::Object(fields))
      },
    },
  }
}

/// `GET /entries?account=...`
///
/// **The flow operator earning its place.** Reading an answer is three steps
/// with no interesting name between them — take the rows, keep the ones that
/// have the shape, render each — and naming the value twice to say so was the
/// whole of what `fn value => value |> ..` bought.
fn listing(pool: Pool, tracer: Tracer, request: Request) -> Response {
  match Map::get(request.queries, "account") {
    Option::None => Response::text(400, "expected an `account` query parameter"),
    Option::Some(account) => {
      let asked = around_result(tracer, "entries.list", fn () =>
        with_db(pool, fn () => entries_for(account)));
      match asked {
        Result::Err(why) => refused(why),
        Result::Ok(inner) => match inner {
          Result::Err(why) => refused(why),
          Result::Ok(rows) =>
            match entries_of(rows) {
              Validated::Valid(entries) => entries |> as_documents |> json_list,
              // The rows are the database's and the shape is this file's, so
              // a disagreement is a server problem, said in full.
              Validated::Invalid(problems) => Response::text(500, Rejection::report(problems)),
            },
        },
      }
    },
  }
}

fn as_documents(entries: List<Entry>) -> List<Json> {
  match entries {
    List::Nil => List::Nil,
    List::Cons(entry, rest) => List::Cons(Entry::as_json(entry), as_documents(rest)),
  }
}

/// `GET /balance/:account`
fn balance(pool: Pool, tracer: Tracer, request: Request) -> Response {
  match Map::get(request.params.bound, "account") {
    Option::None => Response::text(400, "expected an account"),
    Option::Some(account) => {
      let asked = around_result(tracer, "entries.balance", fn () =>
        with_db(pool, fn () => balance_for(account)));
      match asked {
        Result::Err(why) => refused(why),
        Result::Ok(inner) => match inner {
          Result::Err(why) => refused(why),
          Result::Ok(rows) => answered(account, rows),
        },
      }
    },
  }
}

fn answered(account: String, rows: List<Row>) -> Response {
  let total = match rows {
    List::Nil => 0,
    List::Cons(row, _) => match number_at(row.cells, 0) {
      Option::Some(n) => n,
      Option::None => 0,
    },
  };
  let fields = Map::new();
  Map::insert(fields, "account", Json::Text(account));
  Map::insert(fields, "balance", Json::of_int(total));
  Json::Object(fields) |> Response::json(200, _)
}

/// `GET /health`
///
/// **Asks the database.** A health check that answers 200 because the process
/// is running tells a load balancer nothing it did not already know from the
/// connection being accepted.
fn health(pool: Pool, tracer: Tracer, _request: Request) -> Response {
  let asked = around_result(tracer, "health", fn () =>
    with_db(pool, health_query));
  let fields = Map::new();
  match asked {
    Result::Err(_) => {
      Map::insert(fields, "database", Json::Text("unreachable"));
      Response::json(503, Json::Object(fields))
    },
    Result::Ok(inner) => match inner {
      Result::Err(_) => {
        Map::insert(fields, "database", Json::Text("unreachable"));
        Response::json(503, Json::Object(fields))
      },
      Result::Ok(_) => {
        Map::insert(fields, "database", Json::Text("ready"));
        Response::json(200, Json::Object(fields))
      },
    },
  }
}

// ---------------------------------------------------------------------------
// Starting
// ---------------------------------------------------------------------------

fn setting(name: String, fallback: String) -> String with { env: Env } raises EnvError {
  variable_or(name, fallback)!
}

fn number_setting(name: String, fallback: Int) -> Int with { env: Env } raises EnvError {
  match Int::of_string(variable_or(name, Int::to_string(fallback))!) {
    Option::Some(chosen) => chosen,
    // An operator's typo is worth saying so about and not worth refusing to
    // start over. `link_shortener` makes the same call for the same reason.
    Option::None => {
      print(name + " is not a number; using " + Int::to_string(fallback));
      fallback
    },
  }
}

pub fn main() raises HttpError + EnvError + ChildFailed {
  with { env: Env::real(), clock: Clock::real() } {
    let settings: Settings = {
      host: setting("PGHOST", "127.0.0.1")!,
      port: number_setting("PGPORT", 5433)!,
      user: setting("PGUSER", "khora")!,
      database: setting("PGDATABASE", "khora")!,
      secret: setting("PGPASSWORD", "khora")!,
    };

    // The serving fibers live for the whole program, so the crew is opened
    // here and never waited on: a pool that outlives `main` is not a thing,
    // and `Router::listen` does not return.
    let crew = Fibers::open();
    let pool = open_pool(crew, settings, number_setting("POOL", 4)!);
    let tracer = Tracer::none();

    // **Both results, and the inner one is the statement's.** `with_db` answers
    // whether a *connection* was available; what was done with it comes back
    // inside that. Matching only the outer one printed "schema ready" against
    // a database that was not running, which is the more dangerous half of the
    // two to get wrong -- a start-up line that lies about the thing it just
    // checked.
    match with_db(pool, ensure_schema) {
      Result::Err(_) => print("no connection for the schema; starting anyway"),
      Result::Ok(inner) => match inner {
        Result::Ok(_) => print("schema ready"),
        Result::Err(_) => print("could not create the schema; starting anyway"),
      },
    };

    print("ledger listening");
    Router::new()
      |> Router::post("/entries", SharedFn::of(fn request => create(pool, tracer, request)))
      |> Router::get("/entries", SharedFn::of(fn request => listing(pool, tracer, request)))
      |> Router::get("/balance/:account", SharedFn::of(fn request => balance(pool, tracer, request)))
      |> Router::get("/health", SharedFn::of(fn request => health(pool, tracer, request)))
      |> Router::listen(number_setting("PORT", 8080)!)!
  }
}
