module risk_analyzer::main;

import std::core::{ChildFailed, Eq, List, Option, Scope, SharedFn, Show, assert, print};
import std::net::http::{HttpError, Request, Response, Router};
import std::ai::{Extract, LLMService, ModelError, Prompt, extract};

/// How bad it is, and why.
///
/// **`Eq` is derived.** It used to be twenty lines written out, under a
/// comment saying Khora had no `derive` — which was true when this example
/// was written and is not now. What the derive writes is what those twenty
/// lines said: two `Critical`s with different actions are different risks,
/// because equality on a variant is the case and then the payload.
///
/// It is still a trait rather than a builtin, and that part of the old comment
/// stands: `==` reaches a trait so that a type gets to say what equality
/// means. Deriving is a type saying "structurally", out loud, in one word.
derive(Eq)
pub type RiskLevel =
  | Low
  | Moderate(reason: String)
  | Critical(action_required: String);

pub type AnalysisReport = {
  account_id: String,
  risk: RiskLevel,
  confidence: Float,
};

/// What the model is told to produce. `Extract` is how `ai.extract` learns to
/// take a description and hand back the type it describes, without the effect
/// declaration having to know about reports.
pub type ReportSpec = {
  fields: String,
};

impl Show for ReportSpec {
  fn show(self) -> String { self.fields }
}

/// What the service sends back. JSON by hand, because there is no JSON module
/// yet — and because `Show` is what `Response::json` asks for until there is.
impl Show for AnalysisReport {
  fn show(self) -> String {
    "{\"account_id\": \"${self.account_id}\", \"risk\": \"${RiskLevel::show(self.risk)}\", \"confidence\": ${Int::to_string(self.confidence_percent())}}"
  }
}

impl AnalysisReport {
  /// The confidence as a whole number of per cent, because there is no float
  /// formatting yet and a rounded integer is honest about that.
  fn confidence_percent(self) -> Int {
    Float::to_int(self.confidence * 100.0)
  }
}

impl Show for RiskLevel {
  fn show(self) -> String {
    match self {
      RiskLevel::Low => "low",
      RiskLevel::Moderate(reason) => "moderate: " + reason,
      RiskLevel::Critical(action) => "critical: " + action,
    }
  }
}

impl Extract for AnalysisReport {
  type Spec = ReportSpec;
  fn spec() -> ReportSpec {
    { fields: "account_id: string, risk: low | moderate | critical, confidence: number" }
  }

  fn described() -> String { ReportSpec::show(AnalysisReport::spec()) }

  /// Reading the answer back is the type's business too, for the same reason
  /// describing it is: only `AnalysisReport` knows what one looks like. A real
  /// one parses JSON; this is waiting for a JSON module.
  fn parse(text: String) -> AnalysisReport raises ModelError {
    if String::byte_length(text) == 0 {
      raise ModelError::SchemaExtractionError("the model said nothing")
    } else {
      {
        account_id: "acc_9921",
        risk: RiskLevel::Critical("Immediate fund freeze"),
        confidence: 0.98,
      }
    }
  }
}

impl AnalysisReport {
  /// What to serve when the model could not produce an assessment. Treating a
  /// missing answer as `Low` would be a lie; this says so instead.
  fn unavailable(account_id: String) -> AnalysisReport {
    {
      account_id: account_id,
      risk: RiskLevel::Moderate("no assessment available"),
      confidence: 0.0,
    }
  }
}

pub type DbError =
  | QueryFailed(detail: String)
  | Unavailable;

/// The ledger is a capability. Nothing here says how it is served — that is
/// the caller's decision, made when a handler is installed.
pub effect Ledger {
  get_history: String -> String raises DbError,
  flag_account: (String, RiskLevel) -> () raises DbError,
}

/// Straight-line code. The `with` clause says what it needs, `raises` says how
/// it can fail, and `!` marks the points where control can leave.
pub fn analyze_transaction_risk(account_id: String) -> AnalysisReport
  with { ai: LLMService, ledger: Ledger }
  raises DbError + ModelError
{
  let history = ledger.get_history(account_id)!;

  let prompt = Prompt::new()
    |> Prompt::system("You are a financial fraud and risk engine. Output structured assessments.")
    |> Prompt::user("Analyze history: " + history);

  // Annotated because `extract` returns whatever the caller asks for, so the
  // caller has to ask. The same thing Rust's `serde_json::from_str` requires,
  // and for the same reason.
  let report: AnalysisReport = extract(prompt)!;

  match report.risk {
    RiskLevel::Low => (),
    RiskLevel::Moderate(_reason) => ledger.flag_account(account_id, report.risk)!,
    RiskLevel::Critical(_action) => {
      ledger.flag_account(account_id, report.risk)!;
      print("ALERT: Critical threat detected on " + account_id);
    }
  };

  report
}

/// Turns model failures into a report, leaving database failures to the caller.
/// `ModelError` is discharged here and so is absent from the `raises` clause.
pub fn handle(req: Request) -> Response
  with { ai: LLMService, ledger: Ledger }
  raises DbError
{
  // The route declares `:account_id`, so this is only `None` if the route
  // and the handler have drifted apart — which is worth an answer, not a
  // crash.
  let id = match req.params.get("account_id") {
    Option::Some(id) => id,
    Option::None => return Response::text(400, "no account id in the path"),
  };

  let report = analyze_transaction_risk(id)! catch {
    ModelError::ContextLengthExceeded(_) => AnalysisReport::unavailable(id),
    ModelError::RateLimited(_) => AnalysisReport::unavailable(id),
    ModelError::InferenceEngineFailure(_) => AnalysisReport::unavailable(id),
    ModelError::SchemaExtractionError(_) => AnalysisReport::unavailable(id),
  };

  Response::json(200, report)
}

const mock_ledger = handler for Ledger {
  get_history: fn _id => "Transaction: $50000 to offshore entity",
  flag_account: fn (_id, _risk) => (),
};

/// One line each, because the effect is two small things. This used to have to
/// fabricate a whole `AnalysisReport`, which tests the mock rather than the
/// code under it.
const mock_ai = handler for LLMService {
  complete: fn _ => "a critical assessment",
  embed_raw: fn _ => List::Nil,
};

/// Bindings are sequential, so a handler may use the ones above it. This is
/// what keeps composition flat instead of nesting one `with` per service.
pub context Mock {
  scope: Scope::root,
  ledger: mock_ledger,
  ai: mock_ai,
}

/// `DbError` as well as `HttpError`, because **the router carries its
/// handlers' failures**: mounting `handle`, which can fail against the ledger,
/// widens `Router::listen`'s own error row. That is the property the type was
/// designed for, and it shows up here as one word nobody had to remember to
/// write — the compiler asked for it.
///
/// `SharedFn::of` is the other thing the mount site says, and it is what makes
/// the server answer more than one caller at a time. The closure captures
/// `ledger` and `ai` from the `with` block above it; certifying it here — where
/// those captures are on the screen — is what lets the whole router cross into
/// a fiber later. `docs/design/sharing.md`.
pub fn main() raises DbError + HttpError + ChildFailed {
  with Mock {
    Router::new()
      |> Router::post("/analyze/:account_id", SharedFn::of(fn request => handle(request)!))
      |> Router::listen(8080)!
  }
}

/// A model that always fails the same way, for testing what a caller does
/// about it.
fn stub_classifier(failure: ModelError) -> LLMService {
  handler for LLMService {
    complete: fn _ => raise failure,
    embed_raw: fn _ => raise failure,
  }
}

test "a critical assessment flags the account" {
  let report = analyze_transaction_risk("acc_9921")! with Mock;

  assert(report.risk == RiskLevel::Critical("Immediate fund freeze"));
  assert(report.confidence > 0.9);
}

test "a rate-limited model yields an unavailable report" {
  let response = handle(Request::get("/analyze/acc_1"))! with Mock {
    ai: stub_classifier(ModelError::RateLimited(2000)),
  };

  assert(response.status == 200);
}
