/target
**/*.rs.bk
Cargo.lock.bak
.DS_Store

# Built locally by editors/vscode/install.ps1
*.vsix

# What a compiled Khora program leaves beside its source, and what the link
# shortener writes while it runs.
examples/**/src/*.exe
examples/**/src/*.o
# Debug information, since 12.4: a PDB beside the executable on Windows, and
# the IR dump `KHORA_EMIT_LLVM` asks for.
examples/**/src/*.pdb
examples/**/src/*.ll
examples/**/links.txt

# The benchmark servers, built by hand rather than by cargo.
bench/**/src/*.exe
bench/**/src/*.o
bench/**/src/*.pdb
bench/**/src/*.ll
bench/*.exe
bench/*.pdb

# Written by `scripts/setup-llvm.sh`; `.cargo/config.toml.example` is the
# template. It names an LLVM prefix and a Windows SDK version, both of which
# differ per machine.
/.cargo/config.toml
