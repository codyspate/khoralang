module prometheus::metrics;

//! Counters, gauges and histograms, and the registry that renders them.
//!
//! ```khora
//! let registry = Registry::new();
//! let requests = registry.counter("http_requests_total", "Requests answered.", ["route", "status"])!;
//! requests.labels(["/orders", "200"])!.inc();
//! print(registry.render());
//! ```
//!
//! # Many fibers, one number
//!
//! **Every value lives in a `Shared` cell, and every change is one
//! `Shared::update`.** Two fibers incrementing one counter through `get` and
//! `set` would lose increments under load, and a metric that undercounts
//! exactly when the service is busiest is worse than none. `Shared::update`
//! takes the cell's lock for the read and the write together, so 100 fibers
//! making 10,000 increments each count 1,000,000.
//!
//! What it costs is a lock, a call through a closure and one allocation per
//! change: 465 user instructions and 53 ns uncontended on the thread backend
//! in a release build, 510 and 67 ns on the scheduler. A hot path holds the
//! child that `labels` answered rather than calling `labels` per event:
//! `labels` takes a second lock, on the table of children, compares the label
//! values against it, and allocates the list it was given.
//!
//! # A histogram's buckets move together
//!
//! One cell holds a histogram child's whole state, so an observation moves
//! its bucket, its sum and its count in one step. A scrape between two of
//! those, with the three in separate cells, could see a `_count` that
//! disagrees with the `+Inf` bucket, and the format says they are the same
//! number. What it costs is rebuilding the counts up to the bucket the
//! observation landed in, under the lock.

import std::core::{Dict, List, Option, Pair, Share, Shared, Show, String};
import prometheus::text::{escape_help, label_set, number, reserved_label_name, valid_label_name, valid_metric_name};

/// Why a metric was refused.
///
/// **Raised where the mistake is made, never at a scrape.** A name or label
/// the parser would refuse makes Prometheus drop the whole target, so the
/// time to say so is when the metric is declared, in front of whoever wrote
/// it, rather than as a gap in a dashboard an hour after the deploy.
pub type MetricError =
  /// The metric name does not match `[a-zA-Z_:][a-zA-Z0-9_:]*`.
  | InvalidName(String)
  /// A label name does not match `[a-zA-Z_][a-zA-Z0-9_]*`, begins with `__`,
  /// or is `le` on a histogram, which the histogram writes itself.
  | InvalidLabelName(String)
  /// A label name appears twice in one declaration.
  | DuplicateLabel(String)
  /// The registry already holds a metric by this name.
  | AlreadyRegistered(String)
  /// A metric named the first would write a series the metric of the second
  /// kind and the third name already writes: the fourth.
  ///
  /// A histogram `lat` writes `lat_bucket`, `lat_sum` and `lat_count`, so a
  /// gauge named `lat_count` beside it puts two `lat_count` samples in one
  /// scrape. Prometheus' own parser refuses that scrape whole, and its scrape
  /// loop keeps one of the two and drops the other as a duplicate, so one of
  /// the two metrics is wrong on every scrape and nothing says which.
  | Collides(String, String, String, String)
  /// The metric was declared with the first number of labels and given the
  /// second.
  | LabelCount(Int, Int)
  /// A counter was asked to add this, which is below zero or `NaN`.
  | Negative(Float)
  /// The histogram's bucket bounds are not strictly increasing, or one is
  /// `NaN`. The text says which.
  | InvalidBuckets(String);

impl Show for MetricError {
  /// One sentence a person can act on.
  fn show(self) -> String {
    match self {
      MetricError::InvalidName(name) => "`${name}` is not a metric name: it must match [a-zA-Z_:][a-zA-Z0-9_:]*",
      MetricError::InvalidLabelName(name) => "`${name}` is not a label name: it must match [a-zA-Z_][a-zA-Z0-9_]*, not begin with __, and not be `le` on a histogram",
      MetricError::DuplicateLabel(name) => "the label `${name}` is declared twice",
      MetricError::AlreadyRegistered(name) => "a metric named `${name}` is already registered",
      MetricError::Collides(name, kind, other, series) => "`${name}` collides with the ${kind} `${other}`: both would write `${series}`",
      MetricError::LabelCount(declared, given) => "the metric has ${Int::to_string(declared)} labels and was given ${Int::to_string(given)} values",
      MetricError::Negative(by) => "a counter only goes up, and was asked to add ${number(by)}",
      MetricError::InvalidBuckets(why) => "the buckets are refused: ${why}",
    }
  }
}

/// A number that only goes up: requests served, bytes sent, errors seen.
///
/// Declared with label names; each combination of label values is a series
/// of its own, reached with `labels`. Counters start at zero and are never
/// reset by this package, which is what lets Prometheus' `rate` tell a
/// restart from a decrease.
pub type Counter = {
  name: String,
  help: String,
  label_names: List<String>,
  children: Shared<Dict<List<String>, Shared<Float>>>,
};

/// One series of a `Counter`: the metric with every label given a value.
pub type CounterChild = { value: Shared<Float> };

/// A number that goes up and down: requests in flight, a queue's depth, the
/// last time something happened.
pub type Gauge = {
  name: String,
  help: String,
  label_names: List<String>,
  children: Shared<Dict<List<String>, Shared<Float>>>,
};

/// One series of a `Gauge`.
pub type GaugeChild = { value: Shared<Float> };

/// What a histogram series has seen: a count per bucket, not cumulative, and
/// the `+Inf` bucket last; their sum; and how many observations there were.
type Observed = { buckets: List<Int>, sum: Float, count: Int };

/// Observations counted into fixed buckets: request durations, response
/// sizes.
///
/// The buckets are chosen once, when the histogram is declared, because a
/// bucket that appears later has no history and a query over a range that
/// spans its arrival reads garbage. `default_buckets` is Prometheus' own
/// choice, made for latencies in seconds.
pub type Histogram = {
  name: String,
  help: String,
  label_names: List<String>,
  bounds: List<Float>,
  children: Shared<Dict<List<String>, Shared<Observed>>>,
};

/// One series of a `Histogram`.
pub type HistogramChild = { bounds: List<Float>, state: Shared<Observed> };

/// A metric of any kind, as the registry holds it.
type Collector =
  | Counted(Counter)
  | Gauged(Gauge)
  | Bucketed(Histogram);

/// The metrics a service exports, and the text a scrape receives.
///
/// Holds nothing writable outside `Shared`, so the compiler lets it cross to
/// the fiber that answers `/metrics` with nothing said.
pub type Registry = { metrics: Shared<Dict<String, Collector>> };

/// Prometheus' default buckets, in seconds: 5 ms to 10 s.
///
/// The ones every client library ships, so a dashboard built for another
/// service's latency histogram reads this one's without editing.
pub fn default_buckets() -> List<Float> {
  [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0]
}

/// The kind of `metric`, as `# TYPE` names it, and its name.
fn identity(metric: Collector) -> Pair<String, String> {
  match metric {
    Collector::Counted(counter) => { key: "counter", value: counter.name },
    Collector::Gauged(gauge) => { key: "gauge", value: gauge.name },
    Collector::Bucketed(histogram) => { key: "histogram", value: histogram.name },
  }
}

/// Every sample name `metric` writes or that its family is read as.
///
/// A gauge, its name. A histogram, its name and the three it writes. A
/// counter, its name with and without `_total`: OpenMetrics, and Python's
/// parser, read a counter's family as its name without the suffix, so `jobs`
/// and `jobs_total` are one family with two samples named alike.
///
/// Python's `CollectorRegistry` also reserves `_created` for counters and
/// histograms. This package never writes a `_created` sample, so reserving
/// it would refuse names that cannot collide in what it renders.
fn series_names(metric: Collector) -> List<String> {
  match metric {
    Collector::Gauged(gauge) => [gauge.name],
    Collector::Bucketed(histogram) => {
      let name = histogram.name;
      [name, "${name}_bucket", "${name}_sum", "${name}_count"]
    },
    Collector::Counted(counter) => {
      let name = counter.name;
      if String::ends_with(name, "_total") {
        [name, String::slice(name, 0, String::byte_length(name) - 6)]
      } else {
        [name, "${name}_total"]
      }
    },
  }
}

/// The first metric in `held` that writes a series `metric` would, as the
/// error that says so.
fn collision(held: List<Collector>, metric: Collector) -> Option<MetricError> {
  let wanted = series_names(metric);
  let mut found: Option<MetricError> = Option::None;
  let mut rest = held;
  let mut going = true;
  while going {
    match rest {
      List::Nil => going = false,
      List::Cons(other, tail) => {
        let taken = series_names(other);
        match List::find(wanted, fn series => List::contains(taken, series)) {
          Option::Some(series) => {
            let them = identity(other);
            found = Option::Some(MetricError::Collides(identity(metric).value, them.key, them.value, series));
            going = false;
          },
          Option::None => rest = tail,
        }
      },
    }
  };
  found
}

/// The label names, checked: the shape, no `__` prefix, no repeats, and no
/// `le` when `histogram` is set.
fn checked_labels(names: List<String>, histogram: Bool) -> List<String> raises MetricError {
  let mut seen: List<String> = List::Nil;
  let mut rest = names;
  let mut going = true;
  while going {
    match rest {
      List::Nil => going = false,
      List::Cons(name, tail) => {
        if !valid_label_name(name) || reserved_label_name(name) || (histogram && name == "le") {
          raise MetricError::InvalidLabelName(name)
        };
        if List::contains(seen, name) {
          raise MetricError::DuplicateLabel(name)
        };
        seen = List::Cons(name, seen);
        rest = tail;
      },
    }
  };
  names
}

/// The bounds, checked: none `NaN`, each above the one before. A trailing
/// `+Inf` is dropped, because every histogram has that bucket already.
fn checked_bounds(bounds: List<Float>) -> List<Float> raises MetricError {
  let zero = 0.0;
  let infinity = 1.0 / zero;
  let mut kept: List<Float> = List::Nil;
  let mut previous = zero - infinity;
  let mut first = true;
  let mut rest = bounds;
  let mut going = true;
  while going {
    match rest {
      List::Nil => going = false,
      List::Cons(bound, tail) => {
        if bound != bound {
          raise MetricError::InvalidBuckets("a bound is NaN")
        };
        // `NaN` was refused above, so `<=` is the negation of `>` here.
        if !first && bound <= previous {
          raise MetricError::InvalidBuckets("${number(bound)} does not come after ${number(previous)}")
        };
        // Two bounds written alike are two `_bucket` samples with one set of
        // labels, and Prometheus keeps only one of them. `number` writes
        // distinct doubles distinctly, so this refuses nothing today; it is
        // what stops a change to `number` from making that scrape again.
        if !first && number(bound) == number(previous) {
          raise MetricError::InvalidBuckets("${number(bound)} and the bound before it are written alike")
        };
        if bound != infinity {
          kept = List::Cons(bound, kept);
        };
        previous = bound;
        first = false;
        rest = tail;
      },
    }
  };
  List::reverse(kept)
}

/// The child under `values` in `children`, made with `fresh` if there is none.
///
/// **Looked up, then made under the lock.** The first lookup is a plain read,
/// which is every call after the first for a given set of values. Two fibers
/// that both miss race to the `modify`, and the one that arrives second finds
/// the first one's child there and takes it, so a series is never made twice
/// and an increment is never made on a copy nothing renders.
fn child<A: Share>(
  children: Shared<Dict<List<String>, Shared<A>>>,
  declared: List<String>,
  values: List<String>,
  fresh: A,
) -> Shared<A> raises MetricError {
  let wanted = List::length(declared);
  let given = List::length(values);
  if wanted != given {
    raise MetricError::LabelCount(wanted, given)
  };
  match Dict::get(Shared::get(children), values) {
    Option::Some(found) => found,
    Option::None => Shared::modify(children, fn table => {
        match Dict::get(table, values) {
          Option::Some(found) => { state: table, result: found },
          Option::None => {
            let made = Shared::of(fresh);
            { state: Dict::insert(table, values, made), result: made }
          },
        }
      }),
  }
}

/// A zero per bound and one for `+Inf`: the counts of a series nothing has
/// been observed in.
fn empty_buckets(bounds: List<Float>) -> List<Int> {
  List::Cons(0, List::map(bounds, fn _bound => 0))
}

/// `counts` with one added at `index`; the cells after it are shared, not
/// copied.
fn bumped(counts: List<Int>, index: Int) -> List<Int> {
  match counts {
    List::Nil => List::Nil,
    List::Cons(head, tail) =>
      if index == 0 { List::Cons(head + 1, tail) } else { List::Cons(head, bumped(tail, index - 1)) },
  }
}

/// Which bucket `value` falls in: the first bound it does not exceed, or the
/// `+Inf` bucket past the last. `NaN` exceeds nothing and goes to `+Inf`.
fn bucket_of(bounds: List<Float>, value: Float) -> Int {
  let mut index = 0;
  let mut rest = bounds;
  let mut going = true;
  while going {
    match rest {
      List::Nil => going = false,
      List::Cons(bound, tail) =>
        if value <= bound {
          going = false
        } else {
          index = index + 1;
          rest = tail;
        },
    }
  };
  index
}

impl Registry {
  /// A registry with nothing in it.
  pub fn new() -> Registry { { metrics: Shared::of(Dict::new()) } }

  /// Adds `metric` under `name`, unless the name is taken or a series it
  /// would write is already written by another metric.
  ///
  /// **Checked under the registry's lock**, so two fibers declaring
  /// colliding metrics at once cannot both be let in. What it costs is a walk
  /// over every registered metric per declaration, which happens at startup.
  fn holding(self, name: String, metric: Collector) -> () raises MetricError {
    if !valid_metric_name(name) {
      raise MetricError::InvalidName(name)
    };
    let refused = Shared::modify(self.metrics, fn table => {
        match Dict::get(table, name) {
          Option::Some(_taken) => { state: table, result: Option::Some(MetricError::AlreadyRegistered(name)) },
          Option::None =>
            match collision(Dict::values(table), metric) {
              Option::Some(why) => { state: table, result: Option::Some(why) },
              Option::None => { state: Dict::insert(table, name, metric), result: Option::None },
            },
        }
      });
    match refused {
      Option::Some(why) => raise why,
      Option::None => (),
    }
  }

  /// A counter named `name`, with one label per entry in `label_names`.
  ///
  /// A counter with no labels exports `0` from the moment it is registered,
  /// so a dashboard can tell "nothing has happened" from "this service does
  /// not export that". One with labels exports a series only once `labels`
  /// has been asked for it.
  pub fn counter(self, name: String, help: String, label_names: List<String>) -> Counter
    raises MetricError
  {
    let checked = checked_labels(label_names, histogram: false)!;
    let made: Counter = { name: name, help: help, label_names: checked, children: Shared::of(Dict::new()) };
    self.holding(name, Collector::Counted(made))!;
    if List::is_empty(checked) {
      let _ = child(made.children, checked, List::Nil, 0.0)!;
    };
    made
  }

  /// A gauge named `name`, with one label per entry in `label_names`.
  ///
  /// Starts at zero, and with no labels exports that from the start, as a
  /// counter does.
  pub fn gauge(self, name: String, help: String, label_names: List<String>) -> Gauge
    raises MetricError
  {
    let checked = checked_labels(label_names, histogram: false)!;
    let made: Gauge = { name: name, help: help, label_names: checked, children: Shared::of(Dict::new()) };
    self.holding(name, Collector::Gauged(made))!;
    if List::is_empty(checked) {
      let _ = child(made.children, checked, List::Nil, 0.0)!;
    };
    made
  }

  /// A histogram named `name`, counting into `buckets`.
  ///
  /// `buckets` are upper bounds, inclusive, strictly increasing; the `+Inf`
  /// bucket is always added and may be left off. `default_buckets()` is the
  /// usual choice. An empty list is allowed and gives a histogram with only
  /// `+Inf`, which is a count and a sum.
  pub fn histogram(self, name: String, help: String, label_names: List<String>, buckets: List<Float>) -> Histogram
    raises MetricError
  {
    let checked = checked_labels(label_names, histogram: true)!;
    let bounds = checked_bounds(buckets)!;
    let made: Histogram = {
      name: name,
      help: help,
      label_names: checked,
      bounds: bounds,
      children: Shared::of(Dict::new()),
    };
    self.holding(name, Collector::Bucketed(made))!;
    if List::is_empty(checked) {
      let _ = child(made.children, checked, List::Nil, { buckets: empty_buckets(bounds), sum: 0.0, count: 0 })!;
    };
    made
  }

  /// Every metric, in Prometheus' text exposition format 0.0.4.
  ///
  /// Metrics in name order and series in label-value order, so two scrapes of
  /// an idle service are the same bytes. Each value is read once, as it is
  /// when the line is written: a scrape is not a snapshot of every metric at
  /// one instant, and no client library's is, but each histogram series is
  /// read whole, so its buckets, sum and count always agree.
  pub fn render(self) -> String {
    let pieces = List::map(Dict::values(Shared::get(self.metrics)), fn metric => {
        match metric {
          Collector::Counted(counter) => family(counter.name, counter.help, "counter", scalars(counter.name, counter.label_names, counter.children)),
          Collector::Gauged(gauge) => family(gauge.name, gauge.help, "gauge", scalars(gauge.name, gauge.label_names, gauge.children)),
          Collector::Bucketed(histogram) => family(histogram.name, histogram.help, "histogram", histogram_lines(histogram)),
        }
      });
    String::join(pieces, "")
  }
}

/// The `# HELP` and `# TYPE` lines, then `lines`, each ending in a line feed.
///
/// An empty help is left out rather than written as `# HELP name ` with
/// nothing after it; the type line is always there.
fn family(name: String, help: String, kind: String, lines: List<String>) -> String {
  let head = if String::is_empty(help) { "" } else { "# HELP ${name} ${escape_help(help)}\n" };
  let body = String::join(List::map(lines, fn line => "${line}\n"), "");
  "${head}# TYPE ${name} ${kind}\n${body}"
}

/// One line per series of a counter or a gauge.
fn scalars(name: String, label_names: List<String>, children: Shared<Dict<List<String>, Shared<Float>>>) -> List<String> {
  List::map(Dict::entries(Shared::get(children)), fn entry =>
    "${name}${label_set(label_names, entry.key)} ${number(Shared::get(entry.value))}")
}

/// Per series: a `_bucket` line per bound and one for `+Inf`, cumulative,
/// then `_sum` and `_count`.
fn histogram_lines(histogram: Histogram) -> List<String> {
  let name = histogram.name;
  let names = histogram.label_names;
  let le = List::concat(names, ["le"]);
  List::flat_map(Dict::entries(Shared::get(histogram.children)), fn entry => {
      let values = entry.key;
      let seen = Shared::get(entry.value);
      let mut running = 0;
      let mut lines: List<String> = List::Nil;
      let mut counts = seen.buckets;
      let mut bounds = histogram.bounds;
      let mut going = true;
      while going {
        match counts {
          List::Nil => going = false,
          List::Cons(count, more) => {
            running = running + count;
            let bound = match bounds {
              List::Cons(b, rest) => { bounds = rest; number(b) },
              List::Nil => "+Inf",
            };
            lines = List::Cons("${name}_bucket${label_set(le, List::concat(values, [bound]))} ${Int::to_string(running)}", lines);
            counts = more;
          },
        }
      };
      lines = List::Cons("${name}_sum${label_set(names, values)} ${number(seen.sum)}", lines);
      lines = List::Cons("${name}_count${label_set(names, values)} ${Int::to_string(seen.count)}", lines);
      List::reverse(lines)
    })
}

impl Counter {
  /// The series for `values`, one per declared label, in declaration order.
  ///
  /// Made on first use. Raises `LabelCount` when the number of values is not
  /// the number of labels the counter was declared with.
  pub fn labels(self, values: List<String>) -> CounterChild raises MetricError {
    { value: child(self.children, self.label_names, values, 0.0)! }
  }

  /// Adds one to a counter declared with no labels.
  ///
  /// Raises `LabelCount` on one declared with labels, which has no series
  /// without values.
  pub fn inc(self) -> () raises MetricError { self.labels(List::Nil)!.inc() }

  /// Adds `by` to a counter declared with no labels. Raises `Negative` for
  /// `by` below zero or `NaN`, as `CounterChild::add` does.
  pub fn add(self, by: Float) -> () raises MetricError { self.labels(List::Nil)!.add(by)! }
}

impl CounterChild {
  /// Adds one.
  pub fn inc(self) -> () { let _ = Shared::update(self.value, fn n => n + 1.0); }

  /// Adds `by`, which may not be below zero or `NaN`.
  ///
  /// **Refused rather than clamped.** A counter that went down reads to
  /// Prometheus as a process restart, and `rate` then counts the whole value
  /// again as new: a negative add makes a spike, not a dip. A `NaN` is worse:
  /// it is not below zero, and once added the counter is `NaN` for the life
  /// of the process. Either way the counter is left as it was.
  pub fn add(self, by: Float) -> () raises MetricError {
    if by >= 0.0 {
      let _ = Shared::update(self.value, fn n => n + by);
    } else {
      raise MetricError::Negative(by)
    };
  }

  /// What it holds now.
  pub fn get(self) -> Float { Shared::get(self.value) }
}

impl Gauge {
  /// The series for `values`, one per declared label, in declaration order.
  pub fn labels(self, values: List<String>) -> GaugeChild raises MetricError {
    { value: child(self.children, self.label_names, values, 0.0)! }
  }

  /// Sets a gauge declared with no labels.
  pub fn set(self, to: Float) -> () raises MetricError { self.labels(List::Nil)!.set(to) }

  /// Adds one to a gauge declared with no labels.
  pub fn inc(self) -> () raises MetricError { self.labels(List::Nil)!.inc() }

  /// Takes one from a gauge declared with no labels.
  pub fn dec(self) -> () raises MetricError { self.labels(List::Nil)!.dec() }

  /// Adds `by`, which may be negative, to a gauge declared with no labels.
  pub fn add(self, by: Float) -> () raises MetricError { self.labels(List::Nil)!.add(by) }
}

impl GaugeChild {
  /// Replaces the value.
  pub fn set(self, to: Float) -> () { Shared::set(self.value, to) }

  /// Adds one.
  pub fn inc(self) -> () { let _ = Shared::update(self.value, fn n => n + 1.0); }

  /// Takes one away.
  pub fn dec(self) -> () { let _ = Shared::update(self.value, fn n => n - 1.0); }

  /// Adds `by`, which may be negative.
  pub fn add(self, by: Float) -> () { let _ = Shared::update(self.value, fn n => n + by); }

  /// What it holds now.
  pub fn get(self) -> Float { Shared::get(self.value) }
}

impl Histogram {
  /// The series for `values`, one per declared label, in declaration order.
  pub fn labels(self, values: List<String>) -> HistogramChild raises MetricError {
    let fresh: Observed = { buckets: empty_buckets(self.bounds), sum: 0.0, count: 0 };
    { bounds: self.bounds, state: child(self.children, self.label_names, values, fresh)! }
  }

  /// Records `value` in a histogram declared with no labels.
  pub fn observe(self, value: Float) -> () raises MetricError { self.labels(List::Nil)!.observe(value) }
}

impl HistogramChild {
  /// Records one observation of `value`.
  ///
  /// The bucket is found before the lock is taken, since the bounds never
  /// change; under it, the counts are rebuilt up to that bucket and the sum
  /// and count move with them.
  pub fn observe(self, value: Float) -> () {
    let index = bucket_of(self.bounds, value);
    let _ = Shared::update(self.state, fn seen => {
        buckets: bumped(seen.buckets, index),
        sum: seen.sum + value,
        count: seen.count + 1,
      });
  }

  /// How many observations there have been.
  pub fn count(self) -> Int { Shared::get(self.state).count }

  /// Their sum.
  pub fn sum(self) -> Float { Shared::get(self.state).sum }
}
