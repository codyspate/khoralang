module postgres::db;

//! `std::db`'s `Db` capability, over a PostgreSQL connection.
//!
//! This is the join between the driver and the rest of the world. Everything
//! above it -- `std::db::transaction`, a service's business logic, a test
//! double -- is written against `Db` and never learns that PostgreSQL exists.
//!
//! # One fiber owns the connection
//!
//! Not a design flourish. A handler must be safe to hand to another fiber, so
//! it may not capture anything writable, and a `Connection` is writable -- it
//! buffers the bytes that arrived and were not yet a whole message. It is also
//! **strictly serial**: two fibers writing one socket interleave their frames
//! and desynchronize the stream, so even a `Connection` the compiler let
//! through would be wrong.
//!
//! So `serve` owns the connection and nothing else touches it, and the handler
//! captures a `Channel<Request>`, which is `Share`. Requests queue; answers
//! come back on a reply channel the caller made. `docs/design/channels.md` was
//! written for this case, and this package is why it exists.
//!
//! That arrangement is also what makes the transaction contract hold. `begin`,
//! the statements between it and `commit`, and the commit itself all reach the
//! same backend because there is only one, and they arrive in the order the
//! caller made them because a channel is a queue.
//!
//! # The serving fiber opens its own connection
//!
//! `serve` takes `Settings` and not a `Connection`, which looks like an
//! inconvenience and is the only thing that works. A spawned fiber's captures
//! are *copied* -- `docs/design/sharing.md` calls this `Sync` rather than
//! `Send`, and names a consuming spawn as still open -- so handing a
//! connection to the fiber that will own it needs the connection to be
//! shareable, which is exactly what it is not.
//!
//! Opening it inside is better anyway, and not only because it compiles. The
//! connection's lifetime becomes exactly the fiber's: it cannot be used before
//! the fiber starts, cannot outlive it, and cannot be left open by a caller
//! who forgot. A connection that never opened is not an error a caller has to
//! remember to check either -- every request gets the reason as its answer.
//!
//! # Not a pool
//!
//! One handler is one connection, and a second fiber's statements queue behind
//! the first's. `pool.kh` is how a service gets concurrency: several
//! connections, each with a serving fiber, and a channel of the idle ones.

import std::core::{Channel, List, Option, Result};
import std::db::{Cell, Db, DbError, Row};
import postgres::conn::{Answer, Connection, PgError, ask, close, forsake, in_transaction, open, open_within, run, set_transaction_depth, still_open, transaction_depth, usable};

/// What a caller wants done.
pub type Work =
  /// Rows back.
  | Query(sql: String, values: List<Cell>)
  /// A count back.
  | Execute(sql: String, values: List<Cell>)
  | Begin
  | Commit
  | Rollback
  /// How many transactions are open on the connection, answered as a
  /// count. See `std::db::Db`'s `depth`.
  | Depth
  /// `SAVEPOINT` at this depth.
  | Savepoint(level: Int)
  /// `RELEASE SAVEPOINT` for the savepoint opened at this depth.
  | Release(level: Int)
  /// `ROLLBACK TO SAVEPOINT` and `RELEASE` for the savepoint opened at this
  /// depth, or nothing if it is not open.
  | RollbackTo(level: Int)
  /// The connection cannot be trusted with another statement: `std::db` asks
  /// this when a `ROLLBACK` did not arrive. Answered at once; every statement
  /// after it on this connection is refused without touching the socket.
  | Break
  /// Is this connection still worth using? Asked by the pool once per lease,
  /// before the borrower's first statement.
  | Check;

/// What comes back.
///
/// One variant per shape of answer, because a channel carries one type and
/// `Db`'s five operations do not agree on what they return. A caller reads the
/// variant it asked for and treats the others as a broken server -- which they
/// would be, since `serve` answers each `Work` with its matching `Reply` and
/// nothing else can put anything on that reply channel.
pub type Reply =
  | Rows(Result<List<Row>, DbError>)
  | Counted(Result<Int, DbError>)
  | Finished(Result<(), DbError>);

/// One question and where to put the answer.
pub type Request = {
  work: Work,
  /// **Made by the caller, one per request, capacity one.** A shared reply
  /// channel would hand a fiber somebody else's answer the moment two requests
  /// were in flight, and this is the cheapest thing that cannot.
  reply: Channel<Reply>,
};

/// Where to connect and as whom.
///
/// A record rather than five arguments because it crosses into the serving
/// fiber, and one shareable value is easier to reason about than five.
pub type Settings = {
  pub host: String,
  pub port: Int,
  pub user: String,
  pub database: String,
  pub secret: String,
};

/// Opens a connection, serves requests on it until the channel closes, and
/// closes it.
///
/// **Run this on a fiber of its own.** It is the only thing that ever touches
/// the connection, which is what makes the arrangement safe, and the
/// connection's lifetime is exactly this call's.
///
/// A connection that will not open is not a failure a caller has to remember
/// to check: every request is answered with the reason, in the terms
/// `std::db` speaks, until somebody closes the channel.
pub fn serve(settings: Settings, requests: Channel<Request>) -> () {
  match open(settings.host, settings.port, settings.user, settings.database, settings.secret) {
    Result::Err(why) => refuse(requests, PgError::to_db(why)),
    Result::Ok(c) => {
      answer_all(c, requests);
      close(c);
    },
  }
}

fn answer_all(c: Connection, requests: Channel<Request>) -> () {
  let mut going = true;
  while going {
    match Channel::receive(requests) {
      Option::None => going = false,
      Option::Some(request) => {
        Channel::send(request.reply, answer(c, request.work));
        // Closed by the server rather than the caller, so a caller that gave
        // up -- canceled, or raised on the way to its receive -- still leaves
        // a channel that will be released rather than one somebody is expected
        // to come back for.
        Channel::close(request.reply);
        // **A connection that failed partway through a reply is never served
        // again.** The rest of that reply is still on its way, and the next
        // statement would read it as its own answer -- and every caller after
        // that one would get the answer before theirs. The caller whose reply
        // was cut off has been told `Disconnected`; closing `requests` makes
        // this the `broken` path in `over`, so everybody after is told the
        // same, and `serve` closes the socket.
        if !usable(c) {
          Channel::close(requests);
          refuse(requests, gone());
          going = false
        };
      },
    }
  };
}

/// Answers every request with the same failure, until the channel closes.
///
/// The alternative is to close the request channel and let each caller
/// discover a dead server, which says *that* something is wrong and never
/// *what* -- and "could not reach 127.0.0.1:5433" is the whole of what a
/// person needs here.
fn refuse(requests: Channel<Request>, why: DbError) -> () {
  let mut going = true;
  while going {
    match Channel::receive(requests) {
      Option::None => going = false,
      Option::Some(request) => {
        Channel::send(request.reply, apology(request.work, why));
        Channel::close(request.reply);
      },
    }
  };
}

fn apology(work: Work, why: DbError) -> Reply {
  match work {
    Work::Query(_, _) => Reply::Rows(Result::Err(why)),
    Work::Execute(_, _) => Reply::Counted(Result::Err(why)),
    Work::Begin => Reply::Finished(Result::Err(why)),
    Work::Commit => Reply::Finished(Result::Err(why)),
    Work::Rollback => Reply::Finished(Result::Err(why)),
    Work::Depth => Reply::Counted(Result::Ok(0)),
    Work::Savepoint(_) => Reply::Finished(Result::Err(why)),
    Work::Release(_) => Reply::Finished(Result::Err(why)),
    Work::RollbackTo(_) => Reply::Finished(Result::Err(why)),
    Work::Break => Reply::Finished(Result::Ok(())),
    Work::Check => Reply::Finished(Result::Err(why)),
  }
}

fn answer(c: Connection, work: Work) -> Reply {
  match work {
    Work::Query(sql, values) => Reply::Rows(rows(c, sql, values)),
    Work::Execute(sql, values) => Reply::Counted(affected(c, sql, values)),
    // The transaction verbs take no parameters, so they are simple queries.
    // `run` is the right call and not a shortcut: `BEGIN` through the extended
    // protocol would be five frames for a statement with nothing to bind.
    //
    // **The depth guards below are exact, because two fibers can share one
    // lease.** Each `transaction` asks for the depth and then acts on it, and
    // a second fiber on the same connection can move it in between. An
    // operation for a level the connection is not at would act on the other
    // fiber's savepoint: `RELEASE` of level 1 also releases level 2, and
    // `COMMIT` keeps any savepoint still open. So each one is refused unless
    // the connection is exactly where its caller thinks. What that costs is an
    // `Err` for one of two fibers that nest at once; it does not make that
    // work, and `std::db::transaction` says not to do it.
    Work::Begin =>
      if transaction_depth(c) != 0 || in_transaction(c) {
        Reply::Finished(Result::Err(out_of_turn("BEGIN", 0, transaction_depth(c))))
      } else {
        Reply::Finished(opened(c, statement(c, "BEGIN"), 1))
      },
    // **A `COMMIT` with a savepoint still open ends the transaction with a
    // `ROLLBACK` instead.** Only another fiber's `transaction` can have left
    // one open, since one fiber releases or rolls back its own inner levels
    // before its commit, and committing would keep that fiber's writes
    // whatever it is later told. Refusing without sending does not work
    // either: `std::db` settles a transaction on any answer from `commit`, so
    // no rollback would follow, and the connection would stay inside the
    // transaction for the other fiber to release into and be told `Ok` for
    // writes that are never committed. After the `ROLLBACK` the server is
    // outside a transaction and `collect` puts the depth back to 0, so the
    // other fiber's `release` is refused and its `rollback_to` finds nothing
    // left to undo, which is the truth.
    Work::Commit =>
      if transaction_depth(c) > 1 {
        match statement(c, "ROLLBACK") {
          Result::Ok(_) => Reply::Finished(Result::Err(DbError::RolledBack(
                "the transaction was rolled back instead of committed, because a savepoint another fiber opened on this connection was still open",
              ))),
          Result::Err(why) => Reply::Finished(Result::Err(why)),
        }
      } else {
        Reply::Finished(commit(c))
      },
    Work::Rollback => Reply::Finished(statement(c, "ROLLBACK")),
    Work::Depth => Reply::Counted(Result::Ok(depth(c))),
    Work::Savepoint(level) =>
      if transaction_depth(c) != level {
        Reply::Finished(Result::Err(out_of_turn("SAVEPOINT", level, transaction_depth(c))))
      } else {
        Reply::Finished(opened(c, statement(c, "SAVEPOINT " + savepoint_name(level)), level + 1))
      },
    Work::Release(level) =>
      if transaction_depth(c) != level + 1 {
        Reply::Finished(Result::Err(out_of_turn("RELEASE", level, transaction_depth(c))))
      } else {
        Reply::Finished(opened(c, statement(c, "RELEASE SAVEPOINT " + savepoint_name(level)), level))
      },
    // **A savepoint that was never opened is not rolled back to.** The undo
    // is registered before `SAVEPOINT` is sent, so a cancel can bring it
    // here for one that does not exist, and PostgreSQL answers that with an
    // error that aborts the whole enclosing transaction.
    //
    // `Ok` for sending nothing is true with two fibers on the lease as well:
    // a depth at or below `level` means this savepoint is gone, and the ways
    // it can go without its own release -- a `ROLLBACK TO` a lower level, a
    // `ROLLBACK`, a `COMMIT` turned into one above -- all undo its work. The
    // exact `Release` guard is what keeps a lower level's release from taking
    // this one with it, which would keep the work.
    Work::RollbackTo(level) =>
      if transaction_depth(c) <= level {
        Reply::Finished(Result::Ok(()))
      } else {
        let name = savepoint_name(level);
        Reply::Finished(opened(c, statement(c, "ROLLBACK TO SAVEPOINT " + name + "; RELEASE SAVEPOINT " + name), level))
      },
    Work::Break => {
      forsake(c);
      Reply::Finished(Result::Ok(()))
    },
    Work::Check =>
      if still_open(c) && !in_transaction(c) {
        Reply::Finished(Result::Ok(()))
      } else {
        forsake(c);
        Reply::Finished(Result::Err(gone()))
      },
  }
}

/// Answers one lease's requests on `c`, until the lease is over: until
/// `requests`, which belongs to this lease alone, is closed and drained.
///
/// **The end of a lease is the close of its channel**, done by the pool's
/// give-back, so the fiber that owns the connection is the one that learns
/// it is free. That is what lets the pool check a connection before lending
/// it again: a connection that broke during the lease, or that was left
/// inside a transaction because an `abort` cut the `ROLLBACK` off, is
/// reconnected by its serving fiber instead of being handed to the next
/// caller. Requests already queued when the lease ends are answered first;
/// their senders may have stopped, and an answer nobody reads is released
/// with its channel.
///
/// A connection that breaks part-way through a lease stays leased: the
/// statements after the break are refused with `Disconnected` without
/// touching the socket, and the reconnect happens once the lease is over.
pub fn serve_lease(c: Connection, requests: Channel<Request>) -> () {
  let mut going = true;
  while going {
    match Channel::receive(requests) {
      Option::None => going = false,
      Option::Some(request) => {
        Channel::send(request.reply, answer(c, request.work));
        Channel::close(request.reply);
      },
    }
  };
}

/// A `Db` that sends its work to whoever is serving `requests`.
pub fn over(requests: Channel<Request>) -> Db {
  handler for Db {
    query: fn (sql, values) => ask_rows(requests, Work::Query(sql, values)),
    execute: fn (sql, values) => ask_count(requests, Work::Execute(sql, values)),
    begin: fn () => ask_done(requests, Work::Begin),
    commit: fn () => ask_done(requests, Work::Commit),
    rollback: fn () => ask_done(requests, Work::Rollback),
    depth: fn () => match ask_count(requests, Work::Depth) {
      Result::Ok(level) => level,
      Result::Err(_) => 0,
    },
    savepoint: fn level => ask_done(requests, Work::Savepoint(level)),
    release: fn level => ask_done(requests, Work::Release(level)),
    rollback_to: fn level => ask_done(requests, Work::RollbackTo(level)),
    // **Telling the serving fiber is the whole of it.**
    //
    // `std::db` calls this when a `ROLLBACK` did not arrive, which leaves a
    // connection that may still be holding a transaction open. The serving
    // fiber marks it broken, so nothing else in this lease reaches the
    // socket. Outside a pool, `serve` then closes the connection; in a pool,
    // the serving fiber reconnects it when the lease ends, so the next
    // borrower gets a fresh connection rather than uncommitted rows and
    // locks.
    broken: fn () => { let _ = ask_done(requests, Work::Break); () },
  }
}

/// Opens a connection for a pool's serving fiber, in `std::db`'s terms. The
/// handshake is bounded by `within` ms; see `open_within`.
pub fn connect(settings: Settings, within: Int) -> Result<Connection, DbError> {
  match open_within(settings.host, settings.port, settings.user, settings.database, settings.secret, within) {
    Result::Err(why) => Result::Err(PgError::to_db(why)),
    Result::Ok(c) => Result::Ok(c),
  }
}

/// Closes a pool's connection. Nothing still on its way is read.
pub fn hang_up(c: Connection) -> () {
  close(c)
}

/// Whether a connection a pool is about to lend can be lent.
pub type Fitness =
  /// Connected, outside a transaction, and not closed by the server.
  | Fit
  /// Its serving fiber found it unusable, marked it, and will reconnect it
  /// when this lease is given back.
  | Unfit
  /// Nobody took the question: the request channel is closed. A lease's
  /// channel is closed by its own give-back, and by the pool's `close` while
  /// it waits in `idle`, so a borrower that has just taken it does not meet
  /// this; it is answered rather than assumed impossible.
  | Gone;

/// Asks the serving fiber behind `requests` whether it can be lent.
pub fn fitness(requests: Channel<Request>) -> Fitness {
  let reply: Channel<Reply> = Channel::bounded(1);
  if !Channel::send(requests, { work: Work::Check, reply: reply }) {
    Fitness::Gone
  } else {
    match Channel::receive(reply) {
      Option::Some(Reply::Finished(Result::Ok(_))) => Fitness::Fit,
      Option::Some(_) => Fitness::Unfit,
      Option::None => Fitness::Unfit,
    }
  }
}

/// Sends one request and waits for its answer.
///
/// `None` means the server is gone: either the channel was closed before the
/// request could be sent, or it closed with the request unanswered. Both are
/// the same fact to a caller, and `Disconnected` is what `std::db` calls it.
fn exchange(requests: Channel<Request>, work: Work) -> Option<Reply> {
  let reply: Channel<Reply> = Channel::bounded(1);
  let accepted = Channel::send(requests, { work: work, reply: reply });
  if accepted { Channel::receive(reply) } else { Option::None }
}

fn gone() -> DbError {
  DbError::Disconnected("the connection's serving fiber has stopped")
}

fn ask_rows(requests: Channel<Request>, work: Work) -> Result<List<Row>, DbError> {
  match exchange(requests, work) {
    Option::Some(Reply::Rows(answer)) => answer,
    Option::Some(_) => Result::Err(confused()),
    Option::None => Result::Err(gone()),
  }
}

fn ask_count(requests: Channel<Request>, work: Work) -> Result<Int, DbError> {
  match exchange(requests, work) {
    Option::Some(Reply::Counted(answer)) => answer,
    Option::Some(_) => Result::Err(confused()),
    Option::None => Result::Err(gone()),
  }
}

fn ask_done(requests: Channel<Request>, work: Work) -> Result<(), DbError> {
  match exchange(requests, work) {
    Option::Some(Reply::Finished(answer)) => answer,
    Option::Some(_) => Result::Err(confused()),
    Option::None => Result::Err(gone()),
  }
}

/// The reply did not match the request.
///
/// Unreachable through `serve`, which answers each `Work` with its matching
/// `Reply` and is the only thing that can write to a reply channel. Named
/// rather than ignored because "unreachable" is a claim about today's code and
/// a silent wrong answer would be the worst way to find out it changed.
fn confused() -> DbError {
  DbError::Rejected("the serving fiber answered a different question")
}

// --- doing the work ---------------------------------------------------------

fn rows(c: Connection, sql: String, values: List<Cell>) -> Result<List<Row>, DbError> {
  match ask(c, sql, values) {
    Result::Ok(answer) => Result::Ok(answer.rows),
    Result::Err(why) => Result::Err(PgError::to_db(why)),
  }
}

fn affected(c: Connection, sql: String, values: List<Cell>) -> Result<Int, DbError> {
  match ask(c, sql, values) {
    Result::Ok(answer) => Result::Ok(changed(answer.tag)),
    Result::Err(why) => Result::Err(PgError::to_db(why)),
  }
}

fn statement(c: Connection, sql: String) -> Result<(), DbError> {
  match run(c, sql) {
    Result::Ok(_) => Result::Ok(()),
    Result::Err(why) => Result::Err(PgError::to_db(why)),
  }
}

/// `COMMIT`, answered `Ok` only when the server says it committed.
///
/// **What this prevents: `Ok` for a transaction that was rolled back.**
/// PostgreSQL answers `COMMIT` in a transaction a failed statement aborted
/// with no error at all, only a `CommandComplete` whose tag is `ROLLBACK`, so
/// a body that ignored a failed statement and returned `Ok` was told its
/// transaction committed when nothing had.
fn commit(c: Connection) -> Result<(), DbError> {
  match run(c, "COMMIT") {
    Result::Ok(answer) =>
      if answer.tag == "COMMIT" {
        Result::Ok(())
      } else {
        Result::Err(DbError::RolledBack(
            "the server ended the transaction with " + answer.tag
            + " instead of committing it, because a statement in it failed",
          ))
      },
    Result::Err(why) => Result::Err(PgError::to_db(why)),
  }
}

/// Sets the connection's depth to `after` once `done` succeeded.
fn opened(c: Connection, done: Result<(), DbError>, after: Int) -> Result<(), DbError> {
  match done {
    Result::Ok(_) => {
      set_transaction_depth(c, after);
      Result::Ok(())
    },
    Result::Err(why) => Result::Err(why),
  }
}

/// The depth `std::db` is told.
///
/// A transaction somebody opened with a bare `BEGIN` through `execute` is
/// still a transaction, so a `transaction` inside it nests in a savepoint
/// rather than sending a second `BEGIN` its `COMMIT` would end both of.
fn depth(c: Connection) -> Int {
  if in_transaction(c) && transaction_depth(c) == 0 { set_transaction_depth(c, 1) };
  transaction_depth(c)
}

/// The name of the savepoint opened at `level`: made here and never taken
/// from a caller, so it needs no quoting, and one per depth, so a savepoint
/// never shadows one still open below it.
fn savepoint_name(level: Int) -> String {
  "khora_sp_" + Int::to_string(level)
}

/// A savepoint operation for a level the connection is not at.
///
/// Reachable only by a handler used out of order, since `std::db` asks for
/// the depth first; refused rather than sent, because a savepoint at the
/// wrong level would be released or rolled back by the wrong `transaction`.
fn out_of_turn(verb: String, level: Int, at: Int) -> DbError {
  DbError::Rejected(verb + " for depth " + Int::to_string(level) + " on a connection at depth " + Int::to_string(at))
}

/// How many rows a `CommandComplete` tag says were affected.
///
/// The tag is the verb and then its numbers: `UPDATE 3`, `DELETE 2`,
/// `SELECT 5`, and `INSERT 0 1` -- which is an OID that has been zero since
/// PostgreSQL 12 followed by the count. **The number wanted is always the last
/// one**, which is why this reads from the end rather than counting fields.
///
/// A tag with no number is zero: `BEGIN`, `COMMIT` and `SET` have none, and
/// they did not affect any rows, so zero is the answer and not a failure.
pub fn changed(tag: String) -> Int {
  let width = String::byte_length(tag);
  let mut at = width;
  while at > 0 && is_digit(String::byte(tag, at - 1)) {
    at = at - 1
  };
  if at == width {
    0
  } else {
    match Int::of_string(String::slice(tag, at, width)) {
      Option::Some(count) => count,
      Option::None => 0,
    }
  }
}

fn is_digit(byte: U8) -> Bool {
  let value = U8::to_int(byte);
  value >= 48 && value <= 57
}
