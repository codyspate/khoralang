module postgres::scram;

//! SCRAM-SHA-256, the authentication a stock PostgreSQL asks for.
//!
//! **RFC 5802 and RFC 7677**, the subset a client needs. PostgreSQL 14 and
//! later default `password_encryption` to `scram-sha-256`, so this is what an
//! ordinary install demands and a driver without it can only connect to a
//! server somebody has deliberately weakened.
//!
//! The exchange is three messages after the server's `AuthenticationSASL`:
//!
//! 1. the client sends its first message — the mechanism, a GS2 header and a
//!    nonce it invented,
//! 2. the server answers with its own nonce, a salt and an iteration count,
//! 3. the client proves it knows the password without ever sending it.
//!
//! **The password is never transmitted, and neither is anything reusable.**
//! The proof is bound to both nonces, so a recording of one exchange cannot
//! authenticate a second. That is the whole point of the mechanism and the
//! reason cleartext is not an acceptable substitute over a network.
//!
//! The hashes, the key derivation and the base64 are `std::crypto`'s. What is
//! written here is the protocol: the message formats and the exact byte
//! strings the RFC says to sign.

import std::core::{Array, Int, List, Option, Redacted, Result, String, U8, assert};
import std::crypto::{Base64, Hmac, pbkdf2_sha256, sha256};

/// HMAC-SHA-256 of `message` under `key`. Every key in SCRAM is derived from
/// the password, so each is wrapped where it is used rather than carried
/// around as a `Redacted`.
fn hmac(key: Array<U8>, message: Array<U8>) -> Array<U8> {
  Hmac::sha256(Redacted::of(key), message)
}

/// The server's salt, decoded the way PostgreSQL and libpq decode it.
///
/// **What it prevents: refusing a server libpq logs in to.** `Base64::decode`
/// refuses a final character whose unused low bits are set (`..gR==` rather
/// than `..gQ==`), so that a tag has one spelling. A salt is only ever fed to
/// PBKDF2, so a second spelling of it costs nothing, and PostgreSQL stores a
/// hand-made verifier written that way and sends it verbatim. Those bits are
/// cleared here and nothing else is relaxed: whitespace, wrong padding and
/// characters outside the alphabet are still refused.
fn decode_salt(text: String) -> Option<Array<U8>> {
  let length = String::byte_length(text);
  let padding = if String::ends_with(text, "==") { 2 } else if String::ends_with(text, "=") { 1 } else { 0 };
  let last = length - padding - 1;
  let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  if padding == 0 || last < 0 {
    Base64::decode(text)
  } else {
    let value = position(alphabet, String::byte(text, last));
    if value < 0 {
      Option::None
    } else {
      // Two `=` leave four unused bits in the last character, one leaves two.
      let kept = Int::and(value, if padding == 2 { 48 } else { 60 });
      Base64::decode(String::slice(text, 0, last)
        + String::slice(alphabet, kept, kept + 1)
        + String::slice(text, last + 1, length))
    }
  }
}

/// Where `byte` is in `alphabet`, or -1.
fn position(alphabet: String, byte: U8) -> Int {
  let mut at = 0;
  let mut found = -1;
  while at < String::byte_length(alphabet) && found < 0 {
    if String::byte(alphabet, at) == byte { found = at };
    at = at + 1;
  };
  found
}

// --- the exchange -----------------------------------------------------------

/// What the client has to remember between the two halves of the exchange.
pub type Session = {
  /// The nonce this client invented, base64 of random bytes.
  nonce: String,
  /// `n=,r=<nonce>` — signed later, so it is kept rather than rebuilt.
  first_bare: String,
  /// The `ServerSignature` this client expects to be shown at the end.
  ///
  /// **Mutual authentication is the half a client is tempted to skip.** The
  /// proof the client sends convinces the server; this is what convinces the
  /// client, and without checking it a peer that never knew the password can
  /// answer `AuthenticationSASLFinal` with anything and be believed. Computed
  /// while the salted password is in hand and kept, because by the time the
  /// server's final message arrives that value is gone.
  mut expected_signature: String,
};

/// The client's opening message, paired with the state needed to finish.
///
/// Both `pub`: the connection sends the one and keeps the other, and neither
/// has an invariant a caller could break. `Session` itself stays closed.
pub type Opening = {
  pub message: String,
  pub session: Session,
};

/// The client's opening message, and the state needed to finish.
///
/// `n,,` is the GS2 header: no channel binding, no authorization identity.
/// The username is empty because PostgreSQL takes it from the startup packet
/// and RFC 5802 says to send `n=` when it is carried elsewhere — sending it
/// twice is how a driver gets a puzzling mismatch from the server.
pub fn begin(nonce: String) -> Opening {
  let bare = "n=,r=${nonce}";
  {
    message: "n,,${bare}",
    session: { nonce: nonce, first_bare: bare, expected_signature: "" },
  }
}

/// One `key=value` field of a SCRAM message.
fn field(message: String, key: String) -> Option<String> {
  let parts = String::split(message, ",");
  List::fold(parts, Option::None, fn (found, part) =>
    match found {
      Option::Some(v) => Option::Some(v),
      Option::None =>
        if String::starts_with(part, "${key}=") {
          Option::Some(String::slice(part, String::byte_length(key) + 1, String::byte_length(part)))
        } else {
          Option::None
        },
    })
}

/// Why a SCRAM exchange could not be completed.
pub type ScramError = | Malformed(String) | Rejected(String);

/// The client's final message, proving knowledge of the password.
///
/// The proof is `ClientKey XOR HMAC(StoredKey, AuthMessage)`, where the
/// `AuthMessage` is the three message bodies joined by commas — RFC 5802 §3.
/// Every byte of it is fixed by the RFC, so a driver that gets one separator
/// wrong is told only that the password is bad.
pub fn finish(
  session: Session,
  server_first: String,
  password: String,
) -> Result<String, ScramError> {
  match field(server_first, "r") {
    Option::None => Result::Err(ScramError::Malformed("the server sent no nonce")),
    Option::Some(combined) =>
      if !String::starts_with(combined, session.nonce) {
        // **The server's nonce must extend the client's.** A server that
        // returns a different one is not answering this exchange, and
        // continuing would sign somebody else's challenge.
        Result::Err(ScramError::Rejected(
            "the server's nonce does not begin with the one this client sent"))
      } else {
        match field(server_first, "s") {
          Option::None => Result::Err(ScramError::Malformed("the server sent no salt")),
          Option::Some(salt64) => match field(server_first, "i") {
            Option::None => Result::Err(ScramError::Malformed("the server sent no iteration count")),
            Option::Some(count) => match Int::of_string(count) {
              Option::None => Result::Err(ScramError::Malformed(
                  "the server's iteration count is not a number: ${count}")),
              Option::Some(iterations) => match decode_salt(salt64) {
                Option::None => Result::Err(ScramError::Malformed(
                    "the server's salt is not base64: ${salt64}")),
                Option::Some(salt) => match pbkdf2_sha256(Redacted::of(String::bytes(password)), salt, iterations) {
                  Option::None => Result::Err(ScramError::Rejected(
                      "the server asked for an iteration count this client will not use: ${count}")),
                  Option::Some(salted_password) => {
                    let client_key = Hmac::sha256(salted_password, String::bytes("Client Key"));
                    let stored_key = sha256(client_key);
                    let without_proof = "c=biws,r=${combined}";
                    let auth_message =
                      "${session.first_bare},${server_first},${without_proof}";
                    let signature = hmac(stored_key, String::bytes(auth_message));
                    let proof = xor(client_key, signature);
                    // Kept now, checked when the server's final message arrives:
                    // the salted password does not survive this scope, and the
                    // server signature cannot be computed without it.
                    let server_key = Hmac::sha256(salted_password, String::bytes("Server Key"));
                    session.expected_signature =
                    Base64::encode(hmac(server_key, String::bytes(auth_message)));
                    Result::Ok("${without_proof},p=${Base64::encode(proof)}")
                  },
                },
              },
            },
          },
        }
      },
  }
}

/// Whether the server proved it also knew the password.
///
/// **The other half of mutual authentication.** RFC 5802 §3: the server signs
/// the same `AuthMessage` with a key derived differently, so only a peer that
/// held the salted password can produce it. A client that skips this check has
/// authenticated itself to a stranger.
///
/// `e=` instead of `v=` is the server saying the exchange failed, and its text
/// is worth more to a reader than "no signature" would be.
pub fn verify(session: Session, server_final: String) -> Result<Bool, ScramError> {
  match field(server_final, "e") {
    Option::Some(reason) => Result::Err(ScramError::Rejected(
        "the server refused the SASL exchange: ${reason}")),
    Option::None => match field(server_final, "v") {
      Option::None =>
        Result::Err(ScramError::Malformed("the server's final message has no signature")),
      Option::Some(shown) =>
        if shown == session.expected_signature {
          Result::Ok(true)
        } else {
          Result::Err(ScramError::Rejected(
              "the server's signature does not match: it does not hold the password \
             for this account, so this connection is not the server it claims"))
        },
    },
  }
}

/// Byte-wise XOR of two equal-length buffers.
fn xor(left: Array<U8>, right: Array<U8>) -> Array<U8> {
  let width = Array::length(left);
  let out: Array<U8> = Array::new(width, 0);
  let mut at = 0;
  while at < width {
    Array::set(out, at, U8::xor(Array::get(left, at), Array::get(right, at)));
    at = at + 1;
  };
  out
}

// --- mutual authentication, from inside -------------------------------------
//
// Here rather than in `scram_test` because it compares against the signature
// a `Session` keeps, and `Session`'s fields are private to this module: the
// signature is the client's secret half of the exchange, and nothing outside
// has a reason to read it.

test "a server that cannot prove it holds the password is refused" {
  let opening = begin("rOprNGfwEbeRWgbNEkqO");
  let server_first =
    "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096";
  match finish(opening.session, server_first, "pencil") {
    Result::Err(_) => assert(false),
    Result::Ok(_) => {
      // A peer that answered the proof without knowing the password can only
      // guess here, and a guess must not be accepted.
      match verify(opening.session, "v=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=") {
        Result::Ok(_) => assert(false),
        Result::Err(_) => assert(true),
      };
      // The signature this client computed is the one a real server sends.
      match verify(opening.session, "v=${opening.session.expected_signature}") {
        Result::Ok(_) => assert(true),
        Result::Err(_) => assert(false),
      };
    },
  };
}
