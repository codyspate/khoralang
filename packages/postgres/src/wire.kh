module postgres::wire;

import std::core::{Array, List, Option};

/// The bytes of a PostgreSQL frontend/backend message, and how to read them
/// back.
///
/// **Everything here is pure.** No socket, no connection, no state machine —
/// building a message and taking one apart are functions from bytes to bytes,
/// which is what makes them testable without a server. That mattered: there is
/// no PostgreSQL on the machine this was written on, so a protocol that could
/// only be checked by talking to one could not have been checked at all.
///
/// # The frame
///
/// Every message after the handshake is a type byte, a 32-bit big-endian
/// length, and a payload:
///
/// ```text
/// +--------+------------------+------------------+
/// | 'Q'    | length (4 bytes) | payload          |
/// +--------+------------------+------------------+
/// ```
///
/// **The length counts itself and excludes the type byte**, which is the one
/// off-by-one in the protocol worth writing down. A `Query` carrying five
/// bytes of payload has a length field of nine, and the whole message on the
/// wire is ten.
///
/// The startup message is the exception: it has no type byte, because the
/// server does not yet know what protocol it is speaking.

// --- writing ---------------------------------------------------------------

/// A message being built.
///
/// A byte array that doubles when it fills, and how much of it is written:
/// the length is not known until the payload is finished — which is the whole
/// reason a protocol puts the length first and a writer has to buffer.
///
/// **What the array is for: a message written a byte at a time.** A
/// `Vector<U8>` took a call and a bounds check per byte and was copied out a
/// byte at a time by `finish`; text and arrays here are one bounds check and
/// one copy each, and `finish` is one copy.
///
/// What it costs: up to twice the message's size, held until the writer goes.
pub type Writer = {
  mut bytes: Array<U8>,
  mut used: Int,
};

impl Writer {
  pub fn new() -> Writer {
    { bytes: Array::new(256, 0), used: 0 }
  }

  /// Room for `more` bytes after what is written.
  fn room(self, more: Int) -> () {
    let need = self.used + more;
    let have = Array::length(self.bytes);
    if need > have {
      let mut size = have * 2;
      while size < need { size = size * 2 };
      let bigger: Array<U8> = Array::new(size, 0);
      Array::copy_into(self.bytes, 0, bigger, 0, self.used);
      self.bytes = bigger
    }
  }

  /// One byte.
  pub fn u8(self, value: Int) -> () {
    Writer::room(self, 1);
    Array::set(self.bytes, self.used, U8::of(Int::and(value, 255)));
    self.used = self.used + 1;
  }

  /// Sixteen bits, most significant first. The protocol is big-endian
  /// throughout, which is not this machine's order and so is written out
  /// rather than reinterpreted.
  pub fn i16(self, value: Int) -> () {
    Writer::room(self, 2);
    Array::set(self.bytes, self.used, U8::of(Int::and(Int::shr(value, 8), 255)));
    Array::set(self.bytes, self.used + 1, U8::of(Int::and(value, 255)));
    self.used = self.used + 2;
  }

  /// Thirty-two bits, most significant first.
  pub fn i32(self, value: Int) -> () {
    Writer::room(self, 4);
    Writer::put_i32(self, self.used, value);
    self.used = self.used + 4;
  }

  /// Thirty-two bits at `at`, which is already written.
  fn put_i32(self, at: Int, value: Int) -> () {
    Array::set(self.bytes, at, U8::of(Int::and(Int::shr(value, 24), 255)));
    Array::set(self.bytes, at + 1, U8::of(Int::and(Int::shr(value, 16), 255)));
    Array::set(self.bytes, at + 2, U8::of(Int::and(Int::shr(value, 8), 255)));
    Array::set(self.bytes, at + 3, U8::of(Int::and(value, 255)));
  }

  /// A string's bytes, without a terminator.
  pub fn text(self, value: String) -> () {
    let count = String::byte_length(value);
    Writer::room(self, count);
    String::copy_into(value, 0, self.bytes, self.used, count);
    self.used = self.used + count;
  }

  /// A string, terminated by a zero byte, which is how the protocol carries
  /// every name it has: users, databases, parameters, SQL.
  pub fn cstring(self, value: String) -> () {
    Writer::text(self, value);
    Writer::u8(self, 0);
  }

  /// Every byte of an array, as they are.
  ///
  /// Used to put one finished message inside another buffer, which is how the
  /// extended protocol's five frames become a single write.
  pub fn raw(self, values: Array<U8>) -> () {
    let count = Array::length(values);
    Writer::room(self, count);
    Array::copy_into(values, 0, self.bytes, self.used, count);
    self.used = self.used + count;
  }

  pub fn length(self) -> Int { self.used }

  /// Starts a framed message in this buffer: the type byte, and four bytes
  /// for a length that [`Writer::close`] fills in once the payload is written.
  /// Answers where the length goes.
  ///
  /// **What stops a message being copied once per layer.** `framed` takes a
  /// finished payload and copies it into a second buffer, and `extended` used
  /// to copy each of its five framed messages into a third: every byte was
  /// pushed three times and copied into an array three times, which was a
  /// fifth of a single-row query's CPU. Framing in place writes each byte once.
  pub fn open(self, kind: Int) -> Int {
    Writer::u8(self, kind);
    let at = Writer::length(self);
    Writer::i32(self, 0);
    at
  }

  /// Ends the message [`Writer::open`] started, writing its length: four for
  /// the length itself plus everything written since, which is
  /// [`framed`]'s rule computed from the same buffer.
  pub fn close(self, at: Int) -> () {
    Writer::put_i32(self, at, Writer::length(self) - at);
  }

  /// What has been written, as an array ready to send: exactly as long as
  /// what was written, whatever the buffer grew to.
  pub fn finish(self) -> Array<U8> {
    let out: Array<U8> = Array::new(self.used, 0);
    Array::copy_into(self.bytes, 0, out, 0, self.used);
    out
  }
}

/// Wraps a payload in a type byte and a length.
///
/// **The length is four plus the payload**, counting itself and not the type
/// byte. Getting that wrong desynchronizes the stream one message later, where
/// the symptom is an unrelated message type and no clue which frame was
/// mis-sized — so it is one function, used by everything, rather than
/// arithmetic repeated at every call site.
pub fn framed(kind: Int, payload: Array<U8>) -> Array<U8> {
  let out = Writer::new();
  let at = Writer::open(out, kind);
  Writer::raw(out, payload);
  Writer::close(out, at);
  Writer::finish(out)
}

/// The first message, which has no type byte.
///
/// The server has not agreed a protocol yet, so there is nothing for a type
/// byte to mean. Version three is `0x00030000`, and the parameters are
/// `name\0value\0` pairs ended by one more zero.
pub fn startup(user: String, database: String) -> Array<U8> {
  let body = Writer::new();
  Writer::i32(body, 196608);
  Writer::cstring(body, "user");
  Writer::cstring(body, user);
  Writer::cstring(body, "database");
  Writer::cstring(body, database);
  Writer::u8(body, 0);

  let payload = Writer::finish(body);
  let out = Writer::new();
  Writer::i32(out, Array::length(payload) + 4);
  Writer::raw(out, payload);
  Writer::finish(out)
}

/// A simple query: everything in one string, results in one round trip.
pub fn query(sql: String) -> Array<U8> {
  let body = Writer::new();
  Writer::cstring(body, sql);
  framed(81, Writer::finish(body))
}

// --- the extended query protocol -------------------------------------------
//
// Five messages instead of one, and the reason is the only reason that
// matters: **the values never touch the SQL**. `Parse` carries the statement
// with `$1` in it and `Bind` carries the values separately, so there is no
// string for a quote mark to escape out of. A driver without this is a driver
// that invites concatenation, which is the oldest hole there is.
//
// Values are `Option<String>` here rather than anything richer, and that is
// the layering rather than a shortcut: this module knows bytes, and what a
// `Cell` renders to is `conn`'s business. `None` is NULL, which the protocol
// spells as a length of -1 and is not the same as a value of length zero.

/// `Parse`: a name for the statement, the SQL, and the types of its parameters.
///
/// **Zero parameter types, not one per parameter.** An empty list asks the
/// server to infer every type from where the parameter appears, which is the
/// honest answer from a driver that has not read the schema. Naming types the
/// caller guessed at would turn a server-side coercion into a client-side
/// error.
///
/// An empty name is the *unnamed* statement, which every backend keeps exactly
/// one of and replaces without being asked. That is what `extended` sends; a
/// name is what `prepare_and_run` sends, so that the parse can be reused.
pub fn parse(name: String, sql: String) -> Array<U8> {
  let out = Writer::new();
  write_parse(out, name, sql);
  Writer::finish(out)
}

fn write_parse(out: Writer, name: String, sql: String) -> () {
  let at = Writer::open(out, 80);
  Writer::cstring(out, name);
  Writer::cstring(out, sql);
  Writer::i16(out, 0);
  Writer::close(out, at)
}

/// `Bind`: the values, in order, for a parsed statement.
pub fn bind(portal: String, statement: String, values: List<Option<String>>) -> Array<U8> {
  let out = Writer::new();
  write_bind(out, portal, statement, values);
  Writer::finish(out)
}

fn write_bind(out: Writer, portal: String, statement: String, values: List<Option<String>>) -> () {
  let at = Writer::open(out, 66);
  Writer::cstring(out, portal);
  Writer::cstring(out, statement);

  // Zero parameter format codes. One code would apply to every parameter and
  // zero means the default, which is text — and saying nothing is clearer than
  // saying the default out loud.
  Writer::i16(out, 0);

  Writer::i16(out, List::length(values));
  let mut rest = values;
  let mut going = true;
  while going {
    match rest {
      List::Nil => going = false,
      List::Cons(head, tail) => {
        match head {
          // NULL. A length of -1, which is four bytes of `ff` and not an empty
          // value: `WHERE x = ''` and `WHERE x IS NULL` are different questions.
          Option::None => Writer::i32(out, -1),
          Option::Some(text) => {
            Writer::i32(out, String::byte_length(text));
            Writer::text(out, text)
          },
        };
        rest = tail
      },
    }
  };

  // Zero result format codes: text back, which `data_row` already assumes.
  Writer::i16(out, 0);
  Writer::close(out, at)
}

/// `Describe` a portal, which is what produces the `RowDescription`.
///
/// Describing the *statement* would answer a different question — what
/// parameters it takes — and the column types are what `oid_to_cell` needs.
pub fn describe_portal(name: String) -> Array<U8> {
  let out = Writer::new();
  write_describe_portal(out, name);
  Writer::finish(out)
}

fn write_describe_portal(out: Writer, name: String) -> () {
  let at = Writer::open(out, 68);
  Writer::u8(out, 80);
  Writer::cstring(out, name);
  Writer::close(out, at)
}

/// `Execute`: run a bound portal, returning at most `rows` of them.
///
/// **Zero means all of them**, which is not a count of zero. This driver reads
/// whole answers, so zero is what it always passes; a cursor is what the other
/// values are for.
pub fn execute(portal: String, rows: Int) -> Array<U8> {
  let out = Writer::new();
  write_execute(out, portal, rows);
  Writer::finish(out)
}

fn write_execute(out: Writer, portal: String, rows: Int) -> () {
  let at = Writer::open(out, 69);
  Writer::cstring(out, portal);
  Writer::i32(out, rows);
  Writer::close(out, at)
}

/// `Sync`: the end of the exchange, and the thing that gets a `ReadyForQuery`.
///
/// Without it the backend waits for more, and a caller reading until
/// `ReadyForQuery` waits for the backend. Nothing times out and nothing says
/// why — which is why this is never optional and never left to a caller to
/// remember.
pub fn sync() -> Array<U8> {
  let out = Writer::new();
  write_sync(out);
  Writer::finish(out)
}

fn write_sync(out: Writer) -> () {
  let at = Writer::open(out, 83);
  Writer::close(out, at)
}

/// One statement with its values, as a single write.
///
/// Parse, Bind, Describe, Execute, Sync against the unnamed statement and the
/// unnamed portal — the whole exchange in one buffer, because five writes is
/// five chances to leave the backend halfway through a message if one of them
/// fails. Each message is framed where it lies in that buffer rather than
/// built on its own and copied in.
pub fn extended(sql: String, values: List<Option<String>>) -> Array<U8> {
  let out = Writer::new();
  write_parse(out, "", sql);
  write_bind(out, "", "", values);
  write_describe_portal(out, "");
  write_execute(out, "", 0);
  write_sync(out);
  Writer::finish(out)
}

/// `Close` of a prepared statement: the server forgets `name`.
///
/// **Closing a statement that does not exist is not an error**, which is
/// what lets a driver close a statement whose `Parse` it cannot be sure
/// landed. The server answers `CloseComplete` either way.
pub fn close_statement(name: String) -> Array<U8> {
  let out = Writer::new();
  write_close(out, name);
  Writer::finish(out)
}

fn write_close(out: Writer, name: String) -> () {
  let at = Writer::open(out, 67);
  Writer::u8(out, 83);
  Writer::cstring(out, name);
  Writer::close(out, at)
}

/// A `Close` for each of `names`, in order, ahead of whatever `out` gets next.
fn write_closes(out: Writer, names: List<String>) -> () {
  let mut rest = names;
  let mut going = true;
  while going {
    match rest {
      List::Nil => going = false,
      List::Cons(name, more) => {
        write_close(out, name);
        rest = more
      },
    }
  }
}

/// The first use of a statement on a connection, as one write: `Close` for
/// each of `closing`, then Parse under `name`, Bind, Describe, Execute, Sync.
///
/// The same one round trip as `extended`. What differs is that the parse is
/// kept under `name`, for `run_prepared` to use from then on; `closing` is
/// how statements the connection has let go of leave the server without a
/// round trip of their own.
pub fn prepare_and_run(closing: List<String>, name: String, sql: String, values: List<Option<String>>) -> Array<U8> {
  let out = Writer::new();
  write_closes(out, closing);
  write_parse(out, name, sql);
  write_bind(out, "", name, values);
  write_describe_portal(out, "");
  write_execute(out, "", 0);
  write_sync(out);
  Writer::finish(out)
}

/// A statement the connection has already parsed as `name`, run again:
/// `Close` for each of `closing`, then Bind, Execute, Sync.
///
/// No `Parse` and no `Describe`: the server keeps the plan, and the caller
/// kept the columns the first `Describe` answered.
pub fn run_prepared(closing: List<String>, name: String, values: List<Option<String>>) -> Array<U8> {
  let out = Writer::new();
  write_closes(out, closing);
  write_bind(out, "", name, values);
  write_execute(out, "", 0);
  write_sync(out);
  Writer::finish(out)
}

/// A password, in whatever form the server asked for.
pub fn password(secret: String) -> Array<U8> {
  let body = Writer::new();
  Writer::cstring(body, secret);
  framed(112, Writer::finish(body))
}

/// `SASLInitialResponse`: the mechanism this client chose and its first
/// message.
///
/// Same type byte as `PasswordMessage` — the server knows which it asked for.
/// The length is sent explicitly and is *not* a C string, because a SASL
/// message may legitimately contain a zero byte.
pub fn sasl_initial(mechanism: String, first: String) -> Array<U8> {
  let body = Writer::new();
  Writer::cstring(body, mechanism);
  Writer::i32(body, String::byte_length(first));
  Writer::text(body, first);
  framed(112, Writer::finish(body))
}

/// `SASLResponse`: the client's proof, with no framing of its own.
pub fn sasl_response(final: String) -> Array<U8> {
  let body = Writer::new();
  Writer::text(body, final);
  framed(112, Writer::finish(body))
}

/// `Terminate`. Politer than closing the socket: the server logs a
/// disconnection rather than a broken connection.
pub fn terminate() -> Array<U8> {
  let empty: Array<U8> = Array::new(0, 0);
  framed(88, empty)
}

// --- reading ---------------------------------------------------------------

/// A position in a received buffer, and where the part being read ends.
pub type Reader = {
  bytes: Array<U8>,
  mut at: Int,
  /// Where reading stops: the array's length for `of`, and the end of one
  /// message's payload for `over`.
  ///
  /// **What stops a reader running into the next message.** `over` reads a
  /// payload inside a buffer that holds the messages after it too, and a
  /// read that ran off the end would take their bytes as this one's.
  end: Int,
};

impl Reader {
  pub fn of(bytes: Array<U8>) -> Reader { { bytes: bytes, at: 0, end: Array::length(bytes) } }

  /// A reader over one message's payload, in the buffer it arrived in.
  pub fn over(m: Message) -> Reader { { bytes: m.buffer, at: m.from, end: m.from + m.width - 5 } }

  pub fn remaining(self) -> Int { self.end - self.at }

  /// Every byte not yet read.
  ///
  /// A SASL challenge is "the rest of this message" rather than a counted or
  /// terminated field, so reading it needs this rather than a width.
  pub fn rest(self) -> Array<U8> {
    Reader::take(self, Reader::remaining(self))
  }

  /// One byte, or zero past the end.
  ///
  /// **Zero rather than a failure**, deliberately: a reader that runs off the
  /// end is looking at a message it has already decided the length of, so the
  /// mistake was upstream and reporting it here would blame the wrong line.
  /// `remaining` is how a caller checks before it reads.
  pub fn u8(self) -> Int {
    if self.at >= self.end {
      0
    } else {
      let b = U8::to_int(Array::get(self.bytes, self.at));
      self.at = self.at + 1;
      b
    }
  }

  pub fn i16(self) -> Int {
    let hi = Reader::u8(self);
    let lo = Reader::u8(self);
    Int::or(Int::shl(hi, 8), lo)
  }

  /// Thirty-two bits, **signed**.
  ///
  /// The protocol's `Int32` is two's complement and Khora's `Int` is
  /// sixty-four bits wide, so four bytes assembled with shifts give a positive
  /// number where the wire meant a negative one: -1 arrives as 4294967295.
  ///
  /// That is not academic. A `DataRow` gives every value a length, and **-1 is
  /// how it says NULL** — distinct from a length of zero, which is an empty
  /// string. Without the sign, every NULL in every result became an empty
  /// text, which is the kind of wrong that reaches a report rather than a
  /// crash. Found by the first query the driver ever ran.
  ///
  /// One bounds check for the four bytes when they are all there, which is
  /// every read of a well-formed message; a read that runs off the end goes a
  /// byte at a time, so the missing bytes are zeros as `u8` promises.
  pub fn i32(self) -> Int {
    let at = self.at;
    let raw = if at >= 0 && at + 4 <= self.end {
      self.at = at + 4;
      Int::or(
        Int::or(Int::shl(U8::to_int(Array::get(self.bytes, at)), 24), Int::shl(U8::to_int(Array::get(self.bytes, at + 1)), 16)),
        Int::or(Int::shl(U8::to_int(Array::get(self.bytes, at + 2)), 8), U8::to_int(Array::get(self.bytes, at + 3))))
    } else {
      let a = Reader::u8(self);
      let b = Reader::u8(self);
      let c = Reader::u8(self);
      let d = Reader::u8(self);
      Int::or(Int::or(Int::shl(a, 24), Int::shl(b, 16)), Int::or(Int::shl(c, 8), d))
    };
    if raw >= 2147483648 { raw - 4294967296 } else { raw }
  }

  /// Bytes up to a zero, as text. The zero is consumed and not returned.
  ///
  /// Finds the zero first and copies once. Growing a `Vector` a byte at a
  /// time and then copying that out was every column name and command tag
  /// allocated three ways.
  pub fn cstring(self) -> String {
    let end = self.end;
    let mut stop = self.at;
    while stop < end && U8::to_int(Array::get(self.bytes, stop)) != 0 {
      stop = stop + 1
    };
    let bytes = Reader::take(self, stop - self.at);
    // Past the zero, if there was one; a string that ran to the end of the
    // message has none to skip.
    if self.at < end { self.at = self.at + 1 };
    String::from_bytes(bytes)
  }

  /// `count` bytes, as their own array, or fewer if fewer are left.
  pub fn take(self, count: Int) -> Array<U8> {
    let have = Reader::remaining(self);
    let n = if count < have { count } else { have };
    let out: Array<U8> = Array::new(n, 0);
    Array::copy_into(self.bytes, self.at, out, 0, n);
    self.at = self.at + n;
    out
  }

  /// The next `count` bytes as a decimal integer, if they are one, and the
  /// reader moved past them; otherwise `None`, and the reader where it was.
  ///
  /// **What this is for: an `int4` column read without a `String` between.**
  /// Every value in a row arrives as text, and going through `String` and
  /// `Int::of_string` is two allocations per integer per row. This reads the
  /// digits where they lie.
  ///
  /// It accepts what the server sends for an integer column -- an optional
  /// `-` and one to eighteen digits -- and answers `None` for anything else,
  /// including nineteen digits or more, which could overflow. `None` is the
  /// caller's cue to take the slow path, which still gives the right answer.
  pub fn digits(self, count: Int) -> Option<Int> {
    let from = self.at;
    let end = from + count;
    if count < 1 || count > 19 || end > self.end {
      Option::None
    } else {
      let negative = U8::to_int(Array::get(self.bytes, from)) == 45;
      let first = if negative { from + 1 } else { from };
      // Eighteen digits cannot overflow; the sign takes the nineteenth place.
      let mut fine = first < end && end - first <= 18;
      let mut value = 0;
      let mut at = first;
      while fine && at < end {
        let digit = U8::to_int(Array::get(self.bytes, at)) - 48;
        if digit < 0 || digit > 9 { fine = false } else { value = value * 10 + digit; at = at + 1 }
      };
      if fine {
        self.at = end;
        Option::Some(if negative { 0 - value } else { value })
      } else {
        Option::None
      }
    }
  }
}

/// One message read off the wire, before anything is made of it: where it
/// lies, not a copy of it.
///
/// **What this is for: a reply read without copying each message out.**
/// Copying every payload into an array of its own was nine of a single-row
/// query's twenty arrays. `Reader::over` reads a payload where it lies.
///
/// What it costs: a message keeps the whole buffer it arrived in alive, not
/// only its own bytes. The connection gives a drained buffer up and holds no
/// message past the reply it belongs to, so that is one reply's bytes at
/// most. The fields are `pub` because the connection reads them; a message
/// is what the bytes said, with nothing to keep true.
pub type Message = {
  /// The type byte: `R` for authentication, `T` for a row description, and so
  /// on. Kept as a number because that is what the wire carries and a name
  /// here would be a second vocabulary to keep in step.
  pub kind: Int,
  /// The bytes the message lies in, with whatever came before and after it.
  pub buffer: Array<U8>,
  /// Where in `buffer` the payload starts: after the type byte and the length.
  pub from: Int,
  /// The whole message on the wire, type byte and length included: the
  /// payload is five bytes fewer.
  pub width: Int,
};

/// Reads one message from `bytes` starting at `from`, if a whole one is there.
///
/// `Option::None` means *not yet*, not *broken*: a socket read returns whatever
/// has arrived, and a message split across two reads is the ordinary case
/// rather than an error. The caller reads more and asks again.
pub fn message_at(bytes: Array<U8>, from: Int) -> Option<Message> {
  let available = Array::length(bytes) - from;
  if available < 5 {
    Option::None
  } else {
    let head = Reader::of(bytes);
    head.at = from + 1;
    let length = Reader::i32(head);
    // The length counts itself, so the payload is four fewer, and the whole
    // message on the wire is one more than the length.
    if length < 4 {
      Option::None
    } else if available < length + 1 {
      Option::None
    } else {
      let kind = U8::to_int(Array::get(bytes, from));
      Option::Some({ kind: kind, buffer: bytes, from: from + 5, width: length + 1 })
    }
  }
}

/// How many bytes a message occupies on the wire.
pub fn message_width(message: Message) -> Int {
  message.width
}

/// How many bytes of payload a message carries.
pub fn payload_width(message: Message) -> Int {
  message.width - 5
}
