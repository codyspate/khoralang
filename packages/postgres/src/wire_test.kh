module postgres::wire_test;

// **`std` has `assert(Bool)` and nothing else** — no `assert_eq`, no message,
// no way for a failure to say what it got. Every assertion below is therefore
// a comparison whose two sides are only visible by reading the line the
// debugger names, and a test that fails says "assertion failed" and no more.
//
// That is thin for a language meant for production, and it is written here
// rather than worked around because it is the second gap this package has
// found in a day: `Vector` has no `to_array`, and a test cannot say what it
// expected. `docs/roadmap.md` Phase 13.

import std::core::{Array, Iterator, Option, Step, assert, assert_that};
import std::core::{List};
import postgres::wire::{Message, Reader, Writer, bind, describe_portal, execute, extended, framed, message_at, message_width, parse, password, payload_width, query, startup, sync, terminate};

/// The bytes as hex, so a failure says which byte rather than that two arrays
/// differ.
fn hex(bytes: Array<U8>) -> String {
  let digits = "0123456789abcdef";
  let count = Array::length(bytes);
  let mut out = "";
  let mut at = 0;
  while at < count {
    let b = U8::to_int(Array::get(bytes, at));
    out = out + String::slice(digits, Int::shr(b, 4), Int::shr(b, 4) + 1)
    + String::slice(digits, Int::and(b, 15), Int::and(b, 15) + 1);
    at = at + 1
  };
  out
}

/// **A simple query, byte for byte against the protocol.**
///
/// `'Q'` is 0x51, the length is nine — four for itself and five for
/// `SELECT\0`... no: `"a"` is one byte plus its terminator, so the payload is
/// two and the length is six. Written out here rather than computed, because a
/// test that computes the expected value the same way the code does agrees
/// with the code and not with PostgreSQL.
test "a query is a type byte, a length that counts itself, and a C string" {
  let bytes = query("a");
  // 51            'Q'
  //   00 00 00 06 length: 4 for itself + 2 for "a\0"
  //               61 00  "a\0"
  assert(hex(bytes) == "51000000066100");
}

test "the length excludes the type byte and includes itself" {
  let payload: Array<U8> = Array::new(3, 7);
  let bytes = framed(88, payload);
  assert(Array::length(bytes) == 8);
  // The length field reads 7: three of payload and four of itself.
  let read = Reader::of(bytes);
  assert(Reader::u8(read) == 88);
  assert(Reader::i32(read) == 7);
}

/// The startup message has no type byte, because the server does not yet know
/// what protocol it is speaking.
test "the startup message carries the version and no type byte" {
  let bytes = startup("bob", "shop");
  let read = Reader::of(bytes);
  let length = Reader::i32(read);
  assert(length == Array::length(bytes));
  // 196608 is 0x00030000: major three, minor zero.
  assert(Reader::i32(read) == 196608);
  assert(Reader::cstring(read) == "user");
  assert(Reader::cstring(read) == "bob");
  assert(Reader::cstring(read) == "database");
  assert(Reader::cstring(read) == "shop");
  // One more zero ends the parameter list.
  assert(Reader::u8(read) == 0);
  assert(Reader::remaining(read) == 0);
}

test "big-endian is written most significant first" {
  let out = Writer::new();
  Writer::i32(out, 196608);
  Writer::i16(out, 513);
  let bytes = Writer::finish(out);
  assert(hex(bytes) == "000300000201");
}

test "a password message is a C string under 'p'" {
  let bytes = password("hunter2");
  let read = Reader::of(bytes);
  assert(Reader::u8(read) == 112);
  assert(Reader::i32(read) == 12);
  assert(Reader::cstring(read) == "hunter2");
}

test "terminate is a bare frame" {
  let bytes = terminate();
  assert(Array::length(bytes) == 5);
  let read = Reader::of(bytes);
  assert(Reader::u8(read) == 88);
  assert(Reader::i32(read) == 4);
}

// --- reading back ----------------------------------------------------------

/// **A message split across two socket reads is the ordinary case.**
///
/// A `recv` returns what has arrived, not what was sent. `message_at` says
/// `None` for *not yet* rather than for *broken*, and this is the case that
/// distinguishes the two: the same bytes, one short of complete, then complete.
test "a partial message is not yet rather than broken" {
  let whole = query("select 1");
  let short: Array<U8> = Array::new(Array::length(whole) - 1, 0);
  let mut at = 0;
  while at < Array::length(short) {
    Array::set(short, at, Array::get(whole, at));
    at = at + 1
  };

  match message_at(short, 0) {
    Option::Some(_) => assert(false),
    Option::None => (),
  };
  match message_at(whole, 0) {
    Option::Some(m) => {
      assert(m.kind == 81);
      assert(payload_width(m) == 9);
    },
    Option::None => assert(false),
  };
}

/// **A payload is read where it lies, and only it.** Two messages in one
/// buffer, as a reply puts them: a reader over the first stops at the first's
/// end, reading zeros past it as `u8` promises, and never the second's bytes.
/// A C string with no terminator stops there too.
test "a reader over a message stops at the message's end" {
  let out = Writer::new();
  Writer::raw(out, framed(67, String::bytes("ab")));
  Writer::raw(out, framed(90, Array::new(1, 73)));
  let both = Writer::finish(out);
  match message_at(both, 0) {
    Option::None => assert(false),
    Option::Some(m) => {
      assert(m.kind == 67 && payload_width(m) == 2);
      assert(Reader::cstring(Reader::over(m)) == "ab");
      let read = Reader::over(m);
      assert(Reader::remaining(read) == 2);
      assert(Reader::i16(read) == 24930);
      assert(Reader::remaining(read) == 0);
      assert(Reader::i32(read) == 0);
      assert(Array::length(Reader::rest(Reader::over(m))) == 2);
      match message_at(both, message_width(m)) {
        Option::None => assert(false),
        Option::Some(next) => {
          assert(next.kind == 90);
          assert(Reader::u8(Reader::over(next)) == 73);
        },
      }
    },
  };
}

/// Two messages in one read, which is what a server does when it can.
test "messages are read one after another out of one buffer" {
  let first = query("a");
  let second = terminate();
  let total = Array::length(first) + Array::length(second);
  let both: Array<U8> = Array::new(total, 0);
  let mut at = 0;
  while at < Array::length(first) {
    Array::set(both, at, Array::get(first, at));
    at = at + 1
  };
  let mut j = 0;
  while j < Array::length(second) {
    Array::set(both, Array::length(first) + j, Array::get(second, j));
    j = j + 1
  };

  match message_at(both, 0) {
    Option::Some(one) => {
      assert(one.kind == 81);
      match message_at(both, message_width(one)) {
        Option::Some(two) => assert(two.kind == 88),
        Option::None => assert(false),
      }
    },
    Option::None => assert(false),
  };
}

test "a reader stops a C string at its zero and consumes it" {
  let out = Writer::new();
  Writer::cstring(out, "one");
  Writer::cstring(out, "two");
  let read = Reader::of(Writer::finish(out));
  assert(Reader::cstring(read) == "one");
  assert(Reader::cstring(read) == "two");
  assert(Reader::remaining(read) == 0);
}

// --- the extended protocol -------------------------------------------------
//
// Every expected string below is written out rather than computed. A test that
// computes what it expects the same way the code does agrees with the code and
// not with PostgreSQL, which is the only thing worth agreeing with.

test "Parse is the unnamed statement, the SQL, and no parameter types" {
  let bytes = parse("", "s");
  // 50            'P'
  //   00 00 00 09 length: 4 self + 1 name + 2 sql + 2 type count
  //   00          the unnamed statement
  //   73 00       "s\0"
  //   00 00       zero parameter types: let the server infer them
  assert(hex(bytes) == "50000000090073000000");
}

test "Bind sends the value in its own length-prefixed field" {
  let one: List<Option<String>> = List::Cons(Option::Some("hi"), List::Nil);
  let bytes = bind("", "", one);
  // 42            'B'
  //   00 00 00 12 length: 4 self + 1 portal + 1 stmt + 2 formats + 2 count
  //                       + 4 length + 2 value + 2 result formats = 18
  //   00 00       both names unnamed
  //   00 00       zero parameter format codes: text
  //   00 01       one value
  //   00 00 00 02 two bytes long
  //   68 69       "hi"
  //   00 00       zero result format codes: text back
  assert(hex(bytes) == "42000000120000000000010000000268690000");
}

/// **NULL is a length of -1, and an empty string is a length of zero.** They
/// are different questions -- `WHERE x = ''` and `WHERE x IS NULL` do not match
/// the same rows -- and four bytes of `ff` is the whole difference on the wire.
test "NULL is a length of minus one, not an empty value" {
  let null: List<Option<String>> = List::Cons(Option::None, List::Nil);
  let empty: List<Option<String>> = List::Cons(Option::Some(""), List::Nil);
  assert(hex(bind("", "", null)) == "4200000010000000000001ffffffff0000");
  assert(hex(bind("", "", empty)) == "4200000010000000000001000000000000");
}

test "a value keeps a quote mark as a quote mark" {
  // The point of the whole exercise: the value below would close a string
  // literal and start a second statement if it were concatenated into SQL.
  // Here it is five bytes with a length in front, and nothing reads it as SQL.
  let hostile: List<Option<String>> = List::Cons(Option::Some("'; --"), List::Nil);
  let bytes = bind("", "", hostile);
  assert(hex(bytes) == "420000001500000000000100000005273b202d2d0000");
}

test "Bind with no values still says how many there are" {
  let none: List<Option<String>> = List::Nil;
  assert(hex(bind("", "", none)) == "420000000c0000000000000000");
}

test "Describe asks about the portal, not the statement" {
  // 44 'D', length 6, 50 'P', 00 the unnamed portal.
  assert(hex(describe_portal("")) == "44000000065000");
}

test "Execute with a row limit of zero means every row" {
  // 45 'E', length 9, 00 unnamed portal, 00000000 no limit.
  assert(hex(execute("", 0)) == "45000000090000000000");
}

test "Sync is a type byte and a length and nothing else" {
  assert(hex(sync()) == "5300000004");
}

// --- the writer's buffer, and bulk reads -------------------------------------
//
// The writer is an array that doubles, and `take` and `text` are single
// copies. What goes wrong with that shape is at the edges: a write that lands
// exactly at a doubling, a length patched in after the buffer moved, a copy one
// byte short. Each test below builds the expected bytes a byte at a time and
// compares.

/// `n` bytes counting up from `from`, wrapping at 256.
fn run_of(n: Int, from: Int) -> Array<U8> {
  Array::from_fn(n, fn i => U8::of(Int::and(from + i, 255)))
}

/// **A message across every doubling of the buffer.** A framed message whose
/// length is patched in by `close` after the payload has pushed the buffer
/// through one, two or three doublings; the text and the raw bytes are
/// written by bulk copy and must land where a byte loop would put them.
test "a writer's bytes survive the buffer growing under them" {
  for n in [0, 1, 250, 251, 252, 255, 256, 257, 511, 512, 513, 1500, 5000] {
    let out = Writer::new();
    Writer::u8(out, 7);
    let at = Writer::open(out, 68);
    Writer::raw(out, run_of(n, 3));
    Writer::text(out, "é!");
    Writer::i16(out, 258);
    Writer::close(out, at);
    Writer::i32(out, -2);
    let bytes = Writer::finish(out);

    let want = 1 + 1 + 4 + n + 3 + 2 + 4;
    assert_that(Array::length(bytes) == want, "n=${Int::to_string(n)}: ${Int::to_string(Array::length(bytes))} bytes");
    let read = Reader::of(bytes);
    assert_that(Reader::u8(read) == 7, "n=${Int::to_string(n)}: first byte");
    assert_that(Reader::u8(read) == 68, "n=${Int::to_string(n)}: kind");
    assert_that(Reader::i32(read) == 4 + n + 3 + 2, "n=${Int::to_string(n)}: length patched after growing");
    let mut i = 0;
    while i < n {
      assert_that(Reader::u8(read) == Int::and(3 + i, 255), "n=${Int::to_string(n)}: payload byte ${Int::to_string(i)}");
      i = i + 1
    };
    assert_that(Reader::u8(read) == 195 && Reader::u8(read) == 169 && Reader::u8(read) == 33, "n=${Int::to_string(n)}: text");
    assert_that(Reader::i16(read) == 258, "n=${Int::to_string(n)}: i16");
    assert_that(Reader::i32(read) == -2, "n=${Int::to_string(n)}: i32");
    assert_that(Reader::remaining(read) == 0, "n=${Int::to_string(n)}: trailing bytes");
  };
}

/// `take` from each position, for each count, including past the end, where
/// it gives what is left; and `rest`, which is `take` of everything left.
test "take copies exactly the bytes asked for, or what is left" {
  let bytes = run_of(40, 100);
  for from in [0, 1, 17, 39, 40] {
    for count in [0, 1, 5, 23, 39, 40, 41, 100] {
      let read = Reader::of(bytes);
      Reader::take(read, from);
      let got = Reader::take(read, count);
      let left = 40 - from;
      let n = if count < left { count } else { left };
      assert_that(Array::length(got) == n, "from ${Int::to_string(from)} count ${Int::to_string(count)}: length");
      assert_that(Reader::remaining(read) == left - n, "from ${Int::to_string(from)} count ${Int::to_string(count)}: position");
      let mut i = 0;
      while i < n {
        assert_that(U8::to_int(Array::get(got, i)) == Int::and(100 + from + i, 255),
          "from ${Int::to_string(from)} count ${Int::to_string(count)}: byte ${Int::to_string(i)}");
        i = i + 1
      }
    }
  };
  let read = Reader::of(bytes);
  Reader::take(read, 30);
  assert(hex(Reader::rest(read)) == "82838485868788898a8b");
  assert(Reader::remaining(read) == 0);
}

/// These numbers as bytes.
fn bytes_of(values: List<Int>) -> Array<U8> {
  let out: Array<U8> = Array::new(List::length(values), 0);
  let mut at = 0;
  for v in values {
    Array::set(out, at, U8::of(v));
    at = at + 1
  };
  out
}

/// **`i32` at the end of a buffer.** Four bytes in one check when they are
/// there; with fewer left, the missing ones read as zeros, as `u8` says, and
/// never as whatever follows the buffer.
test "i32 reads four bytes at once, and zeros past the end" {
  let bytes = bytes_of([255, 255, 255, 254, 1, 2, 3]);
  let read = Reader::of(bytes);
  assert(Reader::i32(read) == -2);
  assert(Reader::remaining(read) == 3);
  // Three bytes left: 01 02 03, then a zero.
  assert(Reader::i32(read) == 16909056);
  assert(Reader::remaining(read) == 0);
  assert(Reader::i32(read) == 0);
  let exact = Reader::of(bytes_of([128, 0, 0, 0]));
  assert(Reader::i32(exact) == -2147483648);
  assert(Reader::remaining(exact) == 0);
}

/// The text of `value`, read back as `digits` would find it in a row.
fn digits_of(text: String) -> Option<Int> {
  Reader::digits(Reader::of(String::bytes(text)), String::byte_length(text))
}

/// **An integer column read from its digits.** Anything `digits` answers must
/// be what `Int::of_string` answers, and what it declines -- a sign it does
/// not know, a stray byte, too many digits to be safe -- goes the slow way.
test "digits reads what Int::of_string reads, and declines the rest" {
  let accepted = ["0", "7", "-7", "42", "-0", "007", "2147483647", "-2147483648",
    "999999999999999999", "-999999999999999999"];
  for text in accepted {
    match digits_of(text) {
      Option::None => assert_that(false, "declined ${text}"),
      Option::Some(n) => assert_that(Option::Some(n) == Int::of_string(text), "misread ${text}"),
    }
  };
  let declined = ["", "-", "+5", "4a", " 4", "4 ", "1.5", "1000000000000000000", "-9223372036854775808"];
  for text in declined {
    match digits_of(text) {
      Option::None => (),
      Option::Some(n) => assert_that(false, "read ${text} as ${Int::to_string(n)}"),
    }
  };
  // Declining leaves the reader where it was, for the slow path to start from.
  let read = Reader::of(String::bytes("12x"));
  assert(Reader::digits(read, 3) == Option::None);
  assert(Reader::remaining(read) == 3);
  // Reading moves past exactly the digits, not what follows them.
  let two = Reader::of(String::bytes("1234"));
  assert(Reader::digits(two, 2) == Option::Some(12));
  assert(Reader::remaining(two) == 2);
  assert(Reader::digits(two, 3) == Option::None);
}

/// The five messages in one buffer, which is one write and one chance to fail.
test "an extended query is Parse, Bind, Describe, Execute, Sync" {
  let none: List<Option<String>> = List::Nil;
  let whole = extended("s", none);
  let head = hex(parse("", "s")) + hex(bind("", "", none));
  let expected = head + hex(describe_portal("")) + hex(execute("", 0)) + hex(sync());
  assert(hex(whole) == expected);
  // And it ends with Sync, without which the backend waits for more and the
  // caller waits for the backend, and neither says why.
  let text = hex(whole);
  let width = String::byte_length(text);
  assert(String::slice(text, width - 10, width) == "5300000004");
}
