module postgres::conn;

import std::core::{Array, Iterator, List, Option, Result, Step, Vector, assert, assert_that};
import std::db::{Cell, DbError, Row};
import std::decimal::{Decimal};
import std::net::socket::{accept_on, connect_to, invalid_handle, listen_on, nothing_yet, receive, receive_now, set_receive_timeout, shut, start, transmit_bytes};
import postgres::wire::{Message, Reader, Writer, extended, framed, message_at, message_width, password, query, sasl_initial, sasl_response, startup, terminate};
import postgres::scram::{Opening, ScramError, Session, begin, encode64, finish, verify};

extern fn khora_random_seed() -> Int;
extern fn khora_monotonic_millis() -> Int;

/// A connection to a PostgreSQL server, and the conversation it has.
///
/// # What this speaks
///
/// Both query protocols, and which one to use is not a preference:
///
/// - `ask` takes values and sends them as values. Use it for anything with a
///   parameter in it. `Parse` carries the SQL and `Bind` carries the data, so
///   there is no string for a quote mark to escape out of.
/// - `run` takes one string and nothing else. Use it for statements that have
///   no parameters — schema, `BEGIN`, a fixed query. It is the only one that
///   can carry several statements separated by semicolons, which is also the
///   reason it must never be handed anything a user typed.
///
/// **Interpolating a value into `run` is the oldest hole there is**, and the
/// only defense a library can offer is to make the safe call the shorter one.
/// It is: `ask(c, "select * from t where id = $1", cons(Cell::Number(id)))`.
///
/// Parameters are `$1`, `$2` and so on, numbered from one, and the same
/// parameter may appear more than once.
///
/// # What it does not speak
///
/// **MD5.** `ring` does not carry it, deliberately, because nothing new should
/// be using it. A server set to `md5` is refused by name rather than hung:
/// `Unsupported` says which method was asked for, because "connection failed"
/// would send somebody looking at their network.
///
/// `scram-sha-256` — the default on PostgreSQL 14 and later — **is** spoken,
/// and the server is made to prove itself too. See `src/scram.kh`.
///
/// **TLS.** `SSLRequest` is one message and `std::net::tls` exists, so this is
/// closer than it sounds; it is not here yet.

/// What went wrong, before it becomes a `DbError`.
///
/// Kept separate from `DbError` so the driver can say things `std::db`'s three
/// cases cannot — an authentication method it has not got is neither a
/// rejected statement nor a lost connection.
pub type PgError =
  /// The socket never opened.
  | Unreachable(String)
  /// The server said no. Carries its message, which is usually the useful one.
  | Refused(String)
  /// The connection went away mid-conversation.
  | Closed(String)
  /// Something the protocol allows and this driver has not built.
  | Unsupported(String);

impl PgError {
  /// How a driver failure reaches a caller that only knows `std::db`.
  ///
  /// `Unsupported` becomes `Rejected` rather than `Disconnected`: the
  /// connection is fine, the request is the thing that cannot be served, and
  /// a caller retrying a `Disconnected` would retry forever.
  pub fn to_db(self) -> DbError {
    match self {
      PgError::Unreachable(why) => DbError::Disconnected(why),
      PgError::Closed(why) => DbError::Disconnected(why),
      PgError::Refused(why) => DbError::Rejected(why),
      PgError::Unsupported(why) => DbError::Rejected(why),
    }
  }
}

/// An open connection.
pub type Connection = {
  handle: Int,
  /// Bytes that have arrived and not yet been consumed as messages.
  ///
  /// A server may put several messages in one packet and split one across two,
  /// so the socket's boundaries and the protocol's have nothing to do with
  /// each other. This is where that is absorbed.
  mut pending: Array<U8>,
  /// Where the first unconsumed byte of `pending` is.
  ///
  /// **What stops reading a reply being quadratic in its rows.** Taking a
  /// message used to copy everything after it into a new buffer, so a read
  /// holding `n` messages copied the tail `n` times -- a Fortunes reply is a
  /// dozen `DataRow`s in one packet. Moving an offset costs nothing; the
  /// consumed bytes are dropped once, when the next read has to append, or
  /// when the last whole message is taken and nothing is left.
  mut start: Int,
  /// The SCRAM exchange in progress, if one is.
  ///
  /// **Authentication is the one part of this protocol with state that spans
  /// messages.** The server asks, the client answers, the server challenges,
  /// the client proves — and the proof is signed over the client's own first
  /// message, so that message has to survive until the challenge arrives.
  /// Every other exchange here is a request and its replies.
  mut scram: Option<Session>,
  /// Whether a read or a write failed partway through an exchange.
  ///
  /// **What this prevents: a caller given the answer to somebody else's
  /// query.** A reply cut off by a failed read is still arriving, so the next
  /// statement sent on the connection reads the rest of the old reply as its
  /// own, and every statement after it is one reply behind. A write that
  /// failed, or that sent fewer bytes than the request, may have left part of
  /// a frame on the wire, which puts the server out of step instead. Neither
  /// can be repaired from this side: the driver cannot tell how much of the
  /// reply is still coming. So once this is set, `ask` and `run` refuse
  /// without touching the socket, and `postgres::db` stops serving the
  /// connection and closes it.
  ///
  /// What it costs: one failed read ends the connection, including a read
  /// that timed out on a server that was only slow.
  mut broken: Bool,
  /// Whether the last `ReadyForQuery` said a transaction is open. See
  /// `in_transaction`.
  mut open_transaction: Bool,
  /// How many transactions are open: 0 outside one, 1 inside one, and one
  /// more per savepoint `postgres::db` opened inside it.
  ///
  /// **Kept beside the connection because it is the connection's**: two
  /// leases never share it, and every lease of one connection does. A
  /// `ReadyForQuery` that says the connection is outside a transaction sets
  /// it back to 0, so a `ROLLBACK`, a `COMMIT` or a failed `BEGIN` cannot
  /// leave it counting savepoints the server has already dropped.
  mut depth: Int,
  /// Where every socket read lands before `extend` copies out what arrived.
  ///
  /// **One per connection, so a read does not allocate.** A fresh 8 KiB
  /// array per read, and another per lease check, was zeroed by the
  /// allocator every time, and that was an eighth of a single-row query's
  /// instructions. Nothing keeps a reference to it past the read: `extend`
  /// copies the bytes that arrived into `pending`.
  ///
  /// What it costs: 8 KiB per open connection, for as long as it is open.
  inbox: Array<U8>,
};

/// How many bytes one socket read asks for.
fn read_size() -> Int { 8192 }

/// What a column is called and what type the server says it is.
pub type Column = {
  pub name: String,
  /// The type's OID. Text is 25, `int4` is 23, and so on — see `oid_to_cell`.
  pub oid: Int,
};

/// A query's answer.
pub type Answer = {
  pub columns: List<Column>,
  pub rows: List<Row>,
  /// What `CommandComplete` said: `SELECT 3`, `INSERT 0 1`.
  pub tag: String,
};

// --- reading messages ------------------------------------------------------

/// The unconsumed part of `head` from `from`, followed by the first
/// `tail_len` bytes of `tail`.
fn extend(head: Array<U8>, from: Int, tail: Array<U8>, tail_len: Int) -> Array<U8> {
  let head_len = Array::length(head) - from;
  let out: Array<U8> = Array::new(head_len + tail_len, 0);
  Array::copy_into(head, from, out, 0, head_len);
  Array::copy_into(tail, 0, out, head_len, tail_len);
  out
}

/// One message, reading from the socket until a whole one has arrived.
pub fn next_message(c: Connection) -> Result<Message, PgError> {
  let mut answer: Result<Message, PgError> = Result::Err(PgError::Closed("no message"));
  let mut going = true;
  while going {
    match message_at(c.pending, c.start) {
      Option::Some(m) => {
        c.start = c.start + message_width(m);
        // Drained: let the buffer go, so an idle connection holds nothing
        // from its last reply. Otherwise a pooled connection that once
        // answered a 1 MB row keeps that megabyte until its next query.
        if c.start == Array::length(c.pending) {
          c.pending = Array::new(0, 0);
          c.start = 0
        };
        answer = Result::Ok(m);
        going = false
      },
      Option::None => {
        let buffer = c.inbox;
        let read = receive(c.handle, buffer);
        if read <= 0 {
          c.broken = true;
          answer = Result::Err(PgError::Closed(
              "the server closed the connection while a reply was expected",
            ));
          going = false
        } else {
          c.pending = extend(c.pending, c.start, buffer, read);
          c.start = 0
        }
      },
    }
  };
  answer
}

/// The text of an `ErrorResponse`, which is a list of tagged fields.
///
/// `M` is the human-readable message and the only one worth leading with; the
/// rest are severity, SQLSTATE, and where in the server's own source it came
/// from, which nobody debugging their own SQL wants first.
fn error_text(m: Message) -> String {
  let read = Reader::of(m.payload);
  let mut message = "";
  let mut code = "";
  let mut going = true;
  while going {
    let field = Reader::u8(read);
    if field == 0 {
      going = false
    } else {
      let value = Reader::cstring(read);
      if field == 77 { message = value } else if field == 67 { code = value } else { () }
    }
  };
  if code == "" { message } else { "${message} [${code}]" }
}

// --- connecting ------------------------------------------------------------

/// Opens a connection and completes the handshake.
///
/// **There is no connect timeout, and a fiber blocked here cannot be
/// canceled.** The runtime's connect is a blocking call on the worker — it
/// resolves the name and waits for the kernel — so a host that is unroutable
/// rather than refusing takes the operating system's own connect timeout,
/// which is minutes on Linux. `Fiber::cancel` does not shorten it: the fiber
/// is inside `connect(2)` and reaches no cancellation point until it returns.
///
/// A deadline around this call reports on time but does not free the fiber, so
/// a program that has given up must `Fiber::detach` the handle as well as
/// canceling it, or its own exit will wait for the connect to finish. Guard a
/// user-supplied address before reaching here if a prompt answer matters.
pub fn open(
  host: String,
  port: Int,
  user: String,
  database: String,
  secret: String,
) -> Result<Connection, PgError> {
  open_within(host, port, user, database, secret, 0)
}

/// `open`, with the handshake bounded: a server that has not finished it
/// within `millis` is given up on, and the answer is `Closed` saying so. Zero
/// is no bound, which is `open`.
///
/// **What this prevents: a connect that never ends because the server never
/// speaks.** A server stuck in its own startup, or a port something else is
/// listening on, accepts the connection and then says nothing; `open` waits
/// for its first message for ever. A pool reconnecting to it hung the slot,
/// the callers waiting on the slot, and `close`, which waits for the slot.
///
/// The bound is on each read of the handshake, not on the whole of it, so a
/// server that answers each message just inside it can take longer in all. It
/// does not bound the TCP connect before it, for the reason `open` gives: an
/// unroutable host still takes the operating system's connect timeout. Once
/// the handshake is over the bound is lifted, and statements wait for their
/// replies as long as they take.
pub fn open_within(
  host: String,
  port: Int,
  user: String,
  database: String,
  secret: String,
  millis: Int,
) -> Result<Connection, PgError> {
  if !start() {
    Result::Err(PgError::Unreachable("the socket layer would not start"))
  } else {
    let handle = connect_to(host, port);
    if handle == invalid_handle() {
      Result::Err(PgError::Unreachable(
          "could not reach ${host}:${Int::to_string(port)}",
        ))
    } else {
      let empty: Array<U8> = Array::new(0, 0);
      let c: Connection = {
        handle: handle, pending: empty, start: 0, scram: Option::None, broken: false,
        open_transaction: false, depth: 0, inbox: Array::new(read_size(), 0),
      };
      let hello = startup(user, database);
      let began = khora_monotonic_millis();
      if millis > 0 { let _ = set_receive_timeout(handle, millis); () };
      if transmit_bytes(handle, hello) < 0 {
        shut(handle);
        Result::Err(PgError::Closed("the startup message could not be sent"))
      } else {
        match handshake(c, secret) {
          Result::Ok(_) => {
            if millis > 0 { let _ = set_receive_timeout(handle, 0); () };
            Result::Ok(c)
          },
          Result::Err(why) => {
            shut(handle);
            Result::Err(if millis > 0 { unanswered(why, millis, khora_monotonic_millis() - began) } else { why })
          },
        }
      }
    }
  }
}

/// A handshake that failed under a bound, told as what happened.
///
/// A read that runs out of time comes back like a closed connection, so a
/// server that never answered would be reported as one that hung up. Only a
/// failure that took the whole bound is a timeout: a server that closed the
/// connection at once -- one that is restarting, say -- keeps its own
/// message, and so do a refusal and a missing feature.
fn unanswered(why: PgError, millis: Int, took: Int) -> PgError {
  match why {
    PgError::Closed(said) => if took >= millis {
      PgError::Closed(
        "the server did not finish the handshake within ${Int::to_string(millis)} ms",
      )
    } else {
      PgError::Closed(said)
    },
    PgError::Unreachable(said) => PgError::Unreachable(said),
    PgError::Refused(said) => PgError::Refused(said),
    PgError::Unsupported(said) => PgError::Unsupported(said),
  }
}

/// Everything between the startup message and the first `ReadyForQuery`.
fn handshake(c: Connection, secret: String) -> Result<Bool, PgError> {
  let mut outcome: Result<Bool, PgError> = Result::Ok(true);
  let mut going = true;
  while going {
    match next_message(c) {
      Result::Err(why) => {
        outcome = Result::Err(why);
        going = false
      },
      Result::Ok(m) => {
        // 'Z' ReadyForQuery: the handshake is over and the server is idle.
        if m.kind == 90 {
          going = false
        } else if m.kind == 69 {
          // 'E' ErrorResponse. Usually the password or the database name.
          outcome = Result::Err(PgError::Refused(error_text(m)));
          going = false
        } else if m.kind == 82 {
          // 'R' Authentication.
          match authenticate(c, m, secret) {
            Result::Ok(_) => (),
            Result::Err(why) => {
              outcome = Result::Err(why);
              going = false
            },
          }
        } else {
          // 'S' ParameterStatus, 'K' BackendKeyData, 'N' NoticeResponse. None
          // of them is needed to run a query, and a driver that refused what
          // it did not recognize would break on the next server version.
          ()
        }
      },
    }
  };
  outcome
}

/// Bytes for a client nonce.
///
/// **A nonce must not repeat across connections**, because the proof is signed
/// over it and a repeated one makes a recorded exchange replayable. The
/// runtime's seed is drawn from the operating system, and each call draws
/// again, so two connections opened in the same millisecond do not share one.
///
/// This reaches for the runtime directly rather than taking a `Random`
/// capability, because `open` has no capability row and adding one to it would
/// change every caller for a value no caller should be choosing. A nonce the
/// application could pin is a nonce an application will eventually pin.
fn nonce_bytes() -> Array<U8> {
  let out: Array<U8> = Array::new(18, 0);
  let mut at = 0;
  while at < 18 {
    // One draw per three bytes: the seed is 64 bits and taking all eight from
    // one would be eight bytes of one number, not eight independent ones.
    let draw = khora_random_seed();
    Array::set(out, at, U8::of(Int::and(draw, 255)));
    if at + 1 < 18 { Array::set(out, at + 1, U8::of(Int::and(Int::shr(draw, 8), 255))) };
    if at + 2 < 18 { Array::set(out, at + 2, U8::of(Int::and(Int::shr(draw, 16), 255))) };
    at = at + 3;
  };
  out
}

/// Answers whichever authentication the server asked for, if it can.
fn authenticate(c: Connection, m: Message, secret: String) -> Result<Bool, PgError> {
  let read = Reader::of(m.payload);
  let method = Reader::i32(read);
  if method == 0 {
    // AuthenticationOk. Nothing to send.
    Result::Ok(true)
  } else if method == 3 {
    // Cleartext. Only reasonable over a unix socket or TLS, and this driver
    // has neither yet — which is the caller's decision to make, not this
    // function's, so it is sent rather than refused.
    if transmit_bytes(c.handle, password(secret)) < 0 {
      Result::Err(PgError::Closed("the password could not be sent"))
    } else {
      Result::Ok(true)
    }
  } else if method == 5 {
    Result::Err(PgError::Unsupported(
        "the server asked for MD5 authentication, which this driver does not \
       compute: `ring` does not carry MD5, deliberately. Set this role's \
       password_encryption to `scram-sha-256` and reset its password — that is \
       the default from PostgreSQL 14 and this driver speaks it",
      ))
  } else if method == 10 {
    // AuthenticationSASL. The payload lists the mechanisms the server will
    // accept; this client speaks one, and says so.
    //
    // **`SCRAM-SHA-256-PLUS` is deliberately not offered.** It binds the
    // exchange to the TLS channel, and claiming it without doing that binding
    // is worse than not offering it: the whole point of the `-PLUS` variant is
    // that a client refuses to authenticate through a proxy it cannot see.
    let nonce = encode64(nonce_bytes());
    let opening = begin(nonce);
    c.scram = Option::Some(opening.session);
    if transmit_bytes(c.handle, sasl_initial("SCRAM-SHA-256", opening.message)) < 0 {
      Result::Err(PgError::Closed("the SASL handshake could not be started"))
    } else {
      Result::Ok(true)
    }
  } else if method == 11 {
    // AuthenticationSASLContinue: the server's nonce, salt and iteration
    // count. Answer it with the proof.
    match c.scram {
      Option::None => Result::Err(PgError::Refused(
          "the server sent a SASL challenge before this client began one")),
      Option::Some(session) => {
        let challenge = String::from_bytes(Reader::rest(read));
        match finish(session, challenge, secret) {
          Result::Err(why) => Result::Err(PgError::Refused(match why {
                ScramError::Malformed(m) => "the server's SASL challenge is malformed: ${m}",
                ScramError::Rejected(m) => m,
              })),
          Result::Ok(final) =>
            if transmit_bytes(c.handle, sasl_response(final)) < 0 {
              Result::Err(PgError::Closed("the SASL proof could not be sent"))
            } else {
              Result::Ok(true)
            },
        }
      },
    }
  } else if method == 12 {
    // AuthenticationSASLFinal: the server's own proof that it holds the
    // password. Checked rather than accepted — a client that skips this has
    // proved itself to a peer it never made prove anything back.
    match c.scram {
      Option::None => Result::Err(PgError::Refused(
          "the server sent a SASL conclusion before this client began one")),
      Option::Some(session) => {
        let shown = String::from_bytes(Reader::rest(read));
        c.scram = Option::None;
        match verify(session, shown) {
          Result::Ok(_) => Result::Ok(true),
          Result::Err(why) => Result::Err(PgError::Refused(match why {
                ScramError::Malformed(m) => "the server's SASL conclusion is malformed: ${m}",
                ScramError::Rejected(m) => m,
              })),
        }
      },
    }
  } else {
    Result::Err(PgError::Unsupported(
        "the server asked for authentication method " + Int::to_string(method)
        + ", which this driver does not know",
      ))
  }
}

/// Closes politely, so the server logs a disconnection and not a broken pipe.
///
/// **A broken connection is shut without the goodbye.** The server may already
/// have closed it, and a write to a socket the other end has reset stops the
/// whole process with `SIGPIPE`, which the runtime does not ignore. A pool
/// closes every connection it reconnects, most of them because the server
/// went away, so the one write this saves is the one most likely to land on a
/// reset socket.
pub fn close(c: Connection) -> () {
  if !c.broken { transmit_bytes(c.handle, terminate()); () };
  shut(c.handle);
}

// --- querying --------------------------------------------------------------

/// Whether this connection can still carry a statement.
///
/// False once an exchange has failed partway, for good: see `broken`.
pub fn usable(c: Connection) -> Bool {
  !c.broken
}

/// Marks the connection as not to be used again.
///
/// For a caller that knows something the connection does not: `std::db`'s
/// `broken`, sent when a `ROLLBACK` did not arrive. Every later statement is
/// refused without touching the socket, as after a cut-off reply.
pub fn forsake(c: Connection) -> () {
  c.broken = true
}

/// Whether a connection nobody is using is still worth lending.
///
/// **What this prevents: a borrower handed a connection the server has
/// already closed.** A server that restarts, or an administrator who ends a
/// backend, closes connections that are sitting idle, and nothing is read
/// from an idle connection to notice. This reads whatever has arrived without
/// waiting: nothing yet is the healthy answer. The end of the stream is a
/// closed connection and a failed read is a reset one, so both count as
/// broken, and the connection is marked so. A reset connection taken for a
/// quiet one was the costly case: the next statement was written to it, and
/// `SIGPIPE` ended the process.
///
/// **Bytes are read as messages, and the ones a server sends unasked on a
/// healthy connection are kept for the next reply.** A notification from
/// `LISTEN`, a notice, or a changed parameter can arrive while a connection
/// sits idle; counted as broken, each cost a healthy connection a reconnect
/// and any session state it held. They are left where the next exchange
/// reads them, and it skips them as it always has. Anything else -- the
/// `ErrorResponse` a server sends before it hangs up, above all -- counts as
/// broken, and so does a message whose first bytes are in and whose kind is
/// anything else.
///
/// What it costs: one non-blocking read per lease, more if the server has
/// sent something. What it cannot see: a connection that dies between this
/// check and the statement after it, or a peer that vanished without
/// closing (no `FIN` arrives, so the read would block, which is the healthy
/// answer).
pub fn still_open(c: Connection) -> Bool {
  if c.broken {
    false
  } else {
    let mut open = true;
    let mut reading = true;
    // A bound, so a server that never stops talking cannot hold the check.
    let mut rounds = 16;
    while reading && rounds > 0 {
      let probe = c.inbox;
      let read = receive_now(c.handle, probe);
      if nothing_yet(read) {
        reading = false
      } else if read <= 0 {
        open = false;
        reading = false
      } else {
        c.pending = extend(c.pending, c.start, probe, read);
        c.start = 0;
        rounds = rounds - 1
      }
    };
    if open && !only_unasked(c.pending, c.start) { open = false };
    if !open { c.broken = true };
    open
  }
}

/// Whether every message in `bytes` from `from` on is one a server sends
/// unasked on a healthy connection: `NotificationResponse` ('A'),
/// `NoticeResponse` ('N') or `ParameterStatus` ('S').
///
/// **A message still arriving is judged by its first byte**, which is all it
/// takes to know what it is. Left to the next statement, the first bytes of
/// the `FATAL` a server sends before it hangs up were lent, and the
/// statement on them read the `FATAL` as its reply and was answered
/// `Disconnected`, with a healthy connection idle beside it.
fn only_unasked(bytes: Array<U8>, from: Int) -> Bool {
  let mut at = from;
  let mut fine = true;
  let mut going = true;
  while going && fine {
    match message_at(bytes, at) {
      Option::None => {
        if at < Array::length(bytes) { fine = unasked_kind(U8::to_int(Array::get(bytes, at))) };
        going = false
      },
      Option::Some(m) => {
        fine = unasked_kind(m.kind);
        at = at + message_width(m)
      },
    }
  };
  fine
}

/// `NotificationResponse`, `NoticeResponse` or `ParameterStatus`, by kind byte.
fn unasked_kind(kind: Int) -> Bool {
  kind == 65 || kind == 78 || kind == 83
}

/// Whether the server said, in its last `ReadyForQuery`, that a transaction
/// is still open on this connection.
///
/// A pool asks before lending a connection again. A transaction left open --
/// a borrower stopped by `abort` before its `ROLLBACK` went out -- would run
/// the next borrower's statements inside it, and their writes would go when
/// it ends.
pub fn in_transaction(c: Connection) -> Bool {
  c.open_transaction
}

/// How many transactions `postgres::db` has open on this connection: 0
/// outside one, 1 inside one, and one more per savepoint.
///
/// **A function rather than a `pub` field, because the field's only other
/// reader is a sibling module.** `Connection`'s fields are socket plumbing and
/// stay private, so that a caller holding one cannot build one around a
/// foreign handle or put `start` past `pending`. The depth is the one piece of
/// state `postgres::db` keeps here, and these two are all it needs.
pub fn transaction_depth(c: Connection) -> Int {
  c.depth
}

/// Records that `postgres::db` has `depth` transactions open. See
/// `transaction_depth`; a `ReadyForQuery` outside a transaction still puts it
/// back to 0.
pub fn set_transaction_depth(c: Connection, depth: Int) -> () {
  c.depth = depth
}

/// The answer to any statement on a broken connection.
fn out_of_step() -> Result<Answer, PgError> {
  Result::Err(PgError::Closed(
      "an earlier reply on this connection was cut off, so it cannot be used again",
    ))
}

/// Sends one request's frames, marking the connection broken unless every
/// byte went. `transmit_bytes` sends all of them or fails, so the length
/// check costs a comparison and holds even if a transport ever returns a
/// short count.
fn send_frames(c: Connection, frames: Array<U8>) -> Bool {
  let sent = transmit_bytes(c.handle, frames) == Array::length(frames);
  if !sent { c.broken = true };
  sent
}

/// Runs one statement and reads everything it produces.
pub fn run(c: Connection, sql: String) -> Result<Answer, PgError> {
  if c.broken {
    out_of_step()
  } else if !send_frames(c, query(sql)) {
    Result::Err(PgError::Closed("the query could not be sent"))
  } else {
    collect(c)
  }
}

/// Runs one statement with values bound to `$1`, `$2`, and so on.
///
/// **The values never become part of the SQL.** They travel in their own
/// message with their own lengths, so a value containing a quote, a semicolon
/// or `--` is a value containing those characters and not a second statement.
/// That is the whole reason this exists next to `run`.
///
/// The statement is parsed and thrown away each time -- the *unnamed*
/// statement, which every backend keeps one of. Reusing a named one across
/// calls would save a parse; it would also mean tracking what this connection
/// has already prepared, and invalidating it when the schema changes, which is
/// a cache and not a slice of protocol. Round trips are unchanged either way:
/// this is one write and one read, the same as `run`.
pub fn ask(c: Connection, sql: String, values: List<Cell>) -> Result<Answer, PgError> {
  if c.broken {
    out_of_step()
  } else if !send_frames(c, extended(sql, to_wire(values))) {
    Result::Err(PgError::Closed("the query could not be sent"))
  } else {
    collect(c)
  }
}

/// Every `Cell` as the text the server will parse, or `None` for NULL.
///
/// **Text format for everything**, which is what `Bind` was told to expect.
/// Binary would be fewer bytes and a second encoding to get wrong per type,
/// and the server parses these exactly as it parses a literal -- so `Number`
/// reaching an `int4` column and `Text` reaching a `date` both work, and the
/// server says so when they do not.
fn to_wire(values: List<Cell>) -> List<Option<String>> {
  let mut out: Vector<Option<String>> = Vector::new();
  let mut rest = values;
  let mut going = true;
  while going {
    match rest {
      List::Nil => going = false,
      List::Cons(head, tail) => {
        Vector::push(out, cell_text(head));
        rest = tail
      },
    }
  };
  to_list(out)
}

/// One `Cell` as text.
fn cell_text(value: Cell) -> Option<String> {
  match value {
    Cell::Null => Option::None,
    Cell::Text(text) => Option::Some(text),
    Cell::Number(number) => Option::Some(Int::to_string(number)),
    Cell::Money(amount) => Option::Some(Decimal::show(amount)),
    // `t` and `f`, which PostgreSQL accepts for `bool` alongside `true` and
    // `false`. Either would do; this is what the server sends back, so a value
    // read out and written in again is the same bytes.
    Cell::Flag(flag) => Option::Some(if flag { "t" } else { "f" }),
  }
}

/// Reads until `ReadyForQuery`, gathering whatever came before it.
fn collect(c: Connection) -> Result<Answer, PgError> {
  let mut columns: List<Column> = List::Nil;
  // The column names every row carries, built once per reply: one list shared
  // by every row, where building it per row was a list per row.
  let mut names: List<String> = List::Nil;
  let mut rows: Vector<Row> = Vector::new();
  let mut tag = "";
  let mut failure: Option<PgError> = Option::None;
  let mut going = true;

  while going {
    match next_message(c) {
      Result::Err(why) => {
        failure = Option::Some(why);
        going = false
      },
      Result::Ok(m) => {
        if m.kind == 90 {
          // 'Z' ReadyForQuery ends every exchange, including a failed one —
          // which is why the error is remembered rather than returned here:
          // leaving the stream mid-reply would desynchronize the next query.
          // Its one byte is the transaction state: 'I' (73) is outside one.
          c.open_transaction = Array::length(m.payload) > 0
          && U8::to_int(Array::get(m.payload, 0)) != 73;
          if !c.open_transaction { c.depth = 0 };
          going = false
        } else if m.kind == 84 {
          columns = describe(m);
          names = List::map(columns, fn column => column.name)
        } else if m.kind == 68 {
          Vector::push(rows, data_row(m, columns, names))
        } else if m.kind == 67 {
          tag = Reader::cstring(Reader::of(m.payload))
        } else if m.kind == 69 {
          failure = Option::Some(PgError::Refused(error_text(m)))
        } else {
          ()
        }
      },
    }
  };

  match failure {
    Option::Some(why) => Result::Err(why),
    Option::None => Result::Ok({ columns: columns, rows: to_list(rows), tag: tag }),
  }
}

/// `RowDescription`: a count, then a name and a type for each column.
fn describe(m: Message) -> List<Column> {
  let read = Reader::of(m.payload);
  let count = Reader::i16(read);
  let mut out: Vector<Column> = Vector::new();
  let mut i = 0;
  while i < count {
    let name = Reader::cstring(read);
    // The table OID and column number this came from, which this driver has
    // no use for.
    Reader::i32(read);
    Reader::i16(read);
    let oid = Reader::i32(read);
    // Type size, type modifier and format code.
    Reader::i16(read);
    Reader::i32(read);
    Reader::i16(read);
    Vector::push(out, { name: name, oid: oid });
    i = i + 1
  };
  to_list(out)
}

/// `DataRow`: a count, then a length and that many bytes for each value.
///
/// **Every value arrives as text.** The simple query protocol has no way to
/// ask for anything else, so a `bool` is `"t"` and an `int4` is `"42"`, and
/// `oid_to_cell` is where that becomes a `Cell`.
///
/// An integer column is read from its digits where they lie, when they are
/// plain digits; anything else goes through the text, as every other type
/// does, and gets the same answer.
///
/// `names` is the columns' names, which every row carries: they are what a
/// schema reads the row by. The caller builds them once per reply.
///
/// **The cells are a `List` from the start**, one `Cons` each, rather than a
/// `Vector` converted at the end: three fewer objects per row of two columns.
fn data_row(m: Message, columns: List<Column>, names: List<String>) -> Row {
  let read = Reader::of(m.payload);
  let count = Reader::i16(read);
  { columns: names, cells: cells_from(read, columns, count) }
}

/// The next `left` values of a `DataRow`, in order, typed by `columns`.
///
/// Recursive, so the list is built front to back with no reversal: a row has
/// at most 1,664 columns (PostgreSQL's limit), which is the deepest this goes.
/// `columns` is walked alongside rather than indexed, and a row with more
/// values than the description has columns reads the extras as text, as
/// `oid_at` did.
fn cells_from(read: Reader, columns: List<Column>, left: Int) -> List<Cell> {
  if left <= 0 {
    List::Nil
  } else {
    let oid = match columns {
      List::Nil => 25,
      List::Cons(column, _more) => column.oid,
    };
    let later = match columns {
      List::Nil => List::Nil,
      List::Cons(_column, more) => more,
    };
    // Read before recursing: the reader is where this cell is.
    let cell = cell_at(read, oid);
    List::Cons(cell, cells_from(read, later, left - 1))
  }
}

/// One value of a `DataRow`: its length, then that many bytes.
fn cell_at(read: Reader, oid: Int) -> Cell {
  let length = Reader::i32(read);
  // -1 is NULL, which is not the same as a value of length zero.
  if length < 0 {
    Cell::Null
  } else {
    let quick = if oid == 20 || oid == 21 || oid == 23 { Reader::digits(read, length) } else { Option::None };
    match quick {
      Option::Some(n) => Cell::Number(n),
      Option::None => oid_to_cell(oid, String::from_bytes(Reader::take(read, length))),
    }
  }
}

/// A text value, as the `Cell` its column's type calls for.
///
/// **Deliberately few.** `Number` for the integer types, `Money` for
/// `numeric`, `Flag` for `bool`, and `Text` for everything else.
///
/// `numeric` was `Text` until 13.12, on the argument that a value which does
/// not parse would have to become either a wrong number or a lost value. There
/// is a third answer and `int4` was already using it four lines down: try, and
/// keep the server's own digits when the answer is no. `Decimal::of_string`
/// returns an `Option` and rejects a numeral too long for the significand
/// rather than truncating it, which is exactly the case that made the question
/// look closed — a `numeric` wider than a hundred and twenty-eight bits stays
/// `Text` and loses nothing.
///
/// **`Float` appears nowhere in this function.** `float4` and `float8` are
/// `Text` for the same reason `Cell` has no float variant: a `Money` that went
/// through a binary float is a number that has already lost, and `std::json`
/// shipped that exact mistake until 13.11.
pub fn oid_to_cell(oid: Int, text: String) -> Cell {
  // 16 bool, 20 int8, 21 int2, 23 int4, 1700 numeric.
  if oid == 16 {
    Cell::Flag(text == "t")
  } else if oid == 20 || oid == 21 || oid == 23 {
    match Int::of_string(text) {
      Option::Some(n) => Cell::Number(n),
      // A server that says `int4` and sends something that is not one is
      // wrong, and guessing would hide it.
      Option::None => Cell::Text(text),
    }
  } else if oid == 1700 {
    match Decimal::of_string(text) {
      Option::Some(amount) => Cell::Money(amount),
      // Not a wrong number and not a lost value: the digits the server sent,
      // unchanged, for a caller that knows more than this function does.
      Option::None => Cell::Text(text),
    }
  } else {
    Cell::Text(text)
  }
}

// --- Vector to List ---------------------------------------------------------

/// A `Vector` as a `List`, in the same order.
///
/// Built back to front, which is why it walks down rather than up: `Cons` is
/// the cheap end of a list, and the alternative is appending once per element.
///
/// One generic function and not four copies. The four were here because an
/// earlier version of this file believed they had to be; they did not, and the
/// comment that said so was the wrong kind of wrong -- a note explaining a
/// limitation that was never tested.
fn to_list<A>(v: Vector<A>) -> List<A> {
  let mut out: List<A> = List::Nil;
  let mut i = Vector::length(v) - 1;
  while i >= 0 {
    match Vector::get(v, i) {
      Option::Some(item) => out = List::Cons(item, out),
      Option::None => (),
    };
    i = i - 1
  };
  out
}

// --- the buffer, from inside ------------------------------------------------
//
// Here rather than in `conn_test` because they build a `Connection` around a
// buffer and read `pending` and `start` afterwards. Those fields are private
// to this module, and a test in a separate module is outside it.

/// A connection whose buffer already holds `bytes`, so `next_message` answers
/// from it without reading the socket.
fn holding(bytes: Array<U8>) -> Connection {
  {
    handle: invalid_handle(), pending: bytes, start: 0, scram: Option::None, broken: false,
    open_transaction: false, depth: 0, inbox: Array::new(read_size(), 0),
  }
}

/// **An idle connection holds no buffer from its last reply.** Taking a
/// message moves an offset rather than copying, so without letting go of a
/// drained buffer a pooled connection that once answered a 1 MB row would
/// keep that megabyte until its next query. The last message of a reply is
/// `ReadyForQuery`, which usually ends a read, so this is the ordinary case.
test "taking the last buffered message lets the buffer go" {
  let bytes = Writer::new();
  Writer::raw(bytes, framed(68, Array::new(3000, 120)));
  Writer::raw(bytes, framed(90, Array::new(1, 73)));
  let c = holding(Writer::finish(bytes));

  match next_message(c) {
    Result::Ok(m) => assert(m.kind == 68 && Array::length(m.payload) == 3000),
    Result::Err(_) => assert(false),
  };
  // One message still waiting, so the buffer is still needed.
  assert(Array::length(c.pending) == 3000 + 5 + 6);

  match next_message(c) {
    Result::Ok(m) => assert(m.kind == 90),
    Result::Err(_) => assert(false),
  };
  assert(Array::length(c.pending) == 0);
  assert(c.start == 0);
}

/// A connection to a loopback socket this test holds the other end of, and
/// that end: what the test writes there is what `next_message` and
/// `still_open` read, in the pieces it was written in, with no server.
///
/// One fiber writes and then reads, which works because the kernel keeps
/// what was written until it is read. A port is tried until one binds, so a
/// port another program holds is skipped rather than failed on.
type Wire = { client: Connection, server: Int, listener: Int };

fn wire() -> Wire {
  // Winsock refuses every socket call until it is started; on Linux and
  // macOS this does nothing. `connect` starts it the same way. A start that
  // failed shows as the invalid handles each test asserts against.
  let _started = start();
  let mut port = 47100;
  let mut listener = invalid_handle();
  while listener == invalid_handle() && port < 47400 {
    listener = listen_on(port);
    if listener == invalid_handle() { port = port + 1 }
  };
  let handle = connect_to("127.0.0.1", port);
  // A read that waits for bytes this test never sends fails after a second
  // rather than holding the suite: a parse that went wrong usually looks
  // like a message still arriving.
  set_receive_timeout(handle, 1000);
  let server = accept_on(listener);
  // The inbox filled with a byte no message here uses, so a read that
  // carried stale inbox bytes past what arrived shows as garbage rather
  // than as zeros.
  let c: Connection = {
    handle: handle, pending: Array::new(0, 0), start: 0, scram: Option::None, broken: false,
    open_transaction: false, depth: 0, inbox: Array::new(read_size(), 255),
  };
  { client: c, server: server, listener: listener }
}

/// `bytes` from `from` up to `to`.
fn piece(bytes: Array<U8>, from: Int, to: Int) -> Array<U8> {
  let out: Array<U8> = Array::new(to - from, 0);
  Array::copy_into(bytes, from, out, 0, to - from);
  out
}

fn unwire(w: Wire) -> () {
  shut(w.client.handle);
  shut(w.server);
  shut(w.listener)
}

/// **Each read appends only the bytes it received, though the inbox is the
/// same array every time.** A read that appended the whole inbox would carry
/// the previous, longer read's leftovers into `pending`, and the next message
/// would be parsed out of them. So a long message arrives first, then a short
/// one alone, split across reads the way a socket delivers them, and each
/// must come out whole and then nothing more.
test "next_message reads only what arrived, into a reused inbox" {
  let w = wire();
  assert(w.listener != invalid_handle() && w.server != invalid_handle() && w.client.handle != invalid_handle());
  let long = framed(68, Array::new(3000, 120));
  let short = framed(90, Array::new(1, 73));
  transmit_bytes(w.server, long);
  match next_message(w.client) {
    Result::Ok(m) => assert(m.kind == 68 && Array::length(m.payload) == 3000),
    Result::Err(_) => assert(false),
  };
  // In two pieces: a header that is not yet a message, then the rest.
  transmit_bytes(w.server, piece(short, 0, 3));
  transmit_bytes(w.server, piece(short, 3, Array::length(short)));
  match next_message(w.client) {
    Result::Ok(m) => assert(m.kind == 90 && Array::length(m.payload) == 1 && U8::to_int(Array::get(m.payload, 0)) == 73),
    Result::Err(_) => assert(false),
  };
  // Nothing left over from the long read.
  assert(Array::length(w.client.pending) - w.client.start == 0);
  assert(!w.client.broken);
  unwire(w)
}

/// **The lease check keeps only what arrived as well.** A server may send a
/// `ParameterStatus` between queries; `still_open` reads it through the same
/// inbox and must leave exactly it in `pending`, for the next exchange to
/// skip. Leftover inbox bytes would be judged as a message of their own and
/// a healthy connection reported broken.
test "still_open keeps only what arrived from a reused inbox" {
  let w = wire();
  assert(w.listener != invalid_handle() && w.server != invalid_handle() && w.client.handle != invalid_handle());
  // A long message read first, so the inbox holds 3000 bytes of it.
  transmit_bytes(w.server, framed(68, Array::new(3000, 120)));
  match next_message(w.client) {
    Result::Ok(m) => assert(m.kind == 68),
    Result::Err(_) => assert(false),
  };
  let status = Writer::new();
  Writer::cstring(status, "TimeZone");
  Writer::cstring(status, "UTC");
  let unasked = framed(83, Writer::finish(status));
  transmit_bytes(w.server, unasked);
  assert(still_open(w.client));
  assert(Array::length(w.client.pending) - w.client.start == Array::length(unasked));
  match next_message(w.client) {
    Result::Ok(m) => assert(m.kind == 83),
    Result::Err(_) => assert(false),
  };
  unwire(w)
}

/// A `RowDescription` with these columns, as the server frames it.
fn description(names: List<String>, oids: List<Int>) -> Array<U8> {
  let body = Writer::new();
  Writer::i16(body, List::length(names));
  let mut rest_names = names;
  let mut rest_oids = oids;
  let mut going = true;
  while going {
    match rest_names {
      List::Nil => going = false,
      List::Cons(name, more) => {
        let oid = match rest_oids { List::Nil => 25, List::Cons(o, _later) => o };
        rest_oids = match rest_oids { List::Nil => List::Nil, List::Cons(_o, later) => later };
        Writer::cstring(body, name);
        Writer::i32(body, 0);
        Writer::i16(body, 0);
        Writer::i32(body, oid);
        Writer::i16(body, 4);
        Writer::i32(body, -1);
        Writer::i16(body, 0);
        rest_names = more
      },
    }
  };
  framed(84, Writer::finish(body))
}

/// A `DataRow` of these values, `None` for NULL.
fn row_of(values: List<Option<String>>) -> Array<U8> {
  let body = Writer::new();
  Writer::i16(body, List::length(values));
  let mut rest = values;
  let mut going = true;
  while going {
    match rest {
      List::Nil => going = false,
      List::Cons(value, more) => {
        match value {
          Option::None => Writer::i32(body, -1),
          Option::Some(text) => { Writer::i32(body, String::byte_length(text)); Writer::text(body, text) },
        };
        rest = more
      },
    }
  };
  framed(68, Writer::finish(body))
}

/// **A whole reply, read the way `ask` reads one.** Every row carries the
/// column names, which are built once per reply and shared, and every
/// integer column is read from its digits where it can be -- including the
/// ones it cannot, which come out as the text path makes them. A reply with
/// a second description (two statements) must not keep the first one's
/// names.
test "a reply's rows carry their names and read integers from their digits" {
  let bytes = Writer::new();
  Writer::raw(bytes, description(["id", "message", "big"], [23, 25, 20]));
  Writer::raw(bytes, row_of([Option::Some("7"), Option::Some("hello"), Option::Some("-9000000000")]));
  Writer::raw(bytes, row_of([Option::Some("-12"), Option::None, Option::Some("")]));
  // Not digits, and too long to be safe: both go the slow way.
  Writer::raw(bytes, row_of([Option::Some(" 3"), Option::Some("é"), Option::Some("9223372036854775807")]));
  Writer::raw(bytes, framed(67, String::bytes("SELECT 3\u{0}")));
  Writer::raw(bytes, framed(90, Array::new(1, 73)));
  let c = holding(Writer::finish(bytes));

  match collect(c) {
    Result::Err(_) => assert(false),
    Result::Ok(answer) => {
      assert(answer.tag == "SELECT 3");
      assert(List::length(answer.rows) == 3);
      for row in answer.rows {
        assert(row.columns == ["id", "message", "big"]);
      };
      match answer.rows {
        List::Cons(first, later) => {
          assert(first.cells == [Cell::Number(7), Cell::Text("hello"), Cell::Number(-9000000000)]);
          match later {
            List::Cons(second, last) => {
              assert(second.cells == [Cell::Number(-12), Cell::Null, Cell::Text("")]);
              match last {
                List::Cons(third, _none) =>
                  assert(third.cells == [Cell::Text(" 3"), Cell::Text("é"), Cell::Number(9223372036854775807)]),
                List::Nil => assert(false),
              }
            },
            List::Nil => assert(false),
          }
        },
        List::Nil => assert(false),
      }
    },
  };
  assert(!c.open_transaction);
}

test "a second description in one reply names the rows after it" {
  let bytes = Writer::new();
  Writer::raw(bytes, description(["a"], [23]));
  Writer::raw(bytes, row_of([Option::Some("1")]));
  Writer::raw(bytes, description(["b"], [25]));
  Writer::raw(bytes, row_of([Option::Some("1")]));
  Writer::raw(bytes, framed(90, Array::new(1, 73)));
  let c = holding(Writer::finish(bytes));
  match collect(c) {
    Result::Err(_) => assert(false),
    Result::Ok(answer) => match answer.rows {
      List::Cons(first, rest) => {
        assert(first.columns == ["a"] && first.cells == [Cell::Number(1)]);
        match rest {
          List::Cons(second, _none) => assert(second.columns == ["b"] && second.cells == [Cell::Text("1")]),
          List::Nil => assert(false),
        }
      },
      List::Nil => assert(false),
    },
  };
}

/// **What a read appends to.** `extend` is what joins the unread end of the
/// last read to the bytes a new one brought, and a copy that started in the
/// wrong place or stopped short would put a reply out of step with no error
/// until a later message made no sense. Every split of the head against every
/// length of the tail, with the read buffer longer than what arrived, as the
/// connection's read buffer always is.
test "extend keeps the unread head and appends only what arrived" {
  let head: Array<U8> = Array::from_fn(10, fn i => U8::of(100 + i));
  let tail: Array<U8> = Array::from_fn(read_size(), fn i => U8::of(Int::and(i, 255)));
  for from in [0, 1, 5, 9, 10] {
    for arrived in [0, 1, 7, 4096, read_size()] {
      let out = extend(head, from, tail, arrived);
      assert(Array::length(out) == 10 - from + arrived);
      let mut i = 0;
      while i < 10 - from {
        assert(U8::to_int(Array::get(out, i)) == 100 + from + i);
        i = i + 1
      };
      let mut j = 0;
      while j < arrived {
        assert(U8::to_int(Array::get(out, 10 - from + j)) == Int::and(j, 255));
        j = j + 1
      }
    }
  };
}

/// A buffer holding the start of the next message is kept: dropping it would
/// lose those bytes, and the reply would be read out of step.
test "a partial message after the last whole one is kept" {
  let bytes = Writer::new();
  Writer::raw(bytes, framed(90, Array::new(1, 73)));
  Writer::u8(bytes, 68);
  let c = holding(Writer::finish(bytes));

  match next_message(c) {
    Result::Ok(m) => assert(m.kind == 90),
    Result::Err(_) => assert(false),
  };
  assert(Array::length(c.pending) - c.start == 1);
}

extern fn khora_alloc_count() -> Int;

/// A reply of `rows` rows of the fortunes page's shape -- an `int4` and a
/// `text` column -- as the server frames it.
fn fortunes_reply(rows: Int) -> Array<U8> {
  let bytes = Writer::new();
  Writer::raw(bytes, description(["id", "message"], [23, 25]));
  let mut i = 0;
  while i < rows {
    Writer::raw(bytes, row_of([Option::Some(Int::to_string(i + 1)), Option::Some("fortune ${Int::to_string(i)}")]));
    i = i + 1
  };
  Writer::raw(bytes, framed(67, String::bytes("SELECT ${Int::to_string(rows)}\u{0}")));
  Writer::raw(bytes, framed(90, Array::new(1, 73)));
  Writer::finish(bytes)
}

/// What `collect` allocated reading a reply, and whether it read the rows
/// `fortunes_reply` wrote.
type Spent = { count: Int, right: Bool };

fn spent_reading(bytes: Array<U8>, rows: Int) -> Spent {
  let c = holding(bytes);
  let before = khora_alloc_count();
  let answer = collect(c);
  let count = khora_alloc_count() - before;
  let right = match answer {
    Result::Err(_) => false,
    Result::Ok(read) => {
      let mut fine = List::length(read.rows) == rows;
      let mut n = 1;
      for row in read.rows {
        fine = fine && row.columns == ["id", "message"]
        && row.cells == [Cell::Number(n), Cell::Text("fortune ${Int::to_string(n - 1)}")];
        n = n + 1
      };
      fine
    },
  };
  { count: count, right: right }
}

/// **Reading a reply builds each row's cells once.** A row is a `List<Cell>`,
/// and gathering the cells into a `Vector` first and converting it cost 19
/// objects per row of this shape, where building the list directly is 16.
/// What is counted is the cost of sixteen more rows, so the reply's fixed
/// cost is not in it.
test "reading a row allocates its cells once" {
  let small = spent_reading(fortunes_reply(16), 16);
  let large = spent_reading(fortunes_reply(32), 32);
  assert(small.right && large.right);
  let per_row = (large.count - small.count) / 16;
  assert_that(per_row <= 16, "a row of two columns allocated ${Int::to_string(per_row)}");
}
