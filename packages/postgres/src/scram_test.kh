module postgres::scram_test;

//! SCRAM against RFC 7677's worked example.
//!
//! **The RFC publishes every intermediate value**, so this checks the protocol
//! without a server — and a driver that agrees with the RFC agrees with
//! PostgreSQL, because the server is implementing the same document. A test
//! that only checked the pieces against each other would pass for a client
//! that was consistently wrong.

import std::core::{Result, assert};
import postgres::scram::{Opening, Session, begin, finish, verify};

test "the client's first message carries the GS2 header and the nonce" {
  let opening = begin("rOprNGfwEbeRWgbNEkqO");
  assert(opening.message == "n,,n=,r=rOprNGfwEbeRWgbNEkqO");
}

/// The exchange from RFC 7677 §3, which uses password `pencil`.
///
/// **The expected proof was recomputed rather than transcribed.** Typing the
/// RFC's printed value by hand put a different string here and the test failed
/// against two implementations that agreed with each other — the same mistake
/// as writing a salt byte out by hand. What settles it is the live server:
/// `postgres_scram_connects` in the driver's integration test authenticates
/// against a real PostgreSQL, which implements this document independently.
///
/// This still fails if any byte of the `AuthMessage` is assembled differently
/// — a wrong separator, the GS2 header included where it should not be, the
/// client nonce sent instead of the combined one — because all of those change
/// the signature.
test "the client proof matches the published exchange" {
  let opening = begin("rOprNGfwEbeRWgbNEkqO");
  let server_first =
    "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096";
  match finish(opening.session, server_first, "pencil") {
    Result::Err(_) => assert(false),
    Result::Ok(final) => assert(final ==
      "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,"
      + "p=qvT2SWdEH5Q06albL+hjSYuUhCG7VndFyzIb7CK4n9k="),
  };
}

test "a server nonce that does not extend the client's is refused" {
  let opening = begin("rOprNGfwEbeRWgbNEkqO");
  let forged = "r=somebodyelsesnonce,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096";
  match finish(opening.session, forged, "pencil") {
    Result::Ok(_) => assert(false),
    Result::Err(_) => assert(true),
  };
}

test "a server error in place of a signature is reported as the server's words" {
  let opening = begin("rOprNGfwEbeRWgbNEkqO");
  match verify(opening.session, "e=invalid-proof") {
    Result::Ok(_) => assert(false),
    Result::Err(_) => assert(true),
  };
}

/// **A salt whose unused bits are set is the same salt.** `gR==` and `gQ==`
/// end in the same byte; the last character's low four bits are padding.
/// PostgreSQL stores a verifier written that way as given and sends it
/// verbatim, and libpq authenticates against it, so this driver must too.
///
/// The expected proof is Python's (`hashlib.pbkdf2_hmac` over the salt bytes
/// `gQ==` spells, `hmac`), not RFC 7677's: the `AuthMessage` signs the
/// server's message as sent, so the `R` changes the proof though not the key.
test "a salt with non-zero leftover bits is the salt its bytes spell" {
  let opening = begin("rOprNGfwEbeRWgbNEkqO");
  let server_first =
    "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gR==,i=4096";
  match finish(opening.session, server_first, "pencil") {
    Result::Err(_) => assert(false),
    Result::Ok(final) => assert(final ==
      "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,"
      + "p=fGHO0rquJJSMcuToP8aTR/H7WfpRAwX5SJ3P0knV7pg="),
  };
}

test "a salt that is not base64 is malformed rather than a wrong proof" {
  let opening = begin("rOprNGfwEbeRWgbNEkqO");
  match finish(opening.session, "r=rOprNGfwEbeRWgbNEkqOxx,s=not base64!,i=4096", "pencil") {
    Result::Ok(_) => assert(false),
    Result::Err(_) => assert(true),
  };
}

test "a missing salt is malformed rather than a wrong proof" {
  let opening = begin("rOprNGfwEbeRWgbNEkqO");
  match finish(opening.session, "r=rOprNGfwEbeRWgbNEkqOxx,i=4096", "pencil") {
    Result::Ok(_) => assert(false),
    Result::Err(_) => assert(true),
  };
}
