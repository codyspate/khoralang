module ai::llm;

//! Model inference as a capability.
//!
//! A program that calls a model reaches the network, spends money and returns
//! something different every time, so `LLMService` is an effect and the `with`
//! clause says which functions may do it.
//!
//! # Why this is a package and not `std`
//!
//! It was `std::ai` until it was read with 1.0 in mind. Every public item in
//! `std` is a promise for the life of a major version, and this is a vocabulary
//! for an interface that no two providers have agreed on yet -- `role` is a
//! `String` here precisely because the set of roles keeps moving. A package can
//! follow that; `std` would have to be widened by a compatibility promise every
//! time a vendor added a word.
//!
//! [The ecosystem design note](https://github.com/codyspate/khoralang/blob/main/docs/design/ecosystem.md) already put vendor clients here, for the same
//! reason it puts database drivers here. This module is the half of the old
//! `std::ai` that had an implementation and a caller; the tensor half -- a
//! shape-checked `Tensor`, `matmul`, `Embedding` and `cosine_similarity` -- was
//! deleted rather than moved. It declared functions with no bodies, nothing in
//! the repository called any of them, and its own doc examples imported two
//! types that never existed.
//!
//! **Still not an implementation of anything.** There is no HTTP here and no
//! tokenizer: what a package this size can honestly offer is the effect
//! declaration that lets a caller say what it needs without naming a provider.
//!
//! `extract` is the shape of the whole module. A caller writes
//! `let report: Report = extract(prompt)!` and `LLMService` never learns that
//! reports exist -- the handler answers `complete: Prompt -> String`, and the
//! type's own schema, which `derive(Decode)` writes, describes the answer to
//! the model and turns that string into the type the call site asked for.

import std::core::{List, Option, Redacted, Result, Validated};
import std::json::{JsonError, encode, parse};
import std::schema::{Decode, Problem, Raw, Rejection, Schema, Shape};

/// One turn of a conversation: who said it, and what they said.
///
/// `role` is text rather than a variant type deliberately. Providers disagree
/// about the set — `system`, `user`, `assistant`, `tool`, `developer` — and a
/// variant here would have to be widened by `std` every time one of them added
/// a word.
pub type Message = {
  role: String,
  content: String,
};

/// What is sent to a model: standing instructions, a conversation, and how
/// much variation to allow.
///
/// Built by piping rather than by filling in a record, so a half-built prompt
/// is never a value anybody holds. See the `impl` below.
pub type Prompt = {
  system_instructions: Option<String>,
  messages: List<Message>,
  temperature: Float,
};

/// Built by piping: `Prompt::new() |> Prompt::system(..) |> Prompt::user(..)`.
/// Each returns a new prompt rather than mutating one, so a half-built prompt
/// cannot be shared and then changed underneath its other holder.
impl Prompt {
  /// An empty prompt: no instructions, no messages, temperature one.
  pub fn new() -> Prompt {
    { system_instructions: Option::None, messages: List::Nil, temperature: 1.0 }
  }

  /// Replaces the system instructions; the last one written wins.
  pub fn system(self, instructions: String) -> Prompt {
    {
      system_instructions: Option::Some(instructions),
      messages: self.messages,
      temperature: self.temperature,
    }
  }

  /// Adds a turn from the person asking.
  pub fn user(self, message: String) -> Prompt {
    Prompt::saying(self, "user", message)
  }

  /// Adds a turn from the model, which is how a conversation is replayed.
  pub fn assistant(self, message: String) -> Prompt {
    Prompt::saying(self, "assistant", message)
  }

  /// Adds a turn under any role. `user` and `assistant` are this with the two
  /// roles every provider agrees on.
  pub fn saying(self, role: String, content: String) -> Prompt {
    {
      system_instructions: self.system_instructions,
      messages: List::Cons({ role: role, content: content }, self.messages),
      temperature: self.temperature,
    }
  }

  /// Sets how much variation to allow. Zero is as close to deterministic as a
  /// provider offers, which is not a promise any of them makes.
  pub fn at_temperature(self, temperature: Float) -> Prompt {
    {
      system_instructions: self.system_instructions,
      messages: self.messages,
      temperature: temperature,
    }
  }

  /// The prompt, with a description of what the answer should look like
  /// appended. What `extract` puts between a caller's request and the model:
  /// the type's JSON Schema, as text.
  fn describing(self, spec: String) -> Prompt {
    Prompt::saying(self, "user", "Answer with exactly this shape: " + spec)
  }
}

/// Why a model call did not produce an answer.
///
/// Coarse on purpose, on the same reasoning `std::db`'s `DbError` gives: every
/// provider numbers its failures differently, and a `std` that picked one
/// would be wrong for the second. `RateLimited` carries the wait because a
/// caller can act on it; the rest carry text.
pub type ModelError =
  | ContextLengthExceeded(max_tokens: Int)
  | RateLimited(retry_after_ms: Int)
  | InferenceEngineFailure(msg: String)
  /// The model answered, and the answer was not the type asked for: every
  /// problem with it, the way a request body's problems are reported, because
  /// a model is allowed to be wrong and the ordinary case is that it is
  /// wrong in several places.
  | SchemaExtractionError(problems: List<Rejection>);

/// Inference is a capability, not a value: a function that classifies text
/// declares `with { ai: LLMService }`, and the caller decides what serves it.
///
/// **Two operations, and both are rank-1.** A model takes a prompt and returns
/// text, or takes text and returns numbers; that is the whole of what it does,
/// and it is the whole of what belongs here. Asking for a typed answer is
/// `extract` below — a generic *function* over this effect, because an
/// operation is a field of a handler and a field has one type.
///
/// Keeping the effect this small is what makes a mock one line: return a
/// string. An effect that asked a handler to fabricate whatever shape the
/// caller wanted would make a test exercise the mock rather than the code
/// under it.
pub effect LLMService {
  complete: Prompt -> String raises ModelError,
  /// The raw vector, at whatever width the model produces. `embed` below is
  /// the shape-safe reading of it.
  embed_raw: String -> List<Float> raises ModelError,
}

/// A typed answer from the model.
///
/// The call every caller wants — `let report = extract(prompt)!` — and the
/// reason `LLMService` does not have to know that reports exist. `A` is chosen
/// by the caller, which is what makes this a function rather than an
/// operation: a generic function is specialized at each call site, and a field
/// of a handler cannot be.
///
/// **The type's schema is the whole of the contract.** Its shape, rendered as
/// a JSON Schema, is what the model is told to produce; its decoder is what
/// reads the answer back, reporting every problem. A type that derives
/// `Decode` needs nothing else to be extracted.
///
/// ```khora
/// import ai::llm::{LLMService, ModelError, Prompt, extract};
/// import std::schema::{Decode};
///
/// derive(Decode)
/// pub type Invoice = { total_minor: Int, currency: String };
///
/// fn read_invoice(text: String) -> Invoice
///   with { ai: LLMService }
///   raises ModelError
/// {
///   extract(Prompt::new() |> Prompt::user("Read this invoice: " + text))!
/// }
/// ```
///
/// Nothing else is written. The type's shape is rendered as a JSON Schema and
/// is what the model is told to produce, and its decoder reads the answer
/// back -- so a model that answers with a string where a number belongs is a
/// `Rejection` naming the field, not a wrong number.
pub fn extract<A: Decode>(prompt: Prompt) -> A

  with { ai: LLMService }
  raises ModelError
{
  let schema: Schema<A> = Decode::schema();
  let described = Prompt::describing(prompt, encode(Shape::to_json_schema(schema.shape)));
  let text = ai.complete(described)!;
  match parse(text) {
    Result::Err(why) => raise ModelError::SchemaExtractionError(List::Cons(not_json(why), List::Nil)),
    Result::Ok(document) =>
      match Schema::decode(schema, Raw::of_json(document)) {
        Validated::Valid(answer) => answer,
        Validated::Invalid(problems) => raise ModelError::SchemaExtractionError(problems),
      },
  }
}

/// The model's answer was not a document at all, said in the same shape as
/// a document that was the wrong one.
fn not_json(why: JsonError) -> Rejection {
  let found = "text that stopped being JSON at byte " + Int::to_string(why.at) + ", where "
  + why.expected + " was expected";
  { path: List::Nil, secret: false, problem: Problem::Wrong("a JSON document", Redacted::of(found)) }
}
