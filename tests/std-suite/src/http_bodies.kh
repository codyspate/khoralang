module std_suite::http_bodies;

//! What a `Response` puts on the wire.
//!
//! These are claims about a value, not about a server, so they belong here
//! rather than in a test that binds a port: `Response::rendered` is the whole
//! message as text and can be read directly.

import std::core::{assert_that};
import std::net::http::{Response};

test "a String handed to Response::json is encoded, not passed through" {
  // `String` has an `Encode` impl and it encodes to a *JSON string*. So JSON
  // somebody assembled by hand comes back quoted and escaped inside another
  // string -- a correct encoding of the wrong thing, with no diagnostic.
  //
  // This is pinned rather than fixed because it is what `Encode` means. What
  // the trap needed was somewhere else to go, which is `Response::of`.
  let hand_built = "{\"code\":\"abc\"}";
  let rendered = Response::rendered(Response::json(200, hand_built));
  assert_that(String::contains(rendered, "\\\"code\\\""),
    "the quotes are escaped, so the body is a string: " + rendered);
}

test "Response::of sends a body that is already serialised, as it is" {
  let hand_built = "{\"code\":\"abc\"}";
  let rendered = Response::rendered(Response::of(200, "application/json", hand_built));
  assert_that(String::contains(rendered, "{\"code\":\"abc\"}"),
    "the body survives unaltered: " + rendered);
  assert_that(!String::contains(rendered, "\\\""),
    "and nothing was escaped into it: " + rendered);
  assert_that(String::contains(rendered, "Content-Type: application/json"),
    "with the content type asked for: " + rendered);
}
