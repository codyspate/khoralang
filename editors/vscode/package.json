{
  "name": "khora",
  "displayName": "Khora",
  "description": "Language support for Khora (.kh): errors as you type, hover types, go to definition, completion, semantic highlighting, effect-row inlay hints, and format on save.",
  "version": "0.3.0",
  "publisher": "khora-lang",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/codyspate/khoralang"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:khora"
  ],
  "contributes": {
    "languages": [
      {
        "id": "khora",
        "aliases": [
          "Khora",
          "khora"
        ],
        "extensions": [
          ".kh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "khora",
        "scopeName": "source.khora",
        "path": "./syntaxes/khora.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Khora",
      "properties": {
        "khora.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `khora` executable. Empty means look on `PATH`, which is where the installer puts it."
        },
        "khora.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between this extension and the server, into the Khora output channel."
        }
      }
    },
    "commands": [
      {
        "command": "khora.restartServer",
        "title": "Khora: Restart Language Server"
      },
      {
        "command": "khora.showOutput",
        "title": "Khora: Show Language Server Output"
      },
      {
        "command": "khora.runTest",
        "title": "Khora: Run Test"
      }
    ],
    "configurationDefaults": {
      "[khora]": {
        "editor.formatOnSave": true
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "khora.runTest",
          "when": "false"
        }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.2.1"
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository -o khora-lang.khora.vsix"
  }
}
