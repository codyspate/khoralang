module main;

import std::core::{Array, Nursery, Task, bounded_nursery, print};
import std::net::http::{Response};
import std::net::socket::{accept_on, invalid_handle, listen_on, receive, set_receive_timeout, shut, start, transmit};

// The floor plus *only* response building: no parsing, no routing. Against the
// bare floor this says what `Response::rendered_keeping` costs, and against the
// whole server it says what is left for the parser and the router.

fn serve(connection: Int) -> () {
  set_receive_timeout(connection, 10000);
  let buffer: Array<U8> = Array::new(8192, 0);
  let mut going = true;
  while going {
    let read = receive(connection, buffer);
    if read <= 0 {
      going = false;
    } else {
      let answer = Response::json(200, "{\"status\":\"ok\"}");
      transmit(connection, Response::rendered_keeping(answer, true));
    }
  };
  shut(connection)
}

fn loop_forever(server: Int) -> ()
  with { nursery: Nursery }
{
  let taken = accept_on(server);
  if taken == invalid_handle() {
  } else {
    nursery.adopt(Task::spawn(fn () => serve(taken)));
  };
  loop_forever(server)
}

pub fn main() -> () {
  start();
  let server = listen_on(18951);
  print("listening");
  bounded_nursery(256, fn () => loop_forever(server))
}
