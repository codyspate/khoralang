module techempower::main;

import std::core::{ChildFailed, Fibers, Iterator, List, Option, Ord, Result, SharedFn, Step};
import std::db::{Cell, Db, DbError, Row};
import std::env::{Env, EnvError, variable_or};
import std::net::http::{HttpError, Request, Response, Router};
import std::random::{Random};
import std::schema::{Encode};
import postgres::db::{Settings};
import postgres::pool::{Pool, open as open_pool, with_db};

// The four TechEmpower read tests -- JSON serialization, single query,
// multiple queries, Fortunes -- written the way a Khora service would be:
// `std::net::http`'s `Router`, `packages/postgres` behind the `Db`
// capability, a pool of connections shared by every handler.
//
// The rules that make the numbers comparable are TechEmpower's, and each one
// that shapes the code is noted where it does: a new object per request, a
// new query per row, no cache, the escaping, the headers. The Go, Node and
// Bun servers beside this one do exactly the same work.

// ---------------------------------------------------------------------------
// What is sent
// ---------------------------------------------------------------------------

/// The JSON test's object. **Made per request and serialised per request**:
/// TechEmpower forbids caching either, and a constant body string would be
/// measuring a memcpy.
derive(Encode)
type Message = {
  message: String,
};

/// One `World` row. `randomNumber` is spelled the way the test's JSON spells
/// it; the verifier is case-sensitive about keys.
derive(Encode)
type World = {
  id: Int,
  randomNumber: Int,
};

/// One `Fortune` row, read from the table or added at request time.
type Fortune = {
  id: Int,
  message: String,
};

// ---------------------------------------------------------------------------
// The headers every response carries
// ---------------------------------------------------------------------------

/// `Server` on a response. TechEmpower requires it and `Date` on every test;
/// `std::net::http` writes `Date` itself, once a second per connection, and
/// the server's name is the app's to give, so each handler's answer passes
/// through here for that one header.
fn stamped(response: Response) -> Response {
  Response::with_header(response, "Server", "khora")
}

// ---------------------------------------------------------------------------
// The statements
// ---------------------------------------------------------------------------

fn world_by_id(id: Int) -> Result<List<Row>, DbError> with { db: Db } {
  db.query("SELECT id, randomnumber FROM world WHERE id = $1", List::Cons(Cell::Number(id), List::Nil))
}

/// No `ORDER BY`: the test forbids it, and the added row has to be sorted in
/// with the others anyway.
fn all_fortunes() -> Result<List<Row>, DbError> with { db: Db } {
  db.query("SELECT id, message FROM fortune", List::Nil)
}

// ---------------------------------------------------------------------------
// Reading rows
// ---------------------------------------------------------------------------
//
// **A row of the wrong shape is a 500, not a zero.** A `World` served with an
// id of 0 would pass for data, and the verifier only warns about ids out of
// range.

fn world_of(row: Row) -> Option<World> {
  match row.cells {
    List::Cons(Cell::Number(id), List::Cons(Cell::Number(random), List::Nil)) =>
      Option::Some({ id: id, randomNumber: random }),
    _other => Option::None,
  }
}

fn fortune_of(row: Row) -> Option<Fortune> {
  match row.cells {
    List::Cons(Cell::Number(id), List::Cons(Cell::Text(message), List::Nil)) =>
      Option::Some({ id: id, message: message }),
    _other => Option::None,
  }
}

/// A random row, by a fresh query. `None` when the database refused or the
/// row did not have the shape asked for.
fn random_world(pool: Pool) -> Option<World> with { rng: Random } {
  let id = rng.in_range(1, 10001);
  match with_db(pool, fn () => world_by_id(id)) {
    Result::Err(_) => Option::None,
    Result::Ok(Result::Err(_)) => Option::None,
    Result::Ok(Result::Ok(List::Cons(row, List::Nil))) => world_of(row),
    Result::Ok(Result::Ok(_)) => Option::None,
  }
}

// ---------------------------------------------------------------------------
// The four tests
// ---------------------------------------------------------------------------

fn json(_request: Request) -> Response {
  let hello: Message = { message: "Hello, World!" };
  Response::json(200, hello)
}

fn single(pool: Pool) -> Response with { rng: Random } {
  match random_world(pool) {
    Option::Some(world) => Response::json(200, world),
    Option::None => Response::text(500, "the database did not answer"),
  }
}

/// `queries` read by TechEmpower's rule: missing, not a number, or below one
/// is one; above 500 is 500.
fn count_of(request: Request) -> Int {
  match Request::query(request, "queries") {
    Option::None => 1,
    Option::Some(text) => match Int::of_string(text) {
      Option::None => 1,
      Option::Some(n) => if n < 1 { 1 } else if n > 500 { 500 } else { n },
    },
  }
}

/// One lease's worth of rows: `wanted` queries, sequentially, on the
/// connection the caller already holds.
fn some_worlds(wanted: Int) -> Option<List<World>> with { db: Db, rng: Random } {
  let mut worlds: List<World> = List::Nil;
  let mut failed = false;
  let mut done = 0;
  while done < wanted && !failed {
    let id = rng.in_range(1, 10001);
    match world_by_id(id) {
      Result::Ok(List::Cons(row, List::Nil)) => match world_of(row) {
        Option::Some(world) => worlds = List::Cons(world, worlds),
        Option::None => failed = true,
      },
      _other => failed = true,
    };
    done = done + 1
  };
  if failed { Option::None } else { Option::Some(worlds) }
}

/// **One query per row, one after another, all on one lease.** The test
/// forbids `IN (...)` and batching into one statement; every server here also
/// runs them sequentially, so the comparison is not also a comparison of how
/// much each fans out. The lease is taken once for the whole request, not
/// once per row: pgx's pool can do the same (`Acquire` once, `QueryRow` in a
/// loop), so this is a fair comparison of the pool designs, not a handicap
/// for Go.
fn multiple(pool: Pool, request: Request) -> Response with { rng: Random } {
  let wanted = count_of(request);
  let got = match with_db(pool, fn () => some_worlds(wanted)) {
    Result::Ok(found) => found,
    Result::Err(_) => Option::None,
  };
  match got {
    Option::None => Response::text(500, "the database did not answer"),
    Option::Some(worlds) => Response::json(200, List::reverse(worlds)),
  }
}

/// `wanted` rows by `query_each`: every lookup written to the server before
/// any reply is read, each still its own statement with its own `Sync`.
fn pipelined_worlds(wanted: Int) -> Option<List<World>> with { db: Db, rng: Random } {
  let mut ids: List<List<Cell>> = List::Nil;
  let mut done = 0;
  while done < wanted {
    ids = List::Cons(List::Cons(Cell::Number(rng.in_range(1, 10001)), List::Nil), ids);
    done = done + 1
  };
  let mut worlds: List<World> = List::Nil;
  let mut failed = false;
  let mut got = 0;
  for answer in db.query_each("SELECT id, randomnumber FROM world WHERE id = $1", ids) {
    match answer {
      Result::Ok(List::Cons(row, List::Nil)) => match world_of(row) {
        Option::Some(world) => worlds = List::Cons(world, worlds),
        Option::None => failed = true,
      },
      _other => failed = true,
    };
    got = got + 1
  };
  if failed || got != wanted { Option::None } else { Option::Some(worlds) }
}

/// **The multiple-queries test, pipelined.** The same rows, counts and body
/// as `/queries`, but the `wanted` lookups go to the server in one write
/// and their replies are read in order. TechEmpower's rule 7 allows it as
/// long as each query is its own statement separated by a `Sync`, which
/// `query_each` guarantees. Its own route, so `/queries` stays sequential
/// for every server; see the README for which servers have it and why.
fn pipelined(pool: Pool, request: Request) -> Response with { rng: Random } {
  let wanted = count_of(request);
  let got = match with_db(pool, fn () => pipelined_worlds(wanted)) {
    Result::Ok(found) => found,
    Result::Err(_) => Option::None,
  };
  match got {
    Option::None => Response::text(500, "the database did not answer"),
    Option::Some(worlds) => Response::json(200, List::reverse(worlds)),
  }
}

fn fortunes(pool: Pool) -> Response {
  match with_db(pool, all_fortunes) {
    Result::Err(_) => Response::text(500, "the database did not answer"),
    Result::Ok(Result::Err(_)) => Response::text(500, "the database did not answer"),
    Result::Ok(Result::Ok(rows)) => match read_fortunes(rows) {
      Option::None => Response::text(500, "a fortune row had an unexpected shape"),
      Option::Some(read) => {
        let added = List::Cons({ id: 0, message: "Additional fortune added at request time." }, read);
        let sorted = List::sort_by(added, fn (a, b) => Ord::cmp(a.message, b.message));
        Response::of(200, "text/html; charset=utf-8", render(sorted))
      },
    },
  }
}

fn read_fortunes(rows: List<Row>) -> Option<List<Fortune>> {
  match rows {
    List::Nil => Option::Some(List::Nil),
    List::Cons(row, rest) => match fortune_of(row) {
      Option::None => Option::None,
      Option::Some(fortune) => match read_fortunes(rest) {
        Option::None => Option::None,
        Option::Some(others) => Option::Some(List::Cons(fortune, others)),
      },
    },
  }
}

// ---------------------------------------------------------------------------
// The page
// ---------------------------------------------------------------------------
//
// **Khora's `std` has no template facility**, so the page is written here.
// The template is TechEmpower's minimum one with the whitespace removed,
// which is what their example response is. The message is untrusted -- one
// row is a `<script>` tag, and the test exists to catch a page that runs it
// -- so it goes through `std`'s `String::escape_html`, as Go's app uses
// `html/template` and Bun's `Bun.escapeHTML`. (Node has no escaper in its
// standard library; its app writes one regex `replace`.)

fn render(fortunes: List<Fortune>) -> String {
  let rows = List::map(fortunes, fn f =>
    "<tr><td>${Int::to_string(f.id)}</td><td>${String::escape_html(f.message)}</td></tr>");
  "<!DOCTYPE html><html><head><title>Fortunes</title></head><body><table>"
  + "<tr><th>id</th><th>message</th></tr>"
  + String::join(rows, "")
  + "</table></body></html>"
}

// ---------------------------------------------------------------------------
// Starting up
// ---------------------------------------------------------------------------

fn setting(name: String, fallback: String) -> String with { env: Env } raises EnvError {
  variable_or(name, fallback)!
}

fn number_setting(name: String, fallback: Int) -> Int with { env: Env } raises EnvError {
  match Int::of_string(variable_or(name, Int::to_string(fallback))!) {
    Option::Some(chosen) => chosen,
    Option::None => fallback,
  }
}

pub fn main() raises HttpError + EnvError + ChildFailed {
  with { env: Env::real(), rng: Random::real() } {
    let settings: Settings = {
      host: setting("PGHOST", "127.0.0.1")!,
      port: number_setting("PGPORT", 5432)!,
      user: setting("PGUSER", "benchmarkdbuser")!,
      database: setting("PGDATABASE", "hello_world")!,
      secret: setting("PGPASSWORD", "benchmarkdbpass")!,
    };
    let crew = Fibers::open();
    let pool = open_pool(crew, settings, number_setting("POOL", 16)!);

    Router::new()
      |> Router::get("/json", SharedFn::of(fn request => stamped(json(request))))
      |> Router::get("/db", SharedFn::of(fn _request => stamped(single(pool))))
      |> Router::get("/queries", SharedFn::of(fn request => stamped(multiple(pool, request))))
      |> Router::get("/pipelined-queries", SharedFn::of(fn request => stamped(pipelined(pool, request))))
      |> Router::get("/fortunes", SharedFn::of(fn _request => stamped(fortunes(pool))))
      |> Router::listen_quietly(number_setting("PORT", 8080)!)!
  }
}
